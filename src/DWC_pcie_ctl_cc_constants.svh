// Enable 64-bit AtomicOp Completer support.
`define CX_ATOMIC_64_CPL_EN 1'h1


// Name:           CX_ATOMIC_128_CAS_EN
// Default:        false
// Values:         false (0x0), true (0x1)
// Enabled:        CX_ATOMIC_ENABLE
// Parameter Type: Feature Setting.
// 
// Enable 128-bit operand Compare and Swap (CAS) AtomicOp completion support.
`define CX_ATOMIC_128_CAS_EN 1'h1


// Name:           CX_DEF_MEM_WR_ENABLE
// Default:        true (CX_CXL_ENABLE)
