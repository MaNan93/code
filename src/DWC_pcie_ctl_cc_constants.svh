// Example: 0x00000030 indicates that VF BAR1 operates correctly with the 
//  VF BAR sized to either 1MB or 2MB.
`define VF_BAR1_RESOURCE_AVAIL_3 64'h10


// Name:           VF_BAR1_MASK_WRITABLE_3
// Default:        0x0 ((VF_BAR1_ENABLED_3==1 && VF_BAR1_SIZING_SCHEME_3 ==1) ? 1: 0)
// Values:         0x0, 0x1
// Enabled:        VF_BAR1_ENABLED_3==1 && CX_SRIOV_ENABLE && (CX_NFUNC > 3)
// Parameter Type: Feature Setting
// 
