// Name:           CX_RAS_DES_ENABLE
// Default:        false ((CX_AUTOMOTIVE_ENABLE==1)? 1: 0)
// Values:         false (0), true (1)
// Parameter Type: Feature Setting
// 
// Enables RAS D.E.S functions (debug functions, error injection and statistical analysis).
`define CX_RAS_DES_ENABLE


`define CX_RAS_DES_LMT_RXTLP 0


`define CX_RAS_DES_LMT_TXTLP 0


`define CX_RAS_DES_LMT_TXDLLP 0



// Name:           CX_RAS_DES_DBGIO_ENABLE
// Default:        true (CX_RAS_DES_ENABLE)
// Values:         false (0), true (1)
// Enabled:        CX_RAS_DES_ENABLE
// Parameter Type: Feature Setting
// 
// Determines whether to include the debug signals that provide RAS D.E.S. feature information in top-level ports.
`define CX_RAS_DES_DBGIO_ENABLE


// Name:           CX_RAS_DES_DBGIO_LTSSMMON
// Default:        false
// Values:         false (0), true (1)
// Enabled:        CX_RAS_DES_DBGIO_ENABLE && CX_7003_2023DEC_ENABLE
// Parameter Type: Feature Setting
// 
// Determines whether to include the LTSSM monitor debug signals that provide RAS D.E.S. feature information in top-level 
// ports.
// `define CX_RAS_DES_DBGIO_LTSSMMON


// Name:         CX_RAS_DES_DBGIO_LTSSMMON_OR_LAYER1_TB_INTERNAL
// Default:      0 ((CX_RAS_DES_DBGIO_LTSSMMON || SNPS_LAYER1_TB_INTERNAL) && 
//               CX_7003_2023DEC_ENABLE)
// Values:       0, 1
// 
// Enable when CX_RAS_DES_DBGIO_LTSSMMON is defined or SNPS_LAYER1_TB_INTERNAL is defined to use internal debug purpose
// `define CX_RAS_DES_DBGIO_LTSSMMON_OR_LAYER1_TB_INTERNAL


// Name:           CX_RAS_DES_DBGIO_OSMON
// Default:        false
// Values:         false (0), true (1)
// Enabled:        CX_RAS_DES_DBGIO_ENABLE && CX_7003_2023DEC_ENABLE
// Parameter Type: Feature Setting
// 
// Determines whether to include the OS monitor debug signals that provide RAS D.E.S. feature information in top-level 
// ports.
// `define CX_RAS_DES_DBGIO_OSMON


// Name:         CX_RAS_DES_DBGIO_OSMON_OR_LAYER1_TB_INTERNAL
// Default:      0 ((CX_RAS_DES_DBGIO_OSMON || SNPS_LAYER1_TB_INTERNAL) && 
//               CX_7003_2023DEC_ENABLE)
// Values:       0, 1
