// {id, cpl_stat, data}
`define CC_DTIM_FORM_ATS_RSP_RAW_INTF_WD 72


// Name:         CC_DTIM_FORM_ATS_RSP_INTF_WD
// Default:      81 (CX_RASDP_EN==1 ? [<functionof> CC_DTIM_FORM_ATS_RSP_RAW_INTF_WD 
//               CX_RAS_PROT_RANGE] + CC_DTIM_FORM_ATS_RSP_RAW_INTF_WD : 
//               CC_DTIM_FORM_ATS_RSP_RAW_INTF_WD)
// Values:       -2147483648, ..., 2147483647
// 
// DTIM AXI4-Stream Slave ATS Formation Response Interface Width
`define CC_DTIM_FORM_ATS_RSP_INTF_WD 81


// Name:         CC_DTIM_FORM_ATS_RSP_INTF_PROT_WD
// Default:      9 (CX_RASDP_EN==1 ? CC_DTIM_FORM_ATS_RSP_INTF_WD - 
//               CC_DTIM_FORM_ATS_RSP_RAW_INTF_WD : 0)
// Values:       -2147483648, ..., 2147483647
// 
// DTIM AXI4-Stream Slave ATS Formation Response Interface Protection Width
`define CC_DTIM_FORM_ATS_RSP_INTF_PROT_WD 9


// Name:         CC_DTIM_ATS_RSP_INTF_WD
// Default:      667 (CC_MAX_MSTR_TAG_PW +3 +!CX_AXI_MSTR_RD_RSP_INTERLEAVING_EN +3 
//               +CC_MSTR_BUS_WSTRB_WIDTH +CC_MSTR_BUS_DATA_WIDTH +1 
