// Parameter Type: Feature Setting
// 
// Defines the width necessary for the number of IDO ordering streams in the AXI bridge.
`define CC_ORDRB_NIDO_WD 3


// Name:         CC_IB_SCHEDULER_EN
// Default:      1 (MASTER_POPULATED && AXI_POPULATED && CX_MULTISTREAM_ARCH && 
//               !CC_ORDRB_EN)
// Values:       0, 1
// 
// AXI Inbound Scheduler Enable
`define CC_IB_SCHEDULER_EN


`define CC_IB_SCHEDULER_OR_ORDRB_EN


// `define CX_IB_P_ID_MNG_SO_UNDERSIZED


`define CX_IB_P_ID_MNG_RO_UNDERSIZED


// Name:           CC_IB_P_ID_MNG_EN
// Default:        1 (CC_ORDRB_EN || CC_IB_SCHEDULER_EN)
// Values:         0, 1
// Enabled:        (AMBA_INTERFACE > 1) && (!CC_ORDRB_EN)
// Parameter Type: Feature Setting
// 
// With this feature enabled, the AXI Bridge assigns AXI IDs to AXI Inbound Posted Requests. 
//  This allows your AXI Fabric to return Write Responses out-of-order while adhering to PCIe Ordering rules, for example: 
//  
//  - Between different VCs there are no ordering relationships. 
//  - DMA P Writes have no ordering relationship with PCIe P Writes. 
//  - IDO P Writes can overtake SO P Writes if the Requester ID / PASID is different. 
//  
//  The following rules are applied: 
//  1. If CC_ORDRB_EN = 1 and CC_IB_P_ID_MNG_RO_EN = 1 and the IB_P_ID_MNG_CTRL register is configured accordingly, RO 
//  Writes are assigned a unique AXI ID. If decomposition occurs, each AXI Write has a unique AXI ID. 
//  2. Else, if CC_DMA_ENABLE = 1, DMA Writes are assigned a dedicated AXI ID. There is 1 DMA AXI ID, shared between all 
//  DMA Writes. 
//  3. Else, if CC_ORDRB_EN = 1 and CC_ORDRB_NIDO > 0, IDO Writes will be assigned a AXI ID according to its IDO stream. 
//  Each IDO stream has a dedicated AXI ID, shared between all of its Writes. 
//  4. Else, Writes are assigned a AXI ID according to its VC. Each VC has a dedicated AXI ID, shared between all of its 
//  Writes. 
//  
//  Note 1: This feature only relaxes ordering in the AXI Fabric. Unless you also enable CC_IB_WREQ_PTRK_EN/CC_ORDRB_EN, 
//  AXI Writes will still be issued in the same order as TRGT1 Writes. 
//  Note 2: If CC_ORDRB_EN, this feature is always enabled. 
//  Note 3: If !CC_ORDRB_EN, Non-Posteds will no longer be blocked behind Posteds of different VCs.
`define CC_IB_P_ID_MNG_EN


// Name:           CC_IB_P_ID_MNG_RO_EN
// Default:        1 (CC_IB_P_ID_MNG_EN && (CC_ORDRB_EN || CC_IB_SCHEDULER_EN))
// Values:         0, 1
// Enabled:        (CC_IB_P_ID_MNG_EN && (CC_ORDRB_EN || CC_IB_SCHEDULER_EN))
// Parameter Type: Feature Setting
// 
// Populate RO-remapping logic for Inbound Posted ID Management. See description of CC_IB_P_ID_MNG_EN, rule 1. 
// This feature can only be enabled if CC_ORDRB_EN = 1.
`define CC_IB_P_ID_MNG_RO_EN


// Name:         CX_AXI_PRESP_SYN_GOAL
// Default:      Timing ( (CC_IB_P_ID_MNG_RO_EN ) ? 0 : 4)
// Values:       Timing (0), Performance (1), Hard QoR (2), Area (3), Automatic (4)
// Enabled:      ((AMBA_INTERFACE==2) || (AMBA_INTERFACE==3) || (AMBA_INTERFACE==4))
// 
// DWC_pcie_axi_presp_redo synthesis goal 
//  0: TIMING: 4 clock cycle latency to/from CDC boundary. Very low backpressure on mstr_b. Higher area (aprox. 2-4% total 
//  design size for 8 VC configuration). Chosen automatically if more than 8 non-RO Posted IDs used. 
//  1: PERF: 3 clock cycle latency to/from CDC boundary. Very low backpressure on mstr_b. Higher area (aprox. of 2-4% 
//  total design size for 8 VC configuration). Never chosen automatically. 
//  2: QOR: 4 clock cycle latency to/from CDC boundary. Significant backpressure on mstr_b. Higher area (aprox. 2-4% total 
//  design size for 8 VC configuration). Never chosen automatically. 
//  3: Area: 3 clock cycle latency to/from CDC boundary. Low backpressure on mstr_b. Lower area. Chosen automatically if 8 
//  or less non-RO Posted IDs used.
`define CX_AXI_PRESP_SYN_GOAL 0


// Name:         CX_IB_P_ID_MNG_MAX_IBR_ID
// Default:      257 (CC_IB_P_ID_MNG_EN ? (CX_NVC -1 + (CC_ORDRB_EN ? CC_ORDRB_NIDO 
//               : 0) + CC_DMA_ENABLE_VALUE + (CC_IB_P_ID_MNG_RO_EN ? 
//               CC_WR_CH_P_REQ_QUEUE_DP : 0)) : 0)
// Values:       -2147483648, ..., 2147483647
// 
// Maximum AXI ID for IB Posted Writes
`define CX_IB_P_ID_MNG_MAX_IBR_ID 257


