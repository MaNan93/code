// Transmit Arbitration Register 1 (in the register section of the Databook) through the DBI.
`define LPVC_WRR_WEIGHT_VC5 8'h0


// Name:           LPVC_WRR_WEIGHT_VC6
// Default:        0x0
// Values:         0x0, ..., 0x7f
