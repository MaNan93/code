//                 || (CX_RAM_PROTECTION_MODE==2 && CX_RADMQ_MODE!=2) 
//                 || (CX_ECRC_ENABLE && CC_DEVICE_TYPE!=CC_SW && !(CX_P2P_ENABLE)) 
