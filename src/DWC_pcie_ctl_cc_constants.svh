// Name:           CX_RXSTANDBY_CONTROL
// Default:        0x7f ((CX_PCIE_MODE == PCIE_OVER_CIO) ? 0 : 
//                 (PHY_TYPE==CC_GENERIC_PHY) ? 0x7F : (CX_PIPE_SERDES_ARCH) ? 0x7F : 0x44)
// Values:         0x0, ..., 0xff
// Enabled:        (CX_PCIE_MODE == PCIE_OVER_CIO) ? 0 : (PHY_TYPE!=CC_GENERIC_PHY)
// Parameter Type: Feature Setting
// 
// Bits 0..5 and Bit 7 determine if the controller asserts the RxStandby signal (mac_phy_rxstandby) in the indicated 
// condition. 
//  
// Bit 6 enables the controller to perform the RxStandby/RxStandbyStatus handshake. 
//  - [0]: Rx EIOS and subsequent T TX-IDLE-MIN 
//  - [1]: Rate Change (including PAM4RestrictedLevels PHY register write access when 
//  PAM4_RESTRICTED_LEVELS_REQUIREMENT==1) 
//  - [2]: Inactive lane for upconfigure/downconfigure 
//  - [3]: PowerDown=P1,P1.CPM,P1.1,P1.2 or P2 (When CX_PIPE43_SUPPORT==1, this bit must be set to 0) 
//  - [4]: RxL0s.Idle 
//  - [5]: EI Infer in L0 
//  - [6]: Execute RxStandby/RxStandbyStatus Handshake 
//  - [7]: Recovery.RcvrLock after the clocking mode (Sris/CommonClock) changes 
// Note: Contact your PHY vendor for guidelines on how to properly configure the RxStandby behavior. Refer to the User 
// Guide for guidelines on how to configure this parameter for Synopsys PHYs.
`define CX_RXSTANDBY_CONTROL 8'h7f


// Name:           CX_RXSTANDBY_DEFAULT
// Default:        1 (CX_PCIE_MODE == PCIE_OVER_CIO) ? 0 : (PHY_TYPE==CC_GENERIC_PHY)
// Values:         0 1
// Enabled:        (CX_PCIE_MODE == PCIE_OVER_CIO) ? 0 : (PHY_TYPE!=CC_GENERIC_PHY)
// Parameter Type: Feature Setting
// 
// Default value of RxStandby signal (mac_phy_rxstandby) on all lanes after reset. 
//  
// Note: Contact your PHY vendor for guidelines on how to properly configure the RxStandby behavior. Refer to the User 
// Guide for guidelines on how to configure this parameter for Synopsys PHYs.
`define CX_RXSTANDBY_DEFAULT 1'h1


