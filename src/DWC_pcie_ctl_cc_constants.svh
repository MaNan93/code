// Values:       -2147483648, ..., 2147483647
// Enabled:      MASTER_POPULATED
// 
// Low Priority Master AXI completion header queue depth (2^n)
`define CC_AXI_MSTR_CPL_QUEUE_DP 32


// Name:         CC_AXI_MSTRH_CPL_QUEUE_DP
// Default:      16 (CC_HP_MASTER ? CC_MAX_MSTRH_TAGS_AXI : (CC_DMA_ENABLE ? 
//               CC_MAX_MSTRH_TAGS_AXI : ((CC_MAX_MSTRH_TAGS_AXI >= 8) ? 8 : 
