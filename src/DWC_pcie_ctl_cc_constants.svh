//RTL Design Clock to Q output delay (simulator safety)

`define TP 0.1




// Name:         SNPS_TB_DMA_PERFORMANCE_AXI_NREAD
// Default:      1 (((AMBA_INTERFACE > 1) && !MSTR_FIXED_SIZE_ENABLE && 
//               (MASTER_BUS_DATA_WIDTH > 64)) ? 0 : 1)
// Values:       -2147483648, ..., 2147483647
// 
// AXI narrow read configurations options that impact DMA performance, when fetching descriptors 
//  Applies to master data widths wider than 64 bytes, because the 24 byte descriptor gets 
//  natuarally unaligned on these wider data widths
`define SNPS_TB_DMA_PERFORMANCE_AXI_NREAD 1


// Name:         SNPS_TB_DMA_PERFORMANCE_TAGS
// Default:      1 ( ([<functionof> [<functionof> CX_MAX_PCIE_SPEED CX_NL 
//               ROUND_TRIP_LATENCY TLP_EFFICIENCY CX_MAX_MTU CX_NW RADM_CPL_QMODE_VC0] 
//               CX_MAX_MTU CX_MAX_PCIE_SPEED]<= CC_NUM_DMA_RD_TAG) && ((CX_MAX_MTU/(CX_NW*4)) 
//               <= CX_REMOTE_MAX_TAGS) && (4<=CC_NUM_DMA_RD_TAG))
// Values:       -2147483648, ..., 2147483647
// 
// Disables the DMA performance check when the number of tags is not enough
`define SNPS_TB_DMA_PERFORMANCE_TAGS 1


// Name:         SNPS_TB_DMA_PERFORMANCE_BAR
// Default:      95 ((((CX_NW==16) && (CX_MAX_MTU<512 )) || ((CX_NW==8) && 
//               (CX_MAX_MTU<256))) ? (((CX_NW==16) && (CX_MAX_MTU<256)) ? 50 : 75) : 95) * 
//               (AMBA_INTERFACE != 1) * SNPS_TB_DMA_PERFORMANCE_TAGS * 
//               (CC_NUM_DMA_WR_CHAN!=1) * (CC_NUM_DMA_RD_CHAN!=1) * (CC_DMA_ENABLE_VALUE==1) * 
//               (SNPS_TB_DMA_PERFORMANCE_AXI_NREAD)
// Values:       0, ..., 100
// 
// This parameter is used internally in the regression environment to set performance target. 
// When zero, the performance check is disabled
