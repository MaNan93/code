// parameter value when the controller receives Report MSamplingRateTiming Command from System Software.
`define DEFAULT_GEN4_RXMARGIN_SAMPLE_RATE_TIMING 0


// Name:           DEFAULT_GEN4_RXMARGIN_VOLTAGE_SUPPORTED
// Default:        1
// Values:         0, 1
// Enabled:        ((CX_GEN4_SPEED))
// Parameter Type: Register Default Setting
// 
