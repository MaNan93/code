// Name:         DEMUX_EXCLUSIVE_WIDTH
// Default:      54 ([<functionof> FLT_Q_DW_LENGTH_WIDTH  
//               FLT_Q_IN_MEMBAR_RANGE_WIDTH  FLT_Q_ROM_IN_RANGE_WIDTH  FLT_Q_IO_REQ_IN_RANGE_WIDTH  
