// number of bits of the header bus that needs to be stored in the RAMs
`define FLT_Q_HDR_WIDTH 314


// Name:         CX_FLT_OUT_PROT_WD
// Default:      40 ((CX_RASDP_EN==1)? [<functionof> FLT_Q_HDR_WIDTH 
