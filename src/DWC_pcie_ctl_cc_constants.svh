// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// Number of Virtual Channels (VC) in the of NP stream LTIM. It is assumed that LTI has a single virtual channel 
// i.e. VC0 for Posted/Non-Posted TLPs.
`define CC_LTI_NP_VC_COUNT 1


// Name:         CC_LTI_NP_VC_COUNT_WIDTH
// Default:      1 ((CC_LTI_NP_VC_COUNT > 1) ? {[<functionof>  CC_LTI_NP_VC_COUNT]} 
//               : 1)
