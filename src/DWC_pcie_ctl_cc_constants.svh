// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_LTIM_ENABLE
// 
// Width of LTI MPAM value.
`define CX_LTI_MPAM_WIDTH 11


// Name:         CX_LTI_LRRESP_WIDTH
