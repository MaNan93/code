// Name:         FLT_Q_LN_WIDTH
// Default:      0 (CX_LN_ENABLE ? 1 : 0)
// Values:       0, 1
// 
// number of bits for Filter field FLT_Q_LN
`define FLT_Q_LN_WIDTH 0


// Name:         CX_RAS_PROT_RANGE_IS_64
// Default:      0 (CX_RAS_EN? (((CX_RAS_PROT_RANGE==64) && (CX_RAS_PROT_TYPE==0))? 
//               1: 0): 0)
// Values:       0, 1
// 
// Indication of 64 bits being protected by a single ECC code
// `define CX_RAS_PROT_RANGE_IS_64


// Name:         CX_RAS_PROT_RANGE_IS_32
// Default:      0 (CX_RAS_EN? (((CX_RAS_PROT_RANGE==32) && (CX_RAS_PROT_TYPE==0))? 
//               1: 0): 0)
// Values:       0, 1
// 
// Indication of 32 bits being protected by a single ECC code
// `define CX_RAS_PROT_RANGE_IS_32


// Name:         CX_RAS_PARITY_MODE
// Default:      Odd (CX_RASDP==2)
// Values:       Even (0), Odd (1)
// 
// RASDP parity mode selection: even or odd
`define CX_RAS_PARITY_MODE 1


// Name:         CX_RAS_ALL_0S_PROT_CODE
// Default:      0xffffffffffffffff ([<functionof> CX_NW CX_RAS_PROT_TYPE 
//               CX_RAS_PARITY_MODE])
// Values:       0x0, ..., 0xffffffffffffffffffffffffffffffff
// Enabled:      (((CX_RASDP==0)&&(CX_RASDP_RAM_PROT==0))? 0: 1==1)
// 
// Protection code for words filled in with all 0s. Word length used to calculate this parameter is the data path size.
`define CX_RAS_ALL_0S_PROT_CODE 128'hffffffffffffffff


// Name:         CX_RAS_ALL_PRFX_0S_PROT_CODE
// Default:      0xfff ([<functionof> CX_NW CX_NPRFX CX_RAS_PROT_TYPE 
//               CX_RAS_PARITY_MODE])
// Values:       0x0, ..., 0xffffffffffffffff
// Enabled:      (((CX_RASDP==0)&&(CX_RASDP_RAM_PROT==0))? 0: 1==1)
// 
// Protection code for words filled in with all 0s. Word length used to calculate this parameter is the data path size.
`define CX_RAS_ALL_PRFX_0S_PROT_CODE 64'hfff


// Name:         RAS_BASE_PROT_WD
// Default:      1 ((CX_RAS_PROT_TYPE==1)? 1: (CX_RAS_PROT_RANGE<=16)? 6: 
//               (CX_RAS_PROT_RANGE==32)? 7: (CX_RAS_PROT_RANGE==64)? 8: 9)
// Values:       -2147483648, ..., 2147483647
// Enabled:      (((CX_RASDP==0)&&(CX_RASDP_RAM_PROT==0))? 0: 1)
// 
// Number of bits required to protect CX_RAS_PROT_RANGE bits
`define RAS_BASE_PROT_WD 1


// Name:         RAS_RAM_BASE_PROT_WD
// Default:      8 ((((CX_NW>1)? 64: 32)==32)? 7: 8)
// Values:       -2147483648, ..., 2147483647
// Enabled:      (((CX_RASDP==0)&&(CX_RASDP_RAM_PROT==0))? 0: 1)
// 
// Number of bits required to protect CX_RAS_RAM_PROT_RANGE bits
`define RAS_RAM_BASE_PROT_WD 8


// Name:         CX_RAS_CORRECTION_EN
// Default:      Enabled ((CX_RASDP==4)? 0: 1)
// Values:       Disabled (0), Enabled (1)
// Enabled:      ((CX_RASDP==0) || (CX_RASDP==1) || (CX_RASDP==2))
// 
// Determines if single bit error correction is used or not for RASDP. 
// If data path is ECC protected, this parameter affects all ECC checker instances. 
// If data path is parity protected, this parameter affects only the  ECC checker instances protecting the RAMs.
`define CX_RAS_CORRECTION_EN 1


// Name:         CX_RAS_ERROR_INJ_EN
// Default:      Enabled ((((CX_RASDP==0)&&(CX_RASDP_RAM_PROT==0))? 0: 1==1)? 1: 0)
// Values:       Disabled (0), Enabled (1)
// Enabled:      (((CX_RASDP==0)&&(CX_RASDP_RAM_PROT==0))? 0: 1)
// 
// Determines if RASDP error injection logic is included in the core. Bridge and DMA do not support error injection.
`define CX_RAS_ERROR_INJ_EN


// Name:         CX_RAS_ERROR_INJ_REPEAT_EN
// Default:      0
// Values:       0, 1
// Enabled:      CX_RAS_EN && CX_RAS_ERROR_INJ_EN
// 
// Selects if automatic repetition of error injection sessions is supported
// `define CX_RAS_ERROR_INJ_REPEAT_EN


// Name:         CX_RAS_ERROR_INJ_EN_WD
// Default:      256
// Values:       -2147483648, ..., 2147483647
// Enabled:      (((CX_RASDP==0)&&(CX_RASDP_RAM_PROT==0))? 0: 1)
// 
// Error injection enable array
`define CX_RAS_ERROR_INJ_EN_WD 256


// Name:         CX_RAS_ERROR_INJ_MASK_WD
// Default:      2400
// Values:       -2147483648, ..., 2147483647
// Enabled:      (((CX_RASDP==0)&&(CX_RASDP_RAM_PROT==0))? 0: 1)
// 
// Error injection enable array
`define CX_RAS_ERROR_INJ_MASK_WD 2400


// Name:         CX_RAS_PCIE_HDR_PROT_WD
// Default:      16 ((CX_RASDP_EN==1)? [<functionof> CX_RAS_PROT_RANGE 
//               RAS_BASE_PROT_WD ]: 0)
// Values:       -2147483648, ..., 2147483647
// Enabled:      (((CX_RASDP==0)? 0: 1)==1)
// 
// Determines the width of the protection code that protects the PCIE header (128 bits). If RASDP is not used the width is 
// set to 0
`define CX_RAS_PCIE_HDR_PROT_WD 16


// Name:         FLT_Q_ADDR_PROT_WIDTH
// Default:      8 ((CX_RASDP_EN==1)? [<functionof> FLT_Q_ADDR_WIDTH 
//               CX_RAS_PROT_RANGE RAS_BASE_PROT_WD ]:0)
// Values:       -2147483648, ..., 2147483647
// Enabled:      CX_RADMQ_MODE==2
// 
// Number of bits required to protect address bits that are passes through the receive queues
`define FLT_Q_ADDR_PROT_WIDTH 8


// Name:         CX_TX_HW_W_PAR
// Default:      144 (128 + ((CX_RASDP_EN==1)? [<functionof> CX_RAS_PROT_RANGE 
//               RAS_BASE_PROT_WD ]: 0))
// Values:       -2147483648, ..., 2147483647
// 
// Width of header in bits plus the parity bits
`define CX_TX_HW_W_PAR 144


// Name:         CX_RX_NDLLP
// Default:      8 (CX_NW >> 1 == 0) ? 1 : (CX_NW > 16) ? 8 : (CX_NW >> 1)
// Values:       -2147483648, ..., 2147483647
// 
// Max number of DLLPs received per cycle 
// In Non-FlitMode NW/2 (up to 8 because the max datapath NFM width is 512b) 
// In FlitMode only 1 per flit
`define CX_RX_NDLLP 8


// Name:         CX_TX_NDLLP
// Default:      1
// Values:       -2147483648, ..., 2147483647
// 
// Max number of DLLPs sent per cycle
`define CX_TX_NDLLP 1


// Name:         CX_NUM_EOT
// Default:      2 ((CX_NW > 2) ? 2 : 1)
// Values:       -2147483648, ..., 2147483647
// Enabled:      CX_RAS_DES_ENABLE
// 
// Max number of END/EDB per cycle
`define CX_NUM_EOT 2


// Name:         CX_NPRFX_XADM
// Default:      4 (CX_FLIT_MODE_ENABLE ? (CX_NPRFX + 1) : CX_NPRFX)
// Values:       -2147483648, ..., 2147483647
// 
// Number of prefixes used in XADM for Multistream Arch. 
// For NFM, it's CX_NPRFX 
// For FM: it's CX_NPRFX+1, to account for the extra FM Local Prefix
`define CX_NPRFX_XADM 4


// Name:         CX_HDW
// Default:      11 ((CX_FLIT_MODE_ENABLE ? (CX_IS_SW? 10 : 7) : 4) + CX_NPRFX_XADM)
// Values:       -2147483648, ..., 2147483647
// 
// Size of the Prefix_Header bus in XADM. 
// It contains the 4 base header + OHC-A,B,C + LocalPrefixes 
// Then it accounts for OHC-E/LocalPrefix, which summed together will never be more than CX_NPRFX 
// In case of SWITCH supporting FLIT MODE, a maximum of 7 DWs is assumed for base header to support reserved TLPs
`define CX_HDW 11


// Name:         CX_HDW_NW
// Default:      27 (CX_HDW+CX_NW +(CX_APP_VEC_TLP_INTF_TRAILER ? 
//               CX_APP_VEC_NUM_TRAILER :0))
// Values:       -2147483648, ..., 2147483647
// 
// This parameter used at xadm pipe (affects the size of the rasdp-protected vector inside xadm_pipe_ms),so 
// When adding the parallel trailer bus through XADM, 
// the xadm_pipe_ms is not protecting prfx+hdr+data, but prfx+hdr+data+trailer, therefore we need this param increased.
`define CX_HDW_NW 27


// Name:         CX_NDW
// Default:      28 (CX_HDW+CX_NW+(CX_APP_VEC_TLP_INTF_TRAILER ? 
//               CX_APP_VEC_NUM_TRAILER : ( (CX_ECRC_ENABLE && !CX_IDE_ENABLE) ? 1 : (CX_IDE_ENABLE ? 4 : 
//               0))))
// Values:       -2147483648, ..., 2147483647
// 
// This parameter used at xtlh (affects the size of the rasdp-protected vector of xtlh pkt struct and also data,dwen size 
// of xtlh),so 
// When adding the parallel trailer bus through XTLH (with fixed dw num=5), 
// data is not included hdr+prfx+data+variable trailer (1 not ide, 4 ide), but it is included hdr+prfx+data+fixed trailer 
// (5 dw), therefore we need this param increased.
`define CX_NDW 28


