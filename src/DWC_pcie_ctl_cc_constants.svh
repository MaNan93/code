// implementation specific parameter specified in PCI Express Base Specification. Contact your PHY vendor for the value that 
// you should use.
`define DEFAULT_GEN6_RXMARGIN_MAX_VOLTAGE_OFFSET 5


// Name:           DEFAULT_GEN6_RXMARGIN_SAMPLE_RATE_VOLTAGE
// Default:        0 (DEFAULT_GEN5_RXMARGIN_SAMPLE_RATE_VOLTAGE)
// Values:         0, ..., 63
// Enabled:        CX_MARGIN_ENABLE && CX_GEN6_SPEED
// Parameter Type: Register Default Setting
// 
// The ratio of bits tested to bits received during voltage margining for 64.0 GT/s (MSamplingRateVoltage). This is an 
