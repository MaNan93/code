// `define CX_LTI_P_LOOP_WIDTH


// Name:         CX_LTI_P_TLBLOC_WIDTH
// Default:      0
// Values:       0, 1
// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// Width of TLB location of P stream LTIM. For phase 1, no TLB location signals are available.
// `define CX_LTI_P_TLBLOC_WIDTH


// Name:         CX_LTI_P_HW_ATTR_WIDTH
