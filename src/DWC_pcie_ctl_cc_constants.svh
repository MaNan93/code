// Parameter Type: Feature Setting
// 
// LTIM interface clock frequency(MHz)
`define CC_LTIM_CLK_FREQ 1000


// Name:           CC_LTIM_INT_PIN
// Default:        false
// Values:         false (0), true (1)
// Enabled:        CC_LTIM_ENABLE
// Parameter Type: Feature Setting
// 
// Include LTIM interrupt pin.
// `define CC_LTIM_INT_PIN


// Name:         CC_LTI_VC_COUNT
// Default:      1
// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_LTIM_ENABLE
// 
// Number of Virtual Channels (VC) in the LTIM. It is assumed that LTI has a single virtual channel 
// i.e. VC0 for Posted/Non-Posted TLPs.
`define CC_LTI_VC_COUNT 1


// Name:         CC_LTI_VC_COUNT_WIDTH
// Default:      1 ((CC_LTI_VC_COUNT > 1) ? {[<functionof>  CC_LTI_VC_COUNT]} : 1)
// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_LTIM_ENABLE
// 
// LTI Virtual Channel Number Width
`define CC_LTI_VC_COUNT_WIDTH 1


// Name:         CX_LTI_LAATTR_WITH_TPH
// Default:      false
// Values:       false (0), true (1)
// Enabled:      CX_TPH_ENABLE && CC_LTIM_ENABLE
// 
// Enable the decoding of LTI LAATTR With TPH consideration
// `define CX_LTI_LAATTR_WITH_TPH


// Name:         CX_LTI_OG_WIDTH
// Default:      0
// Values:       0, 1
// Enabled:      CC_LTIM_ENABLE
// 
// Width of order group. For phase 1, ordering will be done on PCIe core side.
// `define CX_LTI_OG_WIDTH


// Name:         CX_LTI_LxUSER_WIDTH
// Default:      0
// Values:       0, 1
// Enabled:      CC_LTIM_ENABLE
// 
// Width of LTI channel user signals. For phase 1, no user signals are available.
// `define CX_LTI_LxUSER_WIDTH


// Name:         CX_LTI_LOOP_WIDTH
// Default:      0
// Values:       0, 1
// Enabled:      CC_LTIM_ENABLE
// 
// Width of loopback signals. For phase 1, no loopback signals are available.
// `define CX_LTI_LOOP_WIDTH


// Name:         CX_LTI_TLBLOC_WIDTH
// Default:      0
// Values:       0, 1
// Enabled:      CC_LTIM_ENABLE
// 
// Width of TLB location. For phase 1, no TLB location signals are available.
// `define CX_LTI_TLBLOC_WIDTH


// Name:         CX_LTI_HW_ATTR_WIDTH
// Default:      0
// Values:       0, 1
// Enabled:      CC_LTIM_ENABLE
// 
// Width of implementation defined hardware attribute. For phase 1, no hardware attributes are available.
// `define CX_LTI_HW_ATTR_WIDTH


// Name:         CC_LTI_LRADDR_WIDTH
// Default:      52
// Values:       32 36 40 42 44 48 52
// Enabled:      CC_LTIM_ENABLE
// 
// Width of translated address.
`define CC_LTI_LRADDR_WIDTH 52


// Name:         CC_LTI_LA_LC_CDC_FIFO_DP
// Default:      14
// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_LTIM_ENABLE
// 
// LTI LA/LC CDC FIFOs depth that handle the crossing between mstr_aclk and core_clk.
`define CC_LTI_LA_LC_CDC_FIFO_DP 14


// Name:         CC_LTI_LR_CDC_FIFO_DP
// Default:      15
// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_LTIM_ENABLE
// 
// LTI LR CDC FIFO depth that handle the crossing between lti_clk and mstr_aclk.
`define CC_LTI_LR_CDC_FIFO_DP 15


// Name:         CX_LTI_TO_WIDTH
// Default:      10
// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_LTIM_ENABLE
// 
// Width of watch dog timeout value.
`define CX_LTI_TO_WIDTH 10


// Name:         CX_LTI_MSI_CTRL_WIDTH
