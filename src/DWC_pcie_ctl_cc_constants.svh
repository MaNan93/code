// 
// Width of implementation defined hardware attribute of NP stream LTIM. For phase 1, no hardware attributes are available.
// `define CX_LTI_NP_HW_ATTR_WIDTH


// Name:         CC_LTI_NP_LRADDR_WIDTH
// Default:      52
// Values:       32 36 40 42 44 48 52
// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// Width of translated address of NP stream LTIM.
`define CC_LTI_NP_LRADDR_WIDTH 52


// Name:         CC_LTI_NP_LA_LC_CDC_FIFO_DP
// Default:      14
// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// LTI LA/LC CDC FIFOs depth of NP stream LTIM that handle the crossing between mstr_aclk and core_clk.
`define CC_LTI_NP_LA_LC_CDC_FIFO_DP 14


// Name:         CC_LTI_NP_LR_CDC_FIFO_DP
// Default:      15
// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// LTI LR CDC FIFO depth of NP stream LTIM that handle the crossing between lti_clk and mstr_aclk.
`define CC_LTI_NP_LR_CDC_FIFO_DP 15


// Name:         CX_LTI_NP_TO_WIDTH
