// RAM depth in RAS DES event counter register
`define CX_RAS_DES_TBA_RAM_DEPTH 5


// Name:         CX_RAS_DES_TBA_RAM_ADDR_WIDTH
// Default:      3 ([<functionof> ([<functionof> CX_RAS_DES_TBA_ENABLE 
