// 
// Enable 68 Byte CXL.mem BI-Snoop to BI-Response channels
// `define CX_CXL_BI_SNP_RSP_68B_ENABLE


// Name:           CX_CXL_BI_68B_SUPPORT
// Default:        0 (CX_CXL_BI_SNP_RSP_68B_ENABLE || CX_CXL_BI_RSP_SNP_68B_ENABLE)
