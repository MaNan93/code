// Enable the default value for 68B_FLIT_VH_ENABLE field of CXL_RCRB_FLEXBUS_CNTRL_STATUS_OFF register for an Upstream 
// Port.
`define DEFAULT_CXL_PORT_USP_68B_FLIT_VH_ENABLE 1


// Name:           DEFAULT_CXL_PORT_USP_MLD_ENABLE
// Default:        0
// Values:         0, 1
// Enabled:        CX_CXL_MLD_EN
// Parameter Type: Register Default Setting
// 
// The value of this parameter is the default value of the CXL_MLD_EN field of CXL_RCRB_FLEXBUS_CNTRL_STATUS_OFF register 
// for an Upstream Port.
`define DEFAULT_CXL_PORT_USP_MLD_ENABLE 0


// Name:           DEFAULT_CXL_APN_SW_MODE
// Default:        Based on CXL 2.0 specification
// Values:         Based on CXL 2.0 specification (0), Special negotiation (1)
// Enabled:        ((CX_CXL_2_0_ENABLE) && (CC_DEVICE_TYPE==CC_SW))
// Parameter Type: Feature Setting
// 
// Select the default value for CXL_APN_SW_MODE field of CXL_VLSM_CSR_REG_OFF register.
`define DEFAULT_CXL_APN_SW_MODE 0

// =============================================================================
// CXL Error Isolation Parameter
// =============================================================================


// Name:           CX_CXL_ERR_ISO_EN
// Default:        false
// Values:         false (0), true (1)
// Enabled:        ((CX_CXL_ENABLE) && (CX_IS_DM_OR_RC))
// Parameter Type: Feature Setting
// 
// Enable CXL Error Isolation support
// `define CX_CXL_ERR_ISO_EN


// Name:         CX_CXS_CXL_ERR_ISO_EN
// Default:      0 (CX_CXL_CXS_ENABLE && CX_CXL_ERR_ISO_EN)
