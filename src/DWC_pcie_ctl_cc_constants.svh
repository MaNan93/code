//               CX_RAS_PROT_RANGE] + CC_DTIM_FORM_ATS_P_RAW_INTF_WD : 
//               CC_DTIM_FORM_ATS_P_RAW_INTF_WD)
// Values:       -2147483648, ..., 2147483647
// 
// DTIM AXI4-Stream Slave ATS Formation Posted Interface Width
`define CC_DTIM_FORM_ATS_P_INTF_WD 227


// Name:         CC_DTIM_FORM_ATS_P_INTF_PROT_WD
// Default:      26 (CX_RASDP_EN==1 ? CC_DTIM_FORM_ATS_P_INTF_WD - 
//               CC_DTIM_FORM_ATS_P_RAW_INTF_WD : 0)
// Values:       -2147483648, ..., 2147483647
