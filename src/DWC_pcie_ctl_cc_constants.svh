// Values:       0, ..., 500
// 
// Receive delay through the SerDes architecture module in GEN1 speed when the elastic buffer mode is nominal empty buffer 
// mode.
`define CX_PHY_RX_DELAY_SERDES_PIPE_EMPTY_GEN1 46


// Name:         CX_PHY_RX_DELAY_SERDES_PIPE_EMPTY_GEN2
// Default:      46 (!CX_GEN2_SPEED) ? 0 : ([<functionof> CX_SRIS_SUPPORT 
//               CX_PHY_NB_GEN2 CX_EBUF_SYNC_LTNCY CX_SERDES_ARCH_RX_REGIN CX_SERDES_ARCH_FPGA])
// Values:       0, ..., 500
// 
// Receive delay through the SerDes architecture module in GEN2 speed when the elastic buffer mode is nominal empty buffer 
