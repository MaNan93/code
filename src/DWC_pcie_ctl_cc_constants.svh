// Name:         CX_PHY_RX_DELAY_SERDES_PIPE
// Default:      46 (CX_PIPE_SERDES_ARCH==0) ? 0 : (CX_FREQ_STEP_EN) ? 
//               (CX_PHY_RX_DELAY_SERDES_PIPE_HALFFULL) : (CX_PHY_RX_DELAY_SERDES_PIPE_EMPTY)
// Values:       0, ..., 500
// 
// Receive delay through the SerDes architecture module of the PCIe controller in clock cycles.
`define CX_PHY_RX_DELAY_SERDES_PIPE 46


// Name:         CX_PHY_TX_DELAY_SERDES_PIPE
// Default:      1 (((CX_PIPE_SERDES_ARCH) && (CX_SERDES_ARCH_TX_REGOUT)) ? 1 : 0)
// Values:       0, ..., 500
// 
// Transmit delay through the SerDes architecture module of the PCIe controller in clock cycles.
`define CX_PHY_TX_DELAY_SERDES_PIPE 1


// Name:           CX_PHY_TX_DELAY_MAC
// Default:        4
// Values:         0, ..., 500
// Parameter Type: Feature Setting
// 
// Transmit delay through the MAC layer of the PCIe controller in clock cycles, used for retry buffer auto-size 
// calculation. You normally do not need to change the value of this parameter.
`define CX_PHY_TX_DELAY_MAC 4


// Name:           CX_PHY_TX_DELAY_PHY
// Default:        6
// Values:         0, ..., 500
// Parameter Type: Feature Setting
// 
// PHY Transmitter delay in clock cycles. This must be specified by your PHY provider and is the (worst case) delay in PIPE 
// clock cycles from the PIPE interface to the TX Phy serial pins. This parameter in conjunction with 'PHY Rx Delay' is used 
// to calculate the delay in getting an ACK DLLP back from the link partner, for a TLP sent by your controller. It is then 
// used to calculate the size of the Retry Buffer. This parameter is for Conventional PCIe mode only.
`define CX_PHY_TX_DELAY_PHY 6


// Name:           CX_PHY_RX_DELAY_MAC
// Default:        4
// Values:         0, ..., 500
// Parameter Type: Feature Setting
// 
// Receive delay through the MAC layer of the PCIe controller in clock cycles, used for retry buffer auto-size calculation. 
// You normally do not need to change the value of this parameter.
`define CX_PHY_RX_DELAY_MAC 4


// Name:           CX_PHY_RX_DELAY_PHY
// Default:        14
// Values:         0, ..., 500
// Parameter Type: Feature Setting
// 
// PHY Receiver delay in clock cycles. This must be specified by your PHY provider and is the (worst case) delay in PIPE 
// clock cycles from the RX Phy serial pins to the PIPE interface. This parameter in conjunction with 'PHY Tx Delay' is used to 
// calculate the delay in getting an ACK DLLP back from the link partner, for a TLP sent by your controller It is then used 
// to calculate the size of the Retry Buffer. This parameter is for Conventional PCIe mode only.
`define CX_PHY_RX_DELAY_PHY 14


// Name:         CX_CPCIE_INTERNAL_DELAY
// Default:      75 (CX_PHY_TX_DELAY_MAC + CX_PHY_TX_DELAY_PHY + 
//               CX_PHY_TX_DELAY_SERDES_PIPE + CX_PHY_RX_DELAY_MAC + CX_PHY_RX_DELAY_PHY + 
//               CX_PHY_RX_DELAY_SERDES_PIPE)
// Values:       -2147483648, ..., 2147483647
// 
// Read-only parameter that indicates the sum of the MAC/PHY delays of Conventional PCIe, used for retry buffer 
// auto-sizing, AckNak Timer adjustment and replay timer adjustment.
`define CX_CPCIE_INTERNAL_DELAY 75


// Name:         CX_REMOTE_INTERNAL_DELAY
// Default:      115 ([<functionof> CX_MAX_PCIE_SPEED])
// Values:       -2147483648, ..., 2147483647
// 
// Indicates the TLP/DLLP processing delays for the remote device in symbol times.
`define CX_REMOTE_INTERNAL_DELAY 115


// Name:           CX_INTERNAL_DELAY
// Default:        75 (CX_PHY_TX_DELAY_MAC + CX_PHY_TX_DELAY_PHY + 
//                 CX_PHY_TX_DELAY_SERDES_PIPE + CX_PHY_RX_DELAY_MAC + CX_PHY_RX_DELAY_PHY + 
//                 CX_PHY_RX_DELAY_SERDES_PIPE)
// Values:         0, ..., 2048
// Parameter Type: Feature Setting
// 
// Read-only parameter that indicates the sum of the MAC/PHY delays, used for retry buffer auto-sizing, AckNak Timer 
// adjustment and replay timer adjustment.
`define CX_INTERNAL_DELAY 75


// Name:         CX_RBUF_DATASIZE
// Default:      10 ([<functionof> CX_DL_NB CX_NL CX_MAX_MTU CX_ECRC_ENABLE CX_NPRFX 
//               CX_IDE_ENABLE CX_IDE_CAN_HAVE_PCRC])
// Values:       -2147483648, ..., 2147483647
// 
// Minimum Number of ram entries per packet
`define CX_RBUF_DATASIZE 10


// Name:         CX_ACK_LATENCY_LIMIT
// Default:      183 ([<functionof> CX_NL CX_MAX_MTU CX_ECRC_ENABLE CX_NPRFX 
//               CX_MAX_PCIE_SPEED CX_IDE_ENABLE CX_IDE_CAN_HAVE_PCRC])
// Values:       -2147483648, ..., 2147483647
// 
// PCI Express Base Specification, Rev 1.0a, Section 3.5.3.1
`define CX_ACK_LATENCY_LIMIT 183


// Name:           CX_RX_RBUF_DEPTH_FLITS
// Default:        43 ([<functionof> CX_INTERNAL_DELAY CX_NW])
// Values:         6, ..., 4294967295
// Enabled:        ((!CX_RBUF_AUTOSIZE))
// Parameter Type: Feature Setting
// 
// The depth of the rx retry buffer. When retry buffer auto-sizing is enabled (CX_RBUF_AUTOSIZE), "Retry Buffer Depth" is 
// read-only and indicates the automatically calculated depth of the rc retry buffer. When retry buffer auto-sizing is 
// disabled, "RX Retry Buffer Depth" is the user-specified depth of the retry buffer.
`define CX_RX_RBUF_DEPTH_FLITS 32'd43




// Name:           CX_RBUF_DEPTH
// Default:        440 ([<functionof> CX_DL_NB CX_NL CX_MAX_MTU CX_ECRC_ENABLE 
//                 CX_NPRFX CX_INTERNAL_DELAY CX_MAX_L0S_LTIME CX_FLIT_MODE_ENABLE 
//                 CX_MAX_PCIE_SPEED CX_RETIMER_LATENCY CX_IDE_ENABLE CX_IDE_CAN_HAVE_PCRC])
// Values:         CX_RBUF_DEPTH_MIN, ..., 4294967295
// Enabled:        ((!CX_RBUF_AUTOSIZE))
// Parameter Type: Feature Setting
// 
// The depth of the retry buffer. When retry buffer auto-sizing is enabled (CX_RBUF_AUTOSIZE), "Retry Buffer Depth" is 
// read-only and indicates the automatically calculated depth of the retry buffer. When retry buffer auto-sizing is disabled, 
// "Retry Buffer Depth" is the user-specified depth of the retry buffer. Note that if the autosize feature is disabled, then the 
// minimum value specified must be large enough to allow normal operation. The default value is the automatically calculated 
// value.
`define CX_RBUF_DEPTH 32'd440


`define SOTBUF_NO_RAS_WD 9


`define RBUF_PW 9


`define RX_RBUF_PW 6


`define CX_RBUF_SOT_WD 5


`define CX_RBUF_CTRL_WD 32


// Name:         RBUF_CTRL_PROT_WD
// Default:      0 ((CX_RASDP_EN==1 && CX_RAS_PROT_TYPE==0)? [<functionof> 
//               CX_RBUF_CTRL_WD CX_RAS_PROT_RANGE RAS_BASE_PROT_WD ] : 0)
// Values:       -2147483648, ..., 2147483647
// Enabled:      (((CX_RASDP==0)? 0: 1)==1)
// 
// Determines the width of the protection code that protects the Layer 2 control bits that go into the retry buffer ram. If 
// RAS is not used the width is set to 0
`define RBUF_CTRL_PROT_WD 0


// Name:         RBUF_PROT_WD
// Default:      71 ((CX_RAS_EN==1)? [<functionof> 1 (32*(CX_NW)) 
//               ((CX_NW==32)?0:CX_RBUF_CTRL_WD) CX_RASDP_EN CX_RAS_PROT_TYPE CX_RAS_PROT_RANGE 
//               CX_RAS_RAM_PROT_RANGE  RAS_BASE_PROT_WD RAS_RAM_BASE_PROT_WD RAS_TRACER_EN 
//               RBUF_PW]: 0)
// Values:       -2147483648, ..., 2147483647
// 
// Determines the width of the protection code that protects the data written in the retry buffer
`define RBUF_PROT_WD 71


// Name:         NFM_RBUF_PROT_WD
// Default:      71 ((CX_RAS_EN==1)? [<functionof> 1 (32*((CX_NW==32)?16:CX_NW)) 
//               CX_RBUF_CTRL_WD CX_RASDP_EN CX_RAS_PROT_TYPE CX_RAS_PROT_RANGE 
//               CX_RAS_RAM_PROT_RANGE  RAS_BASE_PROT_WD RAS_RAM_BASE_PROT_WD RAS_TRACER_EN 
//               RBUF_PW]: 0)
// Values:       -2147483648, ..., 2147483647
// 
// Determines the width of the protection code that protects the data written in the retry buffer in non-flit mode
`define NFM_RBUF_PROT_WD 71


// Name:           RBUF_WIDTH
// Default:        615 ( RBUF_PROT_WD + [<functionof> CX_DL_NB CX_NL 
//                 CX_TLP_PREFIX_ENABLE CX_GEN3_SPEED])
// Values:         34, ..., 1268
// Parameter Type: Feature Setting
// 
// Read-only parameter that indicates the width of the retry buffer.
`define RBUF_WIDTH 615



// Name:           NFM_RBUF_WIDTH
// Default:        615 ( NFM_RBUF_PROT_WD + [<functionof> CX_DL_NB CX_NL 
//                 CX_TLP_PREFIX_ENABLE CX_GEN3_SPEED])
// Values:         -2147483648, ..., 2147483647
// Parameter Type: Feature Setting
// 
// Read-only parameter that indicates the width of the retry buffer in non-flit mode.
`define NFM_RBUF_WIDTH 615


// Name:         RBUF_PAR_EN
// Default:      false (CX_RAM_PROTECTION_MODE==1)
// Values:       false (0), true (1)
// 
// Enable parity for Retry Buffer
// `define RBUF_PAR_EN


// Name:         RBUF_PAR_CALC_WIDTH
// Default:      32 ((RBUF_PAR_EN==1) ? CX_PAR_MODE : 32)
// Values:       -2147483648, ..., 2147483647
// 
// Bit width for Parity Calculation
`define RBUF_PAR_CALC_WIDTH 32


// Name:         RBUF_NPAR_BITS
// Default:      20 ([<functionof> RBUF_WIDTH RBUF_PAR_CALC_WIDTH])
// Values:       -2147483648, ..., 2147483647
// 
// Number of Parity Bits
`define RBUF_NPAR_BITS 20


// Name:         RBUF_NECC_BITS
// Default:      0 ([<functionof> RBUF_WIDTH])
// Values:       -2147483648, ..., 2147483647
// 
// Number of ECC Bits
`define RBUF_NECC_BITS 0


`define CX_RBUF_WIDTH 615


// Name:           CX_SOTBUF_DEPTH
// Default:        432 ([<functionof> CX_DL_NB CX_NL CX_MAX_MTU CX_ECRC_ENABLE 
//                 CX_NPRFX CX_INTERNAL_DELAY CX_MAX_L0S_LTIME CX_FLIT_MODE_ENABLE 
//                 CX_MAX_PCIE_SPEED CX_RETIMER_LATENCY CX_IDE_ENABLE CX_IDE_CAN_HAVE_PCRC])
// Values:         -2147483648, ..., 2147483647
// Enabled:        ((CX_RBUF_AUTOSIZE==0))
// Parameter Type: Feature Setting
// 
// When retry buffer auto-sizing is enabled, the value displayed here corresponds to the number of minimum-sized TLPs (3 
// DWORDs) that can reside in the retry buffer. 
//  - The 'Start Of TLP (SOT)' buffer stores the starting address of each unacknowledged TLP stored in the retry buffer. 
//  - The SOT buffer requires one entry for each TLP that can be stored in the retry buffer. 
//  - The selected retry buffer size determines the size of the SOT buffer. 
//  - The actual SOT buffer depth is a combination of the value displayed here and the additional requirements that the 
//  actual SOT buffer depth must be at least 32 and must be a power of 2. 
// When retry buffer auto-sizing is disabled, 'Minimum SOT Depth' is the user-specified depth of the SOT buffer. 
//  - The selected size must allow the retry buffer to store the maximum number of shortest TLPs (3 DWORDs). 
//  - The actual SOT buffer depth (SOTBUF_DEPTH) is calculated by adjusting CX_SOTBUF_DEPTH to be at least 32, and 
//  rounding up to the next power-of-2.
`define CX_SOTBUF_DEPTH 432


// Name:           SOTBUF_L2DEPTH
// Default:        9 ([<functionof> CX_DL_NB CX_NL CX_MAX_MTU CX_ECRC_ENABLE CX_NPRFX 
//                 CX_INTERNAL_DELAY CX_MAX_L0S_LTIME CX_RBUF_AUTOSIZE CX_SOTBUF_DEPTH 
//                 CX_FLIT_MODE_ENABLE CX_MAX_PCIE_SPEED CX_RETIMER_LATENCY CX_IDE_ENABLE 
//                 CX_IDE_CAN_HAVE_PCRC])
// Values:         -2147483648, ..., 2147483647
// Parameter Type: Feature Setting
// 
// Log 2 of CX_SOT_Depth, used to ensure we have ram based upon a power of 2 
// this value returns a minimum of 5
`define SOTBUF_L2DEPTH 9


// Name:           SOTBUF_DEPTH
// Default:        512 ([<functionof> CX_DL_NB CX_NL CX_MAX_MTU CX_ECRC_ENABLE 
//                 CX_NPRFX CX_INTERNAL_DELAY CX_MAX_L0S_LTIME CX_RBUF_AUTOSIZE CX_SOTBUF_DEPTH 
//                 CX_FLIT_MODE_ENABLE CX_MAX_PCIE_SPEED CX_RETIMER_LATENCY 
//                 CX_IDE_ENABLE CX_IDE_CAN_HAVE_PCRC])
// Values:         32, ..., 4294967295
// Parameter Type: Feature Setting
// 
// Read-only parameter that indicates the depth of the SOT buffer.
`define SOTBUF_DEPTH 32'd512


`define RAS_SOTBUF_ECC_ADDR_PROT_WD 9


// Name:         CX_RAS_SOTBUF_PROT_WD
// Default:      6 ((CX_RAS_EN==1)? [<functionof> RAS_SOTBUF_ECC_ADDR_PROT_WD 
//               SOTBUF_NO_RAS_WD CX_RAS_RAM_PROT_RANGE] : 0)
// Values:       -2147483648, ..., 2147483647
// Enabled:      (((CX_RASDP==0)&&(CX_RASDP_RAM_PROT==0))? 0: 1==1)
// 
// Determines the width of the protection code that protects the Layer 2 control bits that go into the retry buffer ram. If 
// RAS is not used the width is set to 0
`define CX_RAS_SOTBUF_PROT_WD 6


// Name:           SOTBUF_WIDTH
// Default:        15 (CX_RAS_EN ? ( CX_RAS_SOTBUF_PROT_WD + SOTBUF_NO_RAS_WD ) : 
//                 SOTBUF_NO_RAS_WD)
// Values:         0, ..., 4294967295
// Parameter Type: Feature Setting
// 
// Read-only parameter that indicates the width of the SOT buffer.
`define SOTBUF_WIDTH 32'd15


// Name:         SOTBUF_PAR_EN
// Default:      false (CX_RAM_PROTECTION_MODE==1)
// Values:       false (0), true (1)
// 
// Enable parity for SOTBUF Buffer
// `define SOTBUF_PAR_EN


// Name:         SOTBUF_PAR_CALC_WIDTH
