`define EXT_TAG_SUPPORTED

//-/===========================================
//-/ START: Radm Formation Queue parameters for RAM sizes
//
//   Note: parameters are defined here because they have a dependency on parity/ECC width parameters (which are defined here)
//         These parameters should all be relocated in some other place, probably common_cc_constants


// Name:         CX_RADM_FORMQ_DEBUG_W_ALIGNED_RAM_WD
// Default:      0
// Values:       0, 1
// Enabled:      CX_NW==16
// 
// When defined aligns the RAM width to a 16b boundary. Used for debug to improve readability of ram content and ram data 
// buses.
// `define CX_RADM_FORMQ_DEBUG_W_ALIGNED_RAM_WD


// Name:         CX_RADM_FORMQ_DEBUG_W_LOCAL_RAM
// Default:      0
// Values:       0, 1
// Enabled:      CX_NW==16
// 
// When defined the formation queue RAMs are instantiated locally inside radm_formation. Used to facilitate debug.
// `define CX_RADM_FORMQ_DEBUG_W_LOCAL_RAM


// Name:         CX_RADM_FORMQ_HDR_DS
// Default:      128 ((CX_MULTISTREAM_ARCH==1) ? 128 : 128 + 
//               CX_RAS_PCIE_HDR_PROT_WD)
// Values:       -2147483648, ..., 2147483647
// 
// RADM formation queue header-bus data size, including parity bits
`define CX_RADM_FORMQ_HDR_DS 128


// Name:         CX_RADM_FORMQ_DATA_DS
// Default:      128 (CX_MULTISTREAM_ARCH==1) ? 128 : ((CX_DW + 
//               TRGT_DATA_PROT_WD)/(CX_NW < 4 ? 1 : CX_NW/4))
// Values:       -2147483648, ..., 2147483647
// 
// RADM formation queue data-bus data size for one qdword of datapath, including parity bits
`define CX_RADM_FORMQ_DATA_DS 128


// Name:         CX_RADM_FORMQ_QDW_DS
// Default:      128 ((CX_RADM_FORMQ_HDR_DS > CX_RADM_FORMQ_DATA_DS) ? 
//               CX_RADM_FORMQ_HDR_DS : CX_RADM_FORMQ_DATA_DS)
// Values:       -2147483648, ..., 2147483647
// 
// RADM formation queue greater number between header and 128b data datasizes
`define CX_RADM_FORMQ_QDW_DS 128


// Name:         CX_RADM_FORMQ_RASDES_DS
// Default:      8 ((CX_RAS_DES_ENABLE) ? 8 : 0)
// Values:       -2147483648, ..., 2147483647
// 
// RADM formation queue data-width for RASDES feature
`define CX_RADM_FORMQ_RASDES_DS 8


// Name:         CX_RADM_FORMQ_CCIX_DS
// Default:      0 ((CX_CCIX_INTERFACE_ENABLE) ? CX_CCIX_RX_WD : 0)
// Values:       -2147483648, ..., 2147483647
// 
// RADM formation queue data-width for CCIX feature
`define CX_RADM_FORMQ_CCIX_DS 0


// Name:         CX_RADM_FORMQ_QDW_CTRL_WD
// Default:      19 ( 10 + ((CX_TLP_PREFIX_ENABLE)? 1 : 0) + CX_RADM_FORMQ_RASDES_DS 
//               + CX_RADM_FORMQ_CCIX_DS + CX_IDE_RX_STRIP_PCRC_MAC)
// Values:       -2147483648, ..., 2147483647
// 
// RADM formation queue Control bit width: dv + hv + eot + 3-bits errors + 4-bits dwen [+ pv]
`define CX_RADM_FORMQ_QDW_CTRL_WD 19


// Name:         CX_RADM_FORMQ_QDW_FF_WD
// Default:      4 (((CX_TLP_PREFIX_ENABLE)? 4 : 3) + CX_IDE_RX_STRIP_PCRC_MAC)
// Values:       -2147483648, ..., 2147483647
// 
// RADM formation queue qdword FF bit width: 3 or 4 Ctl bits {eot, dv, hv, [pv]} are stored in FFs.
`define CX_RADM_FORMQ_QDW_FF_WD 4


// Name:         CX_RADM_FORMQ_QDW_WD
// Default:      143 (CX_RADM_FORMQ_QDW_DS + CX_RADM_FORMQ_QDW_CTRL_WD + 
//               6*(CX_RADM_FORMQ_DEBUG_W_ALIGNED_RAM_WD) - CX_RADM_FORMQ_QDW_FF_WD)
// Values:       -2147483648, ..., 2147483647
// 
// RADM formation queue qdword RAM bit width, calculated from the data size + Control bits + minus the nr. of bits in FFs + 
// RASDES specific bits
`define CX_RADM_FORMQ_QDW_WD 143


// Name:         CX_RASDP_FORMQRAM_ECC_WD
// Default:      22 (CX_RAS_EN ? ((CX_RASDP >2 && CX_RASDP_EN==1)? 6 : 22) : 0)
// Values:       -2147483648, ..., 2147483647
// Enabled:      (((CX_RASDP==0)&&(CX_RASDP_RAM_PROT==0))? 0: 1==1)
// 
// Determines the width of the ECC code generated at the input of the RAM. If RAS is not used the width is set to 0
`define CX_RASDP_FORMQRAM_ECC_WD 22


// Name:         CX_RASDP_FORMQ_ERR_SYND_WD
// Default:      22 ((CX_RAS_EN && CX_NW==16)? ((CX_RASDP>2)? 
//               CX_RASDP_FORMQRAM_ECC_WD + TRGT_DATA_PROT_WD/(CX_NW/4): CX_RASDP_FORMQRAM_ECC_WD) : 0)
// Values:       -2147483648, ..., 2147483647
// Enabled:      (((CX_RASDP==0)&&(CX_RASDP_RAM_PROT==0))? 0: 1==1)
// 
// Determines the width of the RADM FORMATION QUEUE error synd. bus. If RAS is not used the width is set to 0
`define CX_RASDP_FORMQ_ERR_SYND_WD 22


// Name:         CX_RADM_FORMQ_QDW_RAM_WD
// Default:      149 (CX_RADM_FORMQ_QDW_DS + CX_RADM_FORMQ_QDW_CTRL_WD + 
//               6*(CX_RADM_FORMQ_DEBUG_W_ALIGNED_RAM_WD) - CX_RADM_FORMQ_QDW_FF_WD + 
//               CX_RASDP_FORMQRAM_ECC_WD - (((CX_RASDP>0) && (CX_RASDP<3))? 16: 0))
// Values:       -2147483648, ..., 2147483647
// 
// RADM formation queue qdword RAM bit width, calculated from the data size plus 1-bit dv + hv + eot + 3-bits errors + 
// 4-bits dwen minus the nr. of bits in FFs + RASDES specific bits
`define CX_RADM_FORMQ_QDW_RAM_WD 149


// Name:           RX_SERIALIZATION_Q_CTRL
// Default:        0
// Values:         0, 1
// Enabled:        CX_MULTISTREAM_ARCH==0 && CX_NW==16
// Parameter Type: Feature Setting
// 
// The Receive Serialization Queue Size Configuration feature applies to 512-bit data width configurations and allows the 
// size of the serialization queue to be adjusted while maintaining throughput at the application interface.
`define RX_SERIALIZATION_Q_CTRL 0


// Name:         CX_MAX_DELAY_LAYER2_LAYER3
// Default:      16
// Values:       -2147483648, ..., 2147483647
// 
// Latency from the input of Layer2 to the output of Layer 3 due to pipelines
`define CX_MAX_DELAY_LAYER2_LAYER3 16


// Name:         RX_SERIALIZATION_OVFLW_PRVNTN
// Default:      0 (CX_NW==16 && CX_MULTISTREAM_ARCH==0)
// Values:       0, 1
// 
// The Receive Serialization Queue Overflow Prevention feature automatically prevents the reduced serialization queue from 
// overflowing. The feature automatically adjusts the TLP rate on the wire to match the maximum TLP rate possible at the 
// application interface. Depending on the TLP length the wire TLP rate can be up to 2.7 times the application TLP rate. If TLPs 
// accumulate in the serialization queue and its almost full threshold is reached the Core automatically stops processing new 
// TLPs enabling the application to drain the queue. When the serialization queue is no longer almost full the Core starts 
// accepting new TLPs again. The TLPs previously discarded by the Core are replayed by the Remote Link Partner. The optimal 
// queue size depends on the NACK to replayed TLP round trip latency. If the queue is too small then sustaining maximum 
// throughput at the application interface may not be possible. An oversized queue results in redundant memory. If the feature is 
// disabled the queue size is set to its maximum size and overflow is avoided by the credit based flow control mechanism.
`define RX_SERIALIZATION_OVFLW_PRVNTN 0


// `define CX_RADM_FORMQ_OVFLW_PRVNTN_EN


// Name:           CX_RADM_FORMQ_RAM_RD_LATENCY
// Default:        1 Cycle
// Values:         1 Cycle (1), 2 Cycles (2), 3 Cycles (3), 4 Cycles (4)
// Enabled:        CX_NW==16
// Parameter Type: Performance Setting
// 
// Specifies the Receive Serialization Queue RAM read cycle latency. The controller samples the read data 
// CX_RADM_FORMQ_RAM_RD_LATENCY clock cycles after the read address is valid at the RADM FORMQ RAM interface.
`define CX_RADM_FORMQ_RAM_RD_LATENCY 1


// Name:           CX_RADM_FORMQ_WR_REGOUT
// Default:        1 (CX_TECHNOLOGY==0 || (CX_MAX_CORECLK_FREQ >= 1000) || 
//                 (CX_RASDP_EN && ((CX_GEN2_MODE==GEN2_DF && CX_FREQ==FREQ_250) || 
//                 (CX_GEN3_MODE==GEN3_DF && CX_FREQ==FREQ_125) || (CX_GEN4_MODE==GEN4_DF && 
//                 CX_FREQ==FREQ_62_5))))
// Values:         0, 1
// Enabled:        CX_CUSTOM_PIPELINING
// Parameter Type: Performance Setting
// 
// Inserts a pipeline at the Receive Serialization Queue RAM write interface.
`define CX_RADM_FORMQ_WR_REGOUT 1


// Name:           CX_RADM_FORMQ_RD_REGOUT
// Default:        1
// Values:         0, 1
// Enabled:        CX_CUSTOM_PIPELINING
// Parameter Type: Performance Setting
// 
// Inserts a pipeline at the Receive Serialization Queue RAM read interface.
`define CX_RADM_FORMQ_RD_REGOUT 1


// Name:         CX_RADM_SERQ_NUM_RAMS
// Default:      7 ((CX_NW == 16) ? ((CX_TLP_PREFIX_ENABLE)? 7 : 6) : (CX_NW == 8) ? 
//               3 : 2)
// Values:       -2147483648, ..., 2147483647
// 
// The number of RAMs required to implement the receive serialization queue, corresponds to the number of QDWORDs than can 
// be written in one clock cycle.
`define CX_RADM_SERQ_NUM_RAMS 7


// Name:         CX_RADM_FORMQ_NQW
// Default:      7 ((CX_MULTISTREAM_ARCH==1) ? ((CX_NW == 32) ? 14 : ((CX_NW == 16) 
//               ? 7 : ((CX_NW == 8) ? 4 : 2)) ): CX_RADM_SERQ_NUM_RAMS)
// Values:       -2147483648, ..., 2147483647
// 
// Number of qdwords that can be written in the formation queue each cycle, corresponds to the number of RAMs that 
// implement the formation queue.
`define CX_RADM_FORMQ_NQW 7


// Name:         CX_RADM_RXQ_NUM_QDWS
// Default:      15 (CX_RADM_HDRQ_DEPTH + CX_RADM_DATAQ_DEPTH*(CX_NW/4))
// Values:       -2147483648, ..., 2147483647
// 
// The storage capacity of the RADM Rx Queues expressed in QDWORDs, i.e. the number of header queue entries plus the number 
// of QDWORD data queue entries. Note: CX_RADM_DATAQ_DEPTH is the depth of each QWORD RAM.
`define CX_RADM_RXQ_NUM_QDWS 15


// Name:         CX_RADM_RXQ_NUM_QDWS_PER_SERQ_RAM
// Default:      1 (CX_RADM_HDRQ_DEPTH < CX_RADM_SERQ_NUM_RAMS ? 1 : ([<functionof> 
//               CX_RADM_RXQ_NUM_QDWS CX_RADM_SERQ_NUM_RAMS]))
// Values:       -2147483648, ..., 2147483647
// 
// The storage capacity of the RADM Rx Queues normalised per serializtion queue RAM, i.e. the effective number of Rx Queue 
// QDWORDs per serialization queue RAM.
`define CX_RADM_RXQ_NUM_QDWS_PER_SERQ_RAM 1


// Name:         CX_RADM_SERQ_OPT_AF_NUM_QDWS
// Default:      1434 ([<functionof> CX_PHY_TX_DELAY_PHY CX_PHY_RX_DELAY_PHY CX_NB 
//               CX_PHY_NB CX_RETIMER_LATENCY CX_NPRFX CX_IDE_RX_STRIP_PCRC_MAC])
// Values:       -2147483648, ..., 2147483647
// 
// The optimal Receive Serialization queue almost full threshold. This threshold is the minimum number of QDWORDs required 
// to sustain the maximum output rate from the NACK request to the reception of the replayed TLPs.
`define CX_RADM_SERQ_OPT_AF_NUM_QDWS 1434


// Name:         CX_RADM_SERQ_OPT_AF_NUM_QDWS_PER_RAM
// Default:      205 ([<functionof> CX_RADM_SERQ_OPT_AF_NUM_QDWS 
//               CX_RADM_SERQ_NUM_RAMS])
// Values:       -2147483648, ..., 2147483647
// 
// The optimal almost full threshold storage capacity of the Rx Queues normalised per Serialisation Queue RAM.
`define CX_RADM_SERQ_OPT_AF_NUM_QDWS_PER_RAM 205


// Name:         CX_RADM_SERQ_MARGIN_NUM_QDWS
// Default:      124 ([<functionof> CX_MAX_MTU CX_MAX_DELAY_LAYER2_LAYER3 CX_NPRFX])
// Values:       -2147483648, ..., 2147483647
// 
// This the required number of QDWORDs to store in flight TLP data already present in the pipelines prior to Layer3. In 
// addition we have to add the uncertainty of one maximum MTU, i.e. a max MTU TLP can be in progress at the time the NACK 
// request is generated.
`define CX_RADM_SERQ_MARGIN_NUM_QDWS 124


`define CX_RADM_FORMQ_QDW_QUEUE_MARGIN 124


// Name:         CX_RADM_SERQ_MARGIN_NUM_QDWS_PER_RAM
// Default:      18 ([<functionof> CX_RADM_SERQ_MARGIN_NUM_QDWS 
//               CX_RADM_SERQ_NUM_RAMS])
// Values:       -2147483648, ..., 2147483647
// 
// This the number of QDWORDs of margin per serialization queue RAM.
`define CX_RADM_SERQ_MARGIN_NUM_QDWS_PER_RAM 18


// Name:           CX_RADM_SERQ_TO_RXQ_SIZE_RATIO
// Default:        100 (CX_NW==16 ? [<functionof> CX_RADM_RXQ_NUM_QDWS > 
//                 CX_RADM_SERQ_OPT_AF_NUM_QDWS] ? [<functionof> [<functionof> 
//                 CX_RADM_SERQ_OPT_AF_NUM_QDWS_PER_RAM*100] CX_RADM_RXQ_NUM_QDWS_PER_SERQ_RAM] : 100 : 1)
// Values:         0, ..., 100
// Enabled:        RX_SERIALIZATION_Q_CTRL
// Parameter Type: Feature Setting
// 
// This is the size of the serialization queue relative to the storage capacity of the credit queues expressed as a 
// percentage of credit queue size. The serialisation queue margin is excluded.
`define CX_RADM_SERQ_TO_RXQ_SIZE_RATIO 100


// Name:         CX_RADM_SERQ_AF_NUM_QDWS_PER_RAM
// Default:      1 ([<functionof> [<functionof> CX_RADM_RXQ_NUM_QDWS_PER_SERQ_RAM * 
//               CX_RADM_SERQ_TO_RXQ_SIZE_RATIO] 100])
// Values:       -2147483648, ..., 2147483647
// 
// Actual Receive Serialization Queue almost full threshold per RAM.
`define CX_RADM_SERQ_AF_NUM_QDWS_PER_RAM 1


// Name:         CX_RADM_SERQ_QDW_RAM_DP
// Default:      19 (CX_RADM_SERQ_AF_NUM_QDWS_PER_RAM + 
//               CX_RADM_SERQ_MARGIN_NUM_QDWS_PER_RAM)
// Values:       -2147483648, ..., 2147483647
// 
// Serialization Queue RAM Depth
`define CX_RADM_SERQ_QDW_RAM_DP 19


// Name:         CX_RADM_FORMQ_QDW_RAM_DP
// Default:      19 (CX_RADM_SERQ_AF_NUM_QDWS_PER_RAM + 
//               CX_RADM_SERQ_MARGIN_NUM_QDWS_PER_RAM)
// Values:       -2147483648, ..., 2147483647
// 
// Serialization Queue RAM Depth
`define CX_RADM_FORMQ_QDW_RAM_DP 19


// Name:         CX_RADM_SERQ_AF_NUM_QDWS
// Default:      7 (CX_RADM_SERQ_AF_NUM_QDWS_PER_RAM*CX_RADM_SERQ_NUM_RAMS)
// Values:       -2147483648, ..., 2147483647
// 
// Actual Receive Serialization Queue almost full threshold per RAM.
`define CX_RADM_SERQ_AF_NUM_QDWS 7


// Name:         DEFAULT_RX_SERIALIZATION_Q_ALMOST_FULL_THRESHOLD
// Default:      7 (CX_RADM_SERQ_AF_NUM_QDWS_PER_RAM*CX_RADM_SERQ_NUM_RAMS)
// Values:       -2147483648, ..., 2147483647
// 
// Actual Receive Serialization Queue almost full threshold per RAM.
`define DEFAULT_RX_SERIALIZATION_Q_ALMOST_FULL_THRESHOLD 7


// Name:         CX_RADM_SERQ_QDW_RAM_PW
// Default:      5 ([<functionof> (CX_RADM_SERQ_AF_NUM_QDWS_PER_RAM + 
//               CX_RADM_SERQ_MARGIN_NUM_QDWS_PER_RAM)])
// Values:       -2147483648, ..., 2147483647
// 
// Serialisation Queue RAM address width
`define CX_RADM_SERQ_QDW_RAM_PW 5


// Name:         CX_RADM_FORMQ_QDW_RAM_PW
// Default:      5 ([<functionof> CX_RADM_SERQ_QDW_RAM_DP])
// Values:       -2147483648, ..., 2147483647
// 
// Serialisation Queue RAM address width
`define CX_RADM_FORMQ_QDW_RAM_PW 5


// Name:         CX_RADM_SERQ_AF_NUM_BYTES
// Default:      112 ((CX_RADM_SERQ_AF_NUM_QDWS_PER_RAM*CX_RADM_SERQ_NUM_RAMS)*16)
// Values:       -2147483648, ..., 2147483647
// 
// Receive Serialization Queue size expressed in Bytes (additional control bits, parity bits, and so forth are not 
// considered)
`define CX_RADM_SERQ_AF_NUM_BYTES 112

//-/ END:   Radm Formation Queue parameters for RAM sizes
//-/===========================================

//-/ START: Downstream Port Containment parameters
// ------------------------------------------------


// Name:           DPC_CAP_INT_MSG_NUM
// Default:        0x0
// Values:         0x0, ..., 0x1f
// Enabled:        CX_DPC_ENABLE==1
// Parameter Type: Register Default Setting
// 
// Default value for the DPC Interrupt Message Number field of the DPC Capability Register. Applies to function 0 only 
// because DPC can only be enabled for downstream ports.
`define DPC_CAP_INT_MSG_NUM 5'h0

//-/ END: Downstream Port Containment parameters
// ----------------------------------------------


// Name:         DEFAULT_PHY_PERST_ON_WARM_RESET
// Default:      Drive pm_req_phy_perst during a Warm Reset 
//               (CX_PHY_ENHANCED_PM_EN==1 ? 0 : 1)
// Values:       DO NOT drive pm_req_phy_perst (0), Drive pm_req_phy_perst during a 
//               Warm Reset (1)
// 
// Select the PHY Perst on Warm Reset value for the PMC to drive pm_req_phy_perst during Warm Resets (PERST# without 
// cycling of power). PHY_INTEROP_CTRL_OFF.PHY_PERST_ON_WARM_RESET register uses this parameter as the reset value.
`define DEFAULT_PHY_PERST_ON_WARM_RESET 1


// Name:         CX_PHY_RST_TIMER
// Default:      0x64 (10*DEFAULT_AUX_CLK_FREQ)
// Values:       0x0, ..., 0x3ffff
// 
// When exiting P2, the controller only asserts pm_req_phy_perst and pm_req_phy_rst once 
// perst_n is released, to allow any beacon transmission. This parameter controls the 
// duration of these requests. Duration is in slow auxclk cycles.
`define CX_PHY_RST_TIMER 18'h64

