// Name:           RAM1P_RD_ACCESS
// Default:        600 (int(0.6 * DWC_FASTEST_CLK_PERIOD_PS))
// Values:         -2147483648, ..., 2147483647
// Parameter Type: Performance Setting
// 
// Specifies the single port RAM read access time. This parameter has no impact on the RTL, it is only used to generate 
// constraints.
`define RAM1P_RD_ACCESS 600


// Name:           RAM1P_ADDR_SU
// Default:        250 (int(0.25 * DWC_FASTEST_CLK_PERIOD_PS))
// Values:         -2147483648, ..., 2147483647
// Parameter Type: Performance Setting
// 
// Specifies the single port RAM data setup. This parameter has no impact on the RTL, it is only used to generate 
// constraints.
`define RAM1P_ADDR_SU 250


// Name:           RAM2P_RD_ACCESS
// Default:        600 (int(0.6 * DWC_FASTEST_CLK_PERIOD_PS))
// Values:         -2147483648, ..., 2147483647
// Parameter Type: Performance Setting
// 
// Specifies the two port RAM read access time. This parameter has no impact on the RTL, it is only used to generate 
// constraints.
`define RAM2P_RD_ACCESS 600


// Name:           RAM2P_ADDR_SU
// Default:        250 (int(0.25 * DWC_FASTEST_CLK_PERIOD_PS))
// Values:         -2147483648, ..., 2147483647
// Parameter Type: Performance Setting
// 
// Specifies the two port RAM data setup. This parameter has no impact on the RTL, it is only used to generate constraints.
`define RAM2P_ADDR_SU 250


// Name:         EASE_GEN3_FPGA_TIMING
// Default:      0
// Values:       0, 1
// 
// Improve timing on gen3 logic by disabling features 
// and/or inserting pipeline stages 
// This parameter is shared for Gen3 mode.
// `define EASE_GEN3_FPGA_TIMING


// Name:         CX_CRC_LATENCY_XTLH
// Default:      2 (1 + ((CX_NW > 1) ? ((CX_TECHNOLOGY == 0) || ((CX_GEN4_MODE == 
//               GEN4_DF) && CX_NW==16) || (CX_MAX_CORECLK_FREQ > 500)) : 0))
// Values:       1 2
// Enabled:      CX_CUSTOM_PIPELINING && (CX_NW > 1)
// 
// CRC Pipeline Latency value for xtlh.  This value represents the 
// number of pipeline stages needed to calculate and compare ECRC. 
// controller supported latencies:  1,2
`define CX_CRC_LATENCY_XTLH 2


// Name:         CX_CRC_LATENCY_RTLH
// Default:      2 (1 + ((CX_NW > 1) ? ((CX_TECHNOLOGY == 0) || ((CX_GEN4_MODE == 
//               GEN4_DF) && CX_NW==16) || (CX_MAX_CORECLK_FREQ > 500)) : 0))
// Values:       1 2
// Enabled:      CX_CUSTOM_PIPELINING && (CX_NW > 1)
// 
// CRC Pipeline Latency value for rtlh.  This value represents the 
// number of pipeline stages needed to calculate and compare ECRC. 
// controller supported latencies:  1,2
`define CX_CRC_LATENCY_RTLH 2


// Name:         CX_CRC_LATENCY_XDLH
// Default:      2 (1 + ((CX_NW > 1) ? ((CX_TECHNOLOGY == 0) || ((CX_GEN4_MODE == 
//               GEN4_DF) && CX_NW==16) || ((CX_MAX_CORECLK_FREQ >= 500) && CX_RASDP > 
//               0) || (CX_MAX_CORECLK_FREQ > 500)) : 0))
// Values:       1 2
// Enabled:      CX_CUSTOM_PIPELINING && (CX_NW > 1)
// 
// CRC Pipeline Latency value for xdlh.  This value represents the 
// number of pipeline stages needed to calculate and compare LCRC. 
// controller supported latencies:  1,2
`define CX_CRC_LATENCY_XDLH 2


// Name:         CX_CRC_LATENCY_RDLH
// Default:      2 (1 + ((CX_NW > 1) ? ((CX_TECHNOLOGY == 0) || ((CX_GEN4_MODE == 
//               GEN4_DF) && CX_NW==16) || (CX_MAX_CORECLK_FREQ > 500)) : 0))
// Values:       1 2
// Enabled:      CX_CUSTOM_PIPELINING && (CX_NW > 1)
// 
// CRC Pipeline Latency value for rdlh.  This value represents the 
// number of pipeline stages needed to calculate and compare LCRC. 
// controller supported latencies:  1,2
`define CX_CRC_LATENCY_RDLH 2


// Name:           CX_RDLH_REGIN
// Default:        1
// Values:         0 1
// Enabled:        CX_CUSTOM_PIPELINING
// Parameter Type: Performance Setting
// 
// Input pipeline stage to RDLH TLP extraction module
`define CX_RDLH_REGIN 1


// Name:           CX_XDLH_PIPELINE_RBUF
// Default:        0 ((CX_TECHNOLOGY == 0) || ((CX_GEN2_MODE == 0) && (CX_FREQ == 1) 
