// Default value for the Table Offset field in the VF MSI-X Table Offset and BIR Register. Function 7.
`define VF_MSIX_TABLE_OFFSET_7 29'h0


// Name:           VF_MSIX_PBA_BIR_7
// Default:        BAR0
// Values:         BAR0 (0x0), BAR1 (0x1), BAR2 (0x2), BAR3 (0x3), BAR4 (0x4), BAR5 
//                 (0x5)
// Enabled:        CX_NFUNC > 7 && VF_MSIX_CAP_ENABLE==1
