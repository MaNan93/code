// Name:           CC_HP_MASTER
// Default:        0
// Values:         0, 1
// Enabled:        ((AMBA_INTERFACE > 1) && (CX_NVC > 1) && MASTER_POPULATED)
// Parameter Type: Feature Setting
// 
// Enables High Priority AXI Master. 
// This parameter is only visible for a number of Virtual Channels higher than 1.
// `define CC_HP_MASTER


// Name:           CC_MAX_MSTR_TAGS_AXI
// Default:        32
// Values:         2 4 8 16 32 64 128 256 512 768 1024
// Enabled:        ((AMBA_INTERFACE==2) || (AMBA_INTERFACE==3) || (AMBA_INTERFACE==4))
// Parameter Type: Performance Setting
// 
// Represents the maximum number of AXI master IDs and the maximum number of outstanding NP transactions the AXI bridge can 
// handle. 
// It is used to size the master completion RAM which can be large if CC_MAX_MSTR_TAGS_AXI is large. You should set 
// CC_MAX_MSTR_TAGS_AXI to the minimum number of outstanding AXI requests that are required to saturate the AXI bus and/or supply 
// the throughput required by the controller. If decomposition occurs, the number of simultaneously outstanding AXI requests 
// is larger than this value. 
// This parameter is used to size the master ID busses with the value log2{CC_MAX_MSTR_TAGS_AXI}.
`define CC_MAX_MSTR_TAGS_AXI 32


// Name:         CC_MAX_MSTR_TAGS_LT_256
// Default:      1 ((CC_MAX_MSTR_TAGS_AXI < 256) ? 1 : 0)
// Values:       0, 1
// 
// This parameter is used by the DTIM to extract the upper bits of the 8-bit 
// translation response translation ID.
`define CC_MAX_MSTR_TAGS_LT_256

`define SNPS_MAX_MSTR_TAGS_GT_256_18072023 0


// Name:           CC_MAX_MSTRH_TAGS_AXI
// Default:        16 (CC_MAX_MSTR_TAGS_AXI/2)
// Values:         1, ..., (CC_MAX_MSTR_TAGS_AXI-1)
// Enabled:        CC_HP_MASTER
// Parameter Type: Performance Setting
// 
// Represents the maximum number of AXI master IDs and the maximum number of outstanding NP transactions the AXI High 
// Priority master can handle. 
// This value must be smaller than CC_MAX_MSTR_TAGS_AXI. The Low Priority master handles 
// (CC_MAX_MSTR_TAGS_AXI-CC_MAX_MSTRH_TAGS_AXI). 
// Note: This parameter is only visible when High Priority Master is enabled.
`define CC_MAX_MSTRH_TAGS_AXI 16


`define CC_MAX_MSTRL_TAGS_AXI 32


`define CC_MAX_MSTR_TAGS 32


// Name:           CC_DTIM_MSTR_TAGS_MAP_EN
// Default:        0 ((CC_DTIM_ENABLE && (CC_MAX_MSTR_TAGS_AXI > 256)) ? 1 : 0)
// Values:         0, 1
// Enabled:        CC_DTIM_ENABLE
// Parameter Type: Feature Setting
// 
// Enable master tags mapping inside DTIM to support CC_MAX_MSTR_TAGS_AXI greater than 256.
// `define CC_DTIM_MSTR_TAGS_MAP_EN

//-/ =================================================================
//-/ TRGT CPL LUT
//-/ =================================================================


// Name:           TRGT_CPL_LUT_EN
// Default:        true ((CC_DMA_ENABLE) ? 1 : (AMBA_POPULATED) ? 1 : 0)
// Values:         false (0), true (1)
// Enabled:        ((TRGT1_POPULATE==1 && !(CC_DMA_ENABLE) && CC_DEVICE_TYPE!=CC_SW && 
//                 CX_P2P_ENABLE==0 && AMBA_POPULATED==0))
// Parameter Type: Feature Setting
// 
// Enable the Target Completion Lookup Table to be connected internally between the RTRGT1 and XALI0/1/2 interfaces. This 
// feature provides two functions: 
//  - The application does not need to provide certain TLP header information when transmitting completions on XALI0/1/2 
//  because the controller stores and tracks the information in the internal Target Completion Lookup Table. 
//  - When the application has not generated a completion for an incoming request within the required time interval, then 
//  the Target Completion Timeout indicates that a Timeout has occurred. 
// The Target Completion Lookup Table (and Target Completion Timeout event) should not be confused with the Completion 
// Lookup table (and Completion Timeout event) described in 'Received Completion TLP Processing' in the Databook. The size of 
// the this LUT is controlled using the 'Max Forwarded NP Requests' (CX_REMOTE_MAX_TAG) parameter. 
// Note: This feature is not available if Peer-to-Peer support is enabled. 
// Note: When the AXI bridge is used (AMBA_INTERFACE=1, 2 or 3) or when DMA is enabled, the Target Completion Lookup Table 
// is automatically activated.
`define TRGT_CPL_LUT_EN


// Name:           CX_TLUT_IPIPE_EN
// Default:        0 ((TRGT_CPL_LUT_EN==1) && (AMBA_POPULATED == 0) && 
//                 (CX_MULTISTREAM_ARCH == 1))
// Values:         0, 1
// Enabled:        ((TRGT_CPL_LUT_EN==1) && (AMBA_POPULATED == 0) && 
//                 (CX_MULTISTREAM_ARCH == 1))
// Parameter Type: Feature Setting
// 
// Enable the instantiation of the input pipeline in the target completion LUT. This is to ease timing on native 
// configurations.
// `define CX_TLUT_IPIPE_EN


// Name:           CX_CPL_LUT_CPL_ID
// Default:        0 (AMBA_POPULATED && (CX_SRIOV_ENABLE || CX_ARI_ENABLE))
// Values:         0, 1
// Enabled:        TRGT_CPL_LUT_EN
// Parameter Type: Feature Setting
// 
// Enables the target completion LUT to generate the completer ID 
//  instead of having it provided on the client interface
// `define CX_CPL_LUT_CPL_ID

//Use Combo Box

// Name:           CX_REMOTE_MAX_TAG
// Default:        32_Tags (CC_HP_MASTER ? CC_MAX_MSTR_TAGS_AXI-1 :(AXI_POPULATED ? 
//                 CC_MAX_MSTR_TAGS - 1 : ((CX_MAX_TAG >= 767) ? 1023 : CX_MAX_TAG)))
// Values:         2_Tags (1), 4_Tags (3), 8_Tags (7), 16_Tags (15), 32_Tags (31), 
//                 64_Tags (63), 128_Tags (127), 256_Tags (255), 512_Tags (511), 768_Tags 
//                 (767), 1024_Tags (1023)
// Enabled:        ((AMBA_POPULATED) ? (CC_ORDRB_EN) : (TRGT_CPL_LUT_EN))
// Parameter Type: Performance Setting
// 
// The function depends on the nature of the application interface. 
//  - AXI without LTI: You should leave this parameter at its default value. 
//  - AXI with LTI: If CC_ORDRB_LOOKUP_ID_MAP_EN is enabled, you should set it with a value greater than 
//  CC_MAX_MSTR_TAGS_AXI to include the LTI/ORDRB latency. Otherwise, you should keep the default value. 
//  - Native controller: Specifies the maximum number of received non-posted requests that the controller forwards to your 
//  application at one time, when the Target Completion LUT (TRGT_CPL_LUT_EN) is enabled. The default value is sufficient for 
//  typical applications. It does not control the number of non-posted requests that the controller can receive and buffer 
//  from the PCIe wire, which is controlled by flow control credits.
`define CX_REMOTE_MAX_TAG 31


// Name:           CX_REMOTE_MAX_TAGS
// Default:        32 (CX_REMOTE_MAX_TAG+1)
// Values:         2 4 8 16 32 64 128 256 512 768 1024
// Enabled:        0
// Parameter Type: Feature Setting
// 
// Represents the maximum total number of simultaneously outstanding non-posted inbound PCIe requests forwarded by the 
// bridge onto the AXI fabric. This is a read-only copy of CX_REMOTE_MAX_TAG.
`define CX_REMOTE_MAX_TAGS 32


// Name:         CX_REMOTE_LUT_PTR_WIDTH
// Default:      5 ([<functionof> CX_REMOTE_MAX_TAG])
