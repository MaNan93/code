// (CX_DESKEW_DEPTH_CPCIE) ensures.
`define CX_PHY_SKEW_GEN3_PCLK 4


// Name:           CX_PHY_SKEW_GEN4_PCLK
// Default:        3 (CX_DESKEW_DISABLE==1 || CX_NL==1 || CX_GEN4_SPEED==0 ) ? 0 : 
//                 (CX_SKEW_PIPEIF_GEN4_PCLK - CX_WIRE_SKEW_GEN4_PCLK)
// Values:         -2147483648, ..., 2147483647
// Enabled:        0
// Parameter Type: Feature Setting
// 
// This is read-only parameter to indicate how much PHY skew for Gen4 speed your deskew buffer setting 
// (CX_DESKEW_DEPTH_CPCIE) ensures.
`define CX_PHY_SKEW_GEN4_PCLK 3


// Name:           CX_PHY_SKEW_GEN5_PCLK
// Default:        1 (CX_DESKEW_DISABLE==1 || CX_NL==1 || CX_GEN5_SPEED==0 ) ? 0 : 
//                 (CX_SKEW_PIPEIF_GEN5_PCLK - CX_WIRE_SKEW_GEN5_PCLK)
// Values:         -2147483648, ..., 2147483647
// Enabled:        0
// Parameter Type: Feature Setting
// 
// This is read-only parameter to indicate how much PHY skew for Gen5 speed your deskew buffer setting 
// (CX_DESKEW_DEPTH_CPCIE) ensures.
`define CX_PHY_SKEW_GEN5_PCLK 1


// Name:           CX_PHY_SKEW_GEN6_PCLK
// Default:        1 (CX_DESKEW_DISABLE==1 || CX_NL==1 || CX_GEN6_SPEED==0 ) ? 0 : 
//                 (CX_SKEW_PIPEIF_GEN6_PCLK - CX_WIRE_SKEW_GEN6_PCLK)
// Values:         -2147483648, ..., 2147483647
// Enabled:        0
// Parameter Type: Feature Setting
// 
// This is read-only parameter to indicate how much PHY skew for Gen6 speed your deskew buffer setting 
// (CX_DESKEW_DEPTH_CPCIE) ensures.
`define CX_PHY_SKEW_GEN6_PCLK 1


// Name:           CX_PHY_SKEW_CCIX20G_PCLK
// Default:        0 (CX_DESKEW_DISABLE==1 || CX_NL==1 || CX_CCIX_ESM_SUPPORT==0 ) ? 0 
//                 : (CX_SKEW_PIPEIF_CCIX20G_PCLK - CX_WIRE_SKEW_CCIX20G_PCLK)
// Values:         -2147483648, ..., 2147483647
// Enabled:        0
// Parameter Type: Feature Setting
// 
// This is read-only parameter to indicate how much PHY skew for CCIX ESM 20G speed your deskew buffer setting 
// (CX_DESKEW_DEPTH_CPCIE) ensures.
`define CX_PHY_SKEW_CCIX20G_PCLK 0


// Name:           CX_PHY_SKEW_CCIX25G_PCLK
// Default:        0 (CX_DESKEW_DISABLE==1 || CX_NL==1 || CX_CCIX_ESM_SUPPORT==0 ) ? 0 
