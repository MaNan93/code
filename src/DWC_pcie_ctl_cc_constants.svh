// Name:           CX_XMLH_SCRAMBLE_REGOUT
// Default:        1 (CX_PCIE_MODE == PCIE_OVER_CIO) ? 0 : (((CX_TECHNOLOGY == 0)) ? 1 
//                 : 1)
// Values:         0, 1
// Enabled:        (CX_PCIE_MODE == PCIE_OVER_CIO) ? 0 : CX_CUSTOM_PIPELINING
// Parameter Type: Performance Setting
// 
// Specifies insertion of register pipeline at the outputs of XMLH Scrambler, providing trade-off of latency and gates for 
// ease of timing closure.
`define CX_XMLH_SCRAMBLE_REGOUT 1


// Name:           CX_XMLH_GEN3_SCRAMBLE_REGIN
// Default:        0 (((CX_TECHNOLOGY == 0)) ? 1 : ((CX_CXL_ENABLE && CX_GEN5_SPEED) 
//                 || (CX_GEN6_SPEED && (CX_MAX_CORECLK_FREQ < 2000))) ? 0 : 1)
// Values:         0, 1
// Enabled:        CX_CUSTOM_PIPELINING
// Parameter Type: Performance Setting
// 
// Specifies insertion of register pipeline at the inputs of XMLH Scrambler for 128b/130b encoding, providing trade-off of 
// latency and gates for ease of timing closure.
`define CX_XMLH_GEN3_SCRAMBLE_REGIN 0


// Name:           CX_XMLH_GEN3_SCRAMBLE_REGOUT
// Default:        0 (((CX_TECHNOLOGY == 0) || (CX_MAX_CORECLK_FREQ >=2000)) ? 1 : 
//                 (CX_CXL_ENABLE && CX_GEN5_SPEED) ? 0 : 1)
// Values:         0, 1
// Enabled:        CX_CUSTOM_PIPELINING
// Parameter Type: Performance Setting
// 
// Specifies insertion of register pipeline at the outputs of XMLH Scrambler for 128b/130b encoding, providing trade-off of 
// latency and gates for ease of timing closure.
`define CX_XMLH_GEN3_SCRAMBLE_REGOUT 0


// Name:           CX_XMLH_GEN3_SCRAMBLE_LFSR_REGOUT
// Default:        1 (((CX_NB>=16) || (CX_MAX_CORECLK_FREQ >=2000) || (CX_GEN6_SPEED)) 
//                 ? 1 : 0)
// Values:         0, 1
// Enabled:        CX_CUSTOM_PIPELINING
// Parameter Type: Performance Setting
// 
// Specifies insertion of register pipeline at the outputs of XMLH LFSR for 128b/130b encoding, providing trade-off of 
// latency and gates for ease of timing closure.
`define CX_XMLH_GEN3_SCRAMBLE_LFSR_REGOUT 1


// Name:           CX_XMLH_PIPE_REGOUT
// Default:        1 (((CX_TECHNOLOGY == 0) || (CX_MAX_CORECLK_FREQ >=2000)) ? 1 : 
//                 ((CX_CXL_ENABLE) && (CX_NB<=4)) ? 0 : 1)
// Values:         0, 1
// Enabled:        CX_CUSTOM_PIPELINING
// Parameter Type: Performance Setting
// 
// Specifies insertion of register pipeline at the outputs of XMLH PIPE, providing trade-off of latency and gates for ease 
// of timing closure.
`define CX_XMLH_PIPE_REGOUT 1


// Name:           CX_XMLH_PRECODING_REGOUT
// Default:        1 (((EASE_GEN5_FPGA_TIMING == 1) || (CX_MAX_CORECLK_FREQ >=2000)) ? 
