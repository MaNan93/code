// 
// Enable merging of original FBE with calculated FBE in Posted Request Formation module
// `define CC_SLV32_CORE32_FBE_MERGE_PRF_EN

//-/ =================================================================
//-/ AMBA Interface Protection Section
//-/ =================================================================

// Name:         CX_AXI_IF_TYPE_OF_PROT
// Default:      Legacy Mode ((CX_RASDP_EN && CC_RP_TDISP) ? 3 : 0)
// Values:       Legacy Mode (0), Parity in data, address and control (1), ECC in 
//               data, Parity in address and control (2), AMBA AXI Parity Protection (3)
// Enabled:      ((CX_RASDP==0)? 0: 1)
// 
// Select AXI Interface protection features.
`define CX_AXI_IF_TYPE_OF_PROT 0


// Name:         CC_AMBA_AXI_PARITY_BYTE_ALL
// Default:      0 (CX_AXI_IF_TYPE_OF_PROT == 3)
// Values:       0, 1
// 
// Enables support of AMBA AXI parity protection (with CX_RASDP only already has odd data only parity)
// `define CC_AMBA_AXI_PARITY_BYTE_ALL


`define CC_AMBA_AXI_PARITY_BYTE_ALL_VALUE 0


// Name:         CX_AXI_IF_ECC_PAR_PROT_EN
// Default:      0 ((CX_AXI_IF_TYPE_OF_PROT != 0) && CX_RASDP_EN)
// Values:       0, 1
// 
// When defined, protects all AXI Interface
// `define CX_AXI_IF_ECC_PAR_PROT_EN


`define CX_AXI_IF_ECC_PAR_PROT_EN_VALUE 0


`define CX_AXI_PRFX_WIDTH 108


// Name:         CX_AXI_IF_ECC_PROT_EN
// Default:      0 ((CX_AXI_IF_TYPE_OF_PROT == 2) && CX_RASDP_EN)
// Values:       0, 1
// 
// When defined, protects all AXI Interface
// `define CX_AXI_IF_ECC_PROT_EN


`define CX_AXI_IF_ECC_PROT_EN_VALUE 0


// Name:         CX_AXI_IF_ECC_GRAN
// Default:      Full Width
// Values:       Full Width (0), 32-bits (1), 64-bits (2)
// Enabled:      (((CX_AXI_IF_TYPE_OF_PROT == 2) && CX_RASDP_EN)==1)
// 
// Select the ECC Granularity for the AXI Interface
`define CX_AXI_IF_ECC_GRAN 0


// Name:         CX_AXI_IF_ECC_MODE
// Default:      Standard
// Values:       Standard (0), ARC Mode (1)
// Enabled:      (((CX_AXI_IF_TYPE_OF_PROT == 2) && CX_RASDP_EN)==1)
// 
// Select the AXI Interface ECC 32-bit Encoding
`define CX_AXI_IF_ECC_MODE 0


// `define CX_AXI_IF_ECC_MODE_ENABLE


`define CC_MSTR_BUS_ADDR_PROT_WIDTH 8


`define CC_MSTR_BUS_DATA_PROT_WIDTH 64


`define CC_SLV_BUS_ADDR_PROT_WIDTH 8


`define CC_SLV_BUS_DATA_PROT_WIDTH 64


`define CC_DBI_BUS_ADDR_PROT_WIDTH 4


`define CC_DBI_BUS_DATA_PROT_WIDTH 4

//--------\\
// MASTER \\
//--------\\


// Name:         CC_MSTR_AW_MISC_INFO_WIDTH
// Default:      200 (1 + 64 + ATS_RX_ENABLE * (CC_AMBA_ATS_NW + ((CX_CXL_ENABLE==1) 
//               ? 1 : 0)) + ATS_RX_ENABLE * 2 + CX_AMBA_ARI_OR_IOV * CX_NFUNC_WD + 
//               CX_SRIOV_ENABLE * CX_NVFUNC_WD + !CC_AXI_POISON_EN_VALUE + 
//               CC_DMA_ENABLE * (CC_NUM_DMA_RD_CHAN_WIDTH + DC_DMA_TYPE_WIDTH) + 
//               CX_TLP_PREFIX_ENABLE * (32 * CX_NPRFX) + CX_LN_ENABLE + CX_TPH_ENABLE * 11 + 
//               CX_IDO_ENABLE + CC_AXI_GEN6_SEGMENT_EN * 18)
// Values:       -2147483648, ..., 2147483647
// 
// Master AW Channel Misc Info Data Width
`define CC_MSTR_AW_MISC_INFO_WIDTH 200


// Name:         CC_MSTR_AR_MISC_INFO_WIDTH
// Default:      136 (1 + 1 + ATS_RX_ENABLE * (CC_AMBA_ATS_NW + ((CX_CXL_ENABLE==1) 
//               ? 1 : 0)) + ATS_RX_ENABLE * 2 + CX_AMBA_ARI_OR_IOV * CX_NFUNC_WD + 
//               CX_SRIOV_ENABLE * CX_NVFUNC_WD + CC_DMA_ENABLE * 
//               (CC_NUM_DMA_MAX_CHAN_WIDTH + DC_DMA_TYPE_WIDTH) + CX_TLP_PREFIX_ENABLE * (32 * CX_NPRFX) + 
//               CX_LN_ENABLE + CX_TPH_ENABLE * 11 + CX_IDO_ENABLE + 
//               CC_AXI_GEN6_SEGMENT_EN * 18)
// Values:       -2147483648, ..., 2147483647
// 
// Master AR Channel Misc Info Data Width
`define CC_MSTR_AR_MISC_INFO_WIDTH 136


// Name:         CC_MSTR_R_MISC_INFO_WIDTH
// Default:      3 (3 + CC_MSTR_RESP_TLP_PREFIX_ENABLE * (32 * CX_NPRFX) + 
//               CX_LN_ENABLE + (CC_AXI_MSTR_MISC_INFO_CID_ENABLE)*(16))
// Values:       -2147483648, ..., 2147483647
// 
// Master R Channel Misc Info Data Width
`define CC_MSTR_R_MISC_INFO_WIDTH 3


// Name:         CC_MSTR_B_MISC_INFO_WIDTH
// Default:      3 (3 + CC_MSTR_RESP_TLP_PREFIX_ENABLE * (32 * CX_NPRFX) + 
//               CX_LN_ENABLE +(CC_AXI_MSTR_MISC_INFO_CID_ENABLE)*(16))
// Values:       -2147483648, ..., 2147483647
// 
// Master B Channel Misc Info Data Width
`define CC_MSTR_B_MISC_INFO_WIDTH 3


// Name:         CC_MSTR_AW_EXTRA_PYLD_WIDTH
// Default:      267 (MSTR_MISC_INFO_PW + CC_MSTR_AW_MISC_INFO_WIDTH + 
//               CX_ATOMIC_ENABLE * 6 + CC_ACELITE_ENABLE * (7 + CC_AXIJ_DMWR_VALUE * 2) + 
//               CC_LTIM_ENABLE_VALUE * (CC_AMBA_TLP_SEQ_WD + 5 - CC_AMBA_UNTRANS_PROP_VALUE + 
//               CC_AXIJ_RME_VALUE * 3))
// Values:       -2147483648, ..., 2147483647
// 
// Master AW Channel Extra Payload Width
`define CC_MSTR_AW_EXTRA_PYLD_WIDTH 267


// Name:         CC_MSTR_AR_EXTRA_PYLD_WIDTH
// Default:      198 (MSTR_MISC_INFO_PW + CC_MSTR_AR_MISC_INFO_WIDTH + 
//               CC_ACELITE_ENABLE * 8 + CC_LTIM_ENABLE_VALUE * (CC_AMBA_TLP_SEQ_WD + 5 - 
//               CC_AMBA_UNTRANS_PROP_VALUE + CC_AXIJ_RME_VALUE * 3))
// Values:       -2147483648, ..., 2147483647
// 
// Master AR Channel Extra Payload Width
`define CC_MSTR_AR_EXTRA_PYLD_WIDTH 198


// Name:         CC_MSTR_R_EXTRA_PYLD_WIDTH
// Default:      16 (MSTR_RESP_MISC_INFO_PW + CC_MSTR_R_MISC_INFO_WIDTH)
// Values:       -2147483648, ..., 2147483647
// 
// Master R Channel Extra Payload Width
`define CC_MSTR_R_EXTRA_PYLD_WIDTH 16


// Name:         CC_MSTR_B_EXTRA_PYLD_WIDTH
// Default:      3 ((3 + CC_MSTR_RESP_TLP_PREFIX_ENABLE * (32 * CX_NPRFX) + 
//               CX_LN_ENABLE +(CC_AXI_MSTR_MISC_INFO_CID_ENABLE)*(16)))
// Values:       -2147483648, ..., 2147483647
// 
// Master B Channel Extra Payload Width
`define CC_MSTR_B_EXTRA_PYLD_WIDTH 3


// Name:         CC_MSTR_AW_EXTRA_PYLD_PAR_WIDTH
// Default:      34 (((CC_MSTR_AW_EXTRA_PYLD_WIDTH - 1) / CX_RAS_PROT_RANGE) + 1)
// Values:       -2147483648, ..., 2147483647
// 
// Master AW Channel Extra Payload Parity Width
`define CC_MSTR_AW_EXTRA_PYLD_PAR_WIDTH 34


// Name:         CC_MSTR_AR_EXTRA_PYLD_PAR_WIDTH
// Default:      25 (((CC_MSTR_AR_EXTRA_PYLD_WIDTH - 1) / CX_RAS_PROT_RANGE) + 1)
// Values:       -2147483648, ..., 2147483647
// 
// Master AR Channel Extra Payload Parity Width
`define CC_MSTR_AR_EXTRA_PYLD_PAR_WIDTH 25


// Name:         CC_MSTR_R_EXTRA_PYLD_PAR_WIDTH
// Default:      2 (((CC_MSTR_R_EXTRA_PYLD_WIDTH - 1) / CX_RAS_PROT_RANGE) + 1)
// Values:       -2147483648, ..., 2147483647
// 
// Master R Channel Extra Payload Parity Width
`define CC_MSTR_R_EXTRA_PYLD_PAR_WIDTH 2


// Name:         CC_MSTR_B_EXTRA_PYLD_PAR_WIDTH
// Default:      1 (((CC_MSTR_B_EXTRA_PYLD_WIDTH - 1) / CX_RAS_PROT_RANGE) + 1)
// Values:       -2147483648, ..., 2147483647
// 
// Master B Channel Extra Payload Parity Width
`define CC_MSTR_B_EXTRA_PYLD_PAR_WIDTH 1


// Name:         CC_MSTR_AW_USER_WIDTH
// Default:      8 (CX_RASDP == 0 ? 0 : CX_AXI_IF_ECC_PAR_PROT_EN ? (4 + 
//               CC_MSTR_BUS_ADDR_PROT_WIDTH + CC_MSTR_AW_EXTRA_PYLD_PAR_WIDTH + CC_AXI4_ENABLE) 
//               : CC_MSTR_BUS_ADDR_PROT_WIDTH)
// Values:       -2147483648, ..., 2147483647
// 
// Master AW Channel User Width
`define CC_MSTR_AW_USER_WIDTH 8


// Name:         CC_MSTR_W_USER_WIDTH
// Default:      64 (CX_RASDP == 0 ? 0 :  CX_AXI_IF_ECC_PAR_PROT_EN ? (2 + 
//               CC_AXI3_ENABLE + CC_MSTR_BUS_DATA_PROT_WIDTH) : CC_MSTR_BUS_DATA_PROT_WIDTH)
// Values:       -2147483648, ..., 2147483647
// 
// Master W Channel User Width
`define CC_MSTR_W_USER_WIDTH 64


// Name:         CC_MSTR_AR_USER_WIDTH
// Default:      8 (CX_RASDP == 0 ? 0 :  CX_AXI_IF_ECC_PAR_PROT_EN ? (4 + 
//               CC_MSTR_BUS_ADDR_PROT_WIDTH + CC_MSTR_AR_EXTRA_PYLD_PAR_WIDTH + CC_AXI4_ENABLE) 
//               : CC_MSTR_BUS_ADDR_PROT_WIDTH)
// Values:       -2147483648, ..., 2147483647
// 
// Master AR Channel User Width
`define CC_MSTR_AR_USER_WIDTH 8


// Name:         CC_MSTR_R_USER_WIDTH
// Default:      64 (CX_RASDP == 0 ? 0 : CX_AXI_IF_ECC_PAR_PROT_EN ? (2 + 
//               CC_MSTR_BUS_DATA_PROT_WIDTH + CC_MSTR_R_EXTRA_PYLD_PAR_WIDTH) : 
//               CC_MSTR_BUS_DATA_PROT_WIDTH)
// Values:       -2147483648, ..., 2147483647
// 
// Master R Channel User Width
`define CC_MSTR_R_USER_WIDTH 64


// Name:         CC_MSTR_B_USER_WIDTH
// Default:      0 (CX_AXI_IF_ECC_PAR_PROT_EN ? (2 + CC_MSTR_B_EXTRA_PYLD_PAR_WIDTH) 
//               : 0)
// Values:       -2147483648, ..., 2147483647
// 
// Master B Channel User Width
`define CC_MSTR_B_USER_WIDTH 0

