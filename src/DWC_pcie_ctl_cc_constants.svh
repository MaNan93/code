// Enabled:        (CX_ACS_ENABLE && (CC_DEVICE_TYPE==CC_EP || CC_DEVICE_TYPE==CC_DM))
// Parameter Type: Feature Setting
// 
// This determines the default value of the read only bits in the Upstream Port Egress Control Vector(after reset) in PF3. 
// Set bits to 1 to indicate Read Only
`define CX_ACS_UP_EGRESS_CTRL_MASK_3 256'h8


// Name:           CX_ACS_DW_EGRESS_CTRL_MASK_3
// Default:        0x1
// Values:         0x0, ..., 
//                 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
// Enabled:        CX_ACS_ENABLE && CC_DEVICE_TYPE!=CC_EP
// Parameter Type: Feature Setting
// 
// This determines the default value of the read only bits in the Downstream Port Egress Control Vector(after reset) in 
// PF3. Set bits to 1 to indicate Read Only
`define CX_ACS_DW_EGRESS_CTRL_MASK_3 256'h1

