//  - 4: 1MB 
//  - 5: 2MB 
//  - . 
//  - . 
//  - . 
//  - 22: 256GB 
//  - 23: 512GB 
//  - 31-24: RsvdP 
//  
//  Example: 0x00000030 indicates that BAR2 operates correctly with the 
//  BAR sized to either 1MB or 2MB.
`define CX_BAR2_RESOURCE_AVAIL_2 64'h10


