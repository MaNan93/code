// Parameter Type: Feature Setting.
// 
// Enable Deferrable Memory Write (DMWr) support.
`define CX_DEF_MEM_WR_ENABLE


// Name:           CX_DEF_MEM_WR_ROUTING_EN
// Default:        0x0 (CX_DEF_MEM_WR_ENABLE && (CC_DEVICE_TYPE==CC_SW))
