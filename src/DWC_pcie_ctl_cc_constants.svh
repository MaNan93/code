// should use. 
// Note that if MIndErrorSampler = 0, the controller always reports MSamplingRateVoltage=0x3F regardless of this parameter 
// value when the controller receives Report MSamplingRateVoltage Command from System Software.
`define DEFAULT_GEN6_RXMARGIN_SAMPLE_RATE_VOLTAGE 0


// Name:           DEFAULT_GEN6_RXMARGIN_SAMPLE_RATE_TIMING
// Default:        0 (DEFAULT_GEN5_RXMARGIN_SAMPLE_RATE_TIMING)
// Values:         0, ..., 63
// Enabled:        CX_MARGIN_ENABLE && CX_GEN6_SPEED
// Parameter Type: Register Default Setting
// 
// The ratio of bits tested to bits received during timing margining for 64.0 GT/s (MSamplingRateTiming). This is an 
// implementation specific parameter specified in PCI Express Base Specification. Contact your PHY vendor for the value that you 
// should use. 
// Note that if MIndErrorSampler = 0, the controller always reports MSamplingRateTiming=0x3F regardless of this parameter 
// value when the controller receives Report MSamplingRateTiming Command from System Software.
`define DEFAULT_GEN6_RXMARGIN_SAMPLE_RATE_TIMING 0


// Name:           DEFAULT_GEN6_RXMARGIN_VOLTAGE_SUPPORTED
// Default:        1 (DEFAULT_GEN5_RXMARGIN_VOLTAGE_SUPPORTED)
// Values:         0, 1
// Enabled:        CX_MARGIN_ENABLE && CX_GEN6_SPEED
// Parameter Type: Register Default Setting
// 
// Voltage margining is supported for 64.0 GT/s (MVoltageSupported). This is an implementation specific parameter specified 
// in PCI Express Base Specification. Contact your PHY vendor for the value that you should use.
`define DEFAULT_GEN6_RXMARGIN_VOLTAGE_SUPPORTED 1


// Name:           DEFAULT_GEN6_RXMARGIN_IND_LEFT_RIGHT_TIMING
// Default:        1 (DEFAULT_GEN5_RXMARGIN_IND_LEFT_RIGHT_TIMING)
// Values:         0, 1
// Enabled:        CX_MARGIN_ENABLE && CX_GEN6_SPEED
// Parameter Type: Register Default Setting
// 
// Independent left/right timing margin supported for 64.0 GT/s (MIndLeftRightTiming). This is an implementation specific 
// parameter specified in PCI Express Base Specification. Contact your PHY vendor for the value that you should use.
`define DEFAULT_GEN6_RXMARGIN_IND_LEFT_RIGHT_TIMING 1


// Name:           DEFAULT_GEN6_RXMARGIN_IND_UP_DOWN_VOLTAGE
// Default:        1 (DEFAULT_GEN5_RXMARGIN_IND_UP_DOWN_VOLTAGE)
// Values:         0, 1
// Enabled:        CX_MARGIN_ENABLE && CX_GEN6_SPEED
// Parameter Type: Register Default Setting
// 
// Independent up and down voltage margining supported for 64.0 GT/s (MIndUpDownVoltage). This is an implementation 
// specific parameter specified in PCI Express Base Specification. Contact your PHY vendor for the value that you should use.
`define DEFAULT_GEN6_RXMARGIN_IND_UP_DOWN_VOLTAGE 1


// Name:           DEFAULT_GEN6_RXMARGIN_IND_ERROR_SAMPLER
// Default:        1 (DEFAULT_GEN5_RXMARGIN_IND_ERROR_SAMPLER)
// Values:         0, 1
// Enabled:        CX_MARGIN_ENABLE && CX_GEN6_SPEED
// Parameter Type: Register Default Setting
// 
// Indicates Error sampler is independent for 64.0 GT/s (MIndErrorSampler). This is an implementation specific parameter 
// specified in PCI Express Base Specification. Contact your PHY vendor for the value that you should use.
`define DEFAULT_GEN6_RXMARGIN_IND_ERROR_SAMPLER 1


// Name:           DEFAULT_GEN6_RXMARGIN_SAMPLE_REPORTING_METHOD
// Default:        0 (DEFAULT_GEN5_RXMARGIN_SAMPLE_REPORTING_METHOD)
// Values:         0, 1
// Enabled:        CX_MARGIN_ENABLE && CX_GEN6_SPEED
// Parameter Type: Register Default Setting
// 
// Indicates whether a sample frequency is supported (1) or a sample count is supported (0) for 64.0 GT/s 
// (MSampleReportingMethod). This is an implementation specific parameter specified in PCI Express Base Specification. Contact your PHY vendor 
// for the value that you should use. 
// Note that if MIndErrorSampler = 0, the controller always reports MSampleReportingMethod=1 regardless of this parameter 
// value when the controller receives Report Margin Control Capabilities Command from System Software.
`define DEFAULT_GEN6_RXMARGIN_SAMPLE_REPORTING_METHOD 0


// Name:           DEFAULT_GEN6_RXMARGIN_MAXLANES
// Default:        1 (DEFAULT_GEN5_RXMARGIN_MAXLANES)
// Values:         0, ..., 31
// Enabled:        CX_MARGIN_ENABLE && CX_GEN6_SPEED
// Parameter Type: Register Default Setting
// 
// Maximum number of lanes minus 1 that can be margined at the same time for 64.0 GT/s (MMaxLanes). This is an 
// implementation specific parameter specified in PCI Express Base Specification. Contact your PHY vendor for the value that you should 
// use.
`define DEFAULT_GEN6_RXMARGIN_MAXLANES 1


// Name:           DEFAULT_PAM4_RESTRICTED_LEVELS_REQUIREMENT
// Default:        1 (CX_MAX_PCIE_SPEED >= 6)
// Values:         0, 1
// Enabled:        CX_MAX_PCIE_SPEED >= 6
// Parameter Type: Register Default Setting
// 
// Indicates whether the PAM4RestrictedLevels field in the PHY RX Control 1 message bus register is supported. Contact your 
// PHY vendor for the value that you should use.
`define DEFAULT_PAM4_RESTRICTED_LEVELS_REQUIREMENT 1


// Name:           DEFAULT_RX_MESSAGE_BUS_WRITE_BUFFER_DEPTH
// Default:        5 ((CX_PIPE5_SUPPORT) ? 5 : (CX_PIPE44_SUPPORT) ?  2 : 0)
// Values:         0, ..., 15
// Enabled:        (CX_GEN4_SPEED && CX_PIPE44_SUPPORT) || CX_PIPE5_SUPPORT
// Parameter Type: Register Default Setting
// 
// Default value of RX Message Bus Write Buffer Depth. This is an implementation specific parameter specified in PIPE 
// Specification. Contact your PHY vendor for the value that you should use.
`define DEFAULT_RX_MESSAGE_BUS_WRITE_BUFFER_DEPTH 5


// Name:           DEFAULT_TX_MESSAGE_BUS_MIN_WRITE_BUFFER_DEPTH
// Default:        5 ((CX_PIPE5_SUPPORT) ? 5 : (CX_PIPE44_SUPPORT) ?  2 : 0)
// Values:         0, ..., 8
// Enabled:        (CX_GEN4_SPEED && CX_PIPE44_SUPPORT) || CX_PIPE5_SUPPORT
// Parameter Type: Register Default Setting
// 
// Default value of TX Message Bus Minimum Write Buffer Depth. This is an implementation specific parameter specified in 
// PIPE Specification. Contact your PHY vendor for the value that you should use.
`define DEFAULT_TX_MESSAGE_BUS_MIN_WRITE_BUFFER_DEPTH 5


// Name:           DEFAULT_PIPE_GARBAGE_DATA_MODE
// Default:        0 ((RIO_POPULATED==1) ? 1 : 0)
// Values:         0, 1
// Parameter Type: Register Default Setting
// 
// Indicates the PIPE garbage data mode 
//  - 0: PIPE Spec compliant mode: The MAC discards any symbols received after the electrical idle ordered-set until 
//  RxValid is deasserted. 
//  - 1: Special PHY Support mode: The MAC discards any symbols received after the electrical idle ordered-set until 
//  RxValid is deasserted or a valid COM symbol is received at 8b/10b encoding or a valid RxStartBlock is received at 128b/130b 
//  encoding.
`define DEFAULT_PIPE_GARBAGE_DATA_MODE 0


// Name:           CX_INTERFACE_TIMER_EN
// Default:        false ((CX_AUTOMOTIVE_ENABLE==1)? 1 : 0)
// Values:         false (0), true (1)
// Parameter Type: Feature Setting
// 
// Include watchdog timer for the controllers data transmission interfaces.
// `define CX_INTERFACE_TIMER_EN


// Name:           CX_NUM_SLAVE_TIMERS
// Default:        false
// Values:         false (3)
// Enabled:        CX_INTERFACE_TIMER_EN && SLAVE_POPULATED
// Parameter Type: Feature Setting
// 
// Number of Transmit Watchdog Timers in AXI Slave.
`define CX_NUM_SLAVE_TIMERS 3


// Name:           CX_NUM_MASTER_TIMERS
// Default:        false ((CC_HP_MASTER==1)? 4 : 2)
// Values:         false (2), true (4)
// Enabled:        CX_INTERFACE_TIMER_EN && MASTER_POPULATED
// Parameter Type: Feature Setting
// 
// Number of Transmit Watchdog Timers in AXI Master.
`define CX_NUM_MASTER_TIMERS 2

`define SNPS_DMA_CHGROUP_11032016 0

`define SNPS_DMA_CCIX_06092018 0

// =============================================================================
// CXS Interface Configuration
// =============================================================================


// Name:           CX_CXS_ENABLE
// Default:        false (CX_CXL_CXS_ENABLE ? 1 : 0)
// Values:         false (0), true (1)
// Enabled:        CX_CCIX_INTERFACE_ENABLE || CX_CXL_CXS_ENABLE
// Parameter Type: Feature Setting
// 
// Configure the controller to support CXS Interface. 
// The controller does not support CXS Interface for switch device.
// `define CX_CXS_ENABLE


// Name:         CX_CXS_CCIXDATAWIDTH
// Default:      512 (CX_CXL_CXS_ENABLE ? ((CX_NW > 16) ? 1024 : 512) : ((CX_NW == 
//               32) ? 1024 : (CX_NW == 16) ? 512 : (CX_NW == 8) ? 256 : 128))
// Values:       128 256 512 1024
// 
// Configures CCIX Data Bus Width interfacing CXS.
`define CX_CXS_CCIXDATAWIDTH 512


// Name:         CX_CXS_DATAFLITWIDTH_1024
// Default:      0 ((CX_CXL_CXS_ENABLE ? ((CX_NW > 16) ? 1024 : 512) : ((CX_NW == 
//               32) ? 1024 : (CX_NW == 16) ? 512 : (CX_NW == 8) ? 256 : 128)) == 1024)
// Values:       0, 1
// 
// CXS+ CXL Data width is 1024
// `define CX_CXS_DATAFLITWIDTH_1024


// Name:           CX_CXS_DATAFLITWIDTH
// Default:        512 ((CX_CXS_CCIXDATAWIDTH==1024) ? 1024 : 
//                 (CX_CXS_CCIXDATAWIDTH==512) ? 512 : 256)
// Values:         256 512 1024
// Enabled:        CX_CXS_ENABLE
// Parameter Type: Feature Setting
// 
// Configures CXS Data Flit Width (maps to CXSDATAFLITWIDTH in CXS specification).
`define CX_CXS_DATAFLITWIDTH 512


// Name:           CX_CXS_MAXPKTPERFLIT
// Default:        4 (((CX_CXS_DATAFLITWIDTH==256) || CX_CXL_CXS_ENABLE) ? 2 : 4)
// Values:         2 3 4
// Enabled:        (CX_CXS_ENABLE && (CX_CXS_DATAFLITWIDTH>256))
// Parameter Type: Feature Setting
// 
// Maximum number of packets that can be present in a single flit of data (maps to CXSMAXPKTPERFLIT in CXS specification).
`define CX_CXS_MAXPKTPERFLIT 4


// Name:         CX_CXS_CNTLWIDTH
// Default:      36 (CX_CXS_MAXPKTPERFLIT*(3+([<functionof> 
//               CX_CXS_DATAFLITWIDTH]-5)+([<functionof> CX_CXS_DATAFLITWIDTH]-7)))
// Values:       14, ..., 44
// 
// Configures CXS Interface Control Bus Width (CXSCNTL).
`define CX_CXS_CNTLWIDTH 36


// Name:           CX_CXS_SYNCHRONOUS
// Default:        true (CX_CXS_DATAFLITWIDTH==CX_CXS_CCIXDATAWIDTH)
// Values:         false (0), true (1)
// Enabled:        (CX_CXS_ENABLE && (CX_CXS_DATAFLITWIDTH!=CX_CXS_CCIXDATAWIDTH))
// Parameter Type: Feature Setting
// 
// If set to True, this parameter results in a CXS implementation using a single clock domain. 
// The PCIe IP clock (core_clk) is used to drive CXS interface.
`define CX_CXS_SYNCHRONOUS


// Name:           CX_CXS_FREQUENCY
// Default:        1000 
//                 (int((CX_CXS_CCIXDATAWIDTH*1.0/CX_CXS_DATAFLITWIDTH)*CX_MAX_CORECLK_FREQ))
// Values:         -2147483648, ..., 2147483647
// Enabled:        CX_CXS_ENABLE && !CX_CXS_SYNCHRONOUS
// Parameter Type: Feature Setting
// 
// Specifies the maximum operating frequency of CXS Controller (MHz). 
// The default value is the Core and CXS Data Flit width ratio of the core_clk frequency.
`define CX_CXS_FREQUENCY 1000


// Name:           CX_CXS_RX_CREDITS
// Default:        15
// Values:         1, ..., 15
// Enabled:        CX_CXS_ENABLE
// Parameter Type: Feature Setting
// 
// Configures the number of CXS Receiver credits.
`define CX_CXS_RX_CREDITS 15


// Name:           CX_CXS_RX_DATACHECK
// Default:        None ((CX_CXS_ENABLE && (CX_RASDP > 0)) ? (CX_RASDP-1) : 0)
// Values:         None (0), Odd Parity (1), SECDED (2)
// Enabled:        CX_CXS_ENABLE
// Parameter Type: Feature Setting
// 
// Configures data check support on CXSRXDATA, CXSRXCNTL (maps to CXSDATACHECK in CXS 
// specification): 
// 0 - None 
// 1 - Odd Parity; 1 bit per byte on CXSDATA and 1 bit for CXSCNTL 
// 2 - SECDED: ECC on a 64-bit granularity; 8 bits per 64 bits of data and 8 bits for 
// CXSCNTL (zero extended to 64 bits) 
// The default value of this parameter is derived from CX_RASDP setting.
`define CX_CXS_RX_DATACHECK 0


// Name:           CX_CXS_TX_DATACHECK
// Default:        None ((CX_CXS_ENABLE && (CX_RASDP > 0)) ? (CX_RASDP-1) : 0)
// Values:         None (0), Odd Parity (1), SECDED (2)
// Enabled:        CX_CXS_ENABLE
// Parameter Type: Feature Setting
// 
// Configures data check support on CXSTXDATA, CXSTXCNTL (maps to CXSDATACHECK in CXS 
// specification): 
// 0 - None 
// 1 - Odd Parity; 1 bit per byte on CXSDATA and 1 bit for CXSCNTL 
// 2 - SECDED: ECC on a 64-bit granularity; 8 bits per 64 bits of data and 8 bits for 
// CXSCNTL (zero extended to 64 bits) 
// The default value of this parameter is derived from CX_RASDP setting.
`define CX_CXS_TX_DATACHECK 0


// Name:         CX_CXS_DATACHKWIDTH
// Default:      64 (CX_CXS_DATAFLITWIDTH/8)
// Values:       -2147483648, ..., 2147483647
// 
// Configures CXS Interface Data Bus Protection Width (CXSDATACHK).
`define CX_CXS_DATACHKWIDTH 64


// Name:         CX_CXS_CNTLCHKWIDTH
// Default:      1 ((CX_CXS_RX_DATACHECK == 2) ? 8 : ((CX_CXS_RX_DATACHECK == 1) ? 1 
//               : ((CX_CXS_TX_DATACHECK == 2) ? 8 : 1)))
// Values:       -2147483648, ..., 2147483647
// 
// Configures CXS Interface Control Bus Protection Width (CXSCNTLCHK).
`define CX_CXS_CNTLCHKWIDTH 1


// Name:           CX_CXS_RX_CONTINUOUSDATA
// Default:        true ((CX_CXL_ENABLE && CX_FLIT_MODE_ENABLE) ? 1 : 0)
// Values:         false (0), true (1)
// Enabled:        CX_CXS_ENABLE
// Parameter Type: Feature Setting
// 
// If set to True, this receiver requires that after a packet is started it is completed in 
// consecutive cycles if enough credits are available (maps to CXSCONTINUOUSDATA in CXS 
// specification). 
// Note: Once this parameter is set to True, this attribute may not be overwritten through 
// CXS Receiver configuration register.
`define CX_CXS_RX_CONTINUOUSDATA


// Name:           CX_CXS_TX_CONTINUOUSDATA
// Default:        false ((CX_CXL_ENABLE && CX_FLIT_MODE_ENABLE) ? 0 : 1)
// Values:         false (0), true (1)
// Enabled:        CX_CXS_ENABLE
// Parameter Type: Feature Setting
// 
// If set to True, this transmitter do not begin a packet until it can deliver the complete 
// packet in consecutive cycles as long as credits are available (maps to CXSCONTINUOUSDATA 
// in CXS specification). 
// Note: This parameter only sets the Store-Forward mode default 
// value in CXS Transmitter configuration register which may be overwritten later.
// `define CX_CXS_TX_CONTINUOUSDATA


// Name:           CX_CXS_RX_REPLICATION
// Default:        None
// Values:         None (0), Duplicate (1), Triplicate (2)
// Enabled:        0
// Parameter Type: Feature Setting
// 
// Signal replication on CXSRXVALID, CXSRXCRDGNT, CXSRXCRDRTN (maps to CXSREPLICATION in CXS specification). 
// Duplicate: CXSRXVALIDCHK, CXSRXCRDGNTCHK, and CXSRXCRDRTNCHK are each single bit signals 
// duplicating the value of the corresponding control signal. 
// Triplicate: CXSRXVALIDCHK, CXSRXCRDGNTCHK, and CXSRXCRDRTNCHK are each two-bit signals 
// with each of the 2 bits having the same value as the corresponding control signal.
`define CX_CXS_RX_REPLICATION 0


// Name:           CX_CXS_TX_REPLICATION
// Default:        None
// Values:         None (0), Duplicate (1), Triplicate (2)
// Enabled:        0
// Parameter Type: Feature Setting
// 
// Signal replication on CXSTXVALID, CXSTXCRDGNT, CXSTXCRDRTN (maps to CXSREPLICATION in CXS specification). 
// Duplicate: CXSTXVALIDCHK, CXSTXCRDGNTCHK, and CXSTXCRDRTNCHK are each single bit signals 
// duplicating the value of the corresponding control signal. 
// Triplicate: CXSTXVALIDCHK, CXSTXCRDGNTCHK, and CXSTXCRDRTNCHK are each two-bit signals 
// with each of the 2 bits having the same value as the corresponding control signal.
`define CX_CXS_TX_REPLICATION 0


// Name:         CX_CXS_RX_REPLICATION_EN
// Default:      0 ((CX_CXS_RX_REPLICATION > 0) ? 1 : 0)
// Values:       0, 1
// 
// Indicates CXS Interface Signal Replication Enable.
// `define CX_CXS_RX_REPLICATION_EN


// Name:         CX_CXS_TX_REPLICATION_EN
// Default:      0 ((CX_CXS_TX_REPLICATION > 0) ? 1 : 0)
// Values:       0, 1
// 
// Indicates CXS Interface Signal Replication Enable.
// `define CX_CXS_TX_REPLICATION_EN


// Name:           CX_CXS_RX_ERRORFULLPKT
// Default:        true
// Values:         false (0), true (1)
// Enabled:        0
// Parameter Type: Feature Setting
// 
// If set to True, this receiver requires that the length of every packet (including packets 
// ending with EndError) match the packet length specified in the packet header (maps to 
// CXSERRORFULLPKT in CXS specification).
`define CX_CXS_RX_ERRORFULLPKT


// Name:           CX_CXS_TX_ERRORFULLPKT
// Default:        false
// Values:         false (0), true (1)
// Enabled:        0
// Parameter Type: Feature Setting
// 
// If set to True, if this transmitter is unable to complete a packet and must end the 
// packet with an EndError indication, the transmitter sends the number of bytes 
// specified in the packet header before ending the packet (maps to CXSERRORFULLPKT 
// in CXS specification).
// `define CX_CXS_TX_ERRORFULLPKT


// Name:         CX_CXS_PRCL_ENABLE
// Default:      0 (CX_CXS_ENABLE && CX_CCIX_INTERFACE_ENABLE && CX_CXL_CXS_ENABLE)
// Values:       0, 1
// 
// Enables protocol type selection - CXSPRCLTYPE on CXS Interface
// `define CX_CXS_PRCL_ENABLE


// Name:         CX_CXS_LAST_ENABLE
// Default:      0 (CX_CXL_CXS_ENABLE)
// Values:       0, 1
// 
// Enables last of sequence indication - CXSLAST on CXS Interface
// `define CX_CXS_LAST_ENABLE


// Name:         CXS_FLIT_EQUALS_DATA_WIDTH
// Default:      1 (CX_CXS_DATAFLITWIDTH==CX_CXS_CCIXDATAWIDTH)
// Values:       0, 1
// 
// CXS Flit Data width and CCIX Data width are equal.
`define CXS_FLIT_EQUALS_DATA_WIDTH


// Name:         CXS_FLIT_GREATER_DATA_WIDTH
// Default:      0 (CX_CXS_DATAFLITWIDTH>CX_CXS_CCIXDATAWIDTH)
// Values:       0, 1
// 
// CXS Flit Data width is greater than the core data width.
// `define CXS_FLIT_GREATER_DATA_WIDTH


// Name:         CXS_FLIT_LOWER_DATA_WIDTH
// Default:      0 (CX_CXS_DATAFLITWIDTH<CX_CXS_CCIXDATAWIDTH)
// Values:       0, 1
// 
// CXS Flit Data width is lower than the core data width.
// `define CXS_FLIT_LOWER_DATA_WIDTH


// Name:         CX_CXS_RX_CCIXCNTLWIDTH
// Default:      36 ((CX_CXS_CCIXDATAWIDTH/128)*(3+([<functionof> 
//               CX_CXS_CCIXDATAWIDTH]-5)+([<functionof> CX_CXS_CCIXDATAWIDTH]-7)))
// Values:       5, ..., 88
// 
// Configures CXS Interface Control Bus Width (CXSCNTL).
`define CX_CXS_RX_CCIXCNTLWIDTH 36


// Name:         CX_CXS_TX_CCIXCNTLWIDTH
// Default:      36 ((CXS_FLIT_EQUALS_DATA_WIDTH ? CX_CXS_MAXPKTPERFLIT : 
//               1)*(3+([<functionof> CX_CXS_CCIXDATAWIDTH]-5)+([<functionof> 
//               CX_CXS_CCIXDATAWIDTH]-7)))
// Values:       5, ..., 88
// 
// Configures CXS Interface Control Bus Width (CXSCNTL).
`define CX_CXS_TX_CCIXCNTLWIDTH 36


// Name:         CX_CXS_RX_FSM_FIFO_DEPTH
// Default:      16 (CX_CXS_RX_CREDITS + 1 + ((CX_CXS_RX_CONTINUOUSDATA && 
//               (CXS_FLIT_EQUALS_DATA_WIDTH==1)) ? 0 : (4096/CX_CXS_DATAFLITWIDTH)))
// Values:       -2147483648, ..., 2147483647
// 
// Configure CXS FSM Receiver Buffer FIFO depth
`define CX_CXS_RX_FSM_FIFO_DEPTH 16


// Name:         CX_CXS_RX_BUFF_FIFO_DEPTH
// Default:      16 (CX_CXS_RX_CREDITS + 1 + ((CX_CXS_RX_CONTINUOUSDATA && 
//               (CXS_FLIT_EQUALS_DATA_WIDTH==1)) ? 0 : (4096/(CXS_FLIT_LOWER_DATA_WIDTH ? 
//               CX_CXS_CCIXDATAWIDTH : CX_CXS_DATAFLITWIDTH))))
// Values:       -2147483648, ..., 2147483647
// 
// Configure CXS Receiver Buffer FIFO depth
`define CX_CXS_RX_BUFF_FIFO_DEPTH 16


// Name:         CX_CXS_RX_MEM_DEPTH_ADJ
// Default:      0 (([<functionof> CX_CXS_RX_BUFF_FIFO_DEPTH]) ? 0 : 
//               (CX_CXS_RX_BUFF_FIFO_DEPTH % 2) ? 1 : 2)
// Values:       -2147483648, ..., 2147483647
// 
// Adjust CXS Receiver FIFO depth based on Credit counter
`define CX_CXS_RX_MEM_DEPTH_ADJ 0


// Name:           CX_CXS_RX_BUFF_DEPTH
// Default:        16 (CX_CXS_RX_BUFF_FIFO_DEPTH + CX_CXS_RX_MEM_DEPTH_ADJ)
// Values:         2, ..., 32
// Parameter Type: Feature Setting
// 
// Configure CXS Receiver Buffer Memory depth
`define CX_CXS_RX_BUFF_DEPTH 16


// Name:         CX_CXS_RX_BUFF_DATAW
// Default:      620 (CX_CXS_LAST_ENABLE + 3*CX_CXS_PRCL_ENABLE + 
//               (CXS_FLIT_LOWER_DATA_WIDTH ? (CX_CXS_CCIXDATAWIDTH + CX_CXS_RX_CCIXCNTLWIDTH + 
//               (CX_RAS_EN ? (CX_CXS_CCIXDATAWIDTH/8 + 8) : 0)) : (CX_CXS_DATAFLITWIDTH + 
//               CX_CXS_CNTLWIDTH + (CX_RAS_EN ? (CX_CXS_DATACHKWIDTH + 8) : 0)) ))
// Values:       (CXS_FLIT_LOWER_DATA_WIDTH ? 261 : 270), ..., 1208
// 
// Configures CXS Receiver Buffer RAM Data Width
`define CX_CXS_RX_BUFF_DATAW 620


// Name:         CX_CXS_RX_BUFF_ADDRW
// Default:      4 ([<functionof> CX_CXS_RX_BUFF_DEPTH])
// Values:       1, ..., 5
// 
// Configures CXS Receiver Buffer RAM Address Width
`define CX_CXS_RX_BUFF_ADDRW 4


// Name:           CX_CXS_RX_INPUT_REG
// Default:        true
// Values:         false (0), true (1)
// Enabled:        CX_CXS_ENABLE
// Parameter Type: Feature Setting
// 
// Enable input register on CXS Receiver Data/Control bus inputs.
`define CX_CXS_RX_INPUT_REG


// Name:           CX_CXS_TX_BUFF_DEPTH
// Default:        16 (CX_CCIX_INTERFACE_ENABLE ? (4*(4096/(CXS_FLIT_LOWER_DATA_WIDTH 
//                 ? CX_CXS_CCIXDATAWIDTH : CX_CXS_DATAFLITWIDTH))) : 16)
// Values:         4 8 16 32 64 128 256
// Parameter Type: Feature Setting
// 
// Configures CXS Transmitter Buffer Depth
`define CX_CXS_TX_BUFF_DEPTH 16


// Name:         CX_CXS_TX_BUFF_DATAW
// Default:      620 (CX_CXS_LAST_ENABLE + 3*CX_CXS_PRCL_ENABLE + 
//               (CXS_FLIT_LOWER_DATA_WIDTH ? (CX_CXS_CCIXDATAWIDTH + CX_CXS_TX_CCIXCNTLWIDTH + 
//               (CX_RAS_EN ? (CX_CXS_CCIXDATAWIDTH/8 + 8) : 0)) : (CX_CXS_DATAFLITWIDTH + 
//               CX_CXS_CNTLWIDTH + (CX_RAS_EN ? (CX_CXS_DATACHKWIDTH + 8) : 0)) ))
// Values:       (CXS_FLIT_LOWER_DATA_WIDTH ? 261 : 270), ..., 1208
// 
// Configures CXS Transmitter Buffer RAM Data Width
`define CX_CXS_TX_BUFF_DATAW 620


// Name:         CX_CXS_TX_BUFF_ADDRW
// Default:      4 ([<functionof> (CX_CCIX_INTERFACE_ENABLE ? 
//               (4*(4096/(CXS_FLIT_LOWER_DATA_WIDTH ? CX_CXS_CCIXDATAWIDTH : CX_CXS_DATAFLITWIDTH))) : 
//               16)])
// Values:       1, ..., 8
// 
// Configures CXS Transmitter Buffer RAM Address Width
`define CX_CXS_TX_BUFF_ADDRW 4


