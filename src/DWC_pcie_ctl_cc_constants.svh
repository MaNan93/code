// Enabled:        (CX_CUSTOM_PIPELINING) && (CX_PIPE_SERDES_ARCH) && (CX_CXL_ENABLE 
//                 || CX_FLIT_MODE_ENABLE)
// Parameter Type: Performance Setting
// 
// Inserts a pipeline on syncheader generate module(serdes_pipe_rx_syncheadergen) for SerDes architecture when sync header 
// bypass is enabled or 1b1b encoding, providing trade-off of latency and gates for ease of timing closure.
`define CX_SERDES_ARCH_RX_SH_BYPASS_BYPSDATA_REGOUT 0


