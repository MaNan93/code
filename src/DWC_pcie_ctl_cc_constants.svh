// Name:           CX_GEN3_MODE
// Default:        Dynamic Width ((CX_MAX_PCIE_SPEED<3) ? 2 : 
//                 (CX_MAC_SMODE_GEN2==204) && (CX_MAC_SMODE_GEN3==404) ? 1 : 
//                 (CX_MAC_SMODE_GEN2==2) && (CX_MAC_SMODE_GEN3==4) ? 1 : 
//                 (CX_MAC_SMODE_GEN2==4) && (CX_MAC_SMODE_GEN3==8) ? 1 : 
//                 (CX_MAC_SMODE_GEN2==1) && (CX_MAC_SMODE_GEN3==4) ? 4 : 
//                 (CX_MAC_SMODE_GEN2==2) && (CX_MAC_SMODE_GEN3==8) ? 4 : 
//                 (CX_MAC_SMODE_GEN2==4) && (CX_MAC_SMODE_GEN3==16) ? 4 : 
//                 (CX_MAC_SMODE_GEN2==1) && (CX_MAC_SMODE_GEN3==1) ? 0 : 
//                 (CX_MAC_SMODE_GEN2==2) && (CX_MAC_SMODE_GEN3==2) ? 0 : 
//                 (CX_MAC_SMODE_GEN2==4) && (CX_MAC_SMODE_GEN3==4) ? 0 : 2)
// Values:         Dynamic Frequency (0), Dynamic Width (1), Disabled (2), Dynamic 
//                 Pacing (3), Dynamic Width x2 (4)
// Parameter Type: Feature Setting
// 
// Specifies if the controller supports Gen3 and how it performs the data rate scale to Gen3. You can set up the PHY and 
// controller differently. For example, one can be Dynamic Width and the other one Dynamic Frequency. 
// This parameter becomes a read-only parameter and takes the same value as CM_GEAR3_MODE if Single M-PCIe or Selectable 
// PHY mode are enabled. 
//  - Dynamic Pacing: the core's Gen3 mode is enabled, the core's clock frequency and data width do not change, the same 
//  as Gen2 mode.
`define CX_GEN3_MODE 1


// Name:         CX_GEN3_SPEED
// Default:      1 (CX_GEN3_MODE != GEN3_DISABLED)
// Values:       0, 1
// 
// When enabled, controller operates with gen3(not included HS-Gear3 when M-PCIe) features enabled.
`define CX_GEN3_SPEED


`define CX_GEN3_SPEED_VALUE 1


// Name:         DEFAULT_SUPPORT_PART_LANES_RXEI_EXIT_IN_POLL_ACTIVE
// Default:      0x0
// Values:       0x0, 0x1
// Enabled:      0
// 
// The controller supports LTSSM moves from Polling.Active to Polling.Configuration after it receives 8 consecutive TS OSs 
// on any lanes and part of predetermined lanes are detected but not Rx ElecIdle exit after 24ms timeout. 
// This parameter value is the default value for a Port Logic Register, SUPPORT_PART_LANES_RXEI_EXIT bit at location 
// PORT_FORCE_OFF[22]. 
// 1: Support LTSSM moving from Polling.Active to Polling.Configuration when part of predetermined lanes are detected but 
// not Rx ElecIdle exit 
// 0: Support legacy mode, LTSSM moves from Polling.Active to Polling.Configuration when all predetermined lanes are 
// detected and Rx ElecIdle exit
`define DEFAULT_SUPPORT_PART_LANES_RXEI_EXIT_IN_POLL_ACTIVE 1'h0


// Name:         DEFAULT_NO_SEED_VALUE_CHANGE
// Default:      Change Seed Value
// Values:       Change Seed Value (0x0), No Change Seed Value (0x1)
// Enabled:      CX_GEN3_SPEED && CX_AUTO_LANE_FLIP_CTRL_EN
// 
// The seed value of LFSR for scrambler does not change after LinkUp. This requires both sides of the link support this. 
// This parameter is the default value for a Port Logic Register, Gen3 Control Register bit NO_SEED_VALUE_CHANGE which 
// takes effect only when CX_AUTO_LANE_FLIP_CTRL_EN is supported.
`define DEFAULT_NO_SEED_VALUE_CHANGE 1'h0


// Name:         DEFAULT_SELECT_DEEMPH_VAR_MUX
// Default:      0x0
// Values:       0x0, 0x1
// Enabled:      CX_MAX_PCIE_SPEED >= 2
// 
// The select_deemphasis variable for DSP on entry to Recovery.RcvrCfg state is muxed between the Selectable De-emphasis 
// field in the Link Control 2 register and the value 
// requested by USP in the eight consecutive TS1 Ordered Sets the DSP received in Recovery.RcvrLock state. This parameter 
// is the default value for the Port Logic Register, SELECT_DEEMPH_VAR_MUX bit at GEN2_CTRL_OFF[22] 
// 1: the value from the Selectable De-emphasis field in the Link Control 2 register 
// 0: the value requested by USP
`define DEFAULT_SELECT_DEEMPH_VAR_MUX 1'h0


// Name:         DEFAULT_SELECTABLE_DEEMPH_BIT_MUX
// Default:      0x0
// Values:       0x0, 0x1
// Enabled:      CX_MAX_PCIE_SPEED >= 2
// 
// The selectable deemphasis bit (Symbol 4 bit 6) of the transmitted TS2 Ordered Sets for DSP in Recovery.RcvrCfg state is 
// muxed between the Selectable De-emphasis field 
// in the Link Control 2 register and the value requested by USP in the eight consecutive TS1 Ordered Sets the DSP 
// received in Recovery.RcvrLock state. 
// This parameter is the default value for a Port Logic Register, SELECTABLE_DEEMPH_BIT_MUX bit at GEN2_CTRL_OFF[23] 
// 1: the value requested by USP 
// 0: the value from the Selectable De-emphasis field in the Link Control 2 register
`define DEFAULT_SELECTABLE_DEEMPH_BIT_MUX 1'h0



