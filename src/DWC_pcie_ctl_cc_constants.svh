// PF4. If 1b, indicates that the component implements ACS P2P Completion Redirect.
`define CX_ACS_P2P_COMPL_REDIRECT_4 1'h1


// Name:           CX_ACS_P2P_EGRESS_CTRL_4
// Default:        0x1 (CX_ACS_P2P_EGRESS_CTRL_0)
// Values:         0x0, 0x1
// Enabled:        CX_ACS_ENABLE
// Parameter Type: Feature Setting
// 
// This is the default value (after reset) of the ACS P2P Egress Control bit field in the ACS Capability register in PF4. 
// If 1b, indicates that the component implements ACS P2P Egress Control.
`define CX_ACS_P2P_EGRESS_CTRL_4 1'h1


// Name:           CX_ACS_P2P_DIRECT_TRANSL_4
// Default:        0x1 (CX_ACS_P2P_DIRECT_TRANSL_0)
// Values:         0x0, 0x1
// Enabled:        CX_ACS_ENABLE
// Parameter Type: Feature Setting
// 
// This is the default value (after reset) of the ACS Direct Translated P2P bit field in the ACS Capability register in 
// PF4. If 1b, indicates that the component implements ACS Direct Translated P2P.
`define CX_ACS_P2P_DIRECT_TRANSL_4 1'h1


// Name:           CX_ACS_EGRESS_CTRL_SIZE_4
// Default:        0x4 ((CX_ACS_P2P_EGRESS_CTRL_4) * (CX_ACS_EGRESS_CTRL_SIZE_0))
// Values:         0x0, ..., 0xff
// Enabled:        CX_ACS_ENABLE
// Parameter Type: Feature Setting
// 
// This is the default value (after reset) of the Egress Control Vector Size field in the ACS Capability register in PF4. 
// Encodes 01h-FFh directly indicate the number of applicable bits in the Egress Control Vector; the encoding 00h indicates 
// 256 bits.
`define CX_ACS_EGRESS_CTRL_SIZE_4 8'h4


// Name:         ACS_CTRL_VEC_WD_4
// Default:      0x4 ((CX_ACS_P2P_EGRESS_CTRL_4) * ((CX_ACS_EGRESS_CTRL_SIZE_4 == 0) 
//               ? 256 : CX_ACS_EGRESS_CTRL_SIZE_4))
// Values:       0x0, ..., 0x1ff
// 
// This is the width of the ACS control vector for Function 4
`define ACS_CTRL_VEC_WD_4 9'h4


// Name:           CX_ACS_UP_EGRESS_CTRL_MASK_4
// Default:        0x10 ([<functionof> CX_ACS_FUNC_GRP 4])
// Values:         0x0, ..., 
//                 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
// Enabled:        (CX_ACS_ENABLE && (CC_DEVICE_TYPE==CC_EP || CC_DEVICE_TYPE==CC_DM))
// Parameter Type: Feature Setting
// 
// This determines the default value of the read only bits in the Upstream Port Egress Control Vector(after reset) in PF4. 
// Set bits to 1 to indicate Read Only
`define CX_ACS_UP_EGRESS_CTRL_MASK_4 256'h10


// Name:           CX_ACS_DW_EGRESS_CTRL_MASK_4
// Default:        0x1
// Values:         0x0, ..., 
//                 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
// Enabled:        CX_ACS_ENABLE && CC_DEVICE_TYPE!=CC_EP
// Parameter Type: Feature Setting
// 
// This determines the default value of the read only bits in the Downstream Port Egress Control Vector(after reset) in 
// PF4. Set bits to 1 to indicate Read Only
`define CX_ACS_DW_EGRESS_CTRL_MASK_4 256'h1

