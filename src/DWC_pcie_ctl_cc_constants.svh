// Name:           DEFAULT_GEN4_RXMARGIN_MAX_TIMING_OFFSET
// Default:        20
// Values:         0, ..., 50
// Enabled:        ((CX_GEN4_SPEED))
// Parameter Type: Register Default Setting
// 
// Specify the offset from default at maximum step value for 16.0 GT/s (MMaxTimingOffset). Contact your PHY vendor for the 
// value that you should use.
`define DEFAULT_GEN4_RXMARGIN_MAX_TIMING_OFFSET 20


// Name:           DEFAULT_GEN4_RXMARGIN_NUM_VOLTAGE_STEPS
// Default:        32
// Values:         32, ..., 127
// Enabled:        ((CX_GEN4_SPEED))
// Parameter Type: Register Default Setting
// 
// Specify the number of voltage steps from default for 16.0 GT/s (MNumVoltageSteps). Contact your PHY vendor for the value 
// that you should use.
`define DEFAULT_GEN4_RXMARGIN_NUM_VOLTAGE_STEPS 32


// Name:           DEFAULT_GEN4_RXMARGIN_MAX_VOLTAGE_OFFSET
// Default:        5
// Values:         0, ..., 50
// Enabled:        ((CX_GEN4_SPEED))
// Parameter Type: Register Default Setting
// 
// Specify the offset from default at maximum step value as percentage of one voltage for 16.0 GT/s (MMaxVoltageOffset). 
// Contact your PHY vendor for the value that you should use.
`define DEFAULT_GEN4_RXMARGIN_MAX_VOLTAGE_OFFSET 5


// Name:           DEFAULT_GEN4_RXMARGIN_SAMPLE_RATE_VOLTAGE
// Default:        0
// Values:         0, ..., 63
// Enabled:        ((CX_GEN4_SPEED))
// Parameter Type: Register Default Setting
// 
// Specify the ratio of bits tested to bits received during voltage margining for 16.0 GT/s (MSamplingRateVoltage). Contact 
// your PHY vendor for the value that you should use. 
//  
// Note: If MIndErrorSampler =0, the controller always reports MSamplingRateVoltage =0x3F regardless of this parameter 
// value when the controller receives Report MSamplingRateVoltage Command from System Software.
`define DEFAULT_GEN4_RXMARGIN_SAMPLE_RATE_VOLTAGE 0


// Name:           DEFAULT_GEN4_RXMARGIN_SAMPLE_RATE_TIMING
// Default:        0
// Values:         0, ..., 63
// Enabled:        ((CX_GEN4_SPEED))
// Parameter Type: Register Default Setting
// 
// Specify the ratio of bits tested to bits received during timing margining for 16.0 GT/s (MSamplingRateTiming). Contact 
