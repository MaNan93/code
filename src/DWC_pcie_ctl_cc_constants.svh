// Name:           DISABLE_CFG_MAP_PL_REG
// Default:        0
// Values:         0, 1
// Enabled:        !CX_PL_REG_DISABLE
// Parameter Type: Feature Setting
// 
// Disables routing of configuration (CFG) transactions to the PL registers. 
// Endpoints can access the port logic using only memory transactions. 
// PL registers can be accessed by MEM requests through the use of the PL_FUNC_NUM, PL_BAR_NUM, and  PL_OFFSET_BAR 
// configuration parameters. 
// These can be used to map the PL registers to any BAR of any function. 
// The BAR corresponding to PL_BAR_NUM must also be mapped/assigned to RTRGT0. 
// DBI access for both Endpoints and Root ports uses a new address format encoding signal to indicated access to port 
// logic. 
// For more information, see the "Local Bus Controller (LBC)" section in the "Controller Operations" chapter of the 
// Databook.
// `define DISABLE_CFG_MAP_PL_REG


// Name:           ENABLE_MEM_MAP_PL_REG
// Default:        0 (DISABLE_CFG_MAP_PL_REG && CC_DEVICE_TYPE!=CC_RC)
// Values:         0, 1
// Enabled:        !DISABLE_CFG_MAP_PL_REG && CC_DEVICE_TYPE!=CC_RC
// Parameter Type: Feature Setting
// 
// Enables routing of memory (non-CFG) transactions to the port logic (PL) configuration registers. This is memory mapping 
// of the PL register space. PL registers (which by default are accessed by CFG requests) can also (at the same time) be 
// accessed by MEM requests through the use of the ENABLE_MEM_MAP_PL_REG, PL_FUNC_NUM and PL_BAR_NUM configuration parameters. 
// These can be used to map the PL registers to any BAR of any function. All MEM requests that match PL_BAR_NUM (when 
// ENABLE_MEM_MAP_PL_REG=1) and whose address offset is in the range 0x700-0x8FF is routed to the PL registers. The BAR corresponding 
// to PL_BAR_NUM must also be mapped/assigned to RTRGT0. For more information, see the "Local Bus Controller (LBC)" section 
// in the "Controller Operations" chapter of the Databook.
// `define ENABLE_MEM_MAP_PL_REG


// `define DISABLE_CFG_MAP_PL_REG_OR_REG_TDISP_FILTER_EN_OR_UCIE


// Name:           ENABLE_MEM_MAP_UNROLL_DMA_REG
// Default:        0
// Values:         0, 1
// Enabled:        CC_DEVICE_TYPE!=CC_RC && CC_DMA_ENABLE && CC_UNROLL_ENABLE
// Parameter Type: Feature Setting
// 
// Enables routing of memory (non-CFG) transactions to the Unroll DMA configuration registers. Unroll DMA registers can be 
// accessed by MEM requests through the use of the ENABLE_MEM_MAP_UNROLL_DMA_REG, UNROLL_FUNC_NUM and UNROLL_BAR_NUM 
// configuration parameters. These can be used to map the UNROLL registers to any BAR of any function. All MEM requests that match 
// UNROLL_BAR_NUM (when ENABLE_MEM_MAP_UNROLL_DMA_REG=1) and whose address offset is in the range UNROLL_DMA_OFFSET_BAR to 
// UNROLL_DMA_OFFSET_BAR+UNROLL_DMA_SIZE-1 is routed to the UNROLL registers. The BAR corresponding to UNROLL_BAR_NUM must also 
// be mapped/assigned to RTRGT0.
// `define ENABLE_MEM_MAP_UNROLL_DMA_REG


// Name:           ENABLE_MEM_MAP_UNROLL_ATU_REG
// Default:        0
// Values:         0, 1
// Enabled:        CC_DEVICE_TYPE!=CC_RC && CX_INTERNAL_ATU_ENABLE && CC_UNROLL_ENABLE
// Parameter Type: Feature Setting
// 
// Enables routing of memory (non-CFG) transactions to the Unroll ATU configuration registers. Unroll registers can be 
// accessed by MEM requests through the use of the ENABLE_MEM_MAP_UNROLL_ATU_REG, UNROLL_FUNC_NUM and UNROLL_BAR_NUM 
// configuration parameters. These can be used to map the UNROLL registers to any BAR of any function. All MEM requests that match 
// UNROLL_BAR_NUM (when ENABLE_MEM_MAP_UNROLL_ATU_REG=1) and whose address offset is in the range 
// UNROLL_ATU_OFFSET_BAR-UNROLL_ATU_OFFSET_BAR+UNROLL_ATU_SIZE-1 is routed to the UNROLL registers. The BAR corresponding to UNROLL_BAR_NUM must also be 
// mapped/assigned to RTRGT0.
// `define ENABLE_MEM_MAP_UNROLL_ATU_REG


// Name:           UNROLL_FUNC_NUM
// Default:        0
// Values:         0, ..., 7
// Enabled:        ENABLE_MEM_MAP_UNROLL_ATU_REG==1 || 
//                 ENABLE_MEM_MAP_UNROLL_DMA_REG==1 
// Parameter Type: Feature Setting
// 
// Indicates which function is used to map the Unroll configuration registers into memory space. For more information, see 
// the ENABLE_MEM_MAP_UNROLL_ATU_REG or ENABLE_MEM_MAP_UNROLL_DMA_REG parameter.
`define UNROLL_FUNC_NUM 0


// Name:           UNROLL_BAR_NUM
// Default:        BAR0
// Values:         BAR0 (0), BAR1 (1), BAR2 (2), BAR3 (3), BAR4 (4), BAR5 (5)
// Enabled:        ENABLE_MEM_MAP_UNROLL_ATU_REG==1 || 
//                 ENABLE_MEM_MAP_UNROLL_DMA_REG==1
// Parameter Type: Feature Setting
// 
// Indicates which BAR is used to map the UNROLL configuration registers into memory space. For more information, see the 
// ENABLE_MEM_MAP_UNROLL_ATU_REG or ENABLE_MEM_MAP_UNROLL_DMA_REG parameter.
`define UNROLL_BAR_NUM 0


// Name:         UNROLL_DMA_SIZE
// Default:      0x0 (ENABLE_MEM_MAP_UNROLL_DMA_REG ? 
//               (2**CX_DMAREG_CHADDR_SPACE)*[<functionof> CC_NUM_DMA_RD_CHAN CC_NUM_DMA_WR_CHAN] + 
//               (CC_LEGACY_DMA_MAP_VALUE ? 0x200 : 0) : 0)
// Values:       0x0, ..., 0xffffffffffffffff
// Enabled:      ENABLE_MEM_MAP_UNROLL_DMA_REG==1
// 
// Indicates the size of UNROLL DMA configuration registers into memory space.
`define UNROLL_DMA_SIZE 64'h0


// Name:         UNROLL_ATU_SIZE
// Default:      0x0 (ENABLE_MEM_MAP_UNROLL_ATU_REG ? [<functionof> 
//               CX_ATU_NUM_INBOUND_REGIONS CX_ATU_NUM_OUTBOUND_REGIONS] : 0)
// Values:       0x0, ..., 0xffffffffffffffff
// Enabled:      ENABLE_MEM_MAP_UNROLL_ATU_REG==1
// 
// Indicates the size of UNROLL ATU configuration registers into memory space.
`define UNROLL_ATU_SIZE 64'h0


// Name:           PL_FUNC_NUM
// Default:        0
// Values:         0, ..., 7
// Enabled:        ENABLE_MEM_MAP_PL_REG==1
// Parameter Type: Feature Setting
// 
// Indicates which function is used to map the Port Logic configuration registers into memory space. For more information, 
// see the ENABLE_MEM_MAP_PL_REG parameter.
`define PL_FUNC_NUM 0


// Name:           PL_BAR_NUM
// Default:        BAR0
// Values:         BAR0 (0), BAR1 (1), BAR2 (2), BAR3 (3), BAR4 (4), BAR5 (5)
// Enabled:        ENABLE_MEM_MAP_PL_REG==1
// Parameter Type: Feature Setting
// 
// Indicates which BAR is used to map the Port Logic configuration registers into memory space. For more information, see 
// the ENABLE_MEM_MAP_PL_REG parameter.
`define PL_BAR_NUM 0


`define UNROLL_PL_FUNC_BAR_MATCH


// Name:           PL_OFFSET_BAR
// Default:        0x6000
// Values:         0x0, ..., 0xffffffffffffffff
// Enabled:        ENABLE_MEM_MAP_PL_REG==1
// Parameter Type: Feature Setting
// 
// Indicates the offset BAR address to allocate the Port logic configuration registers into memory space.
`define PL_OFFSET_BAR 64'h6000


// Name:           PL_LIMIT
// Default:        0xcac (DISABLE_CFG_MAP_PL_REG? (PL_OFFSET_BAR + 0xCAC - 0x700) : 
//                 0xCAC)
// Values:         DISABLE_CFG_MAP_PL_REG? (PL_OFFSET_BAR + 0x200) : 0x900, ..., 
//                 DISABLE_CFG_MAP_PL_REG? (PL_OFFSET_BAR + 0xCAC - 0x700) : 0xCAC
// Enabled:        ENABLE_MEM_MAP_PL_REG==1
// Parameter Type: Feature Setting
// 
// Indicates the limit address for BAR matched memory mapped Port Logic configuration registers.
`define PL_LIMIT 'hcac


`define PL_OFFSET 1792


`define PL_SIZE 1453


// Name:           UNROLL_DMA_OFFSET_BAR
// Default:        0x0
// Values:         0x0, ..., 0xffffffffffffffff
// Enabled:        ENABLE_MEM_MAP_UNROLL_DMA_REG
// Parameter Type: Feature Setting
// 
// Indicates the offset BAR address to allocate the UNROLL DMA configuration registers into memory space.
`define UNROLL_DMA_OFFSET_BAR 64'h0


// Name:           UNROLL_ATU_OFFSET_BAR
// Default:        0x0 (UNROLL_DMA_OFFSET_BAR + UNROLL_DMA_SIZE)
// Values:         0x0, ..., 0xffffffffffffffff
// Enabled:        ENABLE_MEM_MAP_UNROLL_ATU_REG==1
// Parameter Type: Feature Setting
// 
// Indicates the offset BAR address to allocate the UNROLL ATU configuration registers into memory space.
`define UNROLL_ATU_OFFSET_BAR 64'h0


// Name:         UNROLL_DMA_OFFSET_BAR_LOW
// Default:      0 (UNROLL_DMA_OFFSET_BAR & 0x00000000ffffffff)
// Values:       -2147483648, ..., 2147483647
// Enabled:      ENABLE_MEM_MAP_UNROLL_DMA_REG
// 
// Indicates the 32 LSB of the offset BAR address to allocate the UNROLL DMA configuration registers into memory space.
`define UNROLL_DMA_OFFSET_BAR_LOW 0


// Name:         UNROLL_DMA_OFFSET_BAR_HIGH
// Default:      0 (UNROLL_DMA_OFFSET_BAR >> 32)
// Values:       -2147483648, ..., 2147483647
// Enabled:      ENABLE_MEM_MAP_UNROLL_DMA_REG
// 
// Indicates the 32 MSB of the offset BAR address to allocate the UNROLL DMA configuration registers into memory space.
`define UNROLL_DMA_OFFSET_BAR_HIGH 0
//-/ =================================================================
//-/ End Unroll
//-/ =================================================================



// Name:         CX_RC_FUNC_NUM
// Default:      0
// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_DEVICE_TYPE==CC_RC || CC_DEVICE_TYPE==CC_DM
// 
// Function Number to use for RC 
// function number to use in inbound (RX) direction in RC mode 
// This parameter changes the function number of received requests on the 
// target interface to the set value in an RC. For transmission of 
// PM_ACTIVE_STATE_NAK, PME_TURN_OFF, UNLOCK and SET_SLOT_PWR_LIMIT messages 
// the set value is used.
`define CX_RC_FUNC_NUM 0


`define CX_MAX_MTU_PW 9


// Name:           ENABLE_OPTIONAL_CHECKS
// Default:        true (CX_GEN6_SPEED)
// Values:         false (0), true (1)
// Parameter Type: Feature Setting
// 
// Adds optional protocol checks including byte enable and flow control. Violations of the byte enable check (Section 2.2.5 
// of the PCIe Specification) and the address/length check (Section 2.2.7 of the PCIe Specification) is treated as malformed 
// TLPs. Also, violations of the various flow control checks results in a Flow Control Protocol Error (FCPE). Flow control 
// checks are described in Section 2.6.1 of the PCIe Specification.
`define ENABLE_OPTIONAL_CHECKS


// Name:           SURPRISE_LINK_DOWN_SUPPORTED
// Default:        false
// Values:         false (0), true (1)
// Enabled:        CC_DEVICE_TYPE!=CC_EP
// Parameter Type: Feature Setting
// 
// Adds optional protocol check capability for Surprise Down Error Reporting. Downstream Ports that are Surprise Down Error 
// Reporting Capable (Section 7.8.6 of the PCIe Specification) must treat this transition from DL_Active to DL_Inactive as a 
// Surprise Down error, except in the cases presented in (Section 3.2.1 of the PCIe Specification) where this error 
// detection is blocked.
`define SURPRISE_LINK_DOWN_SUPPORTED


`define DEFAULT_SURPRISE_DOWN_RPT_CAP 1'h1


// Name:           FC_SCALE_EN
// Default:        true (CX_GEN4_SPEED || CX_MULTISTREAM_ARCH)
// Values:         false (0), true (1)
// Enabled:        !CX_GEN4_SPEED && !CX_MULTISTREAM_ARCH
// Parameter Type: Feature Setting
// 
// Link performance can be affected when there are insufficient flow control credits available to account for the Link 
// round trip time. This effect becomes more noticeable at higher Link speeds and the limitation of 127 header credits and 2047 
// data credits can limit performance. The Scaled Flow Control mechanism is designed to address this limitation. Scaled Flow 
// control is described in Section 3.4.2 of the PCIe Specification 4.0.
`define FC_SCALE_EN


`define SCALED_FC_SUPPORTED 1'h1


// Name:           DL_FEATURE_EN
// Default:        true (CX_GEN4_SPEED || FC_SCALE_EN)
// Values:         false (0), true (1)
// Enabled:        0
// Parameter Type: Feature Setting
// 
// The Data Link Feature Capability is an optional Extended Capability that is required for Downstream Ports that support 
// 16.0 GTs. It is optional in other Downstream Ports. It is optional in Functions associated with an Upstream Port. It is not 
// applicable in Functions that are not associated with a Port (For example, Root Complex Integrated Endpoints, Root Complex 
// Event Collectors). Ports that implement this protocol contain the Data Link Feature Extended Capability as described in 
// Section 7.37 of the PCIe Specification 4.0.
`define DL_FEATURE_EN


`define DL_FEATURE_SUPPORTED 1'h1


`define DL_FEATURE_OR_EDPC_SUPPORT


// Name:           DL_FEATURE_EXCHANGE_ENABLE
// Default:        0x1 (DL_FEATURE_EN)
// Values:         0x0, 0x1
// Enabled:        DL_FEATURE_EN
// Parameter Type: Register Default Setting
// 
// Default value for the Data Link Feature Exchange Enable field in the 'Data Link Feature Capabilities Register'. When 
// clear, the device will not enter the Data Link Feature negotiation state.
`define DL_FEATURE_EXCHANGE_ENABLE 1'h1


// Name:           CX_RBUF_AUTOSIZE
// Default:        true
// Values:         false (0x0), true (0x1)
// Parameter Type: Feature Setting
// 
// Enable or disable automatic size calculation for the retry buffer.: 
//  - True: Enable Auto Size: The sizes of the retry buffer and SOT buffer are automatically calculated based on the 
//  "Maximum Payload Size Supported value", the link width, and device latencies. 
//  - False: Disable Auto Size: Automatic buffer sizing is disabled. The value that you enter for Retry Buffer Depth 
//  (CX_RBUF_DEPTH) directly sets the depth of the retry buffer.
`define CX_RBUF_AUTOSIZE 1'h1


// Name:           CX_NPRFX
// Default:        0
// Values:         0 1 2 3 4 5 6 7
// Parameter Type: Feature Setting.
// 
// The number of TLP Prefixes that the controller supports. When CX_NPRFX is greater than zero, then each function in the 
// PCIe controller supports the extended FMT field in TLP prefixes and headers. 
// When CX_NPRFX is zero, then the extended FMT field is not supported. 
// The controller does not support TLP prefixes for the DMA module. 
// Range: 0-8 (excluding 1,2,3 as a switch support that supports prefixes must support up to four End-End TLP Prefixes).
`define CX_NPRFX 3


