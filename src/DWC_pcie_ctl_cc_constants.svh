//  - 1 : Scaling Factor is 256 (1ms is 4us) 
//  - 2 : Scaling Factor is 64 (1ms is 16us) 
//  - 3 : Scaling Factor is 16 (1ms is 64us)
`define DEFAULT_FAST_LINK_SCALING_FACTOR 2'h2


