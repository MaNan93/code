// Parameter Type: Feature Setting
// 
// Include ECRC stripping hardware. If enabled, the controller strips ECRC from all incoming packets. The controller always 
// strips the ECRC when you have selected the AXI bridge module, or when DMA controller is selected. The controller never 
// strips the ECRC when you enable CX_P2P_ENABLE.
`define CX_ECRC_STRIP_ENABLE


// Name:         CX_ECRC_STRIP_ENABLE_AND_PCRC_MAC_STRIP_ENABLE
// Default:      1 ((CX_ECRC_STRIP_ENABLE==1) && (CX_IDE_FLOWTHROUGH==0))
// Values:       0, 1
// 
// If the controller strips both the ECRC and the MAC. 
// This parameter controls how the radm_outq_mgr restore credits to rtlh
`define CX_ECRC_STRIP_ENABLE_AND_PCRC_MAC_STRIP_ENABLE


// Name:         ECRC_CHK_STRIP_DISABLE
// Default:      0 ((CX_ECRC_ENABLE==0) && (CX_ECRC_STRIP_ENABLE==0))
// Values:       0, 1
// Enabled:      0
// 
// If both ECRC checking (CX_ECRC_ENABLE) and stripping are not defined then this will be defined
// `define ECRC_CHK_STRIP_DISABLE


