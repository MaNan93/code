// Name:         CX_PHY_RX_DELAY_SERDES_PIPE_HALFFULL
// Default:      46 (!CX_PIPE_SERDES_ARCH) ? 0 : ([<functionof> 
//               CX_PHY_RX_DELAY_SERDES_PIPE_HALFFULL_GEN1 CX_PHY_RX_DELAY_SERDES_PIPE_HALFFULL_GEN2 
