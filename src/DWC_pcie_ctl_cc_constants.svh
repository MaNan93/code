// Values:         1 Cycle (1), 2 Cycles (2), 3 Cycles (3), 4 Cycles (4)
// Enabled:        SLAVE_POPULATED && AXI_POPULATED
// Parameter Type: Performance Setting
// 
// Specifies the AXI Slave Non-Posted Write Set-Aside Buffer read cycle latency. The controller samples the read data 
// CC_SLV_NPW_SAB_RAM_RD_LATENCY clock cycles after the read address is valid. The default of '1' corresponds to the typical read 
// cycle access time for synchronous memories.
`define CC_SLV_NPW_SAB_RAM_RD_LATENCY 1


// Name:         CC_SLV_WRP_RSP_ROB_FIFO_DP
// Default:      16
// Values:       -2147483648, ..., 2147483647
// Enabled:      AXI_POPULATED && CC_SLV_WRAP_ENABLE
// 
// Slave Wrap Response Re-order Buffer Depth
`define CC_SLV_WRP_RSP_ROB_FIFO_DP 16


// Name:         CC_SLV_WRP_RSP_ROB_FIFO_ADDR_WD
// Default:      4 ([<functionof> CC_SLV_WRP_RSP_ROB_FIFO_DP])
// Values:       -2147483648, ..., 2147483647
// Enabled:      AXI_POPULATED && CC_SLV_WRAP_ENABLE
// 
// Slave Wrap Response Re-order Buffer Address Width
`define CC_SLV_WRP_RSP_ROB_FIFO_ADDR_WD 4


// Name:         CC_SLV_WRP_RSP_HDB_DP
// Default:      8
// Values:       1, ..., 16
// Enabled:      AXI_POPULATED && CC_SLV_WRAP_ENABLE
// 
// Slave Wrap Response Header Buffer Depth
`define CC_SLV_WRP_RSP_HDB_DP 8


// Name:         CC_SLV_WRP_RSP_HDB_ADDR_WD
// Default:      3 ([<functionof> CC_SLV_WRP_RSP_HDB_DP])
// Values:       -2147483648, ..., 2147483647
// Enabled:      AXI_POPULATED && CC_SLV_WRAP_ENABLE
// 
// Slave Wrap Response Header Buffer Address Width
`define CC_SLV_WRP_RSP_HDB_ADDR_WD 3


// Name:         CC_SLV_WRP_RSP_NUM_OUTSTD_WD
// Default:      4 ([<functionof> [<functionof> CC_SLV_WRP_RSP_HDB_DP+2]])
// Values:       -2147483648, ..., 2147483647
// Enabled:      AXI_POPULATED && CC_SLV_WRAP_ENABLE
// 
// Counter width of the maximum outstanding transactions allowed in the slave wrap response buffers
`define CC_SLV_WRP_RSP_NUM_OUTSTD_WD 4


// Name:         CC_NPRSPF_TLP_DATA_WIDTH
// Default:      576 (CC_SLV_DATA_WD_LT_CORE_DATA_WD ? CC_CORE_DATA_BUS_WD : 
//               CC_SLV_BUS_DATA_WIDTH)
// Values:       -2147483648, ..., 2147483647
// 
// Outbound Completion TLP Formation Data Width 
//  Note: per byte parity bits included
`define CC_NPRSPF_TLP_DATA_WIDTH 576



// Name:         CC_NPRSPF_TLP_DATA_WIDTH_NP
// Default:      512 (CC_SLV_DATA_WD_LT_CORE_DATA_WD ? PCIE_CORE_DATA_BUS_WD : 
//               SLAVE_BUS_DATA_WIDTH)
// Values:       -2147483648, ..., 2147483647
// 
// Outbound Completion TLP Formation Data Width Without Parity Bits 
//  Note: per byte parity bits included
`define CC_NPRSPF_TLP_DATA_WIDTH_NP 512


// Name:         CC_NPRSPF_TLP_NUM_STRBS
// Default:      64 (CC_SLV_DATA_WD_LT_CORE_DATA_WD ? CC_CORE_DATA_BUS_WSTRB_WD : 
//               CC_SLV_BUS_WSTRB_WIDTH)
// Values:       -2147483648, ..., 2147483647
// 
// Number of byte lanes per Outbound Completion TLP Formation Data Beat
`define CC_NPRSPF_TLP_NUM_STRBS 64


// Name:         CC_NPRSPF_TLP_NUM_DWORDS
// Default:      16 (CC_SLV_DATA_WD_LT_CORE_DATA_WD ? CX_NW : CC_SLV_NW)
// Values:       -2147483648, ..., 2147483647
// 
// Number of DWORDS per Outbound Completion TLP Formation Data Beat
`define CC_NPRSPF_TLP_NUM_DWORDS 16


`define CC_SLV_RD_REQ_SIZE_GT_NPRSPF_TLP_SIZE


// Name:           CX_AXI_MSTR_RD_RSP_INTERLEAVING_EN
// Default:        1
// Values:         0, 1
// Enabled:        ((AMBA_INTERFACE==2) || (AMBA_INTERFACE==3) || (AMBA_INTERFACE==4))
// Parameter Type: Feature Setting
// 
// Enable support for interleaved read responses on the AXI Master
`define CX_AXI_MSTR_RD_RSP_INTERLEAVING_EN





// =============================================================================
// Distributed Translation Interface Master
// =============================================================================


// Name:           CC_DTIM_VERSION
// Default:        DTI-ATSv1 ((CC_RP_TDISP && CC_DTIM_ENABLE) ? 2 : 0)
// Values:         DTI-ATSv1 (0), DTI-ATSv2 (1), DTI-ATSv3 (2)
// Enabled:        CC_DTIM_ENABLE
// Parameter Type: Feature Setting
// 
// The version of DTI-ATS protocol specification.
`define CC_DTIM_VERSION 0


// `define CC_DTIM_ATS_V2_ENABLE


// `define CC_DTIM_ATS_V3_ENABLE


// Name:           CC_ROOT_PORT_ID
// Default:        0xffff
// Values:         0x0, ..., 0xffff
// Enabled:        CC_DTIM_ENABLE || CC_LTIM_ENABLE
// Parameter Type: Feature Setting
// 
// The Root Port ID determines the upper 16-bits of the PCIe DTIM/LTIM Stream ID (SID).
`define CC_ROOT_PORT_ID 16'hffff


// Name:         CC_DTIM_STREAM_ID_UPPER
// Default:      0xffff (CC_ROOT_PORT_ID)
// Values:       0x0, ..., 0xffff
// 
// Sets the upper 16 bits of the Root Ports Stream ID
`define CC_DTIM_STREAM_ID_UPPER 16'hffff


// Name:         CC_DTIM_DATA_WD
// Default:      160
// Values:       -2147483648, ..., 2147483647
// 
// DTI Master Data Width, no protection.
`define CC_DTIM_DATA_WD 160


// Name:         CC_DTIM_NUM_BYTES_PER_BEAT
// Default:      20 ((160)/8)
// Values:       -2147483648, ..., 2147483647
// 
// DTI Number of Byte Enables
`define CC_DTIM_NUM_BYTES_PER_BEAT 20


// Name:         CC_DTIM_RAW_INTF_WD
// Default:      181 (CC_DTIM_DATA_WD + CC_DTIM_NUM_BYTES_PER_BEAT + 1)
// Values:       -2147483648, ..., 2147483647
// 
// DTIM AXI4 Stream Slave Raw Interface Width 
// {tdata, tkeep, tlast}
`define CC_DTIM_RAW_INTF_WD 181


// Name:         CC_DTIM_INTF_WD
// Default:      204 (CX_RASDP_EN==1 ? [<functionof> CC_DTIM_RAW_INTF_WD 
//               CX_RAS_PROT_RANGE] + CC_DTIM_RAW_INTF_WD : CC_DTIM_RAW_INTF_WD)
// Values:       -2147483648, ..., 2147483647
// 
// DTIM AXI4 Stream Slave Interface Width 
// Includes the width of the protection bits when data protection is enabled.
`define CC_DTIM_INTF_WD 204


// Name:         CC_DTIM_INTF_PROT_WD
// Default:      23 (CX_RAS_EN==1 ? CC_DTIM_INTF_WD - CC_DTIM_RAW_INTF_WD : 0)
// Values:       -2147483648, ..., 2147483647
// 
// DTIM AXI4 Stream Slave Interface Protection Width
`define CC_DTIM_INTF_PROT_WD 23


// Name:           CC_DTIM_NUM_TRANS_TOKENS_REQUESTED
// Default:        32
// Values:         1, ..., 256
// Enabled:        CC_DTIM_ENABLE
// Parameter Type: Feature Setting
// 
// This parameter indicates the maximum number of translation request tokens requested by the 
// DTI Master, i.e. the maximum number of DTI-ATS translation requests outstanding at any point in time. 
// It is used to flow control the number of outstanding translation requests sent by the DTI Master AXI4-Stream Master.
`define CC_DTIM_NUM_TRANS_TOKENS_REQUESTED 32


// Name:           CC_DTIM_NUM_INV_TOKENS_GRANTED
// Default:        16
// Values:         4 8 16
// Enabled:        CC_DTIM_ENABLE
// Parameter Type: Feature Setting
// 
// This parameter indicates the maximum number of invalidate request tokens granted by the 
//  DTI Master, i.e. the maximum number of DTI-ATS invalidate requests outstanding at any point in time. 
//  It is used to determine the depth of the DTI Master AXI4-Stream Slave Request queue.
`define CC_DTIM_NUM_INV_TOKENS_GRANTED 16


// Name:         CC_DTIM_AXI4SS_REQ_Q_RAM_DP
// Default:      16 (CC_DTIM_NUM_INV_TOKENS_GRANTED)
// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_DTIM_ENABLE
// 
// DTIM AXI4-Stream Slave Request Queue Depth
`define CC_DTIM_AXI4SS_REQ_Q_RAM_DP 16


// Name:         CC_DTIM_AXI4SS_REQ_Q_RAM_ADDR_WD
// Default:      4 ([<functionof> CC_DTIM_AXI4SS_REQ_Q_RAM_DP])
// Values:       -2147483648, ..., 2147483647
// 
// DTIM AXI4-Stream Slave Request Queue Address Width
`define CC_DTIM_AXI4SS_REQ_Q_RAM_ADDR_WD 4


// Name:         CC_DTIM_AXI4SS_REQ_Q_RAM_ADDR_WD_AUX
// Default:      4 (CX_MULTISTREAM_ARCH==1 ? CC_DTIM_AXI4SS_REQ_Q_RAM_ADDR_WD : 0)
// Values:       -2147483648, ..., 2147483647
// 
// DTIM AXI4-Stream Slave Request Queue Address Width
`define CC_DTIM_AXI4SS_REQ_Q_RAM_ADDR_WD_AUX 4


// Name:           CC_DTIM_PCIE_MAX_NUM_INV_REQ
// Default:        32
// Values:         16 32 64 128 256
// Enabled:        CC_DTIM_ENABLE
// Parameter Type: Feature Setting
// 
// The maximum number of outstanding PCIe invalidate requests that can be sent on the wire. 
// The theoretical maximum is 32 requests per BDF.
`define CC_DTIM_PCIE_MAX_NUM_INV_REQ 32


// Name:         CC_DTIM_PCIE_MAX_NUM_PAGE_REQ
// Default:      8
// Values:       4 8 16
// Enabled:      CC_DTIM_ENABLE
// 
// The maximum number of outstanding PCIe Page Requests accepted by the DTIM AXI4-Stream 
// Master before blocking the PCIe AXI4 Master Write Channel. 
// This parameter determines the size of the DTIM Page Request Latency Buffer.
`define CC_DTIM_PCIE_MAX_NUM_PAGE_REQ 8


// Name:         CC_DTIM_PCIE_MAX_NUM_TRANS_REQ
// Default:      16
// Values:       8 16 32 64
// Enabled:      CC_DTIM_ENABLE
// 
// The maximum number of outstanding PCIe Translation Requests accepted by the DTIM AXI4-Stream Master before blocking the 
// PCIe AXI4 Master Read Channel. 
// This parameter determines the size of the DTIM Translation Request Latency Buffer.
`define CC_DTIM_PCIE_MAX_NUM_TRANS_REQ 16


// Name:         CC_DTIM_PCIE_MAX_NUM_INV_CPL
// Default:      8
// Values:       4 8 16
// Enabled:      CC_DTIM_ENABLE
// 
// The maximum number of outstanding PCIe Invalidate Completions accepted by the DTIM AXI4-Stream Slave before blocking the 
// PCIe AXI4 Master Write Channel. 
// This parameter determines the size of the DTIM Invalidate Completion Latency Buffer.
`define CC_DTIM_PCIE_MAX_NUM_INV_CPL 8


`define CC_DTIM_PCIE_MAX_NUM_INV_CPL_LOG2 3


// Name:         CC_DTIM_AXI4SS_REQ_Q_RAW_DATA_WD
// Default:      105 (105 +(CC_DTIM_VERSION > 1)*(22))
// Values:       -2147483648, ..., 2147483647
// 
// DTIM AXI4-Stream Slave Request Queue Raw Data Width 
// Includes the Invalidate and Sync request message flags plus all the fields of the respective DTI messages. 
// The upper 16 bits of the Stream ID are excluded. 
// Field widths are defined in the include file "amba_defs.vh". 
// Data width = DTI_ATS_INV_REQ_OPERTN_WD + DTI_ATS_SSID_WD + DTI_ATS_SID_LWR_WD + + DTI_ATS_SID_UPR_WD (DTI-ATSv3) + 
// DTI_ATS_INV_REQ_RANGE_WD + DTI_ATS_INV_REQ_T_WD (T bit, DTI-ATSv3) + DTI_ATS_INV_REQ_ITAG_WD (ITAG, DTI-ATSv3) + 
// DTI_ATS_INV_REQ_VA_WD + 3 (Invalidate and Sync Request flags)
`define CC_DTIM_AXI4SS_REQ_Q_RAW_DATA_WD 105


// Name:         CC_DTIM_AXI4SS_REQ_Q_DATA_WD
// Default:      119 (CX_RASDP_EN==1 ? [<functionof> 
//               CC_DTIM_AXI4SS_REQ_Q_RAW_DATA_WD CX_RAS_PROT_RANGE] + CC_DTIM_AXI4SS_REQ_Q_RAW_DATA_WD : 
//               CC_DTIM_AXI4SS_REQ_Q_RAW_DATA_WD)
// Values:       -2147483648, ..., 2147483647
// 
// DTIM AXI4-Stream Slave Request Queue Data Width 
// Includes the width of the protection bits when data protection is enabled.
`define CC_DTIM_AXI4SS_REQ_Q_DATA_WD 119


// Name:         CC_DTIM_AXI4SS_REQ_Q_RAM_DATA_WD
// Default:      120 (CX_RASDP_RAM_PROT==1 ? [<functionof> 
//               CC_DTIM_AXI4SS_REQ_Q_RAM_ADDR_WD_AUX CC_DTIM_AXI4SS_REQ_Q_RAW_DATA_WD CX_RAS_RAM_PROT_RANGE] + 
//               CC_DTIM_AXI4SS_REQ_Q_RAW_DATA_WD : CC_DTIM_AXI4SS_REQ_Q_RAW_DATA_WD 
//               )
// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_DTIM_ENABLE
// 
// DTI Master AXI4-Stream Slave Request Queue RAM Data Width
`define CC_DTIM_AXI4SS_REQ_Q_RAM_DATA_WD 120


// Name:         CC_DTIM_AXI4SS_REQ_Q_RAM_PROT_WD
// Default:      15 (CX_RASDP_RAM_PROT==1 ? CC_DTIM_AXI4SS_REQ_Q_RAM_DATA_WD - 
//               CC_DTIM_AXI4SS_REQ_Q_RAW_DATA_WD : 0)
// Values:       -2147483648, ..., 2147483647
// 
// DTI Master AXI4-Stream Slave Request Queue Protection Width
`define CC_DTIM_AXI4SS_REQ_Q_RAM_PROT_WD 15


// Name:         CC_DTIM_IREQ_RAW_T_DATA_WD
// Default:      102 ((105 +CC_DTIM_ATS_V3_ENABLE*(22))-3)
// Values:       -2147483648, ..., 2147483647
// 
// DTIM AXI4-Stream Slave Invalidate Request Raw Data Width
`define CC_DTIM_IREQ_RAW_T_DATA_WD 102


// Name:         CC_DTIM_IREQ_T_DATA_WD
// Default:      115 (CX_RASDP_EN==1 ? [<functionof> CC_DTIM_IREQ_RAW_T_DATA_WD 
//               CX_RAS_PROT_RANGE] + CC_DTIM_IREQ_RAW_T_DATA_WD : 
//               CC_DTIM_IREQ_RAW_T_DATA_WD)
// Values:       -2147483648, ..., 2147483647
// 
// DTIM AXI4-Stream Slave Invalidate Request Data Width 
// Includes the width of the protection bits when data protection is enabled.
`define CC_DTIM_IREQ_T_DATA_WD 115


// Name:         CC_DTIM_IREQ_T_DATA_PROT_WD
// Default:      13 (CX_RASDP_EN==1 ? CC_DTIM_IREQ_T_DATA_WD - 
//               CC_DTIM_IREQ_RAW_T_DATA_WD : 0)
// Values:       -2147483648, ..., 2147483647
// 
// DTIM AXI4-Stream Slave Request Queue Protection Width
`define CC_DTIM_IREQ_T_DATA_PROT_WD 13



// Name:         CC_DTIM_AXI4SS_REQ_Q_RAM_ADDRP_WD
// Default:      1 (CX_RASDP_RAM_PROT==1 ? [<functionof> 
//               CC_DTIM_AXI4SS_REQ_Q_RAM_ADDR_WD CX_RAS_RAM_PROT_RANGE] : 0)
// Values:       -2147483648, ..., 2147483647
// 
// DTIM AXI4-Stream Slave Request Queue address parity protection width. 
// Address parity enabled when RAM ECC proteciton is enabled. 
// Address Protection block size equal to RAM data protection block size.
`define CC_DTIM_AXI4SS_REQ_Q_RAM_ADDRP_WD 1


// Name:         CC_DTIM_AXI4SS_REQ_Q_RAM_WPAR_ADDR_WD
// Default:      5 (CC_DTIM_AXI4SS_REQ_Q_RAM_ADDR_WD + 
//               CC_DTIM_AXI4SS_REQ_Q_RAM_ADDRP_WD)
// Values:       -2147483648, ..., 2147483647
// 
// DTIM AXI4-Stream Slave Request Queue With Parity Address Width
`define CC_DTIM_AXI4SS_REQ_Q_RAM_WPAR_ADDR_WD 5


// Name:         CC_DTIM_FORM_ATS_P_RAW_INTF_WD
// Default:      201 (SLAVE_BUS_ADDR_WIDTH +CC_AXI_BURST_SIZE_WD 
