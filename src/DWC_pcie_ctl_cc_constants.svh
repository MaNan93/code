// Name:         CX_CHI_CXL_ERR_ISO_EN
// Default:      0 (CX_CXL_CHI_ENABLE && CX_CXL_ERR_ISO_EN)
// Values:       0, 1
// 
// Enable CXL Error Isolation support with Native interface
// `define CX_CHI_CXL_ERR_ISO_EN

// =============================================================================
// CXL IDE Parameter
// =============================================================================


// Name:           CX_CXL_IDE_ENABLE
// Default:        false
// Values:         false (0), true (1)
// Enabled:        CX_CXL_2_0_ENABLE
// Parameter Type: Feature Setting
// 
// Enable IDE Support for CXL Controller
// `define CX_CXL_IDE_ENABLE


// Name:           CX_CXL_IDE_SKID_ENABLE
// Default:        false (CX_CXL_IDE_ENABLE)
// Values:         false (0), true (1)
// Enabled:        CX_CXL_IDE_ENABLE
// Parameter Type: Feature Setting
// 
// Enable CXL IDE Skid Mode
// `define CX_CXL_IDE_SKID_ENABLE


// Name:           CX_CXL_IDE_CONT_ENABLE
// Default:        false (CX_CXL_IDE_ENABLE)
// Values:         false (0), true (1)
// Enabled:        CX_CXL_IDE_ENABLE
// Parameter Type: Feature Setting
// 
// Enable CXL IDE Containment Mode
// `define CX_CXL_IDE_CONT_ENABLE


// Name:           CX_CXL_IDE_RX_CONT_BUFF
// Default:        CXL IDE Core
// Values:         CXL IDE Core (0), CXL Controller (1)
// Enabled:        CX_CXL_IDE_CONT_ENABLE
// Parameter Type: Feature Setting
// 
// Reuse CXL RX Buffers as IDE Containment Buffer
// `define CX_CXL_IDE_RX_CONT_BUFF


// Name:           CX_CXL_IDE_RX_FLIT_PRED_LATENCY
// Default:        1
// Values:         1, ..., 3
// Enabled:        CX_CXL_IDE_ENABLE
// Parameter Type: Feature Setting
// 
// CXL IDE Core Flit Predictor Latency
`define CX_CXL_IDE_RX_FLIT_PRED_LATENCY 1


// Name:           CX_CXL_IDE_TX_FLIT_LATENCY
// Default:        1
// Values:         1, ..., 3
// Enabled:        CX_CXL_IDE_ENABLE
// Parameter Type: Feature Setting
// 
// CXL IDE Core Transmitter Latency
`define CX_CXL_IDE_TX_FLIT_LATENCY 1


// Name:         CX_CXL_IDE_MODEL_ENABLE
// Default:      0 (CX_CXL_IDE_ENABLE && !CX_IDE_ENABLE)
// Values:       0, 1
// Enabled:      CX_CXL_IDE_ENABLE && !CX_IDE_ENABLE
// 
// Enable CXL IDE Model for verification purpose
// `define CX_CXL_IDE_MODEL_ENABLE


// Name:         CX_CXL_IDE_MS_RAS_EN
// Default:      0 (CX_MS_RAS_EN && CX_CXL_IDE_ENABLE)
// Values:       0, 1
// 
// Indicates CXL RAS IDE protection is enabled for multi-stream architecture
// `define CX_CXL_IDE_MS_RAS_EN


// Name:         CX_CXL_IDE_NMS_RAS_EN
// Default:      0 (CX_NMS_RAS_EN && CX_CXL_IDE_ENABLE)
// Values:       0, 1
// 
// Indicates CXL RAS IDE protection is enabled for non multi-stream architecture
// `define CX_CXL_IDE_NMS_RAS_EN


// Name:         CX_CXL_IDE_DP_ENABLE
// Default:      0 (CX_CXL_IDE_MS_RAS_EN || CX_CXL_IDE_NMS_RAS_EN)
// Values:       0, 1
// 
// Enable CXL IDE Datapath Protection
// `define CX_CXL_IDE_DP_ENABLE


// Name:         CX_CXL_IDE_DP_CHK_SIZE
// Default:      64 
//               ((CX_CXL_DW/CX_CXL_PROTECTION_RANGE)*CX_CXL_PROTECTION_RANGE_WIDTH)
// Values:       -2147483648, ..., 2147483647
// 
// Enable CXL IDE Data check size
`define CX_CXL_IDE_DP_CHK_SIZE 64


// Name:         CX_CXL_IDE_DATA_WIDTH
// Default:      576 (CX_RASDP_EN ? (CX_CXL_DW + CX_CXL_IDE_DP_CHK_SIZE) : 
//               CX_CXL_DW)
// Values:       -2147483648, ..., 2147483647
// 
// Enable CXL IDE Datapath Width
`define CX_CXL_IDE_DATA_WIDTH 576


// `define CX_ANY_IDE_ENABLE


// Name:         CX_CXL_IDE_EINJ_ENABLE
// Default:      0 (CX_CXL_IDE_ENABLE && (CX_CXL_IDE_MS_RAS_EN || 
//               !CX_CXL_CXS_ENABLE))
// Values:       0, 1
// 
// Enable CXL IDE Error Injection
// `define CX_CXL_IDE_EINJ_ENABLE


// Name:         CX_RPLH_CXL_TOKEN_SER_ENABLE
// Default:      0 ((CX_CXL_20_NW > CX_NW) && CX_CXL_ENABLE)
// Values:       0, 1
// 
// Enable RPLH Token Serializer
// `define CX_RPLH_CXL_TOKEN_SER_ENABLE


// Name:         CX_RPLH_CXL_TOKEN_FINDER4
// Default:      1 (CX_RPLH_CXL_TOKEN_SER_ENABLE || (CX_CXL_256B_FLIT_ENABLE && 
//               (CX_NB > CX_NB_GEN5)))
// Values:       0, 1
// 
// Enable decicated RPLH Token Finder4 for CXL
`define CX_RPLH_CXL_TOKEN_FINDER4


// Name:         CX_XPLH_CXL_FLIT_SER_ENABLE
// Default:      0 ((CX_CXL_20_NW > CX_NW) && CX_CXL_ENABLE)
// Values:       0, 1
// 
// Enable XPLH CXL ARB/MUX Serializer
// `define CX_XPLH_CXL_FLIT_SER_ENABLE


// Name:         CX_FLIT_CORE_WIDTH_RATIO
// Default:      4 ((CX_FLIT_MODE_ENABLE ? 64 : (CX_CXL_ENABLE ? 16 : CX_NW)) / 
//               CX_NW)
// Values:       -2147483648, ..., 2147483647
// 
// PCIe/CXL Flit Core Data Width Ratio
`define CX_FLIT_CORE_WIDTH_RATIO 4


// Name:         CX_FLIT_EQUAL_CORE_WIDTH
// Default:      0 (((CX_FLIT_MODE_ENABLE ? 64 : (CX_CXL_ENABLE ? 16 : CX_NW)) / 
//               CX_NW) == 1)
// Values:       0, 1
// 
// PCIe/CXL Flit Equals Core Data Width
// `define CX_FLIT_EQUAL_CORE_WIDTH


// Name:         CX_CXL_FLIT_CORE_WIDTH_RATIO
// Default:      4 ((CX_CXL_256B_FLIT_ENABLE ? 64 : 16) / CX_NW)
// Values:       -2147483648, ..., 2147483647
// 
// Enable CXL Flit Core Data Width Ratio
`define CX_CXL_FLIT_CORE_WIDTH_RATIO 4


// Name:         CX_CXL_FLIT_EQUAL_CORE_WIDTH
// Default:      0 (((CX_CXL_256B_FLIT_ENABLE ? 64 : 16) / CX_NW) == 1)
// Values:       0, 1
// 
// Enable CXL Flit Equals Core Data Width
// `define CX_CXL_FLIT_EQUAL_CORE_WIDTH


// Name:         CX_CXL_SYNC_HEADER_REQUIRED
// Default:      0 (CX_SYNC_HEADER_BYPASS_SUPPORT && (CX_CXL_NW > CX_NW) && 
//               CX_CXL_ENABLE)
// Values:       0, 1
// 
// Inidcates that Sync Header Bypass is required for the given configuration
// `define CX_CXL_SYNC_HEADER_REQUIRED


// Name:         CX_ARBMUX_68B_DATA_WIDTH
// Default:      512
// Values:       -2147483648, ..., 2147483647
// 
// ARB/MUX Interface Flit Data Width for 68B Flit Format
`define CX_ARBMUX_68B_DATA_WIDTH 512


// Name:         CX_ARBMUX_256B_DATA_WIDTH
// Default:      512 ((CX_CXL_DW > 512) ? CX_CXL_DW : 512)
// Values:       -2147483648, ..., 2147483647
// 
// ARB/MUX Interface Flit Data Width for 68B Flit Format
`define CX_ARBMUX_256B_DATA_WIDTH 512


// Name:         CX_ARBMUX_DATA_WIDTH
// Default:      512 ((CX_CXL_256B_FLIT_ENABLE && 
//               (CX_ARBMUX_256B_DATA_WIDTH>CX_ARBMUX_68B_DATA_WIDTH)) ? CX_ARBMUX_256B_DATA_WIDTH : 
//               CX_ARBMUX_68B_DATA_WIDTH)
// Values:       -2147483648, ..., 2147483647
// 
// ARB/MUX Interface Flit Data Width
`define CX_ARBMUX_DATA_WIDTH 512


// Name:         CX_ARBMUX_68B_FLIT_WIDTH
// Default:      528 ((512) + 16)
// Values:       -2147483648, ..., 2147483647
// 
// ARB/MUX Flit Interface Width for 68B Flit Format
`define CX_ARBMUX_68B_FLIT_WIDTH 528


// Name:         CX_ARBMUX_256B_FLIT_WIDTH
// Default:      512 (((CX_CXL_DW > 512) ? CX_CXL_DW : 512))
// Values:       -2147483648, ..., 2147483647
// 
// ARB/MUX Flit Interface Width for 68B Flit Format
`define CX_ARBMUX_256B_FLIT_WIDTH 512


// Name:         CX_ARBMUX_FLIT_WIDTH
// Default:      528 (CX_CXL_256B_FLIT_ENABLE && 
//               (CX_ARBMUX_256B_FLIT_WIDTH>CX_ARBMUX_68B_FLIT_WIDTH) ? CX_ARBMUX_256B_FLIT_WIDTH : 
//               CX_ARBMUX_68B_FLIT_WIDTH)
// Values:       -2147483648, ..., 2147483647
// 
// ARB/MUX Input Flit Interface Width from the Controller/vLSM/IO
`define CX_ARBMUX_FLIT_WIDTH 528


// Name:         CX_ARBMUX_FLIT_PROT_WIDTH
// Default:      64 ( (CX_CXL_256B_FLIT_ENABLE && (CX_RASDP > 0)) ? 
//               (CX_ARBMUX_DATA_WIDTH/CX_RAS_PROT_RANGE) : 0 )
// Values:       -2147483648, ..., 2147483647
// 
// ARB/MUX Input Flit Interface Prot Width with Prot from the Controller/vLSM/IO
`define CX_ARBMUX_FLIT_PROT_WIDTH 64


// Name:         CX_ARBMUX_FLIT_IF_WIDTH
// Default:      592 ( (CX_CXL_256B_FLIT_ENABLE && (CX_RASDP > 0)) ? 
//               (CX_ARBMUX_FLIT_WIDTH + CX_ARBMUX_FLIT_PROT_WIDTH) : CX_ARBMUX_FLIT_WIDTH)
// Values:       -2147483648, ..., 2147483647
// 
// ARB/MUX Input Flit Interface Width with Prot from the Controller/vLSM/IO
`define CX_ARBMUX_FLIT_IF_WIDTH 592


// Name:         CX_ARBMUX_68B_XPLH_WIDTH
// Default:      528 (CX_NW*32+16)
// Values:       -2147483648, ..., 2147483647
// 
// ARB/MUX XPLH Interface Width for 68B Flit Format
`define CX_ARBMUX_68B_XPLH_WIDTH 528


// Name:         CX_ARBMUX_256B_XPLH_WIDTH
// Default:      512 (CX_NW*32)
// Values:       -2147483648, ..., 2147483647
// 
// ARB/MUX XPLH Interface Width for 68B Flit Format
`define CX_ARBMUX_256B_XPLH_WIDTH 512


// Name:         CX_ARBMUX_XPLH_WIDTH
// Default:      528 ( (CX_CXL_256B_FLIT_ENABLE && 
//               (CX_ARBMUX_256B_XPLH_WIDTH>CX_ARBMUX_68B_XPLH_WIDTH)) ? CX_ARBMUX_256B_XPLH_WIDTH : 
//               CX_ARBMUX_68B_XPLH_WIDTH)
// Values:       -2147483648, ..., 2147483647
// 
// ARB/MUX XPLH Interface Width after XPLH Serializer
`define CX_ARBMUX_XPLH_WIDTH 528


// Name:         CX_XPLH_FLIT_MODE_ENABLE
// Default:      1 (CX_CXL_ENABLE || CX_FLIT_MODE_ENABLE)
// Values:       0, 1
// 
// XPLH supports flit mode of operation when either CXL or PCIe flit mode is enabled
`define CX_XPLH_FLIT_MODE_ENABLE


// Name:         CX_ARBMUX_XPLH_PROT_WIDTH
// Default:      66 ( (CX_CXL_256B_FLIT_ENABLE && (CX_RASDP > 0))? 
//               (CX_ARBMUX_XPLH_WIDTH/CX_RAS_PROT_RANGE) : 0)
// Values:       -2147483648, ..., 2147483647
// 
// ARB/MUX XPLH Interface Prot Width after XPLH Serializer
`define CX_ARBMUX_XPLH_PROT_WIDTH 66


// Name:         CX_ARBMUX_XPLH_IF_WIDTH
// Default:      594 ((CX_CXL_256B_FLIT_ENABLE && (CX_RASDP > 0))? 
//               (CX_ARBMUX_XPLH_WIDTH + CX_ARBMUX_XPLH_PROT_WIDTH) : CX_ARBMUX_XPLH_WIDTH)
// Values:       -2147483648, ..., 2147483647
// 
// ARB/MUX XPLH Interface Width with Prot after XPLH Serializer
`define CX_ARBMUX_XPLH_IF_WIDTH 594

// =============================================================================
// CXL Parameter for Application Layer Instantiation in VTB
// =============================================================================


// Name:         CX_CXL_APP_LAYER_EN
// Default:      0
// Values:       0, 1
// Enabled:      CX_CXL_DEVICE_CTS_EN
// 
// Instantiates CXL application Layer in VTB
// `define CX_CXL_APP_LAYER_EN


// Name:           CX_CXL_MBAR0_PREFETCHABLE
// Default:        0x1
// Values:         0x0, 0x1
// Enabled:        CX_CXL_ENABLE
// Parameter Type: Feature Setting
// 
// Determines if the CXL MBAR0 is a prefetchable memory (bit 3 of a memory BAR).
`define CX_CXL_MBAR0_PREFETCHABLE 1'h1

// =============================================================================
// CXL Parameters for CXL MEM Application Layer
// =============================================================================


// Name:           CX_CXL_APP_MEM_ADDRW
// Default:        12
// Values:         6, ..., 15
// Enabled:        CX_CXL_MEM_T3_HOST_APP_EN || CX_CXL_MEM_T3_APP_EN
// Parameter Type: Register Default Setting
// 
// RAM Address Width for CXL.mem, M2S write or read to the RAM address width. It is Cache Line Based RAM address (not Byte 
// Based). From bit 6 in the HPA Address[51:6] field in CXL spec is because 512-bit data = 64 bytes for each access to the 
// RAM, i.e., Cache Line Based access.
`define CX_CXL_APP_MEM_ADDRW 12


// Name:         CX_CXL_APP_MEM_DEPTH
// Default:      4096 ([<functionof> CX_CXL_APP_MEM_ADDRW])
// Values:       -2147483648, ..., 2147483647
// 
// CXL MEM Application Type 3 Device Data RAM Depth. It is Cache Line Based RAM Depth (not Byte Based)
`define CX_CXL_APP_MEM_DEPTH 4096


// Name:         CX_CXL_APP_MEM_BYTE_DEPTH
// Default:      262144 (([<functionof> CX_CXL_APP_MEM_ADDRW]) * 64)
// Values:       -2147483648, ..., 2147483647
// 
// CXL MEM Application Type 3 Device Data RAM Byte-based Depth
`define CX_CXL_APP_MEM_BYTE_DEPTH 262144


// Name:           CX_CXL_APP_MEM_DATAW
// Default:        512
// Values:         -2147483648, ..., 2147483647
// Enabled:        CX_CXL_MEM_T3_APP_EN
// Parameter Type: Register Default Setting
// 
// RAM Data Bit Width for CXL.mem, M2S write or read to the RAM data/payload width. Only 512 bit width is used for each 
// access to the RAM
`define CX_CXL_APP_MEM_DATAW 512


// Name:           CX_CXL_MEM_APP_TX_REGOUT
// Default:        true
// Values:         false (0), true (1)
// Enabled:        CX_CXL_MEM_T3_APP_EN
// Parameter Type: Feature Setting
// 
// Enable CXL.mem Type 3 Device Application Layer Transmitter Signal PIPELINE
`define CX_CXL_MEM_APP_TX_REGOUT


// Name:           CX_CXL_MEM_APP_RX_REGOUT
// Default:        false
// Values:         false (0), true (1)
// Enabled:        CX_CXL_MEM_T3_APP_EN
// Parameter Type: Feature Setting
// 
// Enable CXL.mem Type 3 Device Application Layer Receiver Signal PIPELINE
// `define CX_CXL_MEM_APP_RX_REGOUT


// Name:           CX_CXL_MEM_APP_2G_CLOCK_FREQ
// Default:        false
// Values:         false (0), true (1)
// Enabled:        CX_CXL_MEM_T3_APP_EN
// Parameter Type: Feature Setting
// 
// Enable 2G CXL clock frequency for CXL.mem Type 3 Device Application Layer synthesis. Some logic optimization is needed, 
// e.g., the check for HPA outside of Base and Size range is not performed.
`define CX_CXL_MEM_APP_2G_CLOCK_FREQ 0


// Name:           CX_CXL_APP_HDM_DEC_EN
// Default:        false (CX_CXL_MEM_T3_HOST_APP_EN || CX_CXL_MEM_T3_APP_EN)
// Values:         false (0), true (1)
// Enabled:        CX_CXL_MEM_T3_HOST_APP_EN || CX_CXL_MEM_T3_APP_EN
// Parameter Type: Feature Setting
// 
// If enabled, the CXL HDM Decoder Capability Register is implemented and included
// `define CX_CXL_APP_HDM_DEC_EN


// Name:           CX_CXL_MBAR0_CAP_ARRAY_SIZE
// Default:        0x3 (CX_CXL_APP_HDM_DEC_EN ? 4 : 3)
// Values:         0x3, ..., 0xff
// Enabled:        CX_CXL_ENABLE
// Parameter Type: Feature Setting
// 
// Specify the number of elements in the CXL Capability array, not including the CXL_Capability_Header element.
`define CX_CXL_MBAR0_CAP_ARRAY_SIZE 8'h3


// Name:           CX_CXL_APP_HDM_DEC_NUM
// Default:        0
// Values:         0 1 2 4 6 8 10
// Enabled:        CX_CXL_APP_HDM_DEC_EN
// Parameter Type: Register Default Setting
// 
// CXL HDM Memory Address Decoder Number. The Decoder 0 always exists even if CX_CXL_APP_HDM_DEC_NUM = 0 when the parameter 
// CX_CXL_APP_HDM_DEC_EN is set
`define CX_CXL_APP_HDM_DEC_NUM 0


// Name:         APP_DEC_NUM
// Default:      0 (CX_CXL_APP_HDM_DEC_NUM >> 1)
// Values:       0, ..., 15
// 
// CXL HDM Decoder count or number
`define APP_DEC_NUM 4'd0

`define DN_0


// Name:         CX_APP_DN_EOG_1
// Default:      0 ((CX_CXL_APP_HDM_DEC_NUM >= 1) ? 1 : 0)
// Values:       0, 1
// 
// Specifies device has equal or over 1 Decoders
// `define CX_APP_DN_EOG_1


// Name:         CX_APP_DN_EOG_2
// Default:      0 ((CX_CXL_APP_HDM_DEC_NUM >= 2) ? 1 : 0)
// Values:       0, 1
// 
// Specifies device has equal or over 2 Decoders
// `define CX_APP_DN_EOG_2


// Name:         CX_APP_DN_EOG_4
// Default:      0 ((CX_CXL_APP_HDM_DEC_NUM >= 4) ? 1 : 0)
// Values:       0, 1
// 
// Specifies device has equal or over 4 Decoders
// `define CX_APP_DN_EOG_4


// Name:         CX_APP_DN_EOG_6
// Default:      0 ((CX_CXL_APP_HDM_DEC_NUM >= 6) ? 1 : 0)
// Values:       0, 1
// 
// Specifies device has equal or over 6 Decoders
// `define CX_APP_DN_EOG_6


// Name:         CX_APP_DN_EOG_8
// Default:      0 ((CX_CXL_APP_HDM_DEC_NUM >= 8) ? 1 : 0)
// Values:       0, 1
// 
// Specifies device has equal or over 8 Decoders
// `define CX_APP_DN_EOG_8


// Name:         CX_APP_DN_EOG_10
// Default:      0 ((CX_CXL_APP_HDM_DEC_NUM >= 10) ? 1 : 0)
// Values:       0, 1
// 
// Specifies device has equal or over 10 Decoders
// `define CX_APP_DN_EOG_10

// --------------------------------------------------------------------
//                      REGIN/REGOUT
//---------------------------------------------------------------------


// Name:         CX_CXL_256B_UNPACKER_REGIN
// Default:      1 (((CX_SPIF_ENABLE && CX_RASDP_EN && CX_FLIT_MODE_ENABLE)) ? 1 : 
//               0)
// Values:       0, 1
// 
// 256B unpacker Regin
`define CX_CXL_256B_UNPACKER_REGIN 1


// Name:         CX_CXL_TX_TL_REGOUT
// Default:      0 (CX_CXL_SYNCHRONOUS && !CX_CXL_CHI_DATACHK_EN)
// Values:       0, 1
// 
// Channel Message/Data TL Output Register Enable
// `define CX_CXL_TX_TL_REGOUT


// Name:         CX_CXL_TX_TL_RASDP_REGOUT
// Default:      1 ((CX_CXL_CHI_DATACHK > 0) ? CX_CXL_ENABLE : 0)
