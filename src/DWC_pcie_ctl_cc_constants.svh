// Default:      0
// Values:       0, 1
// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// Width of TLB location of NP stream LTIM. For phase 1, no TLB location signals are available.
// `define CX_LTI_NP_TLBLOC_WIDTH


