//               TRGT0_EXCLUSIVE_WIDTH DEMUX_EXCLUSIVE_WIDTH]) 6 ])
// Values:       0, ..., 1024
// 
// number of bits for Fields Storage for Posted TLPs Header fields 
//  includes queue controls 
//  excludes parity
`define CX_RADM_PQ_HWD 284


