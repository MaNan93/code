// Enabled:        CX_ACS_ENABLE
// Parameter Type: Feature Setting
// 
// This is the default value (after reset) of the ACS P2P Request Redirect bit field in the ACS Capability register in PF4. 
// If 1b, indicates that the component implements ACS P2P Request Redirect.
`define CX_ACS_P2P_REQ_REDIRECT_4 1'h1


// Name:           CX_ACS_P2P_COMPL_REDIRECT_4
// Default:        0x1 (CX_ACS_P2P_COMPL_REDIRECT_0)
// Values:         0x0, 0x1
// Enabled:        CX_ACS_ENABLE
// Parameter Type: Feature Setting
