//               CC_AXI_RCHUNKSTRB_WD : 0))
// Values:       -2147483648, ..., 2147483647
// 
// DTIM AXI4-Stream Slave ATS Response Interface Width 
//  {id, resp, resp_null_read, cpl_stat, byte_en, data, last, misc_info, prfx, ln } 
//  Includes data and prefix protection bits when data path protection is enabled.
`define CC_DTIM_ATS_RSP_INTF_WD 667


// Name:         CC_DTIM_ATS_P_INTF_WD
