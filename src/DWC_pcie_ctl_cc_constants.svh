// Name:         CX_PHY_RX_DELAY_SERDES_PIPE_EMPTY
// Default:      46 (!CX_PIPE_SERDES_ARCH) ? 0 : ([<functionof> 
//               CX_PHY_RX_DELAY_SERDES_PIPE_EMPTY_GEN1 CX_PHY_RX_DELAY_SERDES_PIPE_EMPTY_GEN2 
//               CX_PHY_RX_DELAY_SERDES_PIPE_EMPTY_GEN3 CX_PHY_RX_DELAY_SERDES_PIPE_EMPTY_GEN4 
//               CX_PHY_RX_DELAY_SERDES_PIPE_EMPTY_GEN5])
// Values:       0, ..., 500
// 
// Receive delay through the SerDes architecture module when the elastic buffer mode is nominal empty buffer mode.
