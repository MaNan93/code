// 
// Enable CXL Host Packer
`define CX_CXL_USP_PACKER_ENABLE


// Name:         CX_CXL_DUAL_PACKER_ENABLE
// Default:      1 (CX_CXL_DSP_PACKER_ENABLE && CX_CXL_USP_PACKER_ENABLE)
// Values:       0, 1
// 
// Enable CXL Host and Device Packer
`define CX_CXL_DUAL_PACKER_ENABLE


// Name:         CX_CXL_32B_DATA_EN
// Default:      1 (CX_CXL_D2H_H2D_ENABLE || CX_CXL_H2D_D2H_ENABLE || 
//               CX_CXL_M2S_S2M_ENABLE)
// Values:       0, 1
// 
// Enable 32B Logic in the Flit Unpacker
`define CX_CXL_32B_DATA_EN


// Name:         CX_CXL_32B_BE_EN
// Default:      1 (CX_CXL_32B_DATA_EN && CX_CXL_H2D_D2H_ENABLE)
// Values:       0, 1
// 
// Enable 32B Byte Enable Logic in the Flit Unpacker
`define CX_CXL_32B_BE_EN


// Name:         CX_CXL_32B_INTER_EN
// Default:      1 (CX_CXL_32B_DATA_EN && (CX_CXL_32B_BE_EN || 
//               CX_CXL_D2H_H2D_ENABLE))
// Values:       0, 1
// 
// Enable interleaving between 32B data transfers
`define CX_CXL_32B_INTER_EN


// Name:         CX_CXL_MEM_SHARED_CREDIT
// Default:      1 (CX_CXL_BI_SUPPORT || CX_CXL_SYMMEM_SUPPORT)
// Values:       0, 1
// 
// CXL.mem shared credit pool for Request and Response messages
`define CX_CXL_MEM_SHARED_CREDIT


// Name:         CX_CXL_MEM_REQ_CRDRET_ENABLE
// Default:      1 (CX_CXL_SYMMEM_SUPPORT || CX_CXL_UPSTREAM_PORT)
// Values:       0, 1
// 
// CXL.mem Request Credit Return Enable
`define CX_CXL_MEM_REQ_CRDRET_ENABLE


// Name:         CX_CXL_MEM_RSP_CRDRET_ENABLE
// Default:      1 (CX_CXL_SYMMEM_SUPPORT || CX_CXL_DOWNSTREAM_PORT)
// Values:       0, 1
// 
// CXL.mem Response Credit Return Enable
`define CX_CXL_MEM_RSP_CRDRET_ENABLE




// Name:         CX_CXL_20_NW
// Default:      16
// Values:       -2147483648, ..., 2147483647
// 
// CXL Controller Data Width for CXL1.1/CXL2.0 in DWords without CRC and PID
`define CX_CXL_20_NW 16


// Name:         CX_CXL_30_NW
// Default:      16 ((CX_NW > 16) ? CX_NW : 16)
// Values:       -2147483648, ..., 2147483647
// 
// CXL Controller Data Width for CXL3.0 in DWords
`define CX_CXL_30_NW 16


// Name:         CX_CXL_NW
// Default:      16 (CX_CXL_256B_FLIT_ENABLE ? CX_CXL_30_NW : CX_CXL_20_NW)
// Values:       -2147483648, ..., 2147483647
// 
// CXL Controller Data Width in DWords
`define CX_CXL_NW 16


// Name:         CX_CXL_DW
// Default:      512 ((CX_CXL_256B_FLIT_ENABLE ? CX_CXL_30_NW : CX_CXL_20_NW)*32)
// Values:       -2147483648, ..., 2147483647
// 
// CXL Controller Data Width
`define CX_CXL_DW 512


// Name:         CX_CXL_20_DW
// Default:      512 ((16)*32)
// Values:       -2147483648, ..., 2147483647
// 
// CXL Controller Data Width for CXL 2.0
`define CX_CXL_20_DW 512



// Name:         CX_CXL_FLIT_SLOT_NUM
// Default:      4 (CX_CXL_256B_FLIT_ENABLE ? ((CX_CXL_30_NW == 32) ? 8 : 4) : 4)
// Values:       -2147483648, ..., 2147483647
// 
// CXL Controller Data Width in Number of Flit slots
`define CX_CXL_FLIT_SLOT_NUM 4


// Name:         CX_CXL_FLIT_SLOT_NUM_8
// Default:      0 ((CX_CXL_256B_FLIT_ENABLE ? ((CX_CXL_30_NW == 32) ? 8 : 4) : 
//               4)==8)
// Values:       0, 1
// 
// CXL Controller Data Width equal to 8 slots
// `define CX_CXL_FLIT_SLOT_NUM_8

// Name:         CX_CXL_FLIT_SLOT_NUM_4
// Default:      1 ((CX_CXL_256B_FLIT_ENABLE ? ((CX_CXL_30_NW == 32) ? 8 : 4) : 
//               4)==4)
// Values:       0, 1
// 
// CXL Controller Data Width equal to 4 slots
`define CX_CXL_FLIT_SLOT_NUM_4

// Name:         CX_CXL_FLIT_SLOT_NUM_2
// Default:      0 ((CX_CXL_256B_FLIT_ENABLE ? ((CX_CXL_30_NW == 32) ? 8 : 4) : 
//               4)==2)
// Values:       0, 1
// 
// CXL Controller Data Width equal to 2 slots
// `define CX_CXL_FLIT_SLOT_NUM_2

// Name:         CX_CXL_FLIT_SLOT_NUM_1
// Default:      0 ((CX_CXL_256B_FLIT_ENABLE ? ((CX_CXL_30_NW == 32) ? 8 : 4) : 
//               4)==1)
// Values:       0, 1
// 
// CXL Controller Data Width equal to 1 slots
// `define CX_CXL_FLIT_SLOT_NUM_1

// Name:         CX_CXL_LINK_DATA_NUM
// Default:      1 (((CX_CXL_256B_FLIT_ENABLE ? ((CX_CXL_30_NW == 32) ? 8 : 4) : 4) 
//               > 4) ? 2 : 1)
// Values:       -2147483648, ..., 2147483647
// 
// CXL Controller Number of Data blocks that can be packed per cycle
`define CX_CXL_LINK_DATA_NUM 1





