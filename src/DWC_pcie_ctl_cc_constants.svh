// 
// When enabled, the controller implements the drift buffer.
`define CX_DRIFT_BUFFER_SUPPORT


// Name:         CX_SERDES_ARCH_TX_REGIN
// Default:      1 (CX_CXL_ENABLE)
// Values:       0, 1
// Enabled:      CX_PIPE_SERDES_ARCH
// 
// Inserts a pipeline for transmitted side of SerDes architecture related input signals. It provids trade-off of latency 
// and gates for ease of timing closure.
`define CX_SERDES_ARCH_TX_REGIN


// Name:         CX_SERDES_ARCH_TX_REGOUT
// Default:      1
// Values:       0, 1
// Enabled:      CX_PIPE_SERDES_ARCH
// 
// Inserts a pipeline at the following SerDes architecture related output signals, providing trade-off of latency and gates 
// for ease of timing closure. 
//  - mac_phy_txdata 
//  - mac_phy_txdetectrx_loopback 
//  - mac_phy_txelecidle
`define CX_SERDES_ARCH_TX_REGOUT


// Name:         CX_SERDES_ARCH_RX_REGIN
// Default:      1
// Values:       0, 1
// Enabled:      CX_PIPE_SERDES_ARCH
// 
// Inserts a pipeline at the following SerDes architecture related input signals, providing trade-off of latency and gates 
// for ease of timing closure. 
//  - phy_mac_rxdata 
//  - phy_mac_rxvalid
`define CX_SERDES_ARCH_RX_REGIN


// Name:           CX_SERDES_ARCH_RX_SH_BYPASS_REGIN
// Default:        0
// Values:         0, 1
// Enabled:        (CX_CUSTOM_PIPELINING) && (CX_PIPE_SERDES_ARCH) && (CX_CXL_ENABLE)
// Parameter Type: Performance Setting
// 
// Inserts a pipeline at the following SerDes architecture related input signals for the path used when sync header bypass 
// is enabled, providing trade-off of latency and gates for ease of timing closure. 
//  - phy_mac_rxdata 
//  - phy_mac_rxvalid
// `define CX_SERDES_ARCH_RX_SH_BYPASS_REGIN


// Name:         CX_SERDES_ARCH_FPGA
// Default:      0 (DWC_PCIE_FPGA && CX_PIPE_SERDES_ARCH)
// Values:       0, 1
// Enabled:      CX_PIPE_SERDES_ARCH
// 
// Select this option if you are implementing the controller which implements the SerDes architecture in an FPGA. This will 
// add the required pipelining and simplify logics to enable the synthesis tool to meet FPGA timing. In more detail, the 
// following are changed in the controller. 
//  - Pipelining in the receiver side of the SerDes architecture module 
//  - The EIEOS detection logic is simplified.
// `define CX_SERDES_ARCH_FPGA


// Name:           CX_SERDES_ARCH_RX_SH_BYPASS_BYPSDATA_REGOUT
// Default:        0 ( ((CX_MAX_CORECLK_FREQ >=2000) || (CX_SERDES_ARCH_FPGA)) ? 1 : 0 
