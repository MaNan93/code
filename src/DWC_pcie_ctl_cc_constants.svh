// Values:         false (0), true (1)
// Enabled:        (TRGT1_POPULATE && !(AMBA_POPULATED) && !(CC_DMA_ENABLE) && !(CC_DEVICE_TYPE==CC_SW) && !(CX_P2P_ENABLE) 
//                 && !(CX_RAM_PROTECTION_MODE==2 && CX_RADMQ_MODE!=2) 
//                 && !( (  (RADM_NP_QMODE_VC0==2) || (RADM_NP_QMODE_VC1==2) 
