// Default value for the PBA BAR Indicator Register (BIR) field in the VF MSI-X PBA Offset and BIR Register. Function 4.
`define VF_MSIX_PBA_BIR_4 3'h0


`define VF_MSIX_PBA_OFFSET_4_BASELINE 16


// Name:           VF_MSIX_PBA_OFFSET_4
// Default:        0x2 (VF_MSIX_PBA_OFFSET_0)
// Values:         0x0, ..., 0x1fffffff
// Enabled:        CX_NFUNC > 4 && VF_MSIX_CAP_ENABLE==1
// Parameter Type: Register Default Setting
// 
// Default value for the PBA Offset field in the VF MSI-X PBA Offset and BIR Register. Function 4.
`define VF_MSIX_PBA_OFFSET_4 29'h2

