// PF3. If 1b, indicates that the component implements ACS Direct Translated P2P.
`define CX_ACS_P2P_DIRECT_TRANSL_3 1'h1


// Name:           CX_ACS_EGRESS_CTRL_SIZE_3
// Default:        0x4 ((CX_ACS_P2P_EGRESS_CTRL_3) * (CX_ACS_EGRESS_CTRL_SIZE_0))
// Values:         0x0, ..., 0xff
// Enabled:        CX_ACS_ENABLE
// Parameter Type: Feature Setting
// 
// This is the default value (after reset) of the Egress Control Vector Size field in the ACS Capability register in PF3. 
// Encodes 01h-FFh directly indicate the number of applicable bits in the Egress Control Vector; the encoding 00h indicates 
// 256 bits.
`define CX_ACS_EGRESS_CTRL_SIZE_3 8'h4


// Name:         ACS_CTRL_VEC_WD_3
// Default:      0x4 ((CX_ACS_P2P_EGRESS_CTRL_3) * ((CX_ACS_EGRESS_CTRL_SIZE_3 == 0) 
//               ? 256 : CX_ACS_EGRESS_CTRL_SIZE_3))
// Values:       0x0, ..., 0x1ff
// 
// This is the width of the ACS control vector for Function 3
`define ACS_CTRL_VEC_WD_3 9'h4


// Name:           CX_ACS_UP_EGRESS_CTRL_MASK_3
// Default:        0x8 ([<functionof> CX_ACS_FUNC_GRP 3])
// Values:         0x0, ..., 
