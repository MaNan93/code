// Enabled:      <DWC-XBIU-SAFETY feature authorize> == 1
// 
// This parameter allows user to Enable the Safety feature on the AXI Master and/or Slave Interface. 
// If enabled, this allows us to enable Safety Features: 
//  - Parity Protection Feature and/or 
//  - ECC Protection Feature
`define DWC_XBIU_ECC_PAR_EN 0


`define DWC_PCIE_CTL_RM_BCM46_F 1


`define DWC_PCIE_CTL_RM_BCM46_AA 1


// Name:         DWC_HAS_QOS
// Default:      1 ((AMBA_INTERFACE==3) || (AMBA_INTERFACE==4))
// Values:       0, 1
// 
// QOS Enabled in Safety Modules
`define DWC_HAS_QOS


// Name:         DWC_HAS_AXI3
// Default:      0 (AMBA_INTERFACE==2)
// Values:       0, 1
// 
// AXI 3 Enabled
// `define DWC_HAS_AXI3


// Name:         DWC_M_HAS_AXI3
// Default:      0 (AMBA_INTERFACE==2)
// Values:       0, 1
// 
// AXI 3 Enabled on Master
// `define DWC_M_HAS_AXI3


// Name:         DWC_S_HAS_AXI3
// Default:      0 (AMBA_INTERFACE==2)
// Values:       0, 1
// 
// AXI 3 Enabled on Slave
// `define DWC_S_HAS_AXI3


// Name:         DWC_XBIU_AR_ECC_PAR_MODE
// Default:      Parity - Address and Control
// Values:       Parity - Address and Control (0), ECC - Address and Control (1), 
//               ECC - Address and Parity - Control (2)
// Enabled:      ((CX_AXI_IF_ECC_PAR_PROT_EN && AXI_POPULATED) == 1)
// 
// The AXI AR Channel ECC and Parity Mode Selection: 
//   - 0: Parity for Address and Control signals 
//   - 1: ECC for Address and Control signals 
//   - 2: ECC for Address and Parity for Control signals
`define DWC_XBIU_AR_ECC_PAR_MODE 0


// Name:         DWC_XBIU_AW_ECC_PAR_MODE
// Default:      Parity - Address and Control
// Values:       Parity - Address and Control (0), ECC - Address and Control (1), 
//               ECC - Address and Parity - Control (2)
// Enabled:      ((CX_AXI_IF_ECC_PAR_PROT_EN && AXI_POPULATED) == 1)
// 
// The AXI AW Channel ECC and Parity Mode Selection: 
//   - 0: Parity for Address and Control signals 
//   - 1: ECC for Address and Control signals 
//   - 2: ECC for Address and Parity for Control signals
`define DWC_XBIU_AW_ECC_PAR_MODE 0


// Name:         DWC_XBIU_W_ECC_PAR_MODE
// Default:      Parity - Data and Control ((CX_AXI_IF_TYPE_OF_PROT == 2) ? 2 : 0)
// Values:       Parity - Data and Control (0), ECC - Data and Control (1), ECC - 
//               Data and Parity - Control (2)
// Enabled:      ((CX_AXI_IF_ECC_PAR_PROT_EN && AXI_POPULATED) == 1)
// 
// The AXI W Channel ECC and Parity Mode Selection: 
//   - 0: Parity for Data and Control signals 
//   - 1: ECC for Data and Control signals 
//   - 2: ECC for Data and Parity for Control signals
`define DWC_XBIU_W_ECC_PAR_MODE 0


// Name:         DWC_XBIU_R_ECC_PAR_MODE
// Default:      Parity - Data and Control ((CX_AXI_IF_TYPE_OF_PROT == 2) ? 2 : 0)
// Values:       Parity - Data and Control (0), ECC - Data and Control (1), ECC - 
//               Data and Parity - Control (2)
// Enabled:      ((CX_AXI_IF_ECC_PAR_PROT_EN && AXI_POPULATED) == 1)
// 
// The AXI R Channel ECC and Parity Mode Selection: 
//   - 0: Parity for Data and Control signals 
//   - 1: ECC for Data and Control signals 
//   - 2: ECC for Data and Parity for Control signals
`define DWC_XBIU_R_ECC_PAR_MODE 0


// Name:         DWC_XBIU_B_ECC_PAR_MODE
// Default:      Parity - Control
// Values:       Parity - Control (0), ECC - Control (1)
// Enabled:      ((CX_AXI_IF_ECC_PAR_PROT_EN && AXI_POPULATED) == 1)
// 
// The AXI B Channel ECC and Parity Mode Selection: 
//   - 0: Parity for Control signals 
//   - 1: ECC for Control signals
`define DWC_XBIU_B_ECC_PAR_MODE 0


// Name:         DWC_XBIU_PAR_MODE
// Default:      ARC Compatibility Mode
// Values:       Per Byte Parity Mode (0), ARC Compatibility Mode (1)
// Enabled:      ((CX_AXI_IF_ECC_PAR_PROT_EN && AXI_POPULATED) == 1)
// 
// AXI Interface Parity Mode Selection: 
//   - 0: Per 8-bit Parity Computation 
//   - 1: ARC Mode Parity Computation
`define DWC_XBIU_PAR_MODE 1


// Name:         DWC_XBIU_PAR_TYPE
// Default:      Odd (CX_RASDP==2)
// Values:       Even (0), Odd (1)
// Enabled:      ((CX_AXI_IF_ECC_PAR_PROT_EN && AXI_POPULATED) == 1)
// 
// AXI Interface Even or Odd Parity type selection.
`define DWC_XBIU_PAR_TYPE 1


// Name:         DWC_XBIU_ECC_GRAN_TYPE
// Default:      Full Width (CX_AXI_IF_ECC_GRAN)
// Values:       Full Width (0), 64-Bit ECC (1), 32-Bit ECC (2)
// Enabled:      ((CX_AXI_IF_ECC_PAR_PROT_EN && AXI_POPULATED) == 1)
// 
// AXI Interface ECC Resolution Type. Which is used selects the 
//  Granularity of ECC Checkbits generation. 
//   - 0: Full Width ECC Computation 
//   - 1: 32 bit Granularity ECC Computation 
//   - 2: 64 bit Granularity ECC Computation
`define DWC_XBIU_ECC_GRAN_TYPE 0


// Name:         DWC_XBIU_ECC_MODE
// Default:      Standard ECC Mode (CX_AXI_IF_ECC_MODE)
// Values:       Standard ECC Mode (0), ARC Compatibility ECC Mode (1)
// Enabled:      ((CX_AXI_IF_ECC_GRAN) == 1)
// 
// AXI Interface ECC Mode Selection: 
//   - 0: Standard ECC Computation 
//   - 1: ARC Mode ECC Computation
`define DWC_XBIU_ECC_MODE 0


// Name:         DWC_XBIU_READY_VALID_PAR_EN
// Default:      Yes
// Values:       No (0), Yes (1)
// Enabled:      (CX_AXI_IF_ECC_PAR_PROT_EN && AXI_POPULATED)==1
// 
// AXI Interface Ready and Valid Parity feature Enable/Disable.
`define DWC_XBIU_READY_VALID_PAR_EN 1


// Name:         DWC_XBIU_READY_VALID_PAR_TYPE
// Default:      Odd (CX_RASDP==2)
// Values:       Even (0), Odd (1)
// Enabled:      ((1) == 1)
// 
// AXI Interface Even or Odd Parity type selection.
`define DWC_XBIU_READY_VALID_PAR_TYPE 1


// Name:         DWC_XBIU_AR_REGSLICE_EN
// Default:      No
// Values:       No (0), Yes (1)
// Enabled:      (CX_AXI_IF_ECC_PAR_PROT_EN && AXI_POPULATED)==1
// 
// This parameter allows user to enable/disable the Register Slice to ease the timing on the AR Channel.
`define DWC_XBIU_AR_REGSLICE_EN 0


// Name:         DWC_XBIU_AW_REGSLICE_EN
// Default:      No
// Values:       No (0), Yes (1)
// Enabled:      (CX_AXI_IF_ECC_PAR_PROT_EN && AXI_POPULATED)==1
// 
// This parameter allows user to enable/disable the Register Slice to ease the timing on the AW Channel.
`define DWC_XBIU_AW_REGSLICE_EN 0


// Name:         DWC_XBIU_W_REGSLICE_EN
// Default:      No
// Values:       No (0), Yes (1)
// Enabled:      (CX_AXI_IF_ECC_PAR_PROT_EN && AXI_POPULATED)==1
// 
// This parameter allows user to enable/disable the Register Slice to ease the timing on the W Channel.
`define DWC_XBIU_W_REGSLICE_EN 0


// Name:         DWC_XBIU_R_REGSLICE_EN
// Default:      No
// Values:       No (0), Yes (1)
// Enabled:      (CX_AXI_IF_ECC_PAR_PROT_EN && AXI_POPULATED)==1
// 
// This parameter allows user to enable/disable the Register Slice to ease the timing on the R Channel.
`define DWC_XBIU_R_REGSLICE_EN 0


// Name:         DWC_XBIU_B_REGSLICE_EN
// Default:      No
// Values:       No (0), Yes (1)
// Enabled:      (CX_AXI_IF_ECC_PAR_PROT_EN && AXI_POPULATED)==1
// 
// This parameter allows user to enable/disable the Register Slice to ease the timing on the B Channel.
`define DWC_XBIU_B_REGSLICE_EN 0


