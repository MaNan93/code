//                    ( CX_MAX_PCIE_SPEED == 4 && CX_CXL_ENABLE==1 && DWC_PCIE_FPGA==0) ? 3 : 
//                    ( CX_MAX_PCIE_SPEED == 5 && CX_CXL_ENABLE==1 && CX_PIPE5_SUPPORT==1 && CX_PIPE_SERDES_ARCH && DWC_PCIE_FPGA==0) ? 3 : 
//                    ( CX_MAX_PCIE_SPEED == 6 && CX_PIPE_VER >= 3 && CX_PIPE_SERDES_ARCH  ) ? 2 : 0))
// Values:         PCLK as PHY output (0), PCLK as PHY input Fixed MAXPCLK (1), PCLK 
//                 as PHY input Dynamic MAXPCLK (2), PCLK as PHY input fixed ratio 
//                 MAXPCLK (3)
// Enabled:        ((CX_PIPE_VER>=2) && CX_PHY_LOGICAL_ENABLE)
// Parameter Type: Feature Setting
// 
// Select the PIPE PCLK mode. 
// Note: Any PCLK as PHY input mode requires PIPE4.4.1 and above. 
//  - 0: PCLK as PHY output. 
//  - 1: PCLK as PHY input with Fixed MAX PCLK frequency. 
//  - 2: PCLK as PHY input with Dynamic MAX PCLK frequency. 
//  - 3: PCLK as PHY input with MAX PCLK to PCLK frequency ratio 2:1.
`define CX_PIPE_PCLK_MODE 1


