// Name:           CX_DMAREG_CHADDR_SPACE
// Default:        CHSEP_256
// Values:         CHSEP_256 (0), CHSEP_512 (1), CHSEP_1K (2), CHSEP_2K (3), CHSEP_4K 
//                 (4), CHSEP_8K (5), CHSEP_16K (6), CHSEP_32K (7)
