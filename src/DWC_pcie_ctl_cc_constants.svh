//                 (CC_DEVICE_TYPE!=CC_SW))
// Parameter Type: Feature Setting.
// 
// Support the PASID capability for untranslated addresses.
`define CX_PASID_ENABLE


// Name:           CX_PRG_PASID_REQUIRED
// Default:        0
