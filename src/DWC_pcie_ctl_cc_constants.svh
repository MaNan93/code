// Enabled:      CC_LTIM_ENABLE
// 
// Width of LTI translation flow value.
`define CX_LTI_TRANS_FLOW_WIDTH 2


// Name:         CX_CID_WD
// Default:      16
// Values:       -2147483648, ..., 2147483647
// Enabled:      ((AMBA_INTERFACE==2) || (AMBA_INTERFACE==3) || (AMBA_INTERFACE==4))
// 
// Width of CID value.
`define CX_CID_WD 16


// Name:         CX_RID_WD
// Default:      16
// Values:       -2147483648, ..., 2147483647
// Enabled:      ((AMBA_INTERFACE==2) || (AMBA_INTERFACE==3) || (AMBA_INTERFACE==4))
// 
// Width of RID value.
`define CX_RID_WD 16


// Name:         CX_TPH_ST_WD
// Default:      8
// Values:       -2147483648, ..., 2147483647
// Enabled:      CX_TPH_ENABLE
// 
// Width of TLP Processing Hints ST value.
`define CX_TPH_ST_WD 8


// Name:         CX_TPH_PH_WD
// Default:      2
// Values:       -2147483648, ..., 2147483647
// Enabled:      CX_TPH_ENABLE
// 
// Width of TLP Processing Hints PH value.
`define CX_TPH_PH_WD 2


// Name:         CX_TPH_TH_WD
// Default:      1
// Values:       -2147483648, ..., 2147483647
// Enabled:      CX_TPH_ENABLE
// 
// Width of TLP Processing Hints TH value.
`define CX_TPH_TH_WD 1


// Name:         CX_MISC_INFO_TPH_WD
// Default:      11 (CX_TPH_ST_WD + CX_TPH_PH_WD + CX_TPH_TH_WD)
// Values:       -2147483648, ..., 2147483647
// Enabled:      CX_TPH_ENABLE
// 
// Width of TLP Processing Hints miscellaneous info value.
`define CX_MISC_INFO_TPH_WD 11


// Name:         CC_LTI_P_VC_COUNT
// Default:      1
// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// Number of Virtual Channels (VC) in the of P stream LTIM. It is assumed that LTI has a single virtual channel 
// i.e. VC0 for Posted/Non-Posted TLPs.
`define CC_LTI_P_VC_COUNT 1


// Name:         CC_LTI_P_VC_COUNT_WIDTH
// Default:      1 ((CC_LTI_P_VC_COUNT > 1) ? {[<functionof>  CC_LTI_P_VC_COUNT]} : 
//               1)
// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// LTI Virtual Channel Number Width of P stream LTIM.
`define CC_LTI_P_VC_COUNT_WIDTH 1


// Name:         CX_LTI_P_OG_WIDTH
// Default:      0
// Values:       0, 1
// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// Width of order group of P stream LTIM. For phase 1, ordering will be done on PCIe core side.
// `define CX_LTI_P_OG_WIDTH


// Name:         CX_LTI_P_LxUSER_WIDTH
// Default:      0
// Values:       0, 1
// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// Width of LTI channel user signals of P stream LTIM. For phase 1, no user signals are available.
