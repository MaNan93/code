//               (CC_ORDRB_EN ? CC_ORDRB_NIDO : 0) + CC_DMA_ENABLE_VALUE + 
//               (CC_IB_P_ID_MNG_RO_EN ? CC_WR_CH_P_REQ_QUEUE_DP : 0)) : 0)
// Values:       -2147483648, ..., 2147483647
// 
// Maximum AXI ID for IB Posted Writes
`define CX_IB_P_ID_MNG_MAX_IB_ID 257


`define CX_IB_P_ID_MNG_MAX_IB_ID_WD 9


// Name:         CX_IB_P_ID_MNG_MAX_IBH_ID
// Default:      0 ((CC_IB_P_ID_MNG_EN && CC_HP_MASTER) ? (1 -1 + (CC_ORDRB_EN ? 
//               CC_ORDRB_NIDO : 0) + CC_DMA_ENABLE_VALUE + (CC_IB_P_ID_MNG_RO_EN ? 
//               CC_WR_CH_P_REQ_QUEUE_DP : 0)) : 0)
// Values:       -2147483648, ..., 2147483647
// 
// Maximum AXI ID for IBH Posted Writes
`define CX_IB_P_ID_MNG_MAX_IBH_ID 0


`define CX_IB_P_ID_MNG_MAX_IBH_ID_WD 1


`define CC_MSTR_BUS_ID_WIDTH_NP 6


`define CC_MSTR_BUS_ID_WIDTH_P 10


`define CC_MSTR_BUS_ID_MAX 257


`define CC_MSTR_BUS_ID_WIDTH 10


`define CX_IB_P_ID_MNG_EXTRA_ID_WD 4


`define CX_IB_P_ID_MNG_EXTRA_ID_EN


// `define CX_MSI_CTRL_HALTABLE_EN


`define CX_MSI_RX_P_INC_DATA_WD 32


`define CX_MSI_RX_P_INC_WD 1


`define DC_INBD_HEADER_PNP_WD 357


`define DC_INBD_HEADER_PNP_WD_NP 349


// Name:         DC_INBD_HEADER_PNP_WD_NP_RAM
// Default:      310 (DC_INBD_HEADER_PNP_WD_NP - (13 + !CX_FLT_Q_ADDR_GT_32 + CX_NW 
//               + RADM_SEG_BUF + CX_MSI_CTRL_EN + 
//               CC_EDMA_SINGLE_CHANNEL*CC_DMA_ENABLE + CX_ATU_CTRL_EN*RADM_SEG_BUF + (CX_SINGLE_FUNC ? CX_NFUNC_WD : 
//               CX_NFUNC_WD-CX_NFUNC_WD_OPT) + (13-CC_MSTR_MTU_PW) + 
//               (CC_AXI_NCBE_NODECOMP ? CC_ERRATA_B112_EN ? 1 : (CC_MSTR_BE_CTRL_WIDTH+1) : 0 ) + 
