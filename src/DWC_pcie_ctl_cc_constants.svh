// 
// Width of order group of NP stream LTIM. For phase 1, ordering will be done on PCIe core side.
// `define CX_LTI_NP_OG_WIDTH


// Name:         CX_LTI_NP_LxUSER_WIDTH
// Default:      0
// Values:       0, 1
// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// Width of LTI channel user signals of NP stream LTIM. For phase 1, no user signals are available.
// `define CX_LTI_NP_LxUSER_WIDTH


