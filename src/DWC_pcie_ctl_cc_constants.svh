//  to be reprogrammed by the Root Complex.
`define CX_BAR2_RESIZABLE_2 1'h0


// Name:           CX_BAR2_RESOURCE_AVAIL_2
// Default:        0x10
// Values:         0x10, ..., 0xfffffffffff0
// Enabled:        CX_NFUNC > 2 && CX_BAR2_RESIZABLE_2==1
