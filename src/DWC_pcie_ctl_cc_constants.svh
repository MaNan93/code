// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// Width of implementation defined hardware attribute of P stream LTIM. For phase 1, no hardware attributes are available.
// `define CX_LTI_P_HW_ATTR_WIDTH


// Name:         CC_LTI_P_LRADDR_WIDTH
