// mode.
`define CX_PHY_RX_DELAY_SERDES_PIPE_EMPTY_GEN3 35


// Name:         CX_PHY_RX_DELAY_SERDES_PIPE_EMPTY_GEN4
// Default:      35 (!CX_GEN4_SPEED) ? 0 : ([<functionof> CX_SRIS_SUPPORT 
//               CX_PHY_NB_GEN4 CX_EBUF_SYNC_LTNCY CX_SERDES_ARCH_RX_REGIN CX_SERDES_ARCH_FPGA])
// Values:       0, ..., 500
// 
// Receive delay through the SerDes architecture module in GEN4 speed when the elastic buffer mode is nominal empty buffer 
// mode.
