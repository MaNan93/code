// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// Width of MSI control value of NP stream LTIM.
`define CX_LTI_NP_MSI_CTRL_WIDTH 6


// Name:         CX_LTI_MMU
// Default:      1
// Values:       0, 1
// Enabled:      CC_LTIM_ENABLE && CC_LTIM_B
// 
// Defines if the normal operation of SMMU address translation requests is supported by LTIM or not
`define CX_LTI_MMU


// Name:         CX_LTI_GPC
// Default:      0
// Values:       0, 1
// Enabled:      CC_LTIM_ENABLE && CC_LTIM_B
// 
// Defines if the Granule Protection Check operation is supported by LTIM or not.
// `define CX_LTI_GPC


// Name:           CC_ORDRB_NDRAMS
// Default:        1
// Values:         -2147483648, ..., 2147483647
// Enabled:        (CC_ORDRB_EN && (CX_MULTISTREAM_ARCH==0))
// Parameter Type: Feature Setting
// 
// Order Buffer Number of data RAMs.
`define CC_ORDRB_NDRAMS 1


// Name:           CC_ORDRB_HRAM_ADDR_WD
// Default:        6 (CC_ORDRB_TLP_ID_WIDTH)
// Values:         -2147483648, ..., 2147483647
// Enabled:        (CC_ORDRB_EN && (CX_MULTISTREAM_ARCH==0))
// Parameter Type: Feature Setting
// 
// Order Buffer Header ram address width used in order buffer AHRAM and OHRAM.
`define CC_ORDRB_HRAM_ADDR_WD 6


// Name:           CC_ORDRB_HRAM_ADDRP_WD
// Default:        1 (CX_RAS_EN==1 ? [<functionof> CC_ORDRB_HRAM_ADDR_WD 
//                 CX_RAS_PROT_RANGE] : 1)
// Values:         -2147483648, ..., 2147483647
// Enabled:        (CC_ORDRB_EN && (CX_MULTISTREAM_ARCH==0))
// Parameter Type: Feature Setting
// 
// Order Buffer Header ram address width used in order buffer AHRAM and OHRAM, address parity width.
`define CC_ORDRB_HRAM_ADDRP_WD 1


`define CC_ORDRB_AHRAM_DATA_WD_NOECC 64


// Name:           CC_ORDRB_AHRAM_DATA_WD
// Default:        72 (CX_RAS_EN==1 ? [<functionof> 0 CC_ORDRB_AHRAM_DATA_WD_NOECC 
//                 CX_RAS_RAM_PROT_RANGE] + CC_ORDRB_AHRAM_DATA_WD_NOECC : 
//                 CC_ORDRB_AHRAM_DATA_WD_NOECC)
// Values:         -2147483648, ..., 2147483647
// Enabled:        (CC_ORDRB_EN && (CX_MULTISTREAM_ARCH==0))
// Parameter Type: Feature Setting
// 
// Order Buffer address header ram data width.
`define CC_ORDRB_AHRAM_DATA_WD 72


`define CC_ORDRB_OHRAM_DATA_WD_NOECC 339


// Name:           CC_ORDRB_OHRAM_DATA_WD
// Default:        385 (CX_RAS_EN==1 ? [<functionof> 0 CC_ORDRB_OHRAM_DATA_WD_NOECC 
//                 CX_RAS_RAM_PROT_RANGE] + CC_ORDRB_OHRAM_DATA_WD_NOECC : 
//                 CC_ORDRB_OHRAM_DATA_WD_NOECC)
// Values:         -2147483648, ..., 2147483647
// Enabled:        (CC_ORDRB_EN && (CX_MULTISTREAM_ARCH==0))
// Parameter Type: Feature Setting
// 
// Order Buffer other header ram data width. It include all the header data except the address.
`define CC_ORDRB_OHRAM_DATA_WD 385


// Name:           CC_ORDRB_AVG_MTU
// Default:        128
// Values:         128 256 512 1024 2048 4096
// Enabled:        (CC_ORDRB_EN && (CX_MULTISTREAM_ARCH==0))
// Parameter Type: Feature Setting
// 
// The average MTU received by the orderbuffer. 
// Range: 128 to CX_MAX_MTU.
`define CC_ORDRB_AVG_MTU 128


// Name:           CC_ORDRB_DRAM_SZ
// Default:        4096 (CC_ORDRB_HRAM_WR_DP * CC_ORDRB_AVG_MTU)
// Values:         -2147483648, ..., 2147483647
// Enabled:        (CC_ORDRB_EN && (CX_MULTISTREAM_ARCH==0))
// Parameter Type: Feature Setting
// 
// Order buffer DRAM total size. It is calculated by multiplying the maximum possible write transactions 
// (CC_ORDRB_HRAM_WR_DP) by the average received TLP length (CC_ORDRB_AVG_MTU)..
`define CC_ORDRB_DRAM_SZ 4096


// Name:           CC_ORDRB_DRAM_DP
// Default:        256 (CC_ORDRB_DRAM_SZ > (32*CX_MAX_MTU)) ? 
//                 (CC_ORDRB_DRAM_SZ/(4*CX_NW)) : (CC_LTI_ID_WIDTH == 4) ? (16*CX_MAX_MTU/(4*CX_NW)) : 
//                 (32*CX_MAX_MTU/(4*CX_NW))
// Values:         -2147483648, ..., 2147483647
// Enabled:        (CC_ORDRB_EN && (CX_MULTISTREAM_ARCH==0))
// Parameter Type: Feature Setting
// 
// Order buffer DRAM Depth. It is assumed that the DRAM data width is 4*CX_NW bytes.
`define CC_ORDRB_DRAM_DP 256


// Name:           CC_LTI_TRANSLATION_LATENCY
// Default:        0 ((CC_LTIM_ENABLE) ? 6 : 0)
// Values:         -2147483648, ..., 2147483647
// Enabled:        CC_LTIM_ENABLE
// Parameter Type: Feature Setting
// 
// LTI Translation Hit Latency in clock cycles
`define CC_LTI_TRANSLATION_LATENCY 0


// Name:           CC_LTI_ID_WIDTH_GREATER_THAN_4
// Default:        1 (((CC_ORDRB_TLP_ID_WIDTH) > 4) ? 1 : 0)
// Values:         -2147483648, ..., 2147483647
// Enabled:        CC_ORDRB_EN
// Parameter Type: Feature Setting
// 
// LTI ID Width is greater than 4
`define CC_LTI_ID_WIDTH_GREATER_THAN_4 1


// Name:           CC_ORDRB_DRAM_ADDR_WD
// Default:        8 ([<functionof> (CC_ORDRB_DRAM_SZ > (32*CX_MAX_MTU)) ? 
//                 (CC_ORDRB_DRAM_SZ/(4*CX_NW)) : (CC_LTI_ID_WIDTH == 4) ? 
//                 (16*CX_MAX_MTU/(4*CX_NW)) : (32*CX_MAX_MTU/(4*CX_NW))])
// Values:         -2147483648, ..., 2147483647
// Enabled:        CC_ORDRB_EN
// Parameter Type: Feature Setting
// 
// Order Buffer data ram address width.
`define CC_ORDRB_DRAM_ADDR_WD 8


// Name:           CC_ORDRB_DRAM_ADDRP_WD
// Default:        1 (CX_RAS_EN==1 ? [<functionof> CC_ORDRB_DRAM_ADDR_WD 
//                 CX_RAS_PROT_RANGE] : 1)
// Values:         -2147483648, ..., 2147483647
// Enabled:        (CC_ORDRB_EN && (CX_MULTISTREAM_ARCH==0))
// Parameter Type: Feature Setting
// 
// Order Buffer data ram address width, address parity width.
`define CC_ORDRB_DRAM_ADDRP_WD 1


`define CC_ORDRB_DRAM_DATA_WD_NOECC 512


// Name:           CC_ORDRB_DRAM_DATA_WD
// Default:        576 (CX_RAS_EN==1 ? [<functionof> 0 CC_ORDRB_DRAM_DATA_WD_NOECC 
//                 CX_RAS_RAM_PROT_RANGE] + CC_ORDRB_DRAM_DATA_WD_NOECC : 
//                 CC_ORDRB_DRAM_DATA_WD_NOECC)
// Values:         -2147483648, ..., 2147483647
// Enabled:        (CC_ORDRB_EN && (CX_MULTISTREAM_ARCH==0))
// Parameter Type: Feature Setting
