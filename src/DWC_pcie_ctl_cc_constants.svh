// Name:           DEFAULT_GEN5_RXMARGIN_SAMPLE_REPORTING_METHOD
// Default:        0 (DEFAULT_GEN4_RXMARGIN_SAMPLE_REPORTING_METHOD)
// Values:         0, 1
// Enabled:        CX_MARGIN_ENABLE && CX_GEN5_SPEED
