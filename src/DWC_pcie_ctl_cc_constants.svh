`define CX_RASDP_TRGT1_CPL_HDR_PROT_WD 17


// Name:         FLT_Q_COMMON_WIDTH
// Default:      159 ([<functionof> FLT_Q_DESTINATION_WIDTH FLT_Q_FMT_WIDTH  
//               FLT_Q_TYPE_WIDTH  FLT_Q_TC_WIDTH  FLT_Q_ATTR_WIDTH  FLT_Q_LN_WIDTH 
