`define DEFAULT_GEN5_RXMARGIN_MAX_VOLTAGE_OFFSET 5


// Name:           DEFAULT_GEN5_RXMARGIN_SAMPLE_RATE_VOLTAGE
// Default:        0 (DEFAULT_GEN4_RXMARGIN_SAMPLE_RATE_VOLTAGE)
