`define BAR3_TYPE_0 2'h0


// Name:           BAR3_SIZING_SCHEME_0
// Default:        Fixed Mask
// Values:         Fixed Mask (0x0), Programmable Mask (0x1), Resizable BAR (0x2)
// Enabled:        BAR3_ENABLED_0==1
// Parameter Type: Feature Setting
