// Default:        0x1 (CX_ACS_P2P_EGRESS_CTRL_0)
// Values:         0x0, 0x1
// Enabled:        CX_ACS_ENABLE
// Parameter Type: Feature Setting
// 
// This is the default value (after reset) of the ACS P2P Egress Control bit field in the ACS Capability register in PF2. 
// If 1b, indicates that the component implements ACS P2P Egress Control.
`define CX_ACS_P2P_EGRESS_CTRL_2 1'h1


// Name:           CX_ACS_P2P_DIRECT_TRANSL_2
// Default:        0x1 (CX_ACS_P2P_DIRECT_TRANSL_0)
// Values:         0x0, 0x1
// Enabled:        CX_ACS_ENABLE
// Parameter Type: Feature Setting
// 
