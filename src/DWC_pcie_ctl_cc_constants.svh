// 
// This is read-only parameter to indicate how much wire skew for CCIX ESM 20G speed your deskew buffer setting 
// (CX_DESKEW_DEPTH_CPCIE) ensures.
`define CX_WIRE_SKEW_CCIX20G_NS 0


// Name:           CX_WIRE_SKEW_CCIX25G_NS
