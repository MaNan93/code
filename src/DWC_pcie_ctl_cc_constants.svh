// Parameter Type: Feature Setting.
// 
// Receiver L0P Supported
`define CX_RECEIVER_L0P_SUPPORTED 1


// Name:           CX_PORT_L0P_EXIT_LATENCY
// Default:        0
// Values:         0, ..., 7
// Enabled:        ((CX_L0P_EN))
// Parameter Type: Feature Setting.
// 
// Port L0p Exit Latency. The value reported indicates the length of time this Port requires to complete widening a link 
// using L0p.
`define CX_PORT_L0P_EXIT_LATENCY 0


// Name:           CX_RETIMER_L0P_EXIT_LATENCY
// Default:        0
// Values:         0, ..., 7
// Enabled:        ((CX_L0P_EN))
// Parameter Type: Feature Setting.
// 
// Retimer L0p Exit Latency. The value reported indicates the length of time a Retimer requires to complete widening a link 
// using L0p.
`define CX_RETIMER_L0P_EXIT_LATENCY 0


// Name:           CX_LOCAL_L0P_EXIT_LATENCY
// Default:        0 (CX_PORT_L0P_EXIT_LATENCY > CX_RETIMER_L0P_EXIT_LATENCY? 
//                 CX_PORT_L0P_EXIT_LATENCY : CX_RETIMER_L0P_EXIT_LATENCY)
// Values:         0, ..., 7
// Enabled:        ((CX_L0P_EN))
// Parameter Type: Feature Setting.
// 
// Local L0p Exit Latency. The value reported is the larger of Port L0p Exit Latency and Retimer L0p Exit Latency
`define CX_LOCAL_L0P_EXIT_LATENCY 0


