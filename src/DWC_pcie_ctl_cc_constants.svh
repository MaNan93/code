//               CX_RAS_RAM_PROT_RANGE] + RAM_WD_VC0_NP_NO_ECC : 
//               RAM_WD_VC0_NP_NO_ECC)
// Values:       -2147483648, ..., 2147483647
// 
// VC6 Non-Posted Queue QDW Buffer Bit Width, No Protection.
`define RAM_WD_VC6_NP_NO_ECC 178


// Name:         RAM_WD_VC6_NP
// Default:      178 (CX_RASDP_EN ? [<functionof> RAM_PW_VC0_NP RAM_WD_VC0_NP_NO_ECC 
//               CX_RAS_RAM_PROT_RANGE] + RAM_WD_VC0_NP_NO_ECC : 
//               RAM_WD_VC0_NP_NO_ECC)
// Values:       -2147483648, ..., 2147483647
// 
// VC6 Non-Posted Queue QDW Buffer Bit Width
`define RAM_WD_VC6_NP 178


// Name:         RAM_WD_VC6_CPL_NO_ECC
// Default:      155 (137 + CX_FLIT_MODE_ENABLE*2 + CX_RADM_PKT_ORD_WD)
// Values:       -2147483648, ..., 2147483647
// 
// VC6 Completion Queue QDW Buffer Bit Width, No Protection.
`define RAM_WD_VC6_CPL_NO_ECC 155


// Name:         RAM_WD_VC6_CPL
// Default:      178 (CX_RASDP_EN ? [<functionof> RAM_PW_VC0_CPL 
//               RAM_WD_VC0_CPL_NO_ECC CX_RAS_RAM_PROT_RANGE] + RAM_WD_VC0_CPL_NO_ECC : 
//               RAM_WD_VC0_CPL_NO_ECC)
// Values:       -2147483648, ..., 2147483647
// 
// VC6 Completion Queue QDW Buffer Bit Width
`define RAM_WD_VC6_CPL 178


// Name:         RAM_WD_VC7_P_NO_ECC
// Default:      155 (137 + CX_FLIT_MODE_ENABLE*2 + CX_RADM_PKT_ORD_WD)
// Values:       -2147483648, ..., 2147483647
// 
// VC7 Posted Queue QDW Buffer Bit Width, No Protection.
`define RAM_WD_VC7_P_NO_ECC 155


// Name:         RAM_WD_VC7_P
// Default:      178 (CX_RASDP_EN ? [<functionof> RAM_PW_VC0_P RAM_WD_VC0_P_NO_ECC 
//               CX_RAS_RAM_PROT_RANGE] + RAM_WD_VC0_P_NO_ECC : RAM_WD_VC0_P_NO_ECC)
// Values:       -2147483648, ..., 2147483647
// 
// VC7 Posted Queue QDW Buffer Bit Width
`define RAM_WD_VC7_P 178


// Name:         RAM_WD_VC7_NP_NO_ECC
// Default:      178 (CX_RASDP_EN ? [<functionof> RAM_PW_VC0_NP RAM_WD_VC0_NP_NO_ECC 
//               CX_RAS_RAM_PROT_RANGE] + RAM_WD_VC0_NP_NO_ECC : 
//               RAM_WD_VC0_NP_NO_ECC)
// Values:       -2147483648, ..., 2147483647
// 
// VC7 Non-Posted Queue QDW Buffer Bit Width, No Protection.
`define RAM_WD_VC7_NP_NO_ECC 178


// Name:         RAM_WD_VC7_NP
// Default:      178 (CX_RASDP_EN ? [<functionof> RAM_PW_VC0_NP RAM_WD_VC0_NP_NO_ECC 
//               CX_RAS_RAM_PROT_RANGE] + RAM_WD_VC0_NP_NO_ECC : 
//               RAM_WD_VC0_NP_NO_ECC)
// Values:       -2147483648, ..., 2147483647
// 
// VC7 Non-Posted Queue QDW Buffer Bit Width
`define RAM_WD_VC7_NP 178


// Name:         RAM_WD_VC7_CPL_NO_ECC
// Default:      155 (137 + CX_FLIT_MODE_ENABLE*2 + CX_RADM_PKT_ORD_WD)
// Values:       -2147483648, ..., 2147483647
// 
// VC7 Completion Queue QDW Buffer Bit Width, No Protection.
`define RAM_WD_VC7_CPL_NO_ECC 155


// Name:         RAM_WD_VC7_CPL
// Default:      178 (CX_RASDP_EN ? [<functionof> RAM_PW_VC0_CPL 
//               RAM_WD_VC0_CPL_NO_ECC CX_RAS_RAM_PROT_RANGE] + RAM_WD_VC0_CPL_NO_ECC : 
//               RAM_WD_VC0_CPL_NO_ECC)
// Values:       -2147483648, ..., 2147483647
// 
// VC7 Completion Queue QDW Buffer Bit Width
`define RAM_WD_VC7_CPL 178

// =============================================================================

// Name:         CX_FRAG_TAG
// Default:      512 ((1024 > (CX_MAX_TAG+1)) ? CX_MAX_TAG+1 : 1024)
// Values:       -2147483648, ..., 2147483647
// 
// RADM CPL LUT Fragment TAG SIZE.
`define CX_FRAG_TAG 512



// Name:         CX_N_FRAGMENT
// Default:      1 ((CX_MAX_TAG/CX_FRAG_TAG) + (CX_MAX_TAG%CX_FRAG_TAG !=0))
// Values:       -2147483648, ..., 2147483647
// 
// Number of RADM CPL LUT Fragments.
`define CX_N_FRAGMENT 1



// Name:         CX_PARTIAL_FRAG
// Default:      0 (((CX_FRAG_TAG>512) & (CX_FRAG_TAG<1024)? 1 : 0))
// Values:       0, 1
// 
// Fragment tags not aligned with power of 2 bit width.
// `define CX_PARTIAL_FRAG


// Name:         FRAGMENTED_LUT
// Default:      0 (((CX_MAX_TAG/CX_FRAG_TAG) + (CX_MAX_TAG%CX_FRAG_TAG !=0))>1 ? 1 
//               : 0)
// Values:       0, 1
// 
// CPL LUT is fragmented.
// `define FRAGMENTED_LUT


// Name:         CX_MULTI_PORT_TEMP_PATCH
// Default:      0 ((CX_N_FC_IF_VC0) > 1? 1 : 0)
// Values:       0, 1
// 
// Enable temporary patch to have multiport tx datapath with non-multiport rx datapath.
// `define CX_MULTI_PORT_TEMP_PATCH


// Name:         CX_RADM_FORMQ_N_READ_PORT_VC
// Default:      1 (CX_MULTI_PORT_TEMP_PATCH? 1 : N_XADM_NP_IF)
// Values:       -2147483648, ..., 2147483647
// 
// Number of read ports for formation queue.
`define CX_RADM_FORMQ_N_READ_PORT_VC 1


// `define FORMQ_RD_PORTS_GRT_1


`define CX_RADM_NFC_TRGT_INTF 1


// Name:         CX_HDR_LOG_SERIALIZE_EN
// Default:      1 (CX_GEN6_SPEED)
// Values:       0, 1
// 
// Enable radm_hdr_log
`define CX_HDR_LOG_SERIALIZE_EN


`define TPH_SIZE 12'hc
