// Specifies if controller supports 4s operation
`define CX_4S_EN


// Name:         CX_8S_EN
// Default:      1 ((CX_NB_GEN3==8) || (CX_NB_GEN4==8) || (CX_NB_GEN5==8) || 
//               (CX_NB_GEN6==8))
// Values:       0, 1
// 
// Specifies if controller supports 8s operation
`define CX_8S_EN


// Name:         CX_16S_EN
// Default:      0 ((CX_NB_GEN3==16) || (CX_NB_GEN4==16) || (CX_NB_GEN5==16) || 
//               (CX_NB_GEN6==16))
// Values:       0, 1
// 
// Specifies if controller supports 16s operation
// `define CX_16S_EN


// Name:         CX_32S_EN
// Default:      0 ((CX_GEN6_SPEED ? CX_MAC_SMODE_GEN6 : CX_NB_GEN5 )==32)
// Values:       0, 1
// 
// Specifies if controller supports 16s operation
// `define CX_32S_EN


// Name:         CX_1S_EN_GEN34
// Default:      0 ((CX_MAX_PCIE_SPEED>=3) && ((CX_NB_GEN3==1) || (CX_NB_GEN4==1) || 
//               (CX_NB_GEN5==1)))
// Values:       0, 1
// 
// Specifies if controller supports 1s operation in 128b130b encoding(gen3/gen4)
// `define CX_1S_EN_GEN34


// Name:         CX_2S_EN_GEN34
// Default:      0 ((CX_MAX_PCIE_SPEED>=3) && ((CX_NB_GEN3==2) || (CX_NB_GEN4==2) || 
//               (CX_NB_GEN5==2)))
// Values:       0, 1
// 
// Specifies if controller supports 2s operation in 128b130b encoding(gen3/gen4)
// `define CX_2S_EN_GEN34


// Name:         CX_4S_EN_GEN34
// Default:      1 ((CX_MAX_PCIE_SPEED>=3) && ((CX_NB_GEN3==4) || (CX_NB_GEN4==4) || 
//               (CX_NB_GEN5==4) || (CX_NB_GEN6==4)))
// Values:       0, 1
// 
// Specifies if controller supports 4s operation in 128b130b encoding(gen3/gen4). Note : When CX_GEN4_DYNAMIC_WIDTH, both 
// CX_128B_4S_EN and CX_128B_8S_EN is enabled.
`define CX_4S_EN_GEN34


// Name:         CX_8S_EN_GEN34
// Default:      1 ((CX_MAX_PCIE_SPEED>=3) && ((CX_NB_GEN3==8) || (CX_NB_GEN4==8) || 
//               (CX_NB_GEN5==8) || (CX_NB_GEN6==8)))
// Values:       0, 1
// 
// Specifies if controller supports 8s operation in 128b130b encoding(gen3/gen4)
`define CX_8S_EN_GEN34




// Name:         CX_PHY_4S_EN_GEN34
// Default:      1 ((CX_MAX_PCIE_SPEED>=3) && ((CX_PHY_NB_GEN3==4) || 
//               (CX_PHY_NB_GEN4==4) || (CX_PHY_NB_GEN5==4) || (CX_PHY_NB_GEN6==4)))
// Values:       0, 1
// 
// Specifies if phy supports 4s operation in 128b130b encoding(gen3/gen4)
`define CX_PHY_4S_EN_GEN34


// Name:         CX_PHY_8S_EN_GEN34
// Default:      1 ((CX_MAX_PCIE_SPEED>=3) && ((CX_PHY_NB_GEN3==8) || 
//               (CX_PHY_NB_GEN4==8) || (CX_PHY_NB_GEN5==8) || (CX_PHY_NB_GEN6==8)))
// Values:       0, 1
// 
// Specifies if phy supports 8s operation in 128b130b encoding(gen3/gen4)
`define CX_PHY_8S_EN_GEN34


// Name:         CX_PHY_16S_EN_GEN34
// Default:      0 ((CX_MAX_PCIE_SPEED>=3) && ((CX_PHY_NB_GEN3==16) || 
//               (CX_PHY_NB_GEN4==16) || (CX_PHY_NB_GEN5==16) || (CX_PHY_NB_GEN6==16)))
// Values:       0, 1
// 
// Specifies if phy supports 16s operation in 128b130b encoding(gen3/gen4)
// `define CX_PHY_16S_EN_GEN34


// Name:         CX_PHY_32S_EN_GEN34
// Default:      0 ((CX_MAX_PCIE_SPEED>=3) && (CX_PHY_NB_GEN6==32))
// Values:       0, 1
// 
// Specifies if phy supports 32s operation in 1b/1b encoding(gen6)
// `define CX_PHY_32S_EN_GEN34






// Name:           CX_NFTS
// Default:        32 ((CX_PHY_NB==32) ? 128 : ((CX_PHY_NB>8) || CX_PIPE_SERDES_ARCH) 
//                 ? 32 : 15)
// Values:         1, ..., 255
// Parameter Type: Register Default Setting
// 
// Specifies the number of Fast Training Sequences the controller advertises during link training. This is used to inform 
// the link partner of the controllers ability to recover synchronization after a low power state. This number should come 
// from your PHY vendor. This parameter sets the default value of the ACK_N_FTS field of the 'Ack Frequency and L0-L1 ASPM 
// Control Register'. 
//  
// For SerDes architecture, this number should be the following: 
//  - CX_NFTS =32 + the number of FTS that your PHY vendor requires to detect bit lock.
`define CX_NFTS 8'd200


// Name:           DEFAULT_GEN2_N_FTS
// Default:        200 (CX_NFTS)
// Values:         0, ..., 255
// Enabled:        ((CX_GEN2_MODE != GEN2_DISABLED) == 1)
// Parameter Type: Feature Setting
// 
// Specifies the number of Fast Training Sequences (NFTS) the controller advertises during link training when running at 
// Gen 2 or higher speed. This is used to inform the link partner the controllers ability to recover synchronization after a 
// low power state. This number should come from your PHY vendor. This parameter is for Conventional PCIe mode only. 
//  
// For SerDes architecture, this number should be the following: 
//  - CX_NFTS =32 + the number of FTS that your PHY vendor requires to detect bit lock.
`define DEFAULT_GEN2_N_FTS 8'd200


// Name:           CX_COMM_NFTS
// Default:        200 (CX_NFTS)
// Values:         1, ..., 255
// Enabled:        SLOT_CLK_CONFIG
// Parameter Type: Register Default Setting
// 
// Specifies the number of Fast Training Sequences (NFTS) the controller advertises during link training, when common clock 
// configuration is set. 
//  
// This parameter sets the default value of the Common Clock ACK_N_FTS field of the 'Ack Frequency and L0-L1 ASPM Control 
// Register'. Common Clock operation is enabled (through the Common Clock Configuration field of the Link Control register) 
// Default value is set automatically unless Custom PHY or Sample PHY is used. 
//  
// For SerDes architecture, this number should be the following: 
//  - CX_NFTS =32 + the number of FTS that your PHY vendor requires to detect bit lock.
`define CX_COMM_NFTS 8'd200


`define CX_MAX_NFTS_TMP 200


`define CX_MAX_NFTS 200


// Name:         CX_MAX_L0S_LTIME
// Default:      200 ((CX_GEN2_SPEED==1) ? ((DEFAULT_GEN2_N_FTS > CX_MAX_NFTS_TMP) ? 
//               DEFAULT_GEN2_N_FTS : CX_MAX_NFTS_TMP) : CX_MAX_NFTS_TMP)
// Values:       -2147483648, ..., 2147483647
// 
// Indicates max time to exit L0s(STALL when M-PCIe) (unit 4byte). 
// In C-PCIe case , the maximum value of  all NFTS (Already exits). In M-PCIe case , the maximum value of  all Sync length 
// plus Prepare length. When Selectable PHY Mode, this parameter is the bigger value of above two values. This parameter is 
// used for a lot of parameters that need calculate.
`define CX_MAX_L0S_LTIME 200


// Name:         CX_5GTS_SPEED
// Default:      1 (CX_GEN2_MODE != GEN2_DISABLED)
// Values:       0, 1
// 
// Indicates controller support 5GTs. It means Gen2 support when C-PCIE, HS-Gear3 support when M-PCIe. This parameter is 
// used for a lot of parameters that need calculate.
`define CX_5GTS_SPEED


// Name:           DEFAULT_L0S_EXIT_LATENCY
// Default:        2us to 4us ([<functionof> ((CX_GEN2_SPEED==1) ? 
//                 ((DEFAULT_GEN2_N_FTS > CX_MAX_NFTS_TMP) ? DEFAULT_GEN2_N_FTS : CX_MAX_NFTS_TMP) : 
//                 CX_MAX_NFTS_TMP) ])
// Values:         Less than 64ns (0x0), 64ns to less than 128ns (0x1), 128ns to less 
//                 than 256ns (0x2), 256ns to less than 512ns (0x3), 512ns to less than 
//                 1us (0x4), 1us to less than 2us (0x5), 2us to 4us (0x6), More than 
//                 4us (0x7)
// Parameter Type: Register Default Setting
// 
// Default value for the L0s Exit Latency field in the 'Link Capabilities Register'.
`define DEFAULT_L0S_EXIT_LATENCY 3'h6


// Name:           DEFAULT_COMM_L0S_EXIT_LATENCY
// Default:        2us to 4us ([<functionof> CX_COMM_NFTS ])
// Values:         Less than 64ns (0x0), 64ns to less than 128ns (0x1), 128ns to less 
//                 than 256ns (0x2), 256ns to less than 512ns (0x3), 512ns to less than 
//                 1us (0x4), 1us to less than 2us (0x5), 2us to 4us (0x6), More than 
//                 4us (0x7)
// Enabled:        SLOT_CLK_CONFIG
// Parameter Type: Register Default Setting
// 
// Default value for the L0s Exit Latency field in the 'Link Capabilities Register' when common clock is used. Common Clock 
// operation is enabled (through the Common Clock Configuration field of the Link Control register)
`define DEFAULT_COMM_L0S_EXIT_LATENCY 3'h6


// Name:           DEFAULT_L1_EXIT_LATENCY
// Default:        32us to 64us
// Values:         Less than 1us (0x0), 1us to less than 2us (0x1), 2us to less than 
//                 4us (0x2), 4us to less than 8us (0x3), 8us to less than 16us (0x4), 
//                 16us to less than 32us (0x5), 32us to 64us (0x6), More than 64us (0x7)
// Parameter Type: Register Default Setting
// 
// Default value for the L1 Exit Latency field in the 'Link Capabilities Register'. This parameter represents a 
// characteristic of the PHY being used. It measures the total time from when the controller initiates a transition from P1 to P0 until 
// the PHY begins providing valid receive data to the controller. This parameter is for conventional PCIe mode only.
`define DEFAULT_L1_EXIT_LATENCY 3'h6


// Name:           DEFAULT_COMM_L1_EXIT_LATENCY
// Default:        32us to 64us
// Values:         Less than 1us (0x0), 1us to less than 2us (0x1), 2us to less than 
//                 4us (0x2), 4us to less than 8us (0x3), 8us to less than 16us (0x4), 
//                 16us to less than 32us (0x5), 32us to 64us (0x6), More than 64us (0x7)
// Enabled:        SLOT_CLK_CONFIG
// Parameter Type: Register Default Setting
// 
// Default value for the L1 Exit Latency field in the 'Link Capabilities Register', when common clock is used. It measures 
// the total time from when the controller initiates a transition from P1 to P0 until the PHY begins providing valid receive 
// data to the controller.  Common Clock operation is enabled (through the Common Clock Configuration field of the Link 
// Control register) 
// This parameter is for Conventional PCIe mode only.
`define DEFAULT_COMM_L1_EXIT_LATENCY 3'h6


`define DEFAULT_GEN2_TXSWING 0


// Name:           DEFAULT_GEN2_SPEED_CHANGE
// Default:        0
// Values:         0, 1
// Enabled:        CX_GEN2_MODE != GEN2_DISABLED
// Parameter Type: Register Default Setting
// 
// Enables the controller to initiate a Gen1 -> Gen2 and Gen2 -> Gen3 speed change after the link is initialized. Only 
// applicable for Gen2 or Gen3 configured controllers. This is the default value of the "Directed Speed Change" field of the 
// "Link width and Speed Change Control" register.
`define DEFAULT_GEN2_SPEED_CHANGE 0


// Name:           DEFAULT_FC_WATCH_DOG_DISABLE
// Default:        0
// Values:         0, 1
// Parameter Type: Feature Setting
// 
// Default value of the Disable FC Watchdog Timer bit of the 'Symbol Timer Register and Filter Mask 1' Register, in the 
// 'Registers' section of the Databook.
`define DEFAULT_FC_WATCH_DOG_DISABLE 1'd0


// Name:           CX_DESKEW_DISABLE
// Default:        false (CX_PCIE_MODE == PCIE_OVER_CIO) ? 1 : (CX_NL == 1)
// Values:         false (0x0), true (0x1)
// Enabled:        (CX_PCIE_MODE == PCIE_OVER_CIO) ? 0 : (CX_NL > 1)
// Parameter Type: Feature Setting
// 
// Disable the deskewing mechanism. Disable the deskewing mechanism only if connecting to a multi-Lane PHY that implements 
// Lane-to-Lane deskewing.
`define CX_DESKEW_DISABLE 1'h0



// Name:           CX_WIRE_SKEW_GEN1_NS
// Default:        20
// Values:         0, ..., 60
// Enabled:        CX_SKEW_CUSTOM==1
// Parameter Type: Feature Setting
// 
// This is read-only parameter to indicate how much wire skew for Gen1 speed your deskew buffer setting 
// (CX_DESKEW_DEPTH_CPCIE) ensures.
`define CX_WIRE_SKEW_GEN1_NS 20


// Name:           CX_WIRE_SKEW_GEN2_NS
// Default:        8 (((CX_GEN2_MODE != GEN2_DISABLED)==1) ? 8 : 0)
// Values:         0, ..., 60
// Enabled:        CX_GEN2_SPEED==1 && CX_SKEW_CUSTOM==1
// Parameter Type: Feature Setting
// 
// This is read-only parameter to indicate how much wire skew for Gen2 speed your deskew buffer setting 
// (CX_DESKEW_DEPTH_CPCIE) ensures.
`define CX_WIRE_SKEW_GEN2_NS 8


// Name:           CX_WIRE_SKEW_GEN3_NS
// Default:        6 (((CX_GEN3_MODE != GEN3_DISABLED)==1) ? 6 : 0)
// Values:         0, ..., 60
// Enabled:        CX_GEN3_SPEED==1 && CX_SKEW_CUSTOM==1
// Parameter Type: Feature Setting
// 
// This is read-only parameter to indicate how much wire skew for Gen3 speed your deskew buffer setting 
// (CX_DESKEW_DEPTH_CPCIE) ensures.
`define CX_WIRE_SKEW_GEN3_NS 6


// Name:           CX_WIRE_SKEW_GEN4_NS
// Default:        5 (((CX_GEN4_MODE != GEN4_DISABLED)==1) ? 5 : 0)
// Values:         0, ..., 60
// Enabled:        CX_GEN4_SPEED==1 && CX_SKEW_CUSTOM==1
// Parameter Type: Feature Setting
// 
// This is read-only parameter to indicate how much wire skew for Gen4 speed your deskew buffer setting 
// (CX_DESKEW_DEPTH_CPCIE) ensures.
`define CX_WIRE_SKEW_GEN4_NS 5


// Name:           CX_WIRE_SKEW_GEN5_NS
// Default:        5 (((CX_MAX_PCIE_SPEED >= 5)==1) ? 5 : 0)
// Values:         0, ..., 60
// Enabled:        CX_GEN5_SPEED==1 && CX_SKEW_CUSTOM==1
// Parameter Type: Feature Setting
// 
// This is read-only parameter to indicate how much wire skew for Gen5 speed your deskew buffer setting 
// (CX_DESKEW_DEPTH_CPCIE) ensures.
`define CX_WIRE_SKEW_GEN5_NS 5


// Name:           CX_WIRE_SKEW_GEN6_NS
// Default:        5 (((CX_MAX_PCIE_SPEED >= 6)==1) ? 5 : 0)
// Values:         0, ..., 60
// Enabled:        CX_GEN6_SPEED==1 && CX_SKEW_CUSTOM==1
// Parameter Type: Feature Setting
// 
// This is read-only parameter to indicate how much wire skew for Gen6 speed your deskew buffer setting 
// (CX_DESKEW_DEPTH_CPCIE) ensures.
`define CX_WIRE_SKEW_GEN6_NS 5


// Name:           CX_WIRE_SKEW_CCIX20G_NS
// Default:        0 ((CX_CCIX_ESM_SUPPORT==1) ? 4 : 0)
