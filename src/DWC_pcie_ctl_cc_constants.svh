// Values:       0, 1
// 
// Enable CXL Host Packer
`define CX_CXL_DSP_PACKER_ENABLE


// Name:         CX_SW_IS_NOT_CXL
// Default:      0 (CX_IS_SW && !CX_CXL_ENABLE)
// Values:       0, 1
