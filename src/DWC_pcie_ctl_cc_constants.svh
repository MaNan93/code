// Default:      32 (CC_HP_MASTER ? (CC_MAX_MSTRH_TAGS_AXI < CC_MAX_MSTRL_TAGS_AXI ? 
//               CC_MAX_MSTRH_TAGS_AXI : CC_MAX_MSTRL_TAGS_AXI) : CC_MAX_MSTR_TAGS)
