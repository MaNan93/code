//               FLT_Q_DW_LENGTH_WIDTH + (EP_INTERFACE_ACTIVATED==1 ?  FLT_Q_IN_MEMBAR_RANGE_WIDTH : 0) + 
//               (EP_INTERFACE_ACTIVATED==1 ?  FLT_Q_ROM_IN_RANGE_WIDTH :0) + 
//               FLT_Q_FRSTDW_BE_WIDTH + FLT_Q_ADDR_WIDTH + FLT_Q_TD_WIDTH + 
//               (CX_TPH_ENABLE_VALUE * FLT_Q_TH_WIDTH) + (ATS_RX_ENABLE_VALUE * FLT_Q_AT_WIDTH) + 
//               FLT_Q_EP_WIDTH + FLT_Q_LSTDW_BE_WIDTH + (CX_FLIT_MODE_ENABLE==1 ?  18 : 
//               0 ) + (CX_TPH_ENABLE_VALUE * 10) + (CX_ATU_CTRL_EN==1 ? 1 :0 ) + 
//               (CX_IDE_ENABLE_NO_PASSTHROUGH==1 ?   1 :0) + CX_RADM_PKT_ORD_WD + 
//               FLT_Q_ADDR_WIDTH)   : 0)
// Values:       -2147483648, ..., 2147483647
// 
// Total width of the header fields protected in the TARGET Posted interface
`define CX_RASDP_TRGT1_P_HDR_WD 249


// Name:         CX_RASDP_TRGT1_P_HDR_PROT_WD
// Default:      32 ((CX_RASDP_EN==1 && CX_MULTISTREAM_ARCH==1) ? [<functionof> 
//               CX_RASDP_TRGT1_P_HDR_WD CX_RAS_PROT_RANGE RAS_BASE_PROT_WD]:0)
// Values:       -2147483648, ..., 2147483647
// 
// Width of the protection code covering the header fields protected in the TARGET Posted interface
`define CX_RASDP_TRGT1_P_HDR_PROT_WD 32


// Name:         CX_RASDP_TRGT1_NP_HDR_WD
// Default:      187 ((CX_RASDP_EN==1 && CX_MULTISTREAM_ARCH==1) ? ( 7 + 
//               FLT_Q_TC_WIDTH + FLT_Q_ATTR_WIDTH + (CX_LN_VALUE * FLT_Q_LN_WIDTH) + 
//               FLT_Q_REQID_WIDTH + FLT_Q_TAG_WIDTH + FLT_Q_FUNC_NMBR_WIDTH + 
//               FLT_Q_CPL_STATUS_WIDTH + (CX_SRIOV_ENABLE_VALUE*FLT_Q_VF_WIDTH) + FLT_Q_DW_LENGTH_WIDTH 
//               + (EP_INTERFACE_ACTIVATED==1 ? FLT_Q_IN_MEMBAR_RANGE_WIDTH :0) + 
//               (EP_INTERFACE_ACTIVATED==1 ? FLT_Q_ROM_IN_RANGE_WIDTH :0) + 
//               FLT_Q_IO_REQ_IN_RANGE_WIDTH + FLT_Q_FRSTDW_BE_WIDTH + FLT_Q_ADDR_WIDTH + 
//               FLT_Q_TD_WIDTH + (CX_TPH_ENABLE_VALUE*FLT_Q_TH_WIDTH)  + 
//               (ATS_RX_ENABLE_VALUE*FLT_Q_AT_WIDTH) + FLT_Q_EP_WIDTH + FLT_Q_LSTDW_BE_WIDTH + 
//               (CX_FLIT_MODE_ENABLE==1 ? 18:0 ) + (CX_TPH_ENABLE_VALUE*10) + 
//               (ATS_RX_ENABLE_VALUE*1) + (CX_CXL_ENABLE==1 ? (ATS_RX_ENABLE_VALUE*1) : 0 ) + 
//               (CX_IDE_ENABLE_NO_PASSTHROUGH==1 ? 1:0) + CX_RADM_PKT_ORD_WD )  : 0)
// Values:       -2147483648, ..., 2147483647
// 
// Total width of the header fields protected in the TARGET Non-Posted interface
`define CX_RASDP_TRGT1_NP_HDR_WD 187


// Name:         CX_RASDP_TRGT1_NP_HDR_PROT_WD
// Default:      24 ((CX_RASDP_EN==1 && CX_MULTISTREAM_ARCH==1)? [<functionof> 
//               CX_RASDP_TRGT1_NP_HDR_WD CX_RAS_PROT_RANGE RAS_BASE_PROT_WD ]: 0)
// Values:       -2147483648, ..., 2147483647
// 
// Width of the protection code covering the header fields protected in the TARGET  NP interface
`define CX_RASDP_TRGT1_NP_HDR_PROT_WD 24


// Name:         CX_RASDP_TRGT1_CPL_HDR_WD
// Default:      131 ((CX_RASDP_EN==1 && CX_MULTISTREAM_ARCH==1) ? ( 7 + 
//               FLT_Q_TC_WIDTH + FLT_Q_ATTR_WIDTH + (CX_LN_VALUE*FLT_Q_LN_WIDTH) + 
//               FLT_Q_REQID_WIDTH + FLT_Q_TAG_WIDTH + FLT_Q_FUNC_NMBR_WIDTH + 
