// Values:       32 36 40 42 44 48 52
// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// Width of translated address of P stream LTIM.
`define CC_LTI_P_LRADDR_WIDTH 52


// Name:         CC_LTI_P_LA_LC_CDC_FIFO_DP
// Default:      14
// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// LTI LA/LC CDC FIFOs depth of P stream LTIM that handle the crossing between mstr_aclk and core_clk.
`define CC_LTI_P_LA_LC_CDC_FIFO_DP 14


// Name:         CC_LTI_P_LR_CDC_FIFO_DP
// Default:      15
// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// LTI LR CDC FIFO depth of P stream LTIM that handle the crossing between lti_clk and mstr_aclk.
`define CC_LTI_P_LR_CDC_FIFO_DP 15


// Name:         CX_LTI_P_TO_WIDTH
// Default:      10
// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// Width of watch dog timeout value of P stream LTIM.
`define CX_LTI_P_TO_WIDTH 10


// Name:         CX_LTI_P_MSI_CTRL_WIDTH
// Default:      6
// Values:       -2147483648, ..., 2147483647
// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// Width of MSI control value of P stream LTIM.
`define CX_LTI_P_MSI_CTRL_WIDTH 6


