// =============================================================================
// CXL Configuration Parameters
// =============================================================================


// Name:           CX_CXL_2_0_ENABLE
// Default:        true (CX_CXL_ENABLE && (CX_CXL_VERSION>=2))
// Values:         false (0), true (1)
// Enabled:        0
// Parameter Type: Feature Setting
// 
// Configure the controller to support CXL 2.0
`define CX_CXL_2_0_ENABLE


// Name:           CX_CXL_3_0_ENABLE
// Default:        true (CX_CXL_ENABLE && (CX_CXL_VERSION==3))
// Values:         false (0), true (1)
// Enabled:        0
// Parameter Type: Feature Setting
// 
// Configure the controller to support CXL 3.0
`define CX_CXL_3_0_ENABLE


// Name:         CX_CXL_68B_RETRY_ENABLE
// Default:      1 ((CX_UCIE_ENABLE==0) && CX_CXL_ENABLE)
// Values:       0, 1
// 
// Enables CXL.cachemem reliability flow in 68B flit mode
`define CX_CXL_68B_RETRY_ENABLE


// Name:           CX_CXL_256B_FLIT_ENABLE
// Default:        true (CX_CXL_3_0_ENABLE && CX_FLIT_MODE_ENABLE)
// Values:         false (0), true (1)
// Enabled:        CX_CXL_3_0_ENABLE && CX_FLIT_MODE_ENABLE
// Parameter Type: Feature Setting
// 
// Enables 256B Flit Mode Support. Requires PCIe 6.0 Base Specification and CXL 3.0 Specification support.
`define CX_CXL_256B_FLIT_ENABLE


// Name:           CX_CXL_68B_ENH_FLIT_MODE
// Default:        0
// Values:         0, 1
// Enabled:        0
// Parameter Type: Feature Setting
// 
// Enables 68B Enhanced Flit Mode
// `define CX_CXL_68B_ENH_FLIT_MODE


// Name:           CX_CXL_PBR_FLIT_ENABLE
// Default:        0
// Values:         0, 1
// Enabled:        CX_CXL_256B_FLIT_ENABLE
// Parameter Type: Feature Setting
// 
// Enables Port Based Routing Flit Mode Support.
// `define CX_CXL_PBR_FLIT_ENABLE


// Name:         CX_CXL_LOPT_CM_REORDER
// Default:      0 ((CX_CXL_128B_LOPT_FLIT_MODE && !CX_CXL_CXS_ENABLE) ? 1 : 0)
// Values:       0, 1
// 
// CXL Latency opt flit reordering logic enable
// `define CX_CXL_LOPT_CM_REORDER


// Name:           CX_CXL_CACHE_EN
// Default:        1 (CX_CXL_ENABLE)
// Values:         0, 1
// Enabled:        CX_CXL_ENABLE
// Parameter Type: Feature Setting
// 
// Enable CXL.cache protocol.
`define CX_CXL_CACHE_EN


// Name:           CX_CXL_MEM_EN
// Default:        1 (CX_CXL_ENABLE)
// Values:         0, 1
// Enabled:        CX_CXL_ENABLE
// Parameter Type: Feature Setting
// 
// Enable CXL.mem protocol.
`define CX_CXL_MEM_EN


// Name:           DEFAULT_CXL_IO_ENABLE
// Default:        0x1 (CX_CXL_CACHE_EN || CX_CXL_MEM_EN)
// Values:         0x0, 0x1
// Enabled:        CX_CXL_ENABLE
// Parameter Type: Register Default Value
// 
// Default value for CXL.io Enable bit in CXL DVSEC
`define DEFAULT_CXL_IO_ENABLE 1'h1


// Name:         CX_CXL_CHI_ENABLE
// Default:      1 (CX_CXL_ENABLE && !CX_CXL_CXS_ENABLE)
// Values:       0, 1
// 
// Enables CXS+ Interface on CXL Contoller
`define CX_CXL_CHI_ENABLE


// Name:           CX_CXL_CCIX_ENABLE
// Default:        0
// Values:         0, 1
// Enabled:        CX_CXL_ENABLE && CX_CXL_CXS_ENABLE
// Parameter Type: Feature Setting
// 
// Enable CCIX protocol over 64B CXL flits.
// `define CX_CXL_CCIX_ENABLE


// Name:         CX_CXL_AP_ENABLE
// Default:      0 (CX_CXL_CXS_ENABLE && CX_CXL_CCIX_ENABLE)
// Values:       0, 1
// 
// Enables CXS+ Interface on CXL Contoller
// `define CX_CXL_AP_ENABLE


// Name:           CX_CXL_RCRB_SUPPORT
// Default:        1 (CX_CXL_ENABLE)
// Values:         0, 1
// Enabled:        (CX_CXL_ENABLE && (CX_IS_EP || CX_IS_DM))
// Parameter Type: Feature Setting
// 
// Enables CXL RCD Addressing mode support (RCRB)
`define CX_CXL_RCRB_SUPPORT


// Name:         CX_CXL_VH_SUPPORT
// Default:      1 (CX_CXL_ENABLE && (CX_CXL_VERSION >= 2))
// Values:       0, 1
// 
// Enables CXL Virtual Hierarchy support
`define CX_CXL_VH_SUPPORT


// Name:         CX_CXL_RCD_DEVICE
// Default:      1 (CX_CXL_RCRB_SUPPORT && (CX_IS_EP || CX_IS_DM))
// Values:       0, 1
// 
// CXL RCD Device (supports RCD addressing mode)
`define CX_CXL_RCD_DEVICE


// Name:         CX_CXL_ERCD_DEVICE
// Default:      0 (CX_CXL_RCD_DEVICE && !CX_CXL_VH_SUPPORT)
// Values:       0, 1
// 
// CXL eRCD Device (supports only RCD addressing mode), i.e CXL 1.1 Device
// `define CX_CXL_ERCD_DEVICE


// Name:         CX_CXL_DEVICE
// Default:      1 (CX_CXL_ENABLE && (CX_CXL_VERSION >= 2) && (CX_IS_EP || 
//               CX_IS_DM))
// Values:       0, 1
// 
// CXL Device that is not eRCD (supports only RCD addressing mode), i.e CXL 2.0 Device and above
`define CX_CXL_DEVICE


// Name:         CX_CXL_HOST
// Default:      1 (CX_CXL_ENABLE && (CX_CXL_VERSION >= 2) && (CX_IS_RC || 
//               CX_IS_DM))
// Values:       0, 1
// 
// CXL Host that is not eRCH (supports only RCD addressing mode), i.e CXL 2.0 Device and above
`define CX_CXL_HOST


// Name:           CX_CXL_DEVICE_CTS_EN
// Default:        0
// Values:         0, 1
// Enabled:        (CX_CXL_ENABLE && (CX_IS_EP || CX_IS_DM))
// Parameter Type: Feature Setting
// 
// Enable CXL Device Test Capability DVSEC in the RCiEP.
// `define CX_CXL_DEVICE_CTS_EN


// Name:           CX_CXL_CHI_MAXCREDITS
// Default:        2
// Values:         2, ..., 8
// Enabled:        CX_CXL_ENABLE && CX_CXL_CHI_ENABLE
// Parameter Type: Feature Setting
// 
// Select the number of CXL Transmitter Channel Interface credits.
`define CX_CXL_CHI_MAXCREDITS 2


// Name:           CX_CXL_CHI_DATACHK
// Default:        SECDED: ECC on a 64-bit granularity ((CX_CXL_ENABLE && 
//                 CX_CXL_CHI_ENABLE && (CX_RASDP > 0)) ? 2 : 0)
// Values:         None (0), Odd Parity: 1 bit per byte on Channel Interface Message 
//                 (1), SECDED: ECC on a 64-bit granularity (2)
// Enabled:        CX_CXL_ENABLE && CX_CXL_CHI_ENABLE
// Parameter Type: Feature Setting
// 
// Select the value of CXL Channel Interface data protection. 
// The default value of this parameter is derived from CX_RASDP setting.
`define CX_CXL_CHI_DATACHK 2


// Name:           CX_CXL_CACHE_REQ_DP
// Default:        512
// Values:         64 128 256 512 1024
// Enabled:        CX_CXL_CACHE_EN && CX_CXL_CHI_ENABLE
// Parameter Type: Feature Setting
// 
// Select CXL.cache Request Receive Queue Depth.
`define CX_CXL_CACHE_REQ_DP 3


// Name:           CX_CXL_CACHE_RSP_DP
// Default:        512
// Values:         64 128 256 512 1024
// Enabled:        CX_CXL_CACHE_EN && CX_CXL_CHI_ENABLE
// Parameter Type: Feature Setting
// 
// Select CXL.cache Response Receive Queue Depth.
`define CX_CXL_CACHE_RSP_DP 3


// Name:           CX_CXL_CACHE_DQ_DP
// Default:        512
// Values:         64 128 256 512 1024
// Enabled:        CX_CXL_CACHE_EN && CX_CXL_CHI_ENABLE
// Parameter Type: Feature Setting
// 
// Select CXL.cache Data Receive Queue Depth.
`define CX_CXL_CACHE_DQ_DP 3


// Name:           CX_CXL_MEM_NDR_DP
// Default:        512
// Values:         64 128 256 512 1024
// Enabled:        CX_CXL_MEM_EN && CX_CXL_CHI_ENABLE
// Parameter Type: Feature Setting
// 
// Select CXL.mem Request/Response message, Receive Queue Depth.
`define CX_CXL_MEM_NDR_DP 3


// Name:         CX_CXL_MEM_REQ_DP
// Default:      3 (CX_CXL_MEM_NDR_DP)
// Values:       -2147483648, ..., 2147483647
// Enabled:      CX_CXL_MEM_EN && CX_CXL_CHI_ENABLE
// 
// Select CXL.mem Request Receive Queue Depth:
`define CX_CXL_MEM_REQ_DP 3


// Name:         CX_CXL_MEM_RSP_DP
// Default:      3 (CX_CXL_MEM_NDR_DP)
// Values:       -2147483648, ..., 2147483647
// Enabled:      CX_CXL_MEM_EN && CX_CXL_CHI_ENABLE
// 
// Select CXL.mem Response Receive Queue Depth:
`define CX_CXL_MEM_RSP_DP 3


// Name:           CX_CXL_MEM_DQ_DP
// Default:        512
// Values:         64 128 256 512 1024
// Enabled:        CX_CXL_MEM_EN && CX_CXL_CHI_ENABLE
// Parameter Type: Feature Setting
// 
// Select CXL.mem Data Receive Queue Depth.
`define CX_CXL_MEM_DQ_DP 3


// Name:           CX_CXL_MEM_BI_DP
// Default:        512
// Values:         64 128 256 512 1024
// Enabled:        CX_CXL_BI_SUPPORT && CX_CXL_CHI_ENABLE
// Parameter Type: Feature Setting
// 
// Select CXL.mem Back-Invalidate Snoop/Response message, Receive Queue Depth:
`define CX_CXL_MEM_BI_DP 3


// Name:         CX_CXL_MEM_BI_RSP_DP
// Default:      3 (CX_CXL_MEM_BI_DP)
// Values:       -2147483648, ..., 2147483647
// 
// Select CXL.mem Back-Invalidate Response Queue Depth:
`define CX_CXL_MEM_BI_RSP_DP 3


// Name:         CX_CXL_MEM_BI_SNP_DP
// Default:      3 (CX_CXL_MEM_BI_DP)
// Values:       -2147483648, ..., 2147483647
// 
// Select CXL.mem Back-Invalidate Snoop Queue Depth:
`define CX_CXL_MEM_BI_SNP_DP 3


// Name:           CX_CXL_RAM_READ_LATENCY
// Default:        1
// Values:         1, 2
// Enabled:        CX_CXL_ENABLE && CX_CXL_CHI_ENABLE
// Parameter Type: Feature Setting
// 
// CXL Channel Interface FIFO RAM Read Latency.
`define CX_CXL_RAM_READ_LATENCY 1



// Name:           CX_CXL_SYNCHRONOUS
// Default:        1 (CX_PIPE_PCLK_MODE!=3)
// Values:         0, 1
// Enabled:        CX_PIPE_PCLK_MODE!=3
// Parameter Type: Feature Setting
// 
// Determines the CXL Channel Interface relation to Core clock based on selected PIPE clock mode
`define CX_CXL_SYNCHRONOUS

`define SNPS_CXL_SYNC_07122021 0


// Name:           CX_CXL_TX_LOW_LATENCY
// Default:        0 (!CX_CXL_SYNCHRONOUS)
// Values:         0, 1
// Enabled:        CX_CXL_ENABLE && CX_CXL_CHI_ENABLE
// Parameter Type: Feature Setting
// 
// Enables Low Latency Transmitter architecture. Implements CHI FIFO Bypass feature and 
// eliminates register stage between CXL Transmitter Transaction Layer and Link Layer.
// `define CX_CXL_TX_LOW_LATENCY


// Name:         CX_CXL_APP_INTF_CLK_EQ_2X_CORE_CLK
// Default:      0 (!CX_CXL_SYNCHRONOUS)
// Values:       0, 1
// Enabled:      CX_CXL_ENABLE
// 
// Defines the CXL Application layer interface clock relation with it's core clock 
// 0: CXL Application Interface Clock Frequency is same as the Core Clock 
// 1: CXL Application Interface Clock Frequency is double  the Core Clock
// `define CX_CXL_APP_INTF_CLK_EQ_2X_CORE_CLK


// Name:           CX_CXL_RBUF_DEPTH
// Default:        256
// Values:         32 64 128 256
// Enabled:        CX_CXL_ENABLE
// Parameter Type: Feature Setting
// 
// Select the CXL Retry Buffer Depth.
`define CX_CXL_RBUF_DEPTH 256


// Name:         CX_CXL_DOWNSTREAM_PORT
// Default:      1 (CX_CXL_ENABLE && (CX_IS_RC || CX_IS_DM || CX_IS_SW))
// Values:       0, 1
// 
// Enable support for CXL Downstream Port
`define CX_CXL_DOWNSTREAM_PORT


// Name:         CX_CXL_UPSTREAM_PORT
// Default:      1 (CX_CXL_ENABLE && (CX_IS_EP || CX_IS_DM || CX_IS_SW))
// Values:       0, 1
// 
// Enable support for CXL Upstream Port
`define CX_CXL_UPSTREAM_PORT


// Name:         CX_CXL_DUALSTREAM_PORT
// Default:      1 (CX_CXL_ENABLE && (CX_IS_DM || CX_IS_SW))
// Values:       0, 1
// 
// Enable support for CXL Dualstream Port
`define CX_CXL_DUALSTREAM_PORT


// Name:           CX_CXL_MEM_T3_APP_EN
// Default:        false
// Values:         false (0), true (1)
// Enabled:        (CX_CXL_MEM_EN && CX_CXL_CHI_ENABLE && CX_CXL_S2M_M2S_ENABLE && 
//                 (CX_IS_EP || CX_IS_DM))
// Parameter Type: Feature Setting
// 
// Enable CXL.mem Type 3 Device Application Layer
// `define CX_CXL_MEM_T3_APP_EN


// Name:           CX_CXL_MEM_T3_HOST_APP_EN
// Default:        false
// Values:         false (0), true (1)
// Enabled:        CX_CXL_MEM_T3_APP_EN
// Parameter Type: Feature Setting
// 
// Enable CXL.mem Type 3 Host Application Layer
// `define CX_CXL_MEM_T3_HOST_APP_EN


// Name:         CX_CXL_MEM_T3_HND_APP_EN
// Default:      0 (CX_CXL_MEM_T3_HOST_APP_EN && CX_CXL_MEM_T3_APP_EN)
// Values:       0, 1
// 
// //Enable CXL.mem Type 3 Application Layer for Host and Device
// `define CX_CXL_MEM_T3_HND_APP_EN


// Name:         CX_CXL_MEM_T3_HRD_APP_EN
// Default:      0 (CX_CXL_MEM_T3_HOST_APP_EN || CX_CXL_MEM_T3_APP_EN)
// Values:       0, 1
// 
// //Enable CXL.mem Type 3 Application Layer for Host or Device
// `define CX_CXL_MEM_T3_HRD_APP_EN


// Name:           CX_CXL_BI_SUPPORT
// Default:        1 (CX_CXL_MEM_T3_HRD_APP_EN ? 0 : (CX_CXL_256B_FLIT_ENABLE && 
//                 CX_CXL_MEM_EN && CX_CXL_CACHE_EN))
// Values:         0, 1
// Enabled:        CX_CXL_256B_FLIT_ENABLE && CX_CXL_MEM_EN && !CX_CXL_CACHE_EN
// Parameter Type: Feature Setting
// 
// Back-Invalidate Messages support is obligatory for Type 2 devices which support 256B mode, while it optional for Type 3 
// devices.
`define CX_CXL_BI_SUPPORT


// Name:           CX_CXL_SYMMEM_SUPPORT
// Default:        0 (CX_CXL_68B_ENH_FLIT_MODE && CX_CXL_MEM_EN && 
//                 CX_CXL_DOWNSTREAM_PORT)
// Values:         0, 1
// Enabled:        CX_CXL_68B_ENH_FLIT_MODE && CX_CXL_MEM_EN
// Parameter Type: Feature Setting
// 
// Enable Symmetric Memory Flow.
// `define CX_CXL_SYMMEM_SUPPORT


// Name:         CX_CXL_DEV_LOAD_ENABLE
// Default:      1 ((CX_CXL_VERSION>=2) && CX_CXL_MEM_EN)
// Values:       0, 1
// 
// Expands S2M NDR message by two bits to accomodate 2-bit DevLoad field for QoS Telemetry 
// Available for CXL Specification Version 2.0 and higher.
`define CX_CXL_DEV_LOAD_ENABLE


// Name:         CX_CXL_CTL_FMT_ENABLE
// Default:      1 (CX_CXL_VERSION>=2)
// Values:       0, 1
// 
// Enables 3-bit CTL_FMT field for the control flits to distinguish between 64-bit and 96-bit payload. 
// Available for CXL Specification Version 2.0 and higher.
`define CX_CXL_CTL_FMT_ENABLE


// Name:         CX_CXL_PM_TIMER_ENABLE
// Default:      1 (CX_CXL_UPSTREAM_PORT || CX_CXL_256B_FLIT_ENABLE)
// Values:       0, 1
// 
// Enable CXL Power Management Timer Enable
`define CX_CXL_PM_TIMER_ENABLE


// Name:         CX_CXL_TSOS_NOP_HINT
// Default:      1
// Values:       0, ..., 3
// 
// CXL Controller Layer1 NOP HINT Info in Modified TS OS symbol14[1:0] . (01b: 1 NOP flit / 11b: 2 NOP flits)
`define CX_CXL_TSOS_NOP_HINT 1


// Name:         CX_CXL_NOP_HINT_RTL_FIX
// Default:      0
// Values:       0, 1
// 
// CXL Controller Layer1 NOP HINT RTL FIX
// `define CX_CXL_NOP_HINT_RTL_FIX

// =============================================================================
// CXL CDM Configuration Parameters
// =============================================================================


// Name:           CX_CXL_DEVICE_CTS_CAP
// Default:        0x0
// Values:         0x0, ..., 0x1fffffff
// Enabled:        CX_CXL_DEVICE_CTS_EN
// Parameter Type: Feature Setting
// 
// Specify the value for the CXL Device CTS Capabilities. The field values and their meaning correspond to the fields of 
// CXL_TEST_DVSEC_CAPABILITY_OFF register.
`define CX_CXL_DEVICE_CTS_CAP 29'h0


// Name:           CX_CXL_CACHE_SIZE
// Default:        0x0
// Values:         0x0, ..., 0x3fff
// Enabled:        (CX_CXL_DEVICE_CTS_EN && (CX_IS_EP || CX_IS_DM))
// Parameter Type: Feature Setting
// 
// Specify the cache size that the device supports.
`define CX_CXL_CACHE_SIZE 14'h0


// Name:           CX_CXL_CACHE_SIZE_UNITS
// Default:        Bytes
// Values:         Bytes (0), KiloBytes (1), MegaBytes (2)
// Enabled:        (CX_CXL_DEVICE_CTS_EN && (CX_IS_EP || CX_IS_DM))
// Parameter Type: Feature Setting
// 
// Select the units of advertised cache size in CacheSize field.
`define CX_CXL_CACHE_SIZE_UNITS 0


// Name:           CX_CXL_CTS_BASE_REG_TYPE
// Default:        32 bit wide
// Values:         32 bit wide (0), 64 bit wide (2)
// Enabled:        CX_CXL_DEVICE_CTS_EN
// Parameter Type: Feature Setting
// 
// Select the CXL Device CTS Base register type.
`define CX_CXL_CTS_BASE_REG_TYPE 0


// Name:         CX_CXL_VIRAL_CAPABLE
// Default:      1
// Values:       0, 1
// 
// Indicates CXL device supports Viral handling
`define CX_CXL_VIRAL_CAPABLE 1


// Name:           CX_CXL_MEM_HWINIT_MODE
// Default:        Host software initializes the memory
// Values:         Host software initializes the memory (0), The CXL.mem capable 
//                 device initializes the memory with help from the device hardware and 
//                 software (1)
// Enabled:        (CX_CXL_MEM_EN && (CX_IS_EP || CX_IS_DM))
// Parameter Type: Feature Setting
// 
// If set,indicates this CXL.mem capable device initializes memory with assistance from hardware and firmware located on 
// the device. If clear, indicates memory is initialized by host software such as device driver
`define CX_CXL_MEM_HWINIT_MODE 0


// Name:           CX_CXL_HDM_COUNT
// Default:        One Range (CX_CXL_MEM_EN)
// Values:         Zero Range (0), One Range (1), Two Ranges (2)
// Enabled:        (CX_CXL_MEM_EN && (CX_IS_EP || CX_IS_DM))
// Parameter Type: Register Default Setting
// 
// Select the Number of HDM ranges that the CXL device implements and the HDM_COUNT field of the 
// CXL_RCIEP_DVSEC_HDR_@_FLEXBUS_CAP_OFF reports this value.
`define CX_CXL_HDM_COUNT 1


// Name:           CX_CXL_RANGE_1_MEM_SIZE_HIGH
// Default:        0x0
// Values:         0x0, ..., 0xffffffff
// Enabled:        (CX_CXL_MEM_EN && (CX_IS_EP || CX_IS_DM))
// Parameter Type: Register Default Setting
// 
// Specify the value of bits 63:32 of Flex Bus Range 1 memory size
`define CX_CXL_RANGE_1_MEM_SIZE_HIGH 32'h0


// Name:           CX_CXL_RANGE_1_MEM_INFO_VALID
// Default:        false
// Values:         false (0), true (1)
// Enabled:        (CX_CXL_MEM_EN && (CX_IS_EP || CX_IS_DM))
// Parameter Type: Register Default Setting
// 
// Enable to make the Flex Bus Range 1 Size high and Size Low registers valid.
`define CX_CXL_RANGE_1_MEM_INFO_VALID 0


// Name:           CX_CXL_RANGE_1_MEM_ACTIVE
// Default:        false
// Values:         false (0), true (1)
// Enabled:        (CX_CXL_MEM_EN && (CX_IS_EP || CX_IS_DM))
// Parameter Type: Register Default Setting
// 
// If set, indicates that the Flex Bus Range 1 memory is fully initialized and available for software use
`define CX_CXL_RANGE_1_MEM_ACTIVE 0


// Name:           CX_CXL_RANGE_1_MEDIA_TYPE
// Default:        Use CDAT (CX_CXL_2_0_ENABLE ? 2 : 0)
// Values:         Volatile Memory (0), Non-volatile Memory (1), Use CDAT (2)
// Enabled:        (CX_CXL_MEM_EN && !CX_CXL_2_0_ENABLE && (CX_IS_EP || CX_IS_DM))
// Parameter Type: Register Default Setting
// 
// Select the memory media characteristics for Flex Bus Range 1.
`define CX_CXL_RANGE_1_MEDIA_TYPE 2


// Name:           CX_CXL_RANGE_1_MEM_CLASS
// Default:        Use CDAT (CX_CXL_2_0_ENABLE ? 2 : 0)
// Values:         Memory Class (0), Storage Class (1), Use CDAT (2)
// Enabled:        (CX_CXL_MEM_EN && !CX_CXL_2_0_ENABLE && (CX_IS_EP || CX_IS_DM))
// Parameter Type: Feature Setting
// 
// Select the class of memory for Flex Bus Range 1.
`define CX_CXL_RANGE_1_MEM_CLASS 2


// Name:           CX_CXL_RANGE_1_DESIRED_INTERLEAVE
// Default:        No Interleave
// Values:         No Interleave (0), 256 Byte Granularity (1), 4K Interleave (2), 512 
//                 Bytes (3), 1024 Bytes (4), 2048 Bytes (5), 8192 Bytes (6), 16384 
//                 Bytes (7)
// Enabled:        (CX_CXL_MEM_EN && (CX_IS_EP || CX_IS_DM))
// Parameter Type: Feature Setting
// 
// Select the memory interleaving desired by the device for Flex Bus Range 1.
`define CX_CXL_RANGE_1_DESIRED_INTERLEAVE 0


// Name:           CX_CXL_RANGE_1_MEM_ACTIVE_TIMEOUT
// Default:        1s
// Values:         1s (0), 4s (1), 16s (2), 64s (3), 256s (4)
// Enabled:        (CX_CXL_MEM_EN && (CX_IS_EP || CX_IS_DM))
// Parameter Type: Register Default Setting
// 
// Select the value of Memory_Active_Timeout for Flex Bus Range 1 Size Low Register.
`define CX_CXL_RANGE_1_MEM_ACTIVE_TIMEOUT 0


// Name:           CX_CXL_RANGE_1_MEM_SIZE_LOW
// Default:        0x0
// Values:         0x0, ..., 0xf
// Enabled:        (CX_CXL_MEM_EN && (CX_IS_EP || CX_IS_DM))
// Parameter Type: Register Default Setting
// 
// Specify the value of bits 31:28 of Flex Bus Range 1 memory size.
`define CX_CXL_RANGE_1_MEM_SIZE_LOW 4'h0


// Name:           CX_CXL_RANGE_2_MEM_SIZE_HIGH
// Default:        0x0
// Values:         0x0, ..., 0xffffffff
// Enabled:        (CX_CXL_MEM_EN && (CX_CXL_HDM_COUNT == 2))
// Parameter Type: Feature Setting
// 
// Specify the value of bits 63:32 of Flex Bus Range 2 memory size.
`define CX_CXL_RANGE_2_MEM_SIZE_HIGH 32'h0


// Name:           CX_CXL_RANGE_2_MEM_INFO_VALID
// Default:        false
// Values:         false (0), true (1)
// Enabled:        (CX_CXL_MEM_EN && (CX_CXL_HDM_COUNT == 2))
// Parameter Type: Register Default Setting
// 
// If enabled, the Flex Bus Range 2 Size high and Size Low registers are valid.
`define CX_CXL_RANGE_2_MEM_INFO_VALID 0


// Name:           CX_CXL_RANGE_2_MEM_ACTIVE
// Default:        false
// Values:         false (0), true (1)
// Enabled:        (CX_CXL_MEM_EN && (CX_CXL_HDM_COUNT == 2))
// Parameter Type: Feature Setting
// 
// If set, indicates that the Flex Bus Range 2 memory is fully initialized and available for software use
`define CX_CXL_RANGE_2_MEM_ACTIVE 0


// Name:           CX_CXL_RANGE_2_MEDIA_TYPE
// Default:        Use CDAT (CX_CXL_2_0_ENABLE ? 2 : 0)
// Values:         Volatile Memory (0), Non-volatile Memory (1), Use CDAT (2)
// Enabled:        (CX_CXL_MEM_EN && !CX_CXL_2_0_ENABLE && (CX_CXL_HDM_COUNT == 2))
// Parameter Type: Feature Setting
// 
// Select the memory media characteristics for Flex Bus Range 2.
`define CX_CXL_RANGE_2_MEDIA_TYPE 2


// Name:           CX_CXL_RANGE_2_MEM_CLASS
// Default:        Use CDAT (CX_CXL_2_0_ENABLE ? 2 : 0)
// Values:         Memory Class (0), Storage Class (1), Use CDAT (2)
// Enabled:        (CX_CXL_MEM_EN && !CX_CXL_2_0_ENABLE && (CX_CXL_HDM_COUNT == 2))
// Parameter Type: Feature Setting
// 
// Select the class of memory for Flex Bus Range 2.
`define CX_CXL_RANGE_2_MEM_CLASS 2


// Name:           CX_CXL_RANGE_2_DESIRED_INTERLEAVE
// Default:        No Interleave
// Values:         No Interleave (0), 256 Byte Granularity (1), 4K Interleave (2), 512 
//                 Bytes (3), 1024 Bytes (4), 2048 Bytes (5), 8192 Bytes (6), 16384 
//                 Bytes (7)
// Enabled:        (CX_CXL_MEM_EN && (CX_CXL_HDM_COUNT == 2))
// Parameter Type: Feature Setting
// 
// Select the memory interleaving desired by the device for Flex Bus Range 2.
`define CX_CXL_RANGE_2_DESIRED_INTERLEAVE 0


// Name:           CX_CXL_RANGE_2_MEM_ACTIVE_TIMEOUT
// Default:        1s
// Values:         1s (0), 4s (1), 16s (2), 64s (3), 256s (4)
// Enabled:        (CX_CXL_MEM_EN && (CX_CXL_HDM_COUNT == 2))
// Parameter Type: Register Default Setting
// 
// Select the value of Memory_Active_Timeout for Flex Bus Range 2 Size Low Register.
`define CX_CXL_RANGE_2_MEM_ACTIVE_TIMEOUT 0


// Name:           CX_CXL_RANGE_2_MEM_SIZE_LOW
// Default:        0x0
// Values:         0x0, ..., 0xf
// Enabled:        (CX_CXL_MEM_EN && (CX_CXL_HDM_COUNT == 2))
// Parameter Type: Feature Setting
// 
// Specify the value of bits 31:28 of Flex Bus Range 2 memory size.
`define CX_CXL_RANGE_2_MEM_SIZE_LOW 4'h0

