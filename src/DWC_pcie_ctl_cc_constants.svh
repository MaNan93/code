`define CX_PIPE_RETIMING_DEPTH 0


// Name:         CX_SYNC_HEADER_BYPASS_SUPPORT
// Default:      1 (CX_PIPE_SERDES_ARCH && (CX_CXL_ENABLE || CX_GEN6_SPEED))
// Values:       0, 1
// 
// When enabled, the controller implements logic for sync header bypass.
`define CX_SYNC_HEADER_BYPASS_SUPPORT


// Name:           CX_DRIFT_BUFFER_SUPPORT
// Default:        Enabled (CX_PIPE_SERDES_ARCH && CX_CXL_ENABLE)
// Values:         Disabled (0), Enabled (1)
