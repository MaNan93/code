`define CX_VF_DEPENDENCY_LINK_5 12'h5


// Name:           FIRST_VF_OFFSET_ARI_CAP_HIER1_5
// Default:        0x1 ((CX_NFUNC>=127) ? 256 : (CX_NFUNC>=65) ? 128 : (CX_NFUNC>=33) 
