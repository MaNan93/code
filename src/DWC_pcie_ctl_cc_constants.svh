// Values:         0x0, ..., 0xff
// Enabled:        CX_ACS_ENABLE
// Parameter Type: Feature Setting
// 
// This is the default value (after reset) of the Egress Control Vector Size field in the ACS Capability register in PF6. 
// Encodes 01h-FFh directly indicate the number of applicable bits in the Egress Control Vector; the encoding 00h indicates 
// 256 bits.
`define CX_ACS_EGRESS_CTRL_SIZE_6 8'h4


// Name:         ACS_CTRL_VEC_WD_6
// Default:      0x4 ((CX_ACS_P2P_EGRESS_CTRL_6) * ((CX_ACS_EGRESS_CTRL_SIZE_6 == 0) 
//               ? 256 : CX_ACS_EGRESS_CTRL_SIZE_6))
// Values:       0x0, ..., 0x1ff
// 
// This is the width of the ACS control vector for Function 6
`define ACS_CTRL_VEC_WD_6 9'h4


// Name:           CX_ACS_UP_EGRESS_CTRL_MASK_6
// Default:        0x40 ([<functionof> CX_ACS_FUNC_GRP 6])
// Values:         0x0, ..., 
//                 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
// Enabled:        (CX_ACS_ENABLE && (CC_DEVICE_TYPE==CC_EP || CC_DEVICE_TYPE==CC_DM))
// Parameter Type: Feature Setting
// 
