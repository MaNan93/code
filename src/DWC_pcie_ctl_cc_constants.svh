// Name:           CX_SRIS_SUPPORT
// Default:        true ((CX_GEN5_SPEED || CX_FLIT_MODE_ENABLE) && 
//                 CX_PHY_LOGICAL_ENABLE)
// Values:         false (0), true (1)
// Enabled:        CX_UCIE_ENABLE==0
// Parameter Type: Feature Setting
// 
// When enabled, the controller implements logic for Separate Reference Clocks with Independent SSC (SRIS). 
// Gen5 or Flit_Mode port must support SRIS/non-SRIS mode selection mechanism.
`define CX_SRIS_SUPPORT


// Name:           DEFAULT_DO_DESKEW_FOR_SRIS
// Default:        0x1 (CX_SRIS_SUPPORT || CX_FLIT_MODE_ENABLE)
// Values:         0x0, 0x1
// Parameter Type: Register Default Setting
// 
// When set to 1, the deskew mechanism uses the transition from TS2 or EIEOS or SKP to Logical Idle Symbol for Gen1/2 rate. 
// 
// When set to 0, the deskew mechanism uses the SKP Ordered Set or TS1 to TS2 transition for Gen1/2 rate. 
// Always set to 1 for flit mode enabled
`define DEFAULT_DO_DESKEW_FOR_SRIS 1'h1


// Name:           CX_MAX_RETIMER
// Default:        0x2 (((CX_GEN4_MODE != GEN4_DISABLED)==1) ? 2 : 0)
