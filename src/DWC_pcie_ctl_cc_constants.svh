//               (CX_IDE_ENABLE_NO_PASSTHROUGH==1 ? 1:0) + CX_RADM_PKT_ORD_WD )   : 0)
// Values:       -2147483648, ..., 2147483647
// 
// Total width of the header fields protected in the TARGET CPL interface
`define CX_RASDP_TRGT1_CPL_HDR_WD 131


// Name:         CX_RASDP_TRGT1_CPL_HDR_PROT_WD
// Default:      17 ((CX_RASDP_EN==1 && CX_MULTISTREAM_ARCH==1) ? [<functionof> 
