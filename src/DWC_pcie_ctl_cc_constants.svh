`define SLAVE_POPULATED


// Name:         CX_VEN_MSG_RX_HDR_FORMAT_LEGACY
// Default:      0
// Values:       0, 1
// 
// Bytes 12 to 15 of the vendor message header 
// are output on radm_msg_payload[31:0] in the order received from the wire, 
// i.e. byte 12 is mapped to radm_msg_payload[7:0]. 
// This parameter is defined to maintain backward compatability 
// with GA release 3.90a and prior releases. 
// By default this parameter is not defined post the 3.90a release. 
// Vendor message header bytes 8 to 15 are output on radm_msg_payload[63:0]. 
// and the byte order is reversed to be consistent with the format of message header bytes 
// received on the RTRGT1 interface, i.e. byte 8 is mapped to radm_msg_payload[63:56].
// `define CX_VEN_MSG_RX_HDR_FORMAT_LEGACY


// Name:           CX_PIPE_LOOPBACK_EN
// Default:        Yes
// Values:         No (0), Yes (1)
// Enabled:        0
// Parameter Type: Feature Setting
// 
// Allows local Loopback from the PIPE TX to PIPE TX in the absence of a link partner.
`define CX_PIPE_LOOPBACK_EN


// Name:         CX_LOCAL_LOOPBACK_EN
// Default:      1 (CX_PIPE_LOOPBACK_EN)
// Values:       0, 1
// 
// Local Loopback Enable. This parameter is set if CX_PIPE_LOOPBACK_EN=1
`define CX_LOCAL_LOOPBACK_EN


// Name:           DEFAULT_GEN3_RXEQ_RGRDLESS_RXTS
// Default:        Yes
// Values:         No (0), Yes (1)
// Enabled:        ((CX_GEN3_MODE != GEN3_DISABLED))
// Parameter Type: Register Default Setting
// 
// When set to '1', the controller as Gen3 EQ master asserts RxEqEval to instruct the PHY to do Rx adaptation and 
// evaluation after a 500ns timeout from a new preset request. 
//  
// This is the default of the RXEQ_RGRDLESS_RXTS field in GEN3_RELATED_OFF when in Gen3 mode.
`define DEFAULT_GEN3_RXEQ_RGRDLESS_RXTS 1


// Name:           DEFAULT_GEN4_RXEQ_RGRDLESS_RXTS
// Default:        Yes
// Values:         No (0), Yes (1)
// Enabled:        ((CX_GEN4_MODE != GEN4_DISABLED))
// Parameter Type: Register Default Setting
// 
// When set to '1', the controller as Gen4 EQ master asserts RxEqEval to instruct the PHY to do Rx adaptation and 
// evaluation after a 500ns timeout from a new preset request. 
//  
// This is the default of the RXEQ_RGRDLESS_RXTS field in GEN3_RELATED_OFF when in Gen4 mode.
`define DEFAULT_GEN4_RXEQ_RGRDLESS_RXTS 1


// Name:           DEFAULT_GEN5_RXEQ_RGRDLESS_RXTS
// Default:        Yes
// Values:         No (0), Yes (1)
// Enabled:        ((CX_MAX_PCIE_SPEED >= 5))
// Parameter Type: Register Default Setting
// 
// When set to '1', the controller as Gen5 EQ master asserts RxEqEval to instruct the PHY to do Rx adaptation and 
// evaluation after a 500ns timeout from a new preset request. 
//  
// This is the default of the RXEQ_RGRDLESS_RXTS field in GEN3_RELATED_OFF when in Gen5 mode.
`define DEFAULT_GEN5_RXEQ_RGRDLESS_RXTS 1


// Name:           DEFAULT_GEN6_RXEQ_RGRDLESS_RXTS
// Default:        Yes
// Values:         No (0), Yes (1)
// Enabled:        ((CX_MAX_PCIE_SPEED >= 6))
// Parameter Type: Register Default Setting
// 
// When set to '1', the controller as Gen6 EQ master asserts RxEqEval to instruct the PHY to do Rx adaptation and 
// evaluation after a 500ns timeout from a new preset request. 
//  
// This is the default of the RXEQ_RGRDLESS_RXTS field in GEN3_RELATED_OFF when in Gen6 mode.
`define DEFAULT_GEN6_RXEQ_RGRDLESS_RXTS 1


// Name:           DEFAULT_GEN3_REQ_SEND_CONSECUTIVE_EIEOS_FOR_PSET_MAP
// Default:        Yes
// Values:         No (0), Yes (1)
// Enabled:        ((CX_GEN3_MODE != GEN3_DISABLED))
// Parameter Type: Register Default Setting
// 
// For Gen3 equalization, when set to '1', the controller is requested to send consecutive EIEOS for preset-coefficients 
// mapping in Recovery.RcvrLock if EQ is pending. 
//  
// This is the default of the GEN3_REQ_SEND_CONSEC_EIEOS_FOR_PSET_MAP field in GEN3_EQ_CONTROL_OFF when in Gen3 mode.
`define DEFAULT_GEN3_REQ_SEND_CONSECUTIVE_EIEOS_FOR_PSET_MAP 1'd1


// Name:           DEFAULT_GEN3_REQ_RST_EIEOS_CNT_EQ_DISABLE
// Default:        No
// Values:         No (0), Yes (1)
// Enabled:        ((CX_GEN3_MODE != GEN3_DISABLED))
// Parameter Type: Register Default Setting
// 
// Disable requesting reset of EIEOS count during equalization. 
//  
// This is the default of the EQ_EIEOS_CNT field in GEN3_EQ_CONTROL_OFF.
`define DEFAULT_GEN3_REQ_RST_EIEOS_CNT_EQ_DISABLE 1'd0


// Name:           DEFAULT_GEN3_AUTONOMOUS_EQ_REQ_DISABLE
// Default:        No
// Values:         No (0), Yes (1)
// Enabled:        ((CX_GEN3_MODE != GEN3_DISABLED))
// Parameter Type: Register Default Setting
// 
// Disable autonomous mechanism for requesting to redo the equalization process. 
//  
// This is the default of the EQ_REDO field in GEN3_EQ_CONTROL_OFF.
`define DEFAULT_GEN3_AUTONOMOUS_EQ_REQ_DISABLE 1'd0


// Name:           DEFAULT_GEN4_REQ_SEND_CONSECUTIVE_EIEOS_FOR_PSET_MAP
// Default:        Yes
// Values:         No (0), Yes (1)
// Enabled:        ((CX_GEN4_MODE != GEN4_DISABLED))
// Parameter Type: Register Default Setting
// 
// For Gen4 equalization, when set to '1', the controller is requested to send consecutive EIEOS for preset-coefficients 
// mapping in Recovery.RcvrLock if EQ is pending. 
//  
// This is the default of the GEN3_REQ_SEND_CONSEC_EIEOS_FOR_PSET_MAP field in GEN3_EQ_CONTROL_OFF when in Gen4 mode.
`define DEFAULT_GEN4_REQ_SEND_CONSECUTIVE_EIEOS_FOR_PSET_MAP 1'd1


// Name:           DEFAULT_GEN5_REQ_SEND_CONSECUTIVE_EIEOS_FOR_PSET_MAP
// Default:        Yes
// Values:         No (0), Yes (1)
// Enabled:        ((CX_MAX_PCIE_SPEED >= 5))
// Parameter Type: Register Default Setting
// 
// For Gen5 equalization, when set to '1', the controller is requested to send consecutive EIEOS for preset-coefficients 
// mapping in Recovery.RcvrLock if EQ is pending. 
//  
// This is the default of the GEN3_REQ_SEND_CONSEC_EIEOS_FOR_PSET_MAP field in GEN3_EQ_CONTROL_OFF when in Gen5 mode.
`define DEFAULT_GEN5_REQ_SEND_CONSECUTIVE_EIEOS_FOR_PSET_MAP 1'd1


// Name:           DEFAULT_GEN6_REQ_SEND_CONSECUTIVE_EIEOS_FOR_PSET_MAP
// Default:        Yes
// Values:         No (0), Yes (1)
// Enabled:        ((CX_MAX_PCIE_SPEED >= 6))
// Parameter Type: Register Default Setting
// 
// For Gen6 equalization, when set to '1', the controller is requested to send consecutive EIEOS for preset-coefficients 
// mapping in Recovery.RcvrLock if EQ is pending. 
//  
// This is the default of the GEN3_REQ_SEND_CONSEC_EIEOS_FOR_PSET_MAP field in GEN3_EQ_CONTROL_OFF when in Gen6 mode.
`define DEFAULT_GEN6_REQ_SEND_CONSECUTIVE_EIEOS_FOR_PSET_MAP 1'd1


// Name:           DEFAULT_GEN3_EQ_PSET_COEF_MAP_MODE_PROG
// Default:        No
// Values:         No (0), Yes (1)
// Enabled:        CX_GEN3_MODE != GEN3_DISABLED
// Parameter Type: Register Default Setting
// 
// This is the default of the GEN3_EQ_PSET_COEF_MAP_MODE_PROG field in GEN3_RELATED_OFF register. Select "Yes" to enable EQ 
// Programmable Table out of reset.
`define DEFAULT_GEN3_EQ_PSET_COEF_MAP_MODE_PROG 0


// Name:           DEFAULT_GEN3_EQ_LOCAL_FS
// Default:        48
// Values:         12, ..., 63
// Enabled:        CX_GEN3_MODE != GEN3_DISABLED
// Parameter Type: Register Default Setting
// 
// When you enable the Programmable Table for Gen3 Equalization Presets to Coefficients Mapping, by writing '1' to the 
// GEN3_EQ_PSET_COEF_MAP_MODE_PROG field of GEN3_RELATED_OFF register, this parameter is used to set the default local Full Swing 
// (FS) value for Gen3 data rate. The FS value is specific to the PHY implementation. It is needed by the controller because 
// it is advertised during Gen3 equalization Phase 1, and it is used to determine if the coefficients meet the rules, as 
// described in Rules for Transmitter Coefficients, section 4.2.3.1 of the PCI Express Base Specification, Rev 3.0. 
// This is the default of the GEN3_EQ_LOCAL_FS field in GEN3_EQ_LOCAL_FS_LF_OFF when in Gen3 mode.
`define DEFAULT_GEN3_EQ_LOCAL_FS 6'd48


// Name:           DEFAULT_GEN3_EQ_LOCAL_LF
// Default:        16
// Values:         0, ..., 63
// Enabled:        CX_GEN3_MODE != GEN3_DISABLED
// Parameter Type: Register Default Setting
// 
// When you enable the Programmable Table for Gen3 Equalization Presets to Coefficients Mapping, by writing '1' to the 
// GEN3_EQ_PSET_COEF_MAP_MODE_PROG field of GEN3_RELATED_OFF register, this parameter is used to set the default local Low 
// Frequency (LF) value for Gen3 data rate. The LF value is specific to the PHY implementation. It is needed by the controller 
// because it is advertised during Gen3 equalization Phase1, and it is used to determine if the coefficients meet the rules, as 
// described in Rules for Transmitter Coefficients, section 4.2.3.1 of the PCI Express Base Specification, Rev 3.0. 
// This is the default of the GEN3_EQ_LOCAL_LF field in GEN3_EQ_LOCAL_FS_LF_OFF when in Gen3 mode.
`define DEFAULT_GEN3_EQ_LOCAL_LF 6'd16


// Name:           DEFAULT_GEN4_EQ_LOCAL_FS
// Default:        48
// Values:         12, ..., 63
// Enabled:        CX_GEN4_MODE != GEN4_DISABLED
// Parameter Type: Register Default Setting
// 
// When you enable the Programmable Table for Gen3 Equalization Presets to Coefficients Mapping, by writing '1' to the 
// GEN3_EQ_PSET_COEF_MAP_MODE_PROG field of GEN3_RELATED_OFF register, this parameter is used to set the default local Full Swing 
// (FS) value for Gen4 data rate. The FS value is specific to the PHY implementation. It is needed by the controller because 
// it is advertised during Gen4 equalization Phase 1, and it is used to determine if the coefficients meet the rules, as 
// described in Rules for Transmitter Coefficients, section TBD of the PCI Express Base Specification, Rev 4.0. 
// This is the default of the GEN3_EQ_LOCAL_FS field in GEN3_EQ_LOCAL_FS_LF_OFF when in Gen4 mode.
`define DEFAULT_GEN4_EQ_LOCAL_FS 6'd48


// Name:           DEFAULT_GEN5_EQ_LOCAL_FS
// Default:        48
// Values:         12, ..., 63
// Enabled:        CX_MAX_PCIE_SPEED >= 5
// Parameter Type: Register Default Setting
// 
// When you enable the Programmable Table for Gen3 Equalization Presets to Coefficients Mapping, by writing '1' to the 
// GEN3_EQ_PSET_COEF_MAP_MODE_PROG field of GEN3_RELATED_OFF register, this parameter is used to set the default local Full Swing 
// (FS) value for Gen5 data rate. The FS value is specific to the PHY implementation. It is needed by the controller because 
// it is advertised during Gen5 equalization Phase 1, and it is used to determine if the coefficients meet the rules, as 
// described in Rules for Transmitter Coefficients, section TBD of the PCI Express Base Specification, Rev 5.0. 
// This is the default of the GEN3_EQ_LOCAL_FS field in GEN3_EQ_LOCAL_FS_LF_OFF when in Gen5 mode.
`define DEFAULT_GEN5_EQ_LOCAL_FS 6'd48


// Name:           DEFAULT_GEN6_EQ_LOCAL_FS
// Default:        48
// Values:         12, ..., 63
// Enabled:        CX_MAX_PCIE_SPEED >= 6
// Parameter Type: Register Default Setting
// 
// When you enable the Programmable Table for Gen3 Equalization Presets to Coefficients Mapping, by writing '1' to the 
// GEN3_EQ_PSET_COEF_MAP_MODE_PROG field of GEN3_RELATED_OFF register, this parameter is used to set the default local Full Swing 
// (FS) value for Gen6 data rate. The FS value is specific to the PHY implementation. It is needed by the controller because 
// it is advertised during Gen6 equalization Phase 1, and it is used to determine if the coefficients meet the rules, as 
// described in Rules for Transmitter Coefficients, section TBD of the PCI Express Base Specification, Rev 6.0. 
// This is the default of the GEN3_EQ_LOCAL_FS field in GEN3_EQ_LOCAL_FS_LF_OFF when in Gen6 mode.
`define DEFAULT_GEN6_EQ_LOCAL_FS 6'd48


// Name:           DEFAULT_GEN4_EQ_LOCAL_LF
// Default:        16
// Values:         0, ..., 63
// Enabled:        CX_GEN4_MODE != GEN4_DISABLED
// Parameter Type: Register Default Setting
// 
// When you enable the Programmable Table for Gen3 Equalization Presets to Coefficients Mapping, by writing '1' to the 
// GEN3_EQ_PSET_COEF_MAP_MODE_PROG field of GEN3_RELATED_OFF register, this parameter is used to set the default local Low 
// Frequency (LF) value for Gen4 data rate. The LF value is specific to the PHY implementation. It is needed by the controller 
// because it is advertised during Gen4 equalization Phase1, and it is used to determine if the coefficients meet the rules, as 
// described in Rules for Transmitter Coefficients, section TBD of the PCI Express Base Specification, Rev 4.0. 
// This is the default of the GEN3_EQ_LOCAL_LF field in GEN3_EQ_LOCAL_FS_LF_OFF when in Gen4 mode.
`define DEFAULT_GEN4_EQ_LOCAL_LF 6'd16


// Name:           DEFAULT_GEN5_EQ_LOCAL_LF
// Default:        16
// Values:         0, ..., 63
// Enabled:        CX_MAX_PCIE_SPEED >= 5
// Parameter Type: Register Default Setting
// 
// When you enable the Programmable Table for Gen3 Equalization Presets to Coefficients Mapping, by writing '1' to the 
// GEN3_EQ_PSET_COEF_MAP_MODE_PROG field of GEN3_RELATED_OFF register, this parameter is used to set the default local Low 
// Frequency (LF) value for Gen5 data rate. The LF value is specific to the PHY implementation. It is needed by the controller 
// because it is advertised during Gen5 equalization Phase1, and it is used to determine if the coefficients meet the rules, as 
// described in Rules for Transmitter Coefficients, section TBD of the PCI Express Base Specification, Rev 5.0. 
// This is the default of the GEN3_EQ_LOCAL_LF field in GEN3_EQ_LOCAL_FS_LF_OFF when in Gen5 mode.
`define DEFAULT_GEN5_EQ_LOCAL_LF 6'd16


// Name:           DEFAULT_GEN6_EQ_LOCAL_LF
// Default:        16
// Values:         0, ..., 63
// Enabled:        CX_MAX_PCIE_SPEED >= 6
// Parameter Type: Register Default Setting
// 
// When you enable the Programmable Table for Gen3 Equalization Presets to Coefficients Mapping, by writing '1' to the 
// GEN3_EQ_PSET_COEF_MAP_MODE_PROG field of GEN3_RELATED_OFF register, this parameter is used to set the default local Low 
// Frequency (LF) value for Gen6 data rate. The LF value is specific to the PHY implementation. It is needed by the controller 
// because it is advertised during Gen6 equalization Phase1, and it is used to determine if the coefficients meet the rules, as 
// described in Rules for Transmitter Coefficients, section TBD of the PCI Express Base Specification, Rev 6.0. 
// This is the default of the GEN3_EQ_LOCAL_LF field in GEN3_EQ_LOCAL_FS_LF_OFF when in Gen6 mode.
`define DEFAULT_GEN6_EQ_LOCAL_LF 6'd16


