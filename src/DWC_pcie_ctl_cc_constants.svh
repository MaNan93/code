`define VF_MSI_CAP_ENABLE 1'h0


// `define VF_MSI_EN


// Name:           VF_MSIX_CAP_ENABLE
// Default:        false (CX_SRIOV_ENABLE && (CX_INTERNAL_NVFUNC != 0))
