//  dbi_cs2 in addition to dbi_cs.
`define VF_BAR0_MASK_WRITABLE_5 1'h0


// Name:           VF_BAR0_MASK_5
// Default:        0xfffff (VF_BAR0_RESIZABLE_5==1?[<functionof> 
