`define CC_PHASE_II_REG_SET 1'b1


// Name:         CX_DMA_CHANNEL_GROUP_ENABLE
// Default:      0
// Values:       0, 1
// Enabled:      CC_DMA_ENABLE && AXI_POPULATED && CC_UNROLL_ENABLE && 
//               CC_NUM_DMA_WR_CHAN>1 && CC_NUM_DMA_RD_CHAN>1 && !CX_DMA_PF_ENABLE
// 
// Channel Grouping Feature Enable for both read and write engine. Only supported for AXI configs with Unrolled DMA 
// registers. Only Valid for multi-channel configurations. Enabled by default for AXI+DMA(UNROLL) configs.
// `define CX_DMA_CHANNEL_GROUP_ENABLE


// Name:         CC_LINKED_LIST_DMA
// Default:      1
// Values:       0, 1
// 
// Includes linked list to support multi-DMA write/read block transfers.
`define CC_LINKED_LIST_DMA


// Name:           CC_NUM_DMA_RD_TAG
// Default:        256 ((CX_MAX_TAG>=767) ? 256 : (CX_MAX_TAG==1) ? 2 : 
//                 (CX_MAX_TAG+1)/2)
// Values:         2 4 8 16 32 64 128 256 512
// Enabled:        CC_DMA_ENABLE
// Parameter Type: Performance Setting
// 
// Specifies how many of the CX_MAX_TAG+1 PCIe tags are reserved for DMA MRd generation. 
//  - CC_NUM_DMA_RD_TAG of the CX_MAX_TAG+1 tags are reserved for use by the DMA controller (and are no longer available 
//  to your application) for generation of non-posted DMA traffic. These are in the number range CX_MAX_TAG +1 
//  -CC_NUM_DMA_RD_TAG to CX_MAX_TAG. 
//  - The remaining CX_MAX_TAG +1 - CC_NUM_DMA_RD_TAG tags are assigned to non-DMA transfers. These are in the number 
//  range 0 to CX_MAX_TAG -CC_NUM_DMA_RD_TAG. 
// This parameter is also used to size the DMA Read buffer. The minimum value for CX_MAX_TAG is "3" when DMA is enabled.
`define CC_NUM_DMA_RD_TAG 256


// Name:         CC_NUM_DMA_RD_5BIT_TAG
// Default:      16 ( (CC_DMA_ENABLE) ? ( ( CX_MAX_TAG <= 31 ) ? CC_NUM_DMA_RD_TAG  
//               : ( ( ( ( CX_MAX_TAG + 1 ) / ( CC_NUM_DMA_RD_TAG ) ) <= 8 ) ? ( ( 
//               CC_NUM_DMA_RD_TAG * 32 ) / ( ( CX_MAX_TAG >= 767 ) ? 1024 : ( CX_MAX_TAG 
//               + 1 ) ) ) : 2 ) ) : 2 )
// Values:       2 4 8 16
// Enabled:      CC_DMA_ENABLE
// 
// Specifies how many of the CX_MAX_TAG+1 PCIe tags are reserved for DMA MRd generation when tags are restricted to 5 bit.
`define CC_NUM_DMA_RD_5BIT_TAG 16


// Name:         CC_NUM_DMA_RD_8BIT_TAG
// Default:      128 ( (CC_DMA_ENABLE) ? ( ( CX_MAX_TAG <= 255 ) ? CC_NUM_DMA_RD_TAG 
//                : ( ( ( ( CX_MAX_TAG + 1 ) / ( CC_NUM_DMA_RD_TAG ) ) <= 64 ) ? ( ( 
//               CC_NUM_DMA_RD_TAG * 256 ) / ( ( CX_MAX_TAG >= 767 ) ? 1024 : ( 
//               CX_MAX_TAG + 1 ) ) ) : 2 ) ) : 2 )
// Values:       2 4 8 16 32 64 128
// Enabled:      CC_DMA_ENABLE
// 
// Specifies how many of the CX_MAX_TAG+1 PCIe tags are reserved for DMA MRd generation when tags are restricted to 8 bit.
`define CC_NUM_DMA_RD_8BIT_TAG 128


`define CC_NUM_DMA_RD_TAG_WIDTH 8


`define CC_NUM_DMA_RD_5BIT_TAG_WIDTH 4


`define CC_NUM_DMA_RD_8BIT_TAG_WIDTH 7


// Name:         CC_DMA_RD_TAG_LOW
// Default:      512 (CX_MAX_TAG > 255) ? ((CX_MAX_TAG + 256) +1 - 
//               CC_NUM_DMA_RD_TAG) : (CX_MAX_TAG + 1 - CC_NUM_DMA_RD_TAG)
// Values:       0, ..., 16384
// 
// Specifies the DMA read minimum PCIe tag number.
`define CC_DMA_RD_TAG_LOW 512


// Name:         CC_DMA_RD_TAG_HIGH
// Default:      767 ((CX_MAX_TAG > 255) ? (CX_MAX_TAG + 256) : CX_MAX_TAG)
// Values:       0, ..., 16384
// 
// Specifies the DMA read maximum PCIe tag number.
`define CC_DMA_RD_TAG_HIGH 767


`define CC_DMA_RD_TAG_HIGH_WIDTH 10


// Name:         CC_DMA_RD_5BIT_TAG_LOW
// Default:      16 ( ( CX_MAX_TAG <= 31 ) ? ( ( CX_MAX_TAG + 1 ) - 
//               CC_NUM_DMA_RD_5BIT_TAG ) : ( 32 - CC_NUM_DMA_RD_5BIT_TAG ) )
// Values:       0, ..., 31
// 
// Specifies the DMA read minimum PCIe tag number when tags are restricted to 5 bit.
`define CC_DMA_RD_5BIT_TAG_LOW 16


// Name:         CC_DMA_RD_5BIT_TAG_HIGH
// Default:      31 ( ( CX_MAX_TAG <= 31 ) ? ( CX_MAX_TAG ) : 31 )
// Values:       0, ..., 31
// 
// Specifies the DMA read maximum PCIe tag number when tags are restricted to 5 bit.
`define CC_DMA_RD_5BIT_TAG_HIGH 31


`define CC_DMA_RD_5BIT_TAG_HIGH_WIDTH 5


// Name:         CC_DMA_RD_8BIT_TAG_LOW
// Default:      128 ( ( CX_MAX_TAG <= 255 ) ? ( ( CX_MAX_TAG + 1 ) - 
//               CC_NUM_DMA_RD_8BIT_TAG ) : ( 256 - CC_NUM_DMA_RD_8BIT_TAG ) )
// Values:       0, ..., 255
// 
// Specifies the DMA read minimum PCIe tag number when tags are restricted to 8 bit.
`define CC_DMA_RD_8BIT_TAG_LOW 128


// Name:         CC_DMA_RD_8BIT_TAG_HIGH
// Default:      255 ( ( CX_MAX_TAG <= 255 ) ? ( CX_MAX_TAG ) : 255 )
// Values:       0, ..., 255
// 
// Specifies the DMA read maximum PCIe tag number when tags are restricted to 8 bit.
`define CC_DMA_RD_8BIT_TAG_HIGH 255


`define CC_DMA_RD_8BIT_TAG_HIGH_WIDTH 8


// Name:         CC_MAX_NON_DMA_5BIT_TAG_HIGH
// Default:      15 ((CC_DMA_ENABLE) ? ((CX_MAX_TAG > 31) ? (31 - 
//               CC_NUM_DMA_RD_5BIT_TAG) : (CX_MAX_TAG - CC_NUM_DMA_RD_5BIT_TAG)) : 2)
// Values:       0, ..., 31
// 
// Specifies the number of PCIe tags supported to manage non DMA transactions when tags are restricted to 5 bit.
`define CC_MAX_NON_DMA_5BIT_TAG_HIGH 15


// Name:         CC_MAX_NON_DMA_8BIT_TAG_HIGH
// Default:      127 ((CC_DMA_ENABLE) ? ((CX_MAX_TAG > 255) ? (255 - 
//               CC_NUM_DMA_RD_8BIT_TAG) : (CX_MAX_TAG - CC_NUM_DMA_RD_8BIT_TAG)) : 2)
// Values:       0, ..., 255
// 
// Specifies the number of PCIe tags supported to manage non DMA transactions for 8 bit tags. 
//   
// Note: the number of non DMA tags supported is equal to (CC_MAX_NON_DMA_8BIT_TAG_HIGH + 1) to 
//  align with the bridge xadm tag manager implementation which sets the high tag to 
//  (CC_SLV_DECOMP_TAG_HIGH + 1).
`define CC_MAX_NON_DMA_8BIT_TAG_HIGH 127


// Name:         CC_MAX_NON_DMA_10BIT_TAG_HIGH
// Default:      255 ((CC_DMA_ENABLE) ? (CX_MAX_TAG - CC_NUM_DMA_RD_TAG) : 2)
// Values:       0, ..., 767
// 
// Specifies the number of PCIe tags supported to manage non DMA transactions when 10 bit tags are enabled. 
//   
// Note: the number of non DMA tags supported is equal to (CC_MAX_NON_DMA_10BIT_TAG_HIGH + 1) to 
//  align with the bridge xadm tag manager implementation which sets the high tag to 
//  (CC_SLV_DECOMP_TAG_HIGH + 1).
`define CC_MAX_NON_DMA_10BIT_TAG_HIGH 255


// Name:         CC_MAX_NON_DMA_TAG_HIGH
// Default:      255 ((CX_10BITS_TAG_REQ) ? (CC_MAX_NON_DMA_10BIT_TAG_HIGH) : 
//               (CC_MAX_NON_DMA_8BIT_TAG_HIGH))
// Values:       0, ..., 767
// 
// Specifies the number of PCIe tags supported to manage non DMA transactions. 
//   
// Note: the number of non DMA tags supported is equal to (CC_MAX_NON_DMA_TAG_HIGH + 1) to 
//  align with the bridge xadm tag manager implementation which sets the high tag to 
//  (CC_SLV_DECOMP_TAG_HIGH + 1).
`define CC_MAX_NON_DMA_TAG_HIGH 255


`define CC_MAX_NON_DMA_5BIT_TAG_HIGH_WIDTH 4


`define CC_MAX_NON_DMA_8BIT_TAG_HIGH_WIDTH 7


`define CC_MAX_NON_DMA_10BIT_TAG_HIGH_WIDTH 8


`define CC_MAX_NON_DMA_TAG_HIGH_WIDTH 8


// Name:         DC_DMA_CTX_RAM_DATA_WIDTH
// Default:      288 (((CX_SRIOV_ENABLE==1) || (CX_TPH_ENABLE==1)) ?  288 : 256)
// Values:       -2147483648, ..., 2147483647
// 
// Specifies the eDMA Context and Remote Interrupt Message Information memory data width.
`define DC_DMA_CTX_RAM_DATA_WIDTH 288


// Name:         DC_DMA_CTX_RAM_DATA_WECC_WIDTH
// Default:      327 (CX_RAS_EN==1 ? [<functionof> 0 DC_DMA_CTX_RAM_DATA_WIDTH 
//               CX_RAS_RAM_PROT_RANGE] + DC_DMA_CTX_RAM_DATA_WIDTH : 
//               DC_DMA_CTX_RAM_DATA_WIDTH)
// Values:       -2147483648, ..., 2147483647
// 
// Specifies the eDMA Context data width including ECC bits.
`define DC_DMA_CTX_RAM_DATA_WECC_WIDTH 327


// Name:         CC_DMA_CTX_RAM_DEPTH
// Default:      6 (2 + CC_NUM_DMA_RD_CHAN + CC_NUM_DMA_WR_CHAN)
// Values:       -2147483648, ..., 2147483647
// 
// Specifies the number of entries in the eDMA Context and Remote Interrupt Message Information memory. 
//  The context DMA RAM stores the per channel DMA read and write 
//  context information and interrupt message information. 
//  The maximum per channel context size is 8/9 data words or one entry. 
//  For phase 2 the SAR and DAR address widths (32/64) will be considered in the context DMA RAM depth calculation. 
//  The interupt message info size is 16 data words or two entries.
`define CC_DMA_CTX_RAM_DEPTH 6


// Name:         CC_DMA_CTX_RAM_ADDR_WIDTH
// Default:      3 ([<functionof>  (2 + CC_NUM_DMA_RD_CHAN + CC_NUM_DMA_WR_CHAN)])
// Values:       -2147483648, ..., 2147483647
// 
// Specifies the 256-bit aligned eDMA Context and Remote Interrupt Message Information memory address width.
`define CC_DMA_CTX_RAM_ADDR_WIDTH 3


`define CC_DMA_CTX_RAM_ADDRP_WIDTH 1


// Name:         CC_DMA_SEG_DEPTH
// Default:      10 (CX_NW_GTR_1 ? ((CX_MAX_MTU / (CX_NW*4)) + 2) : (CX_MAX_MTU / 
//               (CX_NW*4)))
// Values:       -2147483648, ..., 2147483647
// 
// Specifes the number of 32/64/128-bit entries per segment. 
//  The width of each entry is equal to the width of the controller data bus. 
//  The segment buffer size is equal to the maximum packet payload size supported by the core. 
//  In 64/128-bit configurations and extra 2 entries per segment is required to account for 
//  data word holes in the first and last TLP's when the completer splits completions on the 
//  root complex boundary (RCB).
`define CC_DMA_SEG_DEPTH 10


// Name:         CC_DMA_SEG_ADDR_WIDTH
// Default:      4 ([<functionof> (CX_NW_GTR_1 ? ((CX_MAX_MTU / (CX_NW*4)) + 2) : 
//               (CX_MAX_MTU / (CX_NW*4)))])
// Values:       -2147483648, ..., 2147483647
// 
// Specifies the 32/64/128-bit aligned segment entry address width.
`define CC_DMA_SEG_ADDR_WIDTH 4


// Name:         CC_DMA_SEG_BUF_DEPTH
// Default:      2560 (CC_NUM_DMA_RD_TAG * CC_DMA_SEG_DEPTH)
// Values:       -2147483648, ..., 2147483647
// 
// Specifes the number of 32/64/128-bit entries in the segment buffer. 
//  The number of segments equals the number of PCIe tags allocated to the DMA read function.
`define CC_DMA_SEG_BUF_DEPTH 2560


// Name:         CC_DMA_SEG_BUF_NW_ADDR_WIDTH
// Default:      12 ([<functionof>  (CC_NUM_DMA_RD_TAG * CC_DMA_SEG_DEPTH)])
// Values:       -2147483648, ..., 2147483647
// 
// Specifies the 32/64/128-bit aligned segment buffer entry address width. 
//  The segment buffer address is aligned to the segment buffer data width.
`define CC_DMA_SEG_BUF_NW_ADDR_WIDTH 12


`define CC_DMA_SEG_BUF_NW_ADDRP_WIDTH 2


// Name:         CC_DMA_SEG_BUF_DATA_WIDTH
// Default:      512 (CX_NW*32)
// Values:       -2147483648, ..., 2147483647
// 
// Specifies the segment buffer data width. 
//  Note: Parity disabled when DMA enabled.
`define CC_DMA_SEG_BUF_DATA_WIDTH 512


// `define CX_DMA_RD_MULTICOMPOSER


// `define CX_SBC_PUSH_EXTRA_EN


`define CX_DMA_RBUF_NSLICES 1


`define CX_DMA_RBUF_SLICE_WD_NECC 512


`define CC_DMA_SEG_BUF_NW_ADDR_WIDTH_MULTISTREAM_ECC 12


`define CX_DMA_RBUF_SLICE_ECC_WD 64


// Name:         CC_DMA_SEG_BUF_DATA_WPAR_WIDTH
// Default:      576 ((CX_RAS_EN==1)? [<functionof> CC_DMA_SEG_BUF_DATA_WIDTH 
//               CX_RAS_PROT_RANGE RAS_BASE_PROT_WD ] + CC_DMA_SEG_BUF_DATA_WIDTH : 
//               CC_DMA_SEG_BUF_DATA_WIDTH)
// Values:       -2147483648, ..., 2147483647
// 
// Specifies the segment buffer data width including Parity bits.
`define CC_DMA_SEG_BUF_DATA_WPAR_WIDTH 576


// Name:         CC_DMA_SEG_BUF_DATA_WECC_WIDTH
// Default:      576 (CX_RAS_EN==1 ? [<functionof> 
//               CC_DMA_SEG_BUF_NW_ADDR_WIDTH_MULTISTREAM_ECC CC_DMA_SEG_BUF_DATA_WIDTH CX_RAS_RAM_PROT_RANGE] + 
//               CC_DMA_SEG_BUF_DATA_WIDTH : CC_DMA_SEG_BUF_DATA_WIDTH)
// Values:       -2147483648, ..., 2147483647
// 
// Specifies the segment buffer data width including ECC bits.
`define CC_DMA_SEG_BUF_DATA_WECC_WIDTH 576


`define CX_DMA_RBUF_SLICE_WD 576


// Name:           CC_DMA_SEG_BUF_RAM_LATENCY
// Default:        1 Cycle
// Values:         1 Cycle (1), 2 Cycles (2), 3 Cycles (3), 4 Cycles (4)
// Enabled:        CC_DMA_ENABLE
// Parameter Type: Performance Setting
// 
// Specifies the RAM latency of the DMA Read Buffer RAM. The controller samples the read data CC_DMA_SEG_BUF_RAM_LATENCY 
// clock cycles after the read address been valid. The default of '1' corresponds to the typical read cycle access time for 
// synchronous memories.
`define CC_DMA_SEG_BUF_RAM_LATENCY 1


// Name:           CC_DMA_SEG_BUF_RAM_REG_IF
// Default:        1 (CX_RAS_EN || CX_DMA_PF_ENABLE)
// Values:         0, 1
// Enabled:        CC_DMA_ENABLE
// Parameter Type: Performance Setting
// 
// Specifies if a pipeline is inserted for the DMA Read Buffer RAM control and R/W data signals.
`define CC_DMA_SEG_BUF_RAM_REG_IF 1


`define CC_DMA_SEG_BUF_RAM_REG_IF_EN


