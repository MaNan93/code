//                 ((CC_DEVICE_TYPE==CC_SW || CX_NW>=8) ? 1 : 4))
// Values:         Store/Fwd (0x1), Cut Thru (0x2), Bypass (0x4)
// Enabled:        (CX_MULTISTREAM_ARCH ? !AMBA_INTERFACE>0 : !(CX_NW>=8 && 
//                 CX_RADMQ_MODE!=2))
// Parameter Type: Feature Setting
// 
// The queue mode for the completion tlp receive queue for VC0. 
//  - Bypass: In this mode your application must accept all completions without halting the TRGT1 completion interface. 
//  For non-multistream architecture configurations there is no receive segmented buffer completion queue. For multistream 
//  architecture configurations, if more than one completion must be processed in a single core cycle or IDE is enabled, then the 
//  receive completion queue is present and is sized based on the enabled overflow prevention mechanism. 
//  - Store-and-forward: TLPs are stored into queue; TLP is advertised only after the full TLP is stored into the queue. 
//  - Cut-through: TLPs are stored into queue and presented to your application at the same time it is being stored into 
//  the queue.
`define RADM_CPL_QMODE_VC0 3'h4


// Name:           RADM_P_QMODE_VC0
// Default:        Cut Thru ((CX_GEN6_SPEED) ? 2 : 1)
// Values:         Store/Fwd (0x1), Cut Thru (0x2), Bypass (0x4)
// Enabled:        (CX_MULTISTREAM_ARCH ? !AMBA_INTERFACE>0 : !(CX_NW>=8 && 
//                 CX_RADMQ_MODE!=2))
// Parameter Type: Feature Setting
// 
// The queue mode for the posted TLP receive queue for VC0. 
//  - Bypass: There is no receive queue in this mode, your application must be able to accept all traffic as back-pressure 
//  is disabled in the mode. 
//  - Store-and-forward: TLPs are stored into queue; TLP is advertised only after the full TLP is stored into the queue. 
//  - Cut-through: TLPs are stored into queue and presented to your application at the same time it is being stored into 
//  the queue.
`define RADM_P_QMODE_VC0 3'h2


// Name:           RADM_NP_QMODE_VC0
// Default:        Store/Fwd (CX_RADMQ_MODE==0 ? RADM_P_QMODE_VC0 : 1)
// Values:         Store/Fwd (0x1)
// Enabled:        (CX_RADMQ_MODE!=0 && !(CX_NW>=8 && CX_RADMQ_MODE!=2))
// Parameter Type: Feature Setting
// 
// The queue mode for the non-posted TLP receive queue for VC0. 
//  - Store-and-forward: TLPs are stored into queue; TLP is advertised only after the full TLP is stored into the queue.
`define RADM_NP_QMODE_VC0 3'h1


// Name:         MSIX_TABLE_EN
// Default:      0
// Values:       0, 1
// Enabled:      (((CC_DEVICE_TYPE==CC_EP) || (CC_DEVICE_TYPE==CC_DM)) && 
//               !CX_EXTENSIBLE_VFUNC)
// 
// Implements the MSI-X generation logic with the data/address table and PBA in the controller. 
// Not available when Extensible Virtual Function (CX_EXTENSIBLE_VFUNC) is enabled.
// `define MSIX_TABLE_EN


// Name:         CX_MSIX_TABLE_RAM_DEPTH
// Default:      0 ([<functionof> table])
// Values:       -2147483648, ..., 2147483647
// Enabled:      0
// 
// Depth of the RAM used to store MSI-X vector information when the MSI-X table module is used (MSIX_TABLE_EN is selected).
`define CX_MSIX_TABLE_RAM_DEPTH 0


// Name:         CX_MSIX_TABLE_PW
// Default:      1 ([<functionof> CX_MSIX_TABLE_RAM_DEPTH])
// Values:       -2147483648, ..., 2147483647
// 
// Bus width required to address the MSI-X vector RAM (MSIX_TABLE_EN is selected).
`define CX_MSIX_TABLE_PW 1


// Name:         CX_MSIX_PBA_RAM_DEPTH
// Default:      0 ([<functionof> pba])
// Values:       -2147483648, ..., 2147483647
// Enabled:      0
// 
// Depth of the RAM used to store MSI-X PBA information when the MSI-X table module is used (MSIX_TABLE_EN is selected).
`define CX_MSIX_PBA_RAM_DEPTH 0


// Name:         CX_MSIX_PBA_PW
// Default:      1 ([<functionof> CX_MSIX_PBA_RAM_DEPTH])
// Values:       -2147483648, ..., 2147483647
// 
// Bus width required to address the MSI-X PBA RAM (MSIX_TABLE_EN is selected).
`define CX_MSIX_PBA_PW 1


// Name:           CX_MAX_MTU
// Default:        512 (CX_FLIT_MODE_ENABLE? 512 : ((CX_PCIE_MODE == PCIE_OVER_CIO) ? 
//                 128 : 256))
// Values:         128 256 512 1024 2048 4096
// Enabled:        (CX_PCIE_MODE == PCIE_OVER_CIO) ? 0 : 1
// Parameter Type: Performance Setting
// 
// The largest packet payload (Maximum Transfer Unit) that the device supports. Specified in bytes and not dwords. This is 
// distinct from the maximum operating payload (Max_Payload_Size) which may be set by software. This value is used to set 
// memory sizes and places other restrictions on the size of structures. The device supports any valid payload size equal to or 
// smaller than the value specified here.
`define CX_MAX_MTU 16'd512


// Name:         CX_MAX_MTU_LEN
// Default:      8 ((CX_MAX_MTU > (CX_NW*4)) ? (CX_MAX_MTU/(CX_NW*4)) : 1)
// Values:       -2147483648, ..., 2147483647
// 
// Max Payload Size in Beats
`define CX_MAX_MTU_LEN 8


// Name:         CX_MAX_MTU_NP
// Default:      128 ((CX_DEF_MEM_WR_ENABLE==1) ? 128 : (CX_ATOMIC_ENABLE==1) ? 32 : 
//               4)
// Values:       -2147483648, ..., 2147483647
// 
// Max Non posted Data MTU size in Bytes
`define CX_MAX_MTU_NP 128


// Name:         CX_MAX_MTU_NP_LEN
// Default:      2 ((CX_MAX_MTU_NP > (CX_NW*4)) ? (CX_MAX_MTU_NP/(CX_NW*4)) : 1)
// Values:       -2147483648, ..., 2147483647
// 
// Max Non posted Data MTU size in Beats
`define CX_MAX_MTU_NP_LEN 2


// Name:         CX_RADM_PKT_ORD_WD
// Default:      16
// Values:       -2147483648, ..., 2147483647
// 
// RADM Packet Order Number Width 
// You must ensure this is always equal to, or greater than, log2ceil(RADM_PQ_HCRD_VCx)+1, for 
// every VC.
`define CX_RADM_PKT_ORD_WD 16

//-/ =================================================================

// Name:           SLAVE_BUS_ADDR_WIDTH
// Default:        64 ((CC_DTIM_ENABLE || MSIX_TABLE_EN || CX_ATS_ENABLE) ? 64 : 32)
// Values:         32 64
// Enabled:        SLAVE_POPULATED && AXI_POPULATED
// Parameter Type: Feature Setting
// 
// Specifies the width of the AXI slave address bus (excluding parity bits [AXI only] if any)
`define SLAVE_BUS_ADDR_WIDTH 64


// Name:           SLAVE_BUS_DATA_WIDTH
// Default:        512 ((CX_NW * 32))
// Values:         32 64 128 256 512 1024
// Enabled:        SLAVE_POPULATED
// Parameter Type: Feature Setting
// 
// Specifies the width of the AXI slave data bus (excluding parity bits [AXI only] if any).
`define SLAVE_BUS_DATA_WIDTH 512


// Name:         CX_AMBA_AXI_S_POISON_WD
// Default:      8 ([<functionof> SLAVE_BUS_DATA_WIDTH 64])
// Values:       -2147483648, ..., 2147483647
// 
// AXI S Poison signal data width
`define CX_AMBA_AXI_S_POISON_WD 8


// Name:           CC_SLV_BURST_LEN
// Default:        8 (CX_MULTISTREAM_ARCH ? (CX_MAX_MTU/(SLAVE_BUS_DATA_WIDTH/8) > 256 
//                 ? 256 : (CX_MAX_MTU/(SLAVE_BUS_DATA_WIDTH/8) < 4 ? 4 : 
//                 CX_MAX_MTU/(SLAVE_BUS_DATA_WIDTH/8))) : 16)
// Values:         4 8 16 32 64 128 256
// Enabled:        SLAVE_POPULATED
// Parameter Type: Performance Setting
// 
// Specify the maximum burst length (in beats) of an AXI transfer at the slave interface. An application master might 
// execute any burst up to a maximum byte size given by CC_SLV_BURST_LEN * (CC_SLV_BUS_DATA_WIDTH / 8) bytes. This parameter 
// controls the default size of the slave request decomposer data RAM inside the AXI bridge based on the maximum MemWr transfer 
// size. This parameter uses the unit of burst beat.
`define CC_SLV_BURST_LEN 8


// Name:           CC_SLV_MTU
// Default:        512 (((CC_SLV_BURST_LEN*SLAVE_BUS_DATA_WIDTH/8) > 4096) ? 4096 : 
//                 (CC_SLV_BURST_LEN*SLAVE_BUS_DATA_WIDTH/8))
// Values:         -2147483648, ..., 2147483647
// Enabled:        0
// Parameter Type: Feature Setting
// 
// Slave Maximum Transfer Unit. The application master (at the AXI Slave Interface) must not request or write more than 
// CC_SLV_MTU bytes in a single AXI burst. This value is used to set memory sizes in the bridge (slave request decomposer data 
// FIFO and slave response composer). This parameter is derived automatically as CC_SLV_BURST_LEN * (SLAVE_BUS_DATA_WIDTH / 8) 
// and is read-only.
`define CC_SLV_MTU 512


// Name:           CC_SLV_WRAP_ENABLE
// Default:        1 ((CX_ATOMIC_ENABLE==1) && (AMBA_INTERFACE==4))
// Values:         0, 1
// Enabled:        AMBA_INTERFACE>=2
// Parameter Type: Feature Setting
// 
// Enable support of wrapping bursts at the AXI bridge slave.
`define CC_SLV_WRAP_ENABLE

//-/ =================================================================

// Name:           ROUND_TRIP_LATENCY
// Default:        500
// Values:         0, ..., 65535
// Parameter Type: Feature Setting
// 
// Specifies your expected Round Trip Latency in ns. 
// Includes: 
//  - Local Controller and PHY latencies 
//  - Remote Controller and PHY latencies 
//  - Retimers 
//  - Response time of the remote side
`define ROUND_TRIP_LATENCY 500


// Name:         CX_MIN_HDR_SIZE
// Default:      12
// Values:       -2147483648, ..., 2147483647
// Enabled:      CX_GEN6_SPEED
// 
// Minimum NFM/FM TLP Header Size in Bytes
`define CX_MIN_HDR_SIZE 12


// Name:         TLP_EFFICIENCY_NFM
// Default:      96 ((100*CX_MAX_MTU/(CX_MAX_MTU+20)))
// Values:       -2147483648, ..., 2147483647
// 
// Non-Flit mode Posted/Completion TLP Efficiency (%)
`define TLP_EFFICIENCY_NFM 96


// Name:         TLP_EFFICIENCY_FM
// Default:      90 ((100*CX_MAX_MTU*236)/((CX_MAX_MTU+CX_MIN_HDR_SIZE)*256))
// Values:       -2147483648, ..., 2147483647
// 
// Flit mode Posted/Completion TLP Efficiency (%)
`define TLP_EFFICIENCY_FM 90


// Name:           TLP_EFFICIENCY
// Default:        96 ([<functionof> CX_FLIT_MODE_ENABLE TLP_EFFICIENCY_NFM 
//                 TLP_EFFICIENCY_FM])
// Values:         0, ..., 65535
// Enabled:        0
// Parameter Type: Feature Setting
// 
// Specifies the TLP Efficiency in %. 
// Smaller payload has less data efficiency (Data/(Hdr+Data)) and therefore requires less data buffer.
`define TLP_EFFICIENCY 96


// Name:           RADM_SEL_CPLQ_OVFLW_PRVNTN_VC
// Default:        Enable Cpl Queue Management ((CC_DEVICE_TYPE==CC_SW) ? 1 : 
//                 (CX_NW==4 && !CX_IDE_ENABLE) ? 0 : 2)
// Values:         None (0), Track Cpl Queue Credits (1), Enable Cpl Queue Management 
//                 (2), Fully Sized Cpl Queue (3)
// Enabled:        CX_GEN6_SPEED
// Parameter Type: Feature Setting
// 
// Selects the VC completion queue overflow prevention mechanism. 
// - None : VC completion queue not required, received completions fully buffered by the application. 
// - Advertise Cpl Queue Credits : The remote partner tracks advertised completion queue header/data credits. 
// - Enable Cpl Queue Management : Tx Non-Posted requests are throttled if there is insufficient header or data storage 
// available to accept the returning completion(s). 
// - Cpl Queue is Fully Sized : Tx Non-Posted requests are throttled when the permitted maximum number of outstanding 
// requests is reached. The CPL Queue has sufficient header and data resources to accept all returning completions to max sized 
// memory read requests.
`define RADM_SEL_CPLQ_OVFLW_PRVNTN_VC 1


// Name:         CPLQ_OVFLW_PRVNTN_VC_EN
// Default:      1 ((CX_MULTISTREAM_ARCH && RADM_SEL_CPLQ_OVFLW_PRVNTN_VC>0) ? 1 : 
//               0)
// Values:       -2147483648, ..., 2147483647
// 
// Enable VC completion queue overflow prevention.
`define CPLQ_OVFLW_PRVNTN_VC_EN 1


// Name:         CPLQ_MNGT_ENABLE_MS
// Default:      0 ((CX_MULTISTREAM_ARCH && RADM_SEL_CPLQ_OVFLW_PRVNTN_VC==2) ? 1 : 
//               0)
// Values:       -2147483648, ..., 2147483647
// 
// Enable the Tx to throttle Non-posted request if there is not enough space for the completion(s) in the per VC completion 
// queue(s).
`define CPLQ_MNGT_ENABLE_MS 0


// Name:         RADM_TRK_CPLQ_CRDTS_VC
// Default:      1 ((RADM_SEL_CPLQ_OVFLW_PRVNTN_VC==1) ? 1 : 0)
// Values:       -2147483648, ..., 2147483647
// 
// Enable the remote link partner to track advertised completion queue credits. 
// By default, if the device type is a switch and the completion queue mode is cut-through/store-forward then the 
// controller advertises completion queue credits, otherwise infinite credits are advertised.
`define RADM_TRK_CPLQ_CRDTS_VC 1


// Name:         CPLQ_FULLY_SIZED
// Default:      0 ((RADM_SEL_CPLQ_OVFLW_PRVNTN_VC==3) ? 1 : 0)
// Values:       -2147483648, ..., 2147483647
// 
// The CPL Queue has sufficient header and data resources to accept all returning completions to max sized memory read 
// requests.
`define CPLQ_FULLY_SIZED 0


// Name:         CX_MAX_APP_RD_REQ_SIZE_AMBA_DMA
// Default:      0x200 ((CC_SLV_MTU < CX_MAX_MTU) ? CX_MAX_MTU : CC_SLV_MTU)
// Values:       0x0, ..., 0xffff
// 
// The max application read request size when the AMBA and DMA blocks are populated.
`define CX_MAX_APP_RD_REQ_SIZE_AMBA_DMA 16'h200


// Name:         CX_APP_RD_REQ_SIZE
// Default:      512 (!AMBA_POPULATED ? CX_MAX_MTU : (CC_DMA_ENABLE ? 
//               CX_MAX_APP_RD_REQ_SIZE_AMBA_DMA : CC_SLV_MTU))
// Values:       32 64 128 256 512 1024 2048 4096
// Enabled:      CX_MULTISTREAM_ARCH ? CPLQ_FULLY_SIZED : !AMBA_POPULATED && 
//               (RADM_CPL_QMODE_VC0!=4)
// 
// This parameter is used to set the depth of the receive completion data queue (CX_CPLQ_DDP_VC*) when completions are in 
// store-and-forward or cut-through modes, and completion credits are infinite. 
//  - It is the maximum individual MRd size that your application (or AXI bridge slave) makes. 
//  - When an AXI bridge is enabled, CX_APP_RD_REQ_SIZE is calculated automatically and you cannot change it.
`define CX_APP_RD_REQ_SIZE 16'd512


// Name:         CPLQ_MNG_DDP_MS
// Default:      30720 ([<functionof> CX_MAX_PCIE_SPEED CX_NL ROUND_TRIP_LATENCY 
//               TLP_EFFICIENCY])
// Values:       -2147483648, ..., 2147483647
// 
// Specifies the logical data storage requirements of the multi-stream architecture receive completion queue in bytes.
`define CPLQ_MNG_DDP_MS 30720


// Name:           CPLQ_MNG_DDP
// Default:        30720 (CX_MULTISTREAM_ARCH ? CPLQ_MNG_DDP_MS : ([<functionof> 
//                 CX_MAX_PCIE_SPEED CX_NL ROUND_TRIP_LATENCY TLP_EFFICIENCY 
//                 CX_APP_RD_REQ_SIZE CX_NW RADM_CPL_QMODE_VC0]))
// Values:         0, ..., 262143
// Enabled:        !(CX_GEN6_SPEED)
// Parameter Type: Feature Setting
// 
// Specifies the size of the Completion Data Queue/RAM in bytes without the overhead needed by the Queue logic. 
// This is a recommendation based on your bandwidth, max TLP size and expected latency. 
// The Completion Queue Management feature can result in throttling of outbound read request. 
// It is your responsibility to guarantee sufficient completion queue buffer to meet your performance requirements.
`define CPLQ_MNG_DDP 30720


// Name:         MIN_RD_REQ_SIZE
// Default:      64
// Values:       32 64 128 256 512 1024 2048 4096
// 
// Specifies the smallest request size for which you want to maintain throughput. 
// Used to calculate the recommended number of TAGs (CPLQ_MNG_DDP/MIN_RD_REQ_SIZE). 
// Recommended size equal to or greater than 64 bytes.
`define MIN_RD_REQ_SIZE 16'd64


// Name:         MIN_RD_REQ_SIZE_
// Default:      64 (MIN_RD_REQ_SIZE)
// Values:       -2147483648, ..., 2147483647
// 
// Minimum Outbound Read Request Size in Bytes
`define MIN_RD_REQ_SIZE_ 64


// Name:         MIN_WR_REQ_SIZE
// Default:      32
// Values:       16 32 64 128 256 512 1024 2048 4096
// 
// Specifies the minimum inbound write request size for which you want to maintain throughput, multistream architecture.
`define MIN_WR_REQ_SIZE 16'd32


// Name:         CX_RX_NQDW
// Default:      7 ((CX_NW==32) ? 14 : (CX_NW==16) ? 7 : (CX_NW==8) ? 4 : 2)
// Values:       -2147483648, ..., 2147483647
// 
// Max Number of QDWs received by the RADM per core clock cyle, multistream architecture.
`define CX_RX_NQDW 7


// Name:           RECOMMENDED_TAGS
// Default:        512 ([<functionof> CPLQ_MNG_DDP MIN_RD_REQ_SIZE CX_MAX_PCIE_SPEED])
// Values:         0, ..., 65535
// Enabled:        0
// Parameter Type: Feature Setting
// 
// Recommended number of TAGs based on Latency and Critical Request Size specified.
`define RECOMMENDED_TAGS 512

//Use Combo Box

// Name:           CX_MAX_TAG
// Default:        512 ((RECOMMENDED_TAGS>767 && AMBA_INTERFACE!=0) ? 767 : 
//                 RECOMMENDED_TAGS)
// Values:         2 4 8 16 32 64 128 256 512 768 1024 2048 3072
// Enabled:        ((CC_DEVICE_TYPE!=CC_SW))
// Parameter Type: Performance Setting
// 
// Specifies the maximum number of simultaneous outbound PCIe non-posted requests in total for all functions. The default 
// value is sufficient for typical endpoint applications. This is used to size: 
//  - the Receive 'Completion Timeout Look-Up Table' 
//  - the completion Header Queue RAM when you configure completions in store-and-forward or cut-through modes 
//  - the tag Manager memories in the AXI bridge slave 
// The controller can always accept 8-bit tags (IDs 0 to 255) from the PCIe wire or your application, regardless of the 
// value of this parameter. 
//  
// Note: The value range in the GUI is displayed as CX_MAX_TAG+1. The actual parameter value in the RTL represents the 
// maximum tag number because the tags are numbered 0 to CX_MAX_TAG 
//  
// If you enable the DMA controller then: 
//  - CC_NUM_DMA_RD_TAG tags are reserved for use by the DMA controller. 
//  - The minimum value of CX_MAX_TAG allowed is 3
`define CX_MAX_TAG 511

`define CX_MAX_TAG_511


// Name:         CX_MAX_TAG_GTR_1
// Default:      1 ((CX_MAX_TAG > 1) ? 1 : 0)
// Values:       0, 1
// 
// Specifies device has more than 1 tag
`define CX_MAX_TAG_GTR_1


// Name:         CX_MAX_TAG_GTR_3
// Default:      1 ((CX_MAX_TAG > 3) ? 1 : 0)
// Values:       0, 1
// 
// Specifies device has more than 3 tags
`define CX_MAX_TAG_GTR_3


// Name:         CX_MAX_TAG_GTR_7
// Default:      1 ((CX_MAX_TAG > 7) ? 1 : 0)
// Values:       0, 1
// 
// Specifies device has more than 7 tags
`define CX_MAX_TAG_GTR_7


// Name:         CX_MAX_TAG_GTR_15
// Default:      1 ((CX_MAX_TAG > 15) ? 1 : 0)
// Values:       0, 1
// 
// Specifies device has more than 15 tags
`define CX_MAX_TAG_GTR_15


// Name:         CX_MAX_TAG_GTR_31
// Default:      1 ((CX_MAX_TAG > 31) ? 1 : 0)
// Values:       0, 1
// 
// Specifies device has more than 31 tags
`define CX_MAX_TAG_GTR_31


// Name:         CX_MAX_TAG_GTR_63
// Default:      1 ((CX_MAX_TAG > 63) ? 1 : 0)
// Values:       0, 1
// 
// Specifies device has more than 63 tags
`define CX_MAX_TAG_GTR_63


// Name:         CX_MAX_TAG_GTR_127
// Default:      1 ((CX_MAX_TAG > 127) ? 1 : 0)
// Values:       0, 1
// 
// Specifies device has more than 127 tags
`define CX_MAX_TAG_GTR_127


// Name:         CX_MAX_TAG_GTR_255
// Default:      1 ((CX_MAX_TAG > 255) ? 1 : 0)
// Values:       0, 1
// 
// Specifies device has more than 255 tags
`define CX_MAX_TAG_GTR_255


// Name:         CX_MAX_TAG_GTR_767
// Default:      0 ((CX_MAX_TAG > 767) ? 1 : 0)
// Values:       0, 1
// 
// Specifies device has more than 767 tags
// `define CX_MAX_TAG_GTR_767


`define CX_CPL_LUT_DEPTH 512


// Name:         CX_LUT_PTR_WIDTH
// Default:      9 ([<functionof> CX_MAX_TAG])
// Values:       -2147483648, ..., 2147483647
// 
// This is the width of the MAG_TAG bus.
`define CX_LUT_PTR_WIDTH 9


// Name:           CX_LBC_EXT_AW
// Default:        32
// Values:         12, ..., (FLT_Q_ADDR_WIDTH<=32 && !CC_RP_TDISP) ? FLT_Q_ADDR_WIDTH 
//                 : 32
// Enabled:        ((CC_DEVICE_TYPE!=CC_RC))
// Parameter Type: Feature Setting
// 
// Defines the width of the ELBI address bus for the Local Bus Controller (LBC). Only 12-bits are needed to access the 4KB 
// (1K DWORDS) of the PCI Express Configuration space per function. However, in order to access more than 4 KB of ELBI 
// register space, the default value of CX_LBC_EXT_AW can be increased up to a maximum of 32.
`define CX_LBC_EXT_AW 6'd32


// Name:           CX_LBC_NW
// Default:        64-bit ((CX_CXL_ENABLE == 1) ? 2 : 1)
// Values:         32-bit (1), 64-bit (2)
// Enabled:        ((!CX_CXL_ENABLE) && (CC_DEVICE_TYPE!=CC_RC))
// Parameter Type: Feature Setting
// 
// Defines the width of the ELBI databus for the Local Bus Controller (LBC) in dwords. There are 32 or 64 bits of 
// ext_lbc_din for each function in your controller configuration.
`define CX_LBC_NW 2


// Name:           CX_UNINVERTED_ELBI_DATA
// Default:        true ((CX_LBC_NW == 2) && CX_CXL_ENABLE)
// Values:         false (0), true (1)
// Enabled:        CX_LBC_NW == 2
// Parameter Type: Feature Setting
// 
// Removes requirement for data swapping logic at application layer for accesses to unaligned addresses for a 64 bit ELBI 
// databus.
`define CX_UNINVERTED_ELBI_DATA


// `define CX_ELBI_WD_32


`define CX_ELBI_WD_64


// `define CX_ELBI_WD_128


`define CX_LBC_INT_WD 64


