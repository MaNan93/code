// Name:           CX_P2NOBEACON_ENABLE
// Default:        false
// Values:         false (0), true (1)
// Enabled:        CX_PIPE_VER>=1
// Parameter Type: Feature Setting
// 
// Enable support for P2.NoBeacon. When this parameter is set, mac_phy_powerdown drives P2.NoBeacon encoding, instead of P2 
// encoding, when the link goes to L2.
`define CX_P2NOBEACON_ENABLE


`define CX_P2NOBEACON_ENABLE_VALUE 1'h1

