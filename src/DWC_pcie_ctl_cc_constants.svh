// time 
// to the assertion of RxEqEval
`define DEFAULT_GEN6_EQ_EVAL_2MS_EXTEND 1'd0


// Name:           DEFAULT_GEN3_LOWER_RATE_EQ_REDO_ENABLE
// Default:        Support (CX_GEN3_MODE != GEN3_DISABLED)
// Values:         Not Support (0), Support (1)
// Enabled:        CX_GEN3_MODE != GEN3_DISABLED
// Parameter Type: Register Default Setting
// 
// Support Gen3 EQ redo and a lower rate change. 
// This parameter is shared for Gen3/4 mode.
`define DEFAULT_GEN3_LOWER_RATE_EQ_REDO_ENABLE 1'd1


// Name:           DEFAULT_GEN3_EQ_FB_MODE
// Default:        Figure Of Merit ((CX_GEN3_MODE != GEN3_DISABLED))
// Values:         Direction Change (0), Figure Of Merit (1)
// Enabled:        ((CX_GEN3_MODE != GEN3_DISABLED))
// Parameter Type: Register Default Setting
// 
// Gen3 EQ Feedback Mode. 
//  - 0000b: Direction Change. Figure Of Merit method is also used by setting "Preset Request Vector". 
//  - 0001b: Figure Of Merit. Only Figure Of Merit method is used. 
//  - 0010b: Reserved 
//  - ...... Reserved 
//  - 1111b: Reserved 
// This is the default of the GEN3_EQ_FB_MODE field in GEN3_EQ_CONTROL_OFF when in Gen3 mode.
`define DEFAULT_GEN3_EQ_FB_MODE 4'd1


// Name:           DEFAULT_SUPPORT_FINITE_EQ_REQUEST
// Default:        Not Support
// Values:         Not Support (0), Support (1)
// Enabled:        ((CX_GEN3_MODE != GEN3_DISABLED))
// Parameter Type: Register Default Setting
// 
// Support finite EQ requests for USP, shared for Gen3, Gen4 and Gen5 rates. This parameter is the default of the 
// GEN3_SUPPORT_FINITE_EQ_REQUEST field in GEN3_EQ_CONTROL_OFF. 
//  - 0b: Not support, keep legacy feature 
//  - 1b: Support
`define DEFAULT_SUPPORT_FINITE_EQ_REQUEST 1'd0


// Name:           DEFAULT_EQ_REQ_NUM
// Default:        1
// Values:         0 1 2 3 4 5 6 7
// Enabled:        ((CX_GEN3_MODE != GEN3_DISABLED))
// Parameter Type: Register Default Setting
// 
// The number of back-to-back EQ requests for USP, shared for Gen3, Gen4 and Gen5 rates. This parameter is the default of 
// the GEN3_EQ_REQ_NUM field in GEN3_EQ_CONTROL_OFF. 
// After the back-to-back EQ requests meet the GEN3_EQ_REQ_NUM number, the USP will stop any more eq redo request for the 
// current rate. 
//  - 000b: No EQ request 
//  - 001b: Do EQ request once 
//  - 010b: Do EQ request twice 
//  - ..... 
//  - 111b: Do EQ request seven times
`define DEFAULT_EQ_REQ_NUM 3'd1


// Name:           DEFAULT_GEN4_EQ_FB_MODE
// Default:        Figure Of Merit ((CX_GEN4_MODE != GEN4_DISABLED))
// Values:         Direction Change (0), Figure Of Merit (1)
// Enabled:        ((CX_GEN4_MODE != GEN4_DISABLED))
// Parameter Type: Register Default Setting
// 
// Gen4 EQ Feedback Mode. 
//  - 0000b: Direction Change. Figure Of Merit method is also used by setting "Preset Request Vector". 
//  - 0001b: Figure Of Merit. Only Figure Of Merit method is used. 
//  - 0010b: Reserved 
//  - ...... Reserved 
//  - 1111b: Reserved 
// This is the default of the GEN3_EQ_FB_MODE field in GEN3_EQ_CONTROL_OFF when in Gen4 mode.
`define DEFAULT_GEN4_EQ_FB_MODE 4'd1


// Name:           DEFAULT_GEN5_EQ_FB_MODE
// Default:        Figure Of Merit ((CX_MAX_PCIE_SPEED >= 5))
// Values:         Direction Change (0), Figure Of Merit (1)
// Enabled:        ((CX_MAX_PCIE_SPEED >= 5))
// Parameter Type: Register Default Setting
// 
// Gen5 EQ Feedback Mode. 
//  - 0000b: Direction Change. Figure Of Merit method is also used by setting "Preset Request Vector". 
//  - 0001b: Figure Of Merit. Only Figure Of Merit method is used. 
//  - 0010b: Reserved 
//  - ...... Reserved 
//  - 1111b: Reserved 
// This is the default of the GEN3_EQ_FB_MODE field in GEN3_EQ_CONTROL_OFF when in Gen5 mode.
`define DEFAULT_GEN5_EQ_FB_MODE 4'd1


// Name:           DEFAULT_GEN6_EQ_FB_MODE
// Default:        Figure Of Merit ((CX_MAX_PCIE_SPEED >= 6))
// Values:         Direction Change (0), Figure Of Merit (1)
// Enabled:        ((CX_MAX_PCIE_SPEED >= 6))
// Parameter Type: Register Default Setting
// 
// Gen6 EQ Feedback Mode. 
//  - 0000b: Direction Change. Figure Of Merit method is also used by setting "Preset Request Vector". 
//  - 0001b: Figure Of Merit. Only Figure Of Merit method is used. 
//  - 0010b: Reserved 
//  - ...... Reserved 
//  - 1111b: Reserved 
// This is the default of the GEN3_EQ_FB_MODE field in GEN3_EQ_CONTROL_OFF when in Gen6 mode.
`define DEFAULT_GEN6_EQ_FB_MODE 4'd1


// Name:           DEFAULT_GEN4_USP_SEND_8GT_EQ_TS2_DISABLE
// Default:        1
// Values:         0, 1
// Enabled:        ((CX_GEN4_MODE != GEN4_DISABLED))
// Parameter Type: Register Default Setting
// 
// Upstream Port Send 8GT/s EQ TS2 Disable. The base spec defines that USP can optionally send 8GT EQ TS2 and it means 
// USP can set DSP TxPreset value in Gen4 Data Rate.  If this register set to 0, USP sends 8GT EQ TS2. If this register 
// set to 1, USP does not send 8GT EQ TS2. This applies to upstream ports only. No Function for downstream ports.
`define DEFAULT_GEN4_USP_SEND_8GT_EQ_TS2_DISABLE 1'd1


// Name:           DEFAULT_GEN5_USP_SEND_16GT_EQ_TS2_DISABLE
// Default:        0
// Values:         0, 1
// Enabled:        ((CX_MAX_PCIE_SPEED >= 5))
// Parameter Type: Register Default Setting
// 
// Upstream Port Send 16GT/s EQ TS2 Disable.
`define DEFAULT_GEN5_USP_SEND_16GT_EQ_TS2_DISABLE 1'd0


// Name:           DEFAULT_GEN6_USP_SEND_16GT_EQ_TS2_DISABLE
// Default:        0
// Values:         0, 1
// Enabled:        ((CX_MAX_PCIE_SPEED >= 6))
// Parameter Type: Register Default Setting
// 
// Upstream Port Send 16GT/s EQ TS2 Disable.
`define DEFAULT_GEN6_USP_SEND_16GT_EQ_TS2_DISABLE 1'd0


// Name:           DEFAULT_GEN3_RXEQ_PH01_EN
// Default:        0
// Values:         0, 1
// Enabled:        ((CX_GEN3_MODE != GEN3_DISABLED))
// Parameter Type: Register Default Setting
// 
// Gen3 EQ Rx Equalization Phase 0/Phase 1 Hold Enable. When this bit is set the upstream port holds phase 0 
// (the downstream port holds phase 1) for 10ms. Holding phase 0 or phase 1 can be used to allow sufficient time for 
// Rx Equalization to be performed by the PHY. This bit is used during Virtex-7 Gen3 equalization. The programmable 
// bits [RXEQ_PH01_EN, EQ_PHASE_2_3] can be used to obtain the following variations of the equalization procedure: 
//  - 00: Tx equalization only in phase 2/3 
//  - 01: No Tx equalization, no Rx equalization 
//  - 10: Tx equalization in phase 2/3, Rx equalization in phase 0/1 
//  - 11: No Tx equalization, Rx equalization in phase 0/1
`define DEFAULT_GEN3_RXEQ_PH01_EN 1'd0


// Name:           DEFAULT_GEN3_EQ_PHASE23_EXIT_MODE
// Default:        To Recovery.Speed
// Values:         To Recovery.Speed (0), To EQ 3 for USP or to Recovery.RcvrLock for 
//                 DSP (1)
// Enabled:        ((CX_GEN3_MODE != GEN3_DISABLED))
// Parameter Type: Register Default Setting
// 
// Gen3 EQ Master Phase Exit Mode After 24 ms Timeout 
//  - 0b: Exit to Recovery.Speed state 
//  - 1b: Exit to EQ Phase 3 for USP controller or Recovery.RcvrLock state for DSP controller 
// This is the default of the GEN3_EQ_PHASE23_EXIT_MODE field in GEN3_EQ_CONTROL_OFF when in Gen3 mode. 
// Setting to '1b' affects Direction Change EQ Feedback Mode. EQ requests for Figure Of Merit mode complete before 24 ms 
// timeout. See DEFAULT_GEN3_EQ_PSET_REQ_VEC for more.
`define DEFAULT_GEN3_EQ_PHASE23_EXIT_MODE 1'd0


// Name:           DEFAULT_GEN4_EQ_PHASE23_EXIT_MODE
// Default:        To Recovery.Speed
// Values:         To Recovery.Speed (0), To EQ 3 for USP or to Recovery.RcvrLock for 
//                 DSP (1)
// Enabled:        ((CX_GEN4_MODE != GEN4_DISABLED))
// Parameter Type: Register Default Setting
// 
// Gen4 EQ Master Phase Exit Mode After 24 ms Timeout 
//  - 0b: Exit to Recovery.Speed state 
//  - 1b: Exit to EQ Phase 3 for USP controller or Recovery.RcvrLock state for DSP controller 
// This is the default of the GEN3_EQ_PHASE23_EXIT_MODE field in GEN3_EQ_CONTROL_OFF when in Gen4 mode. 
// Setting to '1b' affects Direction Change EQ Feedback Mode. EQ requests for Figure Of Merit mode complete before 24 ms 
// timeout. See DEFAULT_GEN4_EQ_PSET_REQ_VEC for more.
`define DEFAULT_GEN4_EQ_PHASE23_EXIT_MODE 1'd0


// Name:           DEFAULT_GEN5_EQ_PHASE23_EXIT_MODE
// Default:        To Recovery.Speed
// Values:         To Recovery.Speed (0), To EQ 3 for USP or to Recovery.RcvrLock for 
//                 DSP (1)
// Enabled:        ((CX_MAX_PCIE_SPEED >= 5))
// Parameter Type: Register Default Setting
// 
// Gen5 EQ Master Phase Exit Mode After 24 ms Timeout 
//  - 0b: Exit to Recovery.Speed state 
//  - 1b: Exit to EQ Phase 3 for USP controller or Recovery.RcvrLock state for DSP controller 
// This is the default of the GEN3_EQ_PHASE23_EXIT_MODE field in GEN3_EQ_CONTROL_OFF when in Gen5 mode. 
// Setting to '1b' affects Direction Change EQ Feedback Mode. EQ requests for Figure Of Merit mode complete before 24 ms 
// timeout. See DEFAULT_GEN5_EQ_PSET_REQ_VEC for more.
`define DEFAULT_GEN5_EQ_PHASE23_EXIT_MODE 1'd0


// Name:           DEFAULT_GEN6_EQ_PHASE23_EXIT_MODE
// Default:        To Recovery.Speed
// Values:         To Recovery.Speed (0), To EQ 3 for USP or to Recovery.RcvrLock for 
//                 DSP (1)
// Enabled:        ((CX_MAX_PCIE_SPEED >= 6))
// Parameter Type: Register Default Setting
// 
// Gen6 EQ Master Phase Exit Mode After 24 ms Timeout 
//  - 0b: Exit to Recovery.Speed state 
//  - 1b: Exit to EQ Phase 3 for USP controller or Recovery.RcvrLock state for DSP controller 
