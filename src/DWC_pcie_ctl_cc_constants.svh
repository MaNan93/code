// Name:           VF_MSIX_TABLE_BIR_2
// Default:        BAR0
// Values:         BAR0 (0x0), BAR1 (0x1), BAR2 (0x2), BAR3 (0x3), BAR4 (0x4), BAR5 
//                 (0x5)
// Enabled:        CX_NFUNC > 2 && VF_MSIX_CAP_ENABLE==1
// Parameter Type: Register Default Setting
// 
// Default value for the Table BAR Indicator Register (BIR) field in the VF MSI-X Table Offset and BIR Register. Function 
// 2.
`define VF_MSIX_TABLE_BIR_2 3'h0


// Name:           VF_MSIX_TABLE_OFFSET_2
// Default:        0x0
// Values:         0x0, ..., 0x1fffffff
// Enabled:        CX_NFUNC > 2 && VF_MSIX_CAP_ENABLE==1
// Parameter Type: Register Default Setting
// 
// Default value for the Table Offset field in the VF MSI-X Table Offset and BIR Register. Function 2.
`define VF_MSIX_TABLE_OFFSET_2 29'h0


// Name:           VF_MSIX_PBA_BIR_2
// Default:        BAR0
// Values:         BAR0 (0x0), BAR1 (0x1), BAR2 (0x2), BAR3 (0x3), BAR4 (0x4), BAR5 
//                 (0x5)
// Enabled:        CX_NFUNC > 2 && VF_MSIX_CAP_ENABLE==1
// Parameter Type: Register Default Setting
// 
// Default value for the PBA BAR Indicator Register (BIR) field in the VF MSI-X PBA Offset and BIR Register. Function 2.
`define VF_MSIX_PBA_BIR_2 3'h0


`define VF_MSIX_PBA_OFFSET_2_BASELINE 16


// Name:           VF_MSIX_PBA_OFFSET_2
// Default:        0x2 (VF_MSIX_PBA_OFFSET_0)
// Values:         0x0, ..., 0x1fffffff
// Enabled:        CX_NFUNC > 2 && VF_MSIX_CAP_ENABLE==1
// Parameter Type: Register Default Setting
// 
// Default value for the PBA Offset field in the VF MSI-X PBA Offset and BIR Register. Function 2.
