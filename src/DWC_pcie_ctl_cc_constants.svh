// Values:         0, 1
// Enabled:        CX_CUSTOM_PIPELINING && CX_GEN5_SPEED
// Parameter Type: Performance Setting
// 
// Specifies insertion of register pipeline at the outputs of XMLH Precoding, providing trade-off of latency and gates for 
// ease of timing closure.
`define CX_XMLH_PRECODING_REGOUT 1


// Name:           CX_XMLH_GLAYCODING_REGOUT
