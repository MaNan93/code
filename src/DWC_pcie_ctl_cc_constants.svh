`define CX_SPIF_NSTREAM 8


// Name:         CX_SPIF_NPROTOCOL
// Default:      3
// Values:       -2147483648, ..., 2147483647
// 
// Number of bits for Protocol Type on the SPIF interface
`define CX_SPIF_NPROTOCOL 3


// Name:         CX_SPIF_NFMT
// Default:      4
// Values:       -2147483648, ..., 2147483647
// 
// Number of bits for Protocol Flit Format on the SPIF interface
`define CX_SPIF_NFMT 4


// Name:         CX_SPIF_NPRI
// Default:      2
// Values:       -2147483648, ..., 2147483647
// 
// Number of bits for Link Layer priority signal on the SPIF interface
`define CX_SPIF_NPRI 2


// Name:         CX_SPIF_NSPEEDMODE
// Default:      3
// Values:       -2147483648, ..., 2147483647
// 
// Number of bits for Speed Mode on the SPIF interface
`define CX_SPIF_NSPEEDMODE 3


// Name:         CX_SPIF_NLINKMODE
// Default:      6
// Values:       -2147483648, ..., 2147483647
// 
// Number of bits for Link Mode on the SPIF interface
`define CX_SPIF_NLINKMODE 6


// Name:         CX_SPIF_NESMSPEEDMODE
// Default:      6
// Values:       -2147483648, ..., 2147483647
// 
// Number of bits for CCIX Extended Speed Mode (ESM) on the SPIF interface
