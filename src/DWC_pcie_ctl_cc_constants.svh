// Name:         CC_AXI_BURST_SIZE_WD
// Default:      3
// Values:       -2147483648, ..., 2147483647
// 
// Defines the maximum number of bytes to transfer in each data transfer, or beat, in 
// a burst. Applicable to Master and Slave AXI interfaces.
`define CC_AXI_BURST_SIZE_WD 3


// Name:         CC_PCIE_TLP_TYPE_WD
// Default:      5
// Values:       -2147483648, ..., 2147483647
// 
// Defines the width of PCIe TLP Type field.
`define CC_PCIE_TLP_TYPE_WD 5


// Name:         CC_PCIE_TLP_MSG_CODE_WD
// Default:      8
// Values:       -2147483648, ..., 2147483647
// 
// Defines the width of PCIe Msg/MsgD TLP Message Code field.
`define CC_PCIE_TLP_MSG_CODE_WD 8


// Name:         CC_DTIM_PSTD_PCIE_TLP_DATA_WD
// Default:      64
// Values:       -2147483648, ..., 2147483647
// 
// Defines the width of the PCIe Posted MsgD data bus associated with DTIM messages. 
// e.g. Invalidate Request message.
`define CC_DTIM_PSTD_PCIE_TLP_DATA_WD 64


// Name:         CC_DTIM_PSTD_PCIE_TLP_DATA_STRB_WD
// Default:      8
// Values:       -2147483648, ..., 2147483647
// 
// Defines the width of the PCIe Posted MsgD data byte strobe bus associated with DTIM messages.
`define CC_DTIM_PSTD_PCIE_TLP_DATA_STRB_WD 8


// Name:         CC_DTIM_PSTD_PCIE_TLP_PRFX_WD
// Default:      32
// Values:       -2147483648, ..., 2147483647
// 
// Defines the width of the PCIe Posted MsgD prefix bus associated with DTIM messages.
`define CC_DTIM_PSTD_PCIE_TLP_PRFX_WD 32

