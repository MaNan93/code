`define CX_ACS_AT_BLOCK 1'h1


// Name:           CX_ACS_P2P_REQ_REDIRECT_0
// Default:        0x1
// Values:         0x0, 0x1
// Enabled:        CX_ACS_ENABLE
// Parameter Type: Feature Setting
// 
// This is the default value (after reset) of the ACS P2P Request Redirect bit field in the ACS Capability register in PF0. 
// A value of 1, indicates that the component implements ACS P2P Request Redirect.
`define CX_ACS_P2P_REQ_REDIRECT_0 1'h1


// Name:           CX_ACS_P2P_COMPL_REDIRECT_0
// Default:        0x1
// Values:         0x0, 0x1
// Enabled:        CX_ACS_ENABLE
// Parameter Type: Feature Setting
// 
