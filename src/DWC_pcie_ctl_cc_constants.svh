// Name:           CX_INTERNAL_ATU_ENABLE
// Default:        false
// Values:         false (0x0), true (0x1)
// Parameter Type: Feature Setting
// 
// Enable the instantiation of the internal address translation unit (iATU).
`define CX_INTERNAL_ATU_ENABLE 1'h1


// Name:           CX_ATU_NUM_OUTBOUND_REGIONS
// Default:        2
// Values:         0, ..., 256
// Enabled:        CX_INTERNAL_ATU_ENABLE
// Parameter Type: Feature Setting
// 
// Specify the number of address regions to be mapped by the internal Address Translation Unit in the outbound direction.
`define CX_ATU_NUM_OUTBOUND_REGIONS 16


// Name:           CX_ATU_NUM_INBOUND_REGIONS
// Default:        2
// Values:         0, ..., 256
// Enabled:        CX_INTERNAL_ATU_ENABLE
// Parameter Type: Feature Setting
// 
// Specifies the number of address regions to be mapped by the internal Address Translation Unit in the inbound direction.
`define CX_ATU_NUM_INBOUND_REGIONS 16


`define CX_ATU_OUT_NREGIONS_MIN1 16


`define CX_ATU_IN_NREGIONS_MIN1 16


// Name:           CX_IATU_LATENCY_RADM
// Default:        0 ((CX_INTERNAL_ATU_ENABLE && CX_MULTISTREAM_ARCH && 
//                 CX_ATU_NUM_INBOUND_REGIONS >= 64) ? 1 : 0)
// Values:         0, 1
// Enabled:        CX_INTERNAL_ATU_ENABLE && CX_MULTISTREAM_ARCH && 
//                 CX_CUSTOM_PIPELINING
// Parameter Type: Feature Setting
// 
// Specifies enabling of ATU_OPIPE register insertion, when  CX_ATU_NUM_INBOUND_REGIONS >=64 default value of this 
// parameter will be 1 else 0. This inserts an extra delay in the Filter Module which introduces an extra latency  to ease timing.
`define CX_IATU_LATENCY_RADM 0




// Name:           ADDR_TRANSLATION_SUPPORT_EN
// Default:        true (CX_INTERNAL_ATU_ENABLE)
// Values:         false (0), true (1)
// Enabled:        !CX_INTERNAL_ATU_ENABLE
// Parameter Type: Feature Setting
// 
// When set, the controller supports local (application <-> system) address translation services. Address translation is 
// used for mapping different address ranges between different memory spaces comprehended by the application. The address 
// translation unit (ATU) is internal or external (supplied by user) depending on the value of the CX_INTERNAL_ATU_ENABLE 
// parameter. Setting the CX_INTERNAL_ATU_ENABLE parameter forces ADDR_TRANSLATION_SUPPORT_EN to be '1'. For more information, see 
// the 'Address Translation' section in the the Databook. 
//  
// Note: The external ATU feature is deprecated - you should use the Internal Address Translation Unit (iATU) 
// as it is the easiest, most flexible and recommended method of implementing address/type translation. 
// The external address translation interface has numerous limitations in connection with the translation of MWr to 
// Msg/IOWr/CfgWr.
`define ADDR_TRANSLATION_SUPPORT_EN


// Name:           CX_ATU_CPIPE_EN
// Default:        0 (CX_INTERNAL_ATU_ENABLE && CX_MULTISTREAM_ARCH && 
//                 (CX_MAX_CORECLK_FREQ > 500) && (CX_ATU_NUM_OUTBOUND_REGIONS > 64))
// Values:         0, 1
// Enabled:        (CX_INTERNAL_ATU_ENABLE && CX_MULTISTREAM_ARCH && 
//                 (CX_MAX_CORECLK_FREQ > 500) && (CX_ATU_NUM_OUTBOUND_REGIONS > 64))
// Parameter Type: Feature Setting
// 
// Enable the instantiation of the central pipeline in the internal address translation unit. This is to ease timing on 
// larger ATU region configurations
