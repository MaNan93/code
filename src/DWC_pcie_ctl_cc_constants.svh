`define CX_RX_RBUF_DATA_WD 1938


// Name:         CX_RAS_RX_RBUF_PROT_WD
// Default:      246 ((CX_RAS_EN==1)? [<functionof> 0 CX_RX_RBUF_DATA_WD 0 
//               CX_RASDP_EN CX_RAS_PROT_TYPE CX_RAS_PROT_RANGE CX_RAS_RAM_PROT_RANGE 
//               RAS_BASE_PROT_WD RAS_RAM_BASE_PROT_WD RAS_TRACER_EN RX_RBUF_PW]: 0)
// Values:       -2147483648, ..., 2147483647
// Enabled:      CX_RX_RBUF_EN
// 
// Protection of RX Retry Buffer Data
`define CX_RAS_RX_RBUF_PROT_WD 246


// Name:         CX_RX_RBUF_WIDTH
// Default:      2184 ( CX_RAS_RX_RBUF_PROT_WD + CX_RX_RBUF_DATA_WD)
// Values:       -2147483648, ..., 2147483647
// Enabled:      CX_RX_RBUF_EN
// 
// Read-only parameter that indicates the width of the rx retry buffer.
`define CX_RX_RBUF_WIDTH 2184

