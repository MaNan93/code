// 
// This parameter indicates that the Margining Rate Mode Enable: 
//  - 0: Base Spec compliant mode: Lane Margining at Receiver is available at Gen4 data rate and higher rate. 
//  - 1: Special PHY Support mode: Lane Margining at Receiver is available at Gen4 data rate and at Gen1,Gen2 and Gen3 
//  data rate for debug. For more information, contact SYNOPSYS support/sales.
// `define CX_RXMARGIN_RATE_MODE_ENABLE


// Name:           DEFAULT_RXMARGIN_RATE_MODE
// Default:        0 (CX_RXMARGIN_RATE_MODE_ENABLE)
