// Parameter Type: Feature Setting
// 
// Default value to set the lane under test
`define CX_DEFAULT_LANE_UNDER_TEST 4'h0


// Name:         CX_NL_M_1
// Default:      7 (CX_NL-1)
// Values:       -2147483648, ..., 2147483647
// 
// Set the value of CX_NL - 1
`define CX_NL_M_1 7


// Name:           CX_PIPE_VER
// Default:        PIPE6.x (!CX_PHY_LOGICAL_ENABLE) ? 0 : (CX_GEN6_SPEED) ? 4 : 
//                 (CX_PCIE_MODE == PCIE_OVER_CIO) ? 2 : ((CX_GEN5_SPEED || 
//                 CX_CCIX_ESM_SUPPORT) ? 2 : [<functionof> %item])
// Values:         PIPE4.2 and below (0), PIPE4.3 (1), PIPE4.4.1 (2), PIPE5.1.1 (3), 
//                 PIPE6.x (4)
// Enabled:        ((CX_PCIE_MODE != PCIE_OVER_CIO) && CX_PHY_LOGICAL_ENABLE)
// Parameter Type: Feature Setting
// 
// Select PIPE Version. 
//  - PIPE 4.2 
//  - PIPE 4.3 
//  -- Use mac_phy_powerdown signal for L1 substate/L1.CPM transition 
//  -- Use Synopsys specific Message Bus Interface for Lane Margining 
//  - PIPE 4.4.1 
//  -- Use mac_phy_powerdown signal for L1 substate/L1.CPM transition 
//  -- Use 5-bit LocalPresetIndex encoding for Gen4 data rate 
//  -- Use Message Bus Interface for Lane Margining for Gen4 data rate 
//  - PIPE 5.1.1 
//  -- Use mac_phy_powerdown signal for L1 substate/L1.CPM transition 
//  -- Use PIPE Low Pin Count Interface 
//  -- Use SerDes Architecture (Optional) 
//  -- Use PCLK as PHY input optionally 
//  - PIPE 6.x 
// Contact your PHY vendor for guidelines on PIPE Spec Version.
`define CX_PIPE_VER 4



// Name:           CX_PIPE43_SUPPORT
// Default:        PowerDown (CX_PIPE_VER>=1)
// Values:         Side band (0), PowerDown (1)
// Enabled:        CX_PIPE43_OVERRIDE_EN
// Parameter Type: Feature Setting
// 
// This is read-only parameter to indicate whether the controller uses mac_phy_powerdown signal for L1-Substate transition 
// or uses legacy side-band interface signals. You can change the setting by @CX_PIPE_VER parameter located in "Basic Feature 
// Config".
`define CX_PIPE43_SUPPORT


`define CX_PIPE44_SUPPORT


`define CX_PIPE5_SUPPORT


`define CX_PIPE6_SUPPORT


// Name:           CX_PIPE_SERDES_ARCH
// Default:        SerDes architecture (CX_GEN6_SPEED && CX_PHY_LOGICAL_ENABLE)
// Values:         Original PIPE architecture (0), SerDes architecture (1)
// Enabled:        ((CX_PIPE5_SUPPORT || (CX_GEN6_SPEED && DWC_PCIE_FPGA==1)) && 
//                 CX_PHY_LOGICAL_ENABLE)
// Parameter Type: Feature Setting
// 
