// Enabled:      CC_LTIM_ENABLE && CX_MULTISTREAM_ARCH
// 
// Width of watch dog timeout value of NP stream LTIM.
`define CX_LTI_NP_TO_WIDTH 10


// Name:         CX_LTI_NP_MSI_CTRL_WIDTH
// Default:      6
