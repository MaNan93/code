// Default:      1 (CX_CXL_CHI_ENABLE && CX_CXL_MEM_EN && (CX_CXL_DOWNSTREAM_PORT || 
//               CX_CXL_SYMMEM_SUPPORT))
// Values:       0, 1
// 
// Enable CXL.mem M2S to S2M channels
`define CX_CXL_M2S_S2M_ENABLE


// Name:         CX_CXL_S2M_M2S_ENABLE
// Default:      1 (CX_CXL_CHI_ENABLE && CX_CXL_MEM_EN && (CX_CXL_UPSTREAM_PORT || 
//               CX_CXL_SYMMEM_SUPPORT))
// Values:       0, 1
// 
// Enable CXL.mem S2M to M2S channels
`define CX_CXL_S2M_M2S_ENABLE


// Name:         CX_CXL_H2D_D2H_ENABLE
// Default:      1 (CX_CXL_CHI_ENABLE && CX_CXL_CACHE_EN && CX_CXL_DOWNSTREAM_PORT)
// Values:       0, 1
// 
// Enable CXL.cache H2D to D2H channels
`define CX_CXL_H2D_D2H_ENABLE


// Name:         CX_CXL_D2H_H2D_ENABLE
// Default:      1 (CX_CXL_CHI_ENABLE && CX_CXL_CACHE_EN && CX_CXL_UPSTREAM_PORT)
