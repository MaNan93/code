// Parameter Type: Feature Setting
// 
// Include the BAR3 registers.
`define BAR3_ENABLED_0 1'h0


`define DEFAULT_BAR3_ENABLED_0 1'h0


// Name:           MEM3_SPACE_DECODER_0
