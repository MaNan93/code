//  - 5: 2MB 
//  - . 
//  - . 
//  - . 
//  - 22: 256GB 
//  - 23: 512GB 
//  - 31-24: RsvdP 
//  
//  Example: 0x00000030 indicates that BAR3 operates correctly with the 
//  BAR sized to either 1MB or 2MB.
`define CX_BAR3_RESOURCE_AVAIL_4 32'h10


// Name:           BAR3_MASK_WRITABLE_4
