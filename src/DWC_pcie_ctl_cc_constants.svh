// Name:         CX_MEMORY_MAP_VIEW
// Default:      DBI
// Values:       DBI (0), WIRE (1), DBI2 (2)
// 
// Specifies the current memory map view. There are two buses that can access the controller's register space: DBI and WIRE 
// (over PCIe protocol). 
// The register map as perceived from the remote link partner (wire view) is different to that of the local application 
// (DBI view). For example, many registers that are RO over the wire are also RW over the DBI. When generating DocBook XML or 
// HTML register reports, coreConsultant uses this parameter to determine which memory map view to generate. This parameter 
// has no effect on the RTL implementation. 
//  - 0: DBI 
//  - 1: WIRE 
//  - 2: DBI2
`define CX_MEMORY_MAP_VIEW 0


// Name:         CX_UNROLL_VIEW
// Default:      NO_UNROLL
// Values:       NO_UNROLL (0), UNROLL (1)
// Enabled:      (CC_UNROLL_ENABLE && (CX_MEMORY_MAP_VIEW <2))
// 
// Specifies whether to generate unroll (that is, iATU and DMA registers only) DocBook XML or HTML register reports or not. 
// 
// coreConsultant uses this parameter to determine whether to generate the unroll (that is, iATU and DMA registers only) 
// register report or not. This parameter has no effect on the RTL implementation. 
//  - 0: NO_UNROLL 
//  - 1: UNROLL
`define CX_UNROLL_VIEW 0


// Name:         CX_MEMBAR0_VIEW
// Default:      NO_MEMBAR0_WIRE
// Values:       NO_MEMBAR0_WIRE (0), MEMBAR0_WIRE (1)
// Enabled:      CX_CXL_ENABLE
// 
// Specifies whether to generate RCRB MEMBAR0 WIRE View DocBook XML or HTML register reports or not. 
// coreConsultant uses this parameter to determine whether to generate the Membar0(that is, MEMBAR0 wire view registers 
// only) register report or not. This parameter has no effect on the RTL implementation.
`define CX_MEMBAR0_VIEW 0


// Name:         CX_BANK_SEL
// Default:      EXTENDED_PF1_PF32
// Values:       EXTENDED_PF1_PF32 (0), EXTENDED_PF33_PF64 (1), EXTENDED_PF65_PF96 
//               (2), EXTENDED_PF97_PF128 (3), EXTENDED_PF129_PF160 (4)
// Enabled:      CX_NFUNC > 32
// 
// Specifies whether to generate EXTENDED PF DBI/WIRE View DocBook XML or HTML register reports or not. 
// coreConsultant uses this parameter to determine whether to generate the extended PFs register report or not. This 
// parameter has no effect on the RTL implementation.
`define CX_BANK_SEL 0


// Name:         FUNC_GTR_THAN_64
// Default:      NO_EXTENDED_PF_GRT64 (CX_NFUNC > 64)
// Values:       NO_EXTENDED_PF_GRT64 (0), EXTENDED_PF_GRT64 (1)
// Enabled:      CX_NFUNC > 64
// 
// Specifies whether to generate EXTENDED PF DBI/WIRE View DocBook XML or HTML register reports or not for CX_NFUNC>64. 
// coreConsultant uses this parameter to determine whether to generate the extended PFs register report or not. This 
// parameter has no effect on the RTL implementation.
// `define FUNC_GTR_THAN_64


// Name:         FUNC_GTR_THAN_96
// Default:      NO_EXTENDED_PF_GRT96 (CX_NFUNC > 96)
