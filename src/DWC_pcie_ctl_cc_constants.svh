// Enabled:        (CC_DEVICE_TYPE!=CC_EP) && CX_DEF_MEM_WR_ENABLE
// Parameter Type: Feature Setting.
// 
// Enable Deferrable Memory Write (DMWr) routing support. Applicable only to Switch USPs, Switch DSPs, and Root Ports (AXI 
// Bridge not supported).
`define CX_DEF_MEM_WR_ROUTING_EN 1'h0


// `define CX_DEF_MEM_WR_ROUTING_SUP



// Name:           CX_L0P_EN
// Default:        true (CX_GEN6_SPEED)
